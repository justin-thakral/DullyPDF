            },
            {
              "key": "quantity",
              "label": "Qty. / extent / status",
              "units": 0.95
            },
            {
              "key": "evidence",
              "label": "Evidence ref",
              "units": 0.95
            },
            {
              "key": "owner",
              "label": "Owner or custodian",
              "units": 0.9
            }
          ],
          "rows": 6
        },
        {
          "key": "financial_status",
          "type": "table",
          "label": "Value, cost, payment, or transaction tracking",
          "columns": [
            {
              "key": "item_id",
              "label": "Item ID",
              "units": 0.75
            },
            {
              "key": "basis",
              "label": "Claimed / estimated basis",
              "units": 1.2
            },
            {
              "key": "amount",
              "label": "Amount or unit value",
              "units": 0.9
            },
            {
              "key": "status",
              "label": "Review or payment status",
              "units": 1.0
            },
            {
              "key": "support",
              "label": "Invoice / estimate / system ref",
              "units": 1.25
            },
            {
              "key": "reviewer",
              "label": "Reviewer",
              "units": 0.85
            }
          ],
          "rows": 5,
          "guidance": "Amounts are factual record entries, not coverage, valuation, or payment recommendations."
        },
        {
          "key": "inventory_boundary",
          "type": "notice",
          "label": "Inventory record boundary",
          "guidance": "This record does not classify water, diagnose contamination, authorize entry into electrical or structurally unsafe areas, or determine coverage. Stop unsafe work and route source control, sampling, demolition, and claim decisions to qualified authority."
        }
      ]
    },
    {
      "key": "evidence_reconciliation",
      "title": "Water Damage evidence support and reconciliation",
      "guidance": "Link each material item to source evidence and make missing, duplicated, and conflicting records explicit.",
      "blocks": [
        {
          "key": "expected_support",
          "type": "checklist",
          "label": "Water Damage supporting evidence",
          "items": [
            "Source and affected-area photographs before material removal",
            "Moisture readings with location, instrument, date, and operator",
            "Plumber, appliance, roofer, utility, or mitigation report",
            "Water bills, alarms, maintenance, or prior leak records",
            "Drying, extraction, equipment-placement, and monitoring logs",
            "Removed material, contents, sample, or disposal authorization log",
            "Repair, mitigation, temporary lodging, and utility receipts",
            "Adjoining unit, landlord, tenant, or property-manager notices"
          ]
        },
        {
          "key": "reconciliation_register",
          "type": "table",
          "label": "Source-to-inventory reconciliation",
          "columns": [
            {
              "key": "source",
              "label": "Source or schedule",
              "units": 1.1
            },
            {
              "key": "expected",
              "label": "Expected count or amount",
              "units": 1.0
            },
            {
              "key": "recorded",
              "label": "Recorded count or amount",
              "units": 1.0
            },
            {
              "key": "variance",
              "label": "Variance and reason",
              "units": 1.1
            },
            {
              "key": "action",
              "label": "Action, owner, and due",
              "units": 1.25
            }
          ],
          "rows": 4
        },
        {
          "key": "control_totals",
          "type": "fields",
          "label": "Worksheet control totals",
          "fields": [
            {
              "key": "recorded_count",
              "label": "Recorded item count",
              "units": 0.9
            },
            {
              "key": "supported_count",
              "label": "Evidence-supported count",
              "units": 1.0
            },
            {
              "key": "exception_count",
              "label": "Exception count",
              "units": 0.9
            },
            {
              "key": "total_recorded",
              "label": "Recorded total, if applicable",
              "units": 1.0
            },
            {
              "key": "total_verified",
              "label": "Verified total, if applicable",
              "units": 1.0
            },
            {
              "key": "difference",
              "label": "Unreconciled difference",
              "units": 1.0
            }
          ]
        }
      ]
    },
    {
      "key": "exceptions_review",
      "title": "Water Damage inventory exceptions and decisions",
      "guidance": "Keep every discrepancy open until its evidence, owner, review authority, and disposition are recorded.",
      "blocks": [
        {
          "key": "exception_screen",
          "type": "checklist",
          "label": "Water Damage inventory exception screen",
          "items": [
            "Water source remains active, inaccessible, or unverified",
            "Wet electrical or structural condition blocks safe access",
            "Contamination or microbial concern lacks qualified assessment",
            "Materials were removed before condition and location were documented",
            "Moisture readings conflict or omit affected cavities and boundaries",
            "Adjoining unit, tenant, landlord, or recovery route is unresolved"
          ]
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Inventory discrepancy and disposition",
          "columns": [
            {
              "key": "item_ref",
              "label": "Item or source ref",
              "units": 0.9
            },
            {
              "key": "discrepancy",
              "label": "Missing, duplicate, or conflict",
              "units": 1.3
            },
            {
              "key": "investigation",
              "label": "Verification action",
              "units": 1.15
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "decision",
              "label": "Authorized disposition",
              "units": 1.15
            }
          ],
          "rows": 5
        },
        {
          "key": "reconciliation_rationale",
          "type": "textarea",
          "label": "Reconciliation rationale and unresolved limitations",
          "fields": [
            {
              "key": "rationale",
              "label": "Water Damage differences, source reliability, evidence conflicts, decisions, and items excluded from totals",
              "multiline": true
            }
          ],
          "height": 68
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Water Damage inventory closeout, certification, and handoff",
      "guidance": "Close only after totals, exceptions, evidence, and downstream ownership are independently reviewable.",
      "blocks": [
        {
          "key": "closeout_checks",
          "type": "checklist",
          "label": "Inventory closeout checks",
          "items": [
            "Control totals reconcile to the stated source and cutoff",
            "Each material item has a unique identity and evidence route",
            "Amounts and status entries identify their source and date",
            "No inventory entry implies an unauthorized coverage decision",
            "Exceptions have final dispositions or accountable owners",
            "The receiving reviewer can reproduce the reconciliation"
          ]
        },
        {
          "key": "final_reconciliation",
          "type": "fields",
          "label": "Final reconciliation and handoff",
          "fields": [
            {
              "key": "final_status",
              "label": "Final worksheet status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Reconciled",
                "Reconciled with exceptions",
                "Open",
                "Superseded"
              ]
            },
            {
              "key": "final_count",
              "label": "Final item count",
              "units": 0.9
            },
            {
              "key": "open_count",
              "label": "Open exception count",
              "units": 0.9
            },
            {
              "key": "recipient",
              "label": "Receiving owner",
              "units": 1.0
            },
            {
              "key": "next_action",
              "label": "Next action or decision",
              "units": 1.15
            },
            {
              "key": "handoff_date",
              "label": "Handoff date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "worksheet_signoff",
          "type": "signatures",
          "label": "Prepared, independently reviewed, and accepted",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by / date",
              "units": 1.0
            },
            {
              "key": "reconciled_by",
              "label": "Reconciled by / date",
              "units": 1.05
            },
            {
              "key": "reviewed_by",
              "label": "Qualified reviewer / date",
              "units": 1.05
            },
            {
              "key": "accepted_by",
              "label": "Recipient / date",
              "units": 0.95
            }
          ]
        }
      ]
    }
