{
  "schema_version": 1,
  "catalog_id": "insurance_claims/dic_2016__water_damage_inventory_worksheet_form",
  "source_section": "insurance_claims",
  "source_filename": "dic_2016__water_damage_inventory_worksheet_form.pdf",
  "slug": "water-damage-inventory-worksheet-form",
  "title": "Water Damage Inventory Worksheet Form",
  "subtitle": "A decision-ready water damage inventory worksheet that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original water damage inventory worksheet for water source, migration path, and affected materials with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the water-loss claim and mitigation coordination owner must open and control a inventory worksheet for water source, migration path, and affected materials. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Water Damage inventory worksheet identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
      "blocks": [
        {
          "key": "record_identity",
          "type": "fields",
          "label": "Water Damage inventory worksheet record",
          "fields": [
            {
              "key": "worksheet_id",
              "label": "Inventory worksheet ID",
              "units": 0.95
            },
            {
              "key": "claim_reference",
              "label": "Claim or service record",
              "units": 1.05
            },
            {
              "key": "inventory_cutoff",
              "label": "Inventory as-of date and time",
              "units": 1.0
            },
            {
              "key": "prepared_by",
              "label": "Prepared by",
              "units": 0.95
            },
            {
              "key": "location_scope",
              "label": "Location or schedule scope",
              "units": 1.15
            },
            {
              "key": "reconciliation_status",
              "label": "Reconciliation status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Open",
                "In review",
                "Reconciled",
                "Exception hold"
              ]
            }
          ],
          "guidance": "Use the same record identifiers in evidence, communications, and handoff."
        },
        {
          "key": "domain_identity",
          "type": "fields",
          "label": "Water Damage subject and event identity",
          "fields": [
            {
              "key": "discovery_time",
              "label": "First observed date and time",
              "units": 1.0
            },
            {
              "key": "source_location",
              "label": "Suspected source and exact location",
              "units": 1.25
            },
            {
              "key": "source_status",
              "label": "Source active, stopped, or unknown",
              "units": 1.15
            },
            {
              "key": "affected_levels",
              "label": "Affected rooms, units, and levels",
              "units": 1.05
            },
            {
              "key": "occupancy_status",
              "label": "Occupancy and access status",
              "units": 1.0
            },
            {
              "key": "mitigation_ref",
              "label": "Mitigation company/job ref",
              "units": 1.1
            }
          ],
          "guidance": "Source, affected level, and moisture-map reference"
        },
        {
          "key": "scope_statement",
          "type": "textarea",
          "label": "Inventory Worksheet scope and opening facts",
          "fields": [
            {
              "key": "scope_detail",
              "label": "Water Damage purpose, source wording, requested outcome, known limitations, and excluded work",
              "multiline": true
            }
          ],
          "height": 50
        }
      ]
    },
    {
      "key": "inventory_scope",
      "title": "Water Damage inventory scope, method, and completeness",
      "guidance": "Define the population, cutoff, source systems, and reconciliation method before recording items.",
      "blocks": [
        {
          "key": "scope_control",
          "type": "fields",
          "label": "Inventory control totals and method",
          "fields": [
            {
              "key": "source_population",
              "label": "Source population or system",
              "units": 1.15
            },
            {
              "key": "cutoff_rule",
              "label": "Cutoff rule and timestamp",
              "units": 1.05
            },
            {
              "key": "starting_count",
              "label": "Starting expected count",
              "units": 0.9
            },
            {
              "key": "location_count",
              "label": "Location or category count",
              "units": 0.9
            },
            {
              "key": "currency_unit",
              "label": "Currency or measurement basis",
              "units": 1.0
            },
            {
              "key": "version_ref",
              "label": "Source export or version ref",
              "units": 1.1
            }
          ]
        },
        {
          "key": "scope_checks",
          "type": "checklist",
          "label": "Water Damage inventory setup checks",
          "items": [
            "Exact claim, policy, request, or service record was confirmed",
            "Included and excluded categories are documented",
            "Cutoff date and later additions are distinguishable",
            "Source records and attachment locations are traceable",
            "Ownership, interest, or responsible party is captured",
            "Condition and pre-existing information are preserved",
            "Duplicate, replacement, transferred, and withdrawn items are marked",
            "Sensitive data is limited and stored through approved routes"
          ]
        },
        {
          "key": "method_notes",
          "type": "textarea",
          "label": "Inventory method, scope limits, and known gaps",
          "fields": [
            {
              "key": "method",
              "label": "Water Damage source population, wet area, material, contents, and mitigation categories, reconciliation approach, assumptions, and exclusions",
              "multiline": true
            }
          ],
          "height": 62
        }
      ]
    },
    {
