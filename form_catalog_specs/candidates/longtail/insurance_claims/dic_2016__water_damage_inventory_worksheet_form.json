      "title": "Water Damage detailed inventory",
      "guidance": "Use one row per independently traceable item, task, amount, document, or subject.",
      "blocks": [
        {
          "key": "primary_inventory",
          "type": "table",
          "label": "Primary wet area, material, contents, and mitigation register",
          "columns": [
