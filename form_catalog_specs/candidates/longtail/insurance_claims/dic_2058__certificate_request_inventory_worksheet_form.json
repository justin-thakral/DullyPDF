    {
      "key": "exceptions_review",
      "title": "Certificate Request inventory exceptions and decisions",
      "guidance": "Keep every discrepancy open until its evidence, owner, review authority, and disposition are recorded.",
      "blocks": [
        {
          "key": "exception_screen",
          "type": "checklist",
          "label": "Certificate Request inventory exception screen",
          "items": [
            "Requester authority, insured identity, or recipient cannot be verified",
            "Policy, line, term, or status conflicts with the request",
            "Requested wording would amend, expand, guarantee, or misstate coverage",
            "Required endorsement or authorized approval is absent",
            "Delivery route exposes policy data or sends to an unverified recipient",
            "Superseded or incorrect certificate remains in circulation"
          ]
        },
