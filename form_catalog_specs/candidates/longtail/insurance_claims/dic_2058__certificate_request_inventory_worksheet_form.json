          "key": "inventory_boundary",
          "type": "notice",
          "label": "Inventory record boundary",
          "guidance": "A certificate is evidence of insurance and must not amend, expand, guarantee, or replace the policy. Use only an approved form and verified policy data, route endorsement requests separately, and allow only an authorized insurer or producer process to issue it."
        }
      ]
    },
    {
      "key": "evidence_reconciliation",
      "title": "Certificate Request evidence support and reconciliation",
      "guidance": "Link each material item to source evidence and make missing, duplicated, and conflicting records explicit.",
      "blocks": [
        {
          "key": "expected_support",
          "type": "checklist",
          "label": "Certificate Request supporting evidence",
          "items": [
            "Dated request and authenticated requester-source reference",
            "Named-insured, policy, line, status, and term verification",
            "Certificate-holder name, address, project, and contract reference",
            "Requested wording excerpt stored with source and page reference",
            "Applicable endorsement or policy-language verification",
            "Authorized form, system transaction, issuer, and issue timestamp",
            "Quality review, correction, replacement, or withdrawal record",
            "Approved delivery, recipient, access, and retention confirmation"
          ]
        },
