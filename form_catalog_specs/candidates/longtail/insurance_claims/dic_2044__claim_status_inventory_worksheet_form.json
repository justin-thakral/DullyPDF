            }
          ],
          "rows": 5
        },
        {
          "key": "reconciliation_rationale",
          "type": "textarea",
          "label": "Reconciliation rationale and unresolved limitations",
          "fields": [
            {
              "key": "rationale",
              "label": "Claim Status differences, source reliability, evidence conflicts, decisions, and items excluded from totals",
              "multiline": true
            }
          ],
          "height": 68
        }
      ]
