          "rows": 5,
          "guidance": "Amounts are factual record entries, not coverage, valuation, or payment recommendations."
        },
        {
          "key": "inventory_boundary",
          "type": "notice",
          "label": "Inventory record boundary",
          "guidance": "A status record reports verified file activity as of a stated time; it does not create coverage, waive requirements, promise payment, or replace an authorized decision notice. Separate facts, pending work, estimates, and final decisions and cite the controlling record."
        }
      ]
    },
    {
      "key": "evidence_reconciliation",
      "title": "Claim Status evidence support and reconciliation",
      "guidance": "Link each material item to source evidence and make missing, duplicated, and conflicting records explicit.",
      "blocks": [
        {
          "key": "expected_support",
          "type": "checklist",
          "label": "Claim Status supporting evidence",
          "items": [
            "Claim-system status and assigned-owner confirmation",
            "Diary, task, milestone, and promised-update records",
            "Coverage correspondence and controlling-policy reference",
            "Inspection, estimate, invoice, valuation, or expert report",
            "Payment, deductible, recovery, salvage, or subrogation record",
            "Customer, claimant, insured, or representative correspondence",
            "Management, legal, fraud, complaint, or regulatory-review reference",
            "Closure notice, reopen condition, and retention reference"
          ]
        },
