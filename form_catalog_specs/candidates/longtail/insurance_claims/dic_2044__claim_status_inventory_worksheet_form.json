    {
      "key": "exceptions_review",
      "title": "Claim Status inventory exceptions and decisions",
      "guidance": "Keep every discrepancy open until its evidence, owner, review authority, and disposition are recorded.",
      "blocks": [
        {
          "key": "exception_screen",
          "type": "checklist",
          "label": "Claim Status inventory exception screen",
          "items": [
            "System status conflicts with the latest dated evidence",
            "No accountable owner or next update date is assigned",
            "A promised communication or required route may be overdue",
            "Coverage, liability, payment, or closure wording lacks authorization",
            "Complaint, dispute, attorney, regulator, or vulnerable-person issue exists",
            "Claim is marked closed while a task, payment, recovery, or notice remains"
          ]
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Inventory discrepancy and disposition",
          "columns": [
            {
              "key": "item_ref",
