        {
          "key": "condition_indicators",
          "type": "checklist",
          "label": "Property Damage condition indicators",
          "items": [
            "Fire, smoke, soot, heat, or fire-department response",
            "Theft, vandalism, forced entry, or missing property",
            "Wind, hail, fallen object, or exterior opening",
            "Water, moisture, plumbing, appliance, or drainage involvement",
            "Electrical arcing, damaged service, gas odor, or utility hazard",
            "Structural movement, collapse, ceiling sag, or unsafe access",
            "Contents, tenant improvements, or business property affected",
            "Temporary lodging, loss of use, or continuity expense reported"
          ],
          "guidance": "Checking an indicator records its presence or report; it is not a cause or coverage conclusion."
        },
        {
          "key": "observation_narrative",
          "type": "textarea",
          "label": "Inspection sequence and factual narrative",
          "fields": [
            {
              "key": "narrative",
