        },
        {
          "key": "inspection_boundary",
          "type": "notice",
          "label": "Inspection and authority boundary",
          "guidance": "This record does not authorize unsafe entry, demolition, disposal, repair scope, valuation, or coverage. Protect people, prevent further damage when safely authorized, retain evidence, and route technical and claim decisions to qualified reviewers."
        }
