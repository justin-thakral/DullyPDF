              "field_type": "choice",
              "options": [
                "Scheduled",
                "Partial",
                "Complete",
                "Review hold"
              ]
            }
          ],
          "guidance": "Use the same record identifiers in evidence, communications, and handoff."
        },
        {
          "key": "domain_identity",
          "type": "fields",
          "label": "Auto Accident subject and event identity",
          "fields": [
            {
              "key": "loss_date_time",
              "label": "Collision date and time",
