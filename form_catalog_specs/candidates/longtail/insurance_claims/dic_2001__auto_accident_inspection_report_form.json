            {
              "key": "operability",
              "label": "Operability and tow site",
              "units": 1.0
            },
            {
              "key": "trip_context",
              "label": "Trip purpose or use at time of event",
              "units": 1.1
            }
          ],
          "guidance": "Police agency and report reference"
        },
