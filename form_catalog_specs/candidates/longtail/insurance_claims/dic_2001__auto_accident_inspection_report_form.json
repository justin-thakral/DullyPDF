          "key": "scope_statement",
          "type": "textarea",
          "label": "Inspection Report scope and opening facts",
          "fields": [
            {
              "key": "scope_detail",
              "label": "Auto Accident purpose, source wording, requested outcome, known limitations, and excluded work",
              "multiline": true
            }
          ],
          "height": 50
        }
      ]
    },
    {
      "key": "inspection_plan",
      "title": "Auto Accident inspection authority, access, and evidence plan",
      "guidance": "Confirm the approved scope, safe access, evidence method, and conditions that require the inspection to stop.",
      "blocks": [
        {
          "key": "preinspection_check",
          "type": "checklist",
          "label": "Pre-inspection controls",
          "items": [
            "Assignment scope and exact subject were verified",
            "Access permission and site contact were confirmed",
            "Required qualification, equipment, and protective controls were confirmed",
            "Known hazards and restricted areas were reviewed",
            "Photograph, measurement, sample, and data permissions were confirmed",
            "Preservation or custody expectations were documented",
            "Potential conflicts of interest were disclosed",
            "Stop-work and emergency route were understood"
          ]
        },
        {
          "key": "inspection_conditions",
          "type": "fields",
          "label": "Inspection conditions",
          "fields": [
            {
              "key": "arrival_departure",
              "label": "Arrival and departure time",
              "units": 1.0
            },
            {
              "key": "weather_environment",
              "label": "Weather or environment",
              "units": 1.05
            },
            {
              "key": "access_provided_by",
              "label": "Access provided by",
              "units": 1.0
            },
            {
              "key": "persons_present",
              "label": "Persons present reference",
              "units": 1.1
            },
            {
              "key": "limitations",
              "label": "Access or inspection limitation",
              "units": 1.15
            },
            {
              "key": "scope_status",
              "label": "Scope status",
              "units": 0.9,
              "field_type": "choice",
              "options": [
                "Complete",
                "Partial",
                "Stopped",
                "Reschedule"
              ]
            }
          ]
        },
        {
          "key": "inspection_boundary",
          "type": "notice",
          "label": "Inspection and authority boundary",
          "guidance": "This record does not determine fault, liability, value, or coverage. Address emergencies first, avoid admissions or promises, preserve evidence, and route decisions to the authorized adjuster under the controlling policy and applicable requirements."
        }
      ]
    },
