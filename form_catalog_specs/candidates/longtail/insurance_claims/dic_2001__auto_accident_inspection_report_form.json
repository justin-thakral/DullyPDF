{
  "schema_version": 1,
  "catalog_id": "insurance_claims/dic_2001__auto_accident_inspection_report_form",
  "source_section": "insurance_claims",
  "source_filename": "dic_2001__auto_accident_inspection_report_form.pdf",
  "slug": "auto-accident-inspection-report-form",
  "title": "Auto Accident Inspection Report Form",
  "subtitle": "A decision-ready auto accident inspection report that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original auto accident inspection report for collision event and involved vehicle with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the auto claim intake or adjusting owner must open and control a inspection report for collision event and involved vehicle. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Auto Accident inspection report identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
      "blocks": [
        {
          "key": "record_identity",
          "type": "fields",
          "label": "Auto Accident inspection report record",
          "fields": [
            {
              "key": "inspection_id",
              "label": "Inspection report ID",
              "units": 0.95
            },
            {
              "key": "claim_reference",
              "label": "Claim or service record",
              "units": 1.05
            },
            {
              "key": "inspection_date",
              "label": "Inspection date and time",
              "units": 1.0
            },
            {
              "key": "inspector",
              "label": "Inspector and qualification ref",
