        {
          "key": "condition_indicators",
          "type": "checklist",
          "label": "Auto Accident condition indicators",
          "items": [
            "Injury or emergency response was reported",
            "More than two vehicles or a chain event was involved",
            "Hit-and-run, uninsured, or unknown driver concern exists",
            "Vehicle was towed, impounded, or is accruing storage",
            "Commercial, delivery, rideshare, or business use was reported",
            "Child restraint or mobility equipment may need separate review",
            "Roadside property, cargo, or a non-vehicle asset was affected",
            "Citation, witness, dashcam, or traffic-camera evidence exists"
          ],
          "guidance": "Checking an indicator records its presence or report; it is not a cause or coverage conclusion."
        },
        {
          "key": "observation_narrative",
          "type": "textarea",
          "label": "Inspection sequence and factual narrative",
          "fields": [
            {
              "key": "narrative",
              "label": "Auto Accident inspection path, direct facts, reported facts, comparison points, and unknowns",
              "multiline": true
