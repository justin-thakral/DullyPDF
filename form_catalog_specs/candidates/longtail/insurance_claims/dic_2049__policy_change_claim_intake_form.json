              "multiline": true
            }
          ],
          "height": 78
        },
        {
          "key": "intake_boundary",
          "type": "notice",
          "label": "Claim intake boundary",
          "guidance": "This record is a request, not a binder, endorsement, certificate, coverage confirmation, or promise of effective date. Only authorized issuance changes the policy. Keep known losses and claim decisions separate and apply the controlling policy and jurisdiction requirements."
        }
      ]
    },
