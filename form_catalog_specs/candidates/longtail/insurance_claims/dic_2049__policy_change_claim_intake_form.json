              "units": 1.1
            }
          ]
        },
        {
          "key": "triage_indicators",
          "type": "checklist",
          "label": "Policy Change triage indicators",
          "items": [
            "Named insured, entity, ownership, address, or contact change",
            "Vehicle, driver, property, location, equipment, or subject change",
            "Use, occupancy, operations, territory, payroll, or exposure change",
            "Lienholder, mortgagee, additional interest, or payee change",
            "Coverage, limit, deductible, endorsement, or option review requested",
            "Backdated, same-day, cancellation, reinstatement, or lapse concern exists",
            "Open claim or known loss may be confused with a prospective change",
            "Underwriting, signature, payment, verification, or jurisdiction approval is pending"
          ],
          "guidance": "Check only conditions reported or directly observed; explain source and uncertainty in the narrative."
        },
