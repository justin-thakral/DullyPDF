{
  "schema_version": 1,
  "catalog_id": "insurance_claims/dic_2015__water_damage_inspection_report_form",
  "source_section": "insurance_claims",
  "source_filename": "dic_2015__water_damage_inspection_report_form.pdf",
  "slug": "water-damage-inspection-report-form",
  "title": "Water Damage Inspection Report Form",
  "subtitle": "A decision-ready water damage inspection report that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original water damage inspection report for water source, migration path, and affected materials with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the water-loss claim and mitigation coordination owner must open and control a inspection report for water source, migration path, and affected materials. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Water Damage inspection report identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
      "blocks": [
        {
          "key": "record_identity",
          "type": "fields",
          "label": "Water Damage inspection report record",
          "fields": [
            {
              "key": "inspection_id",
              "label": "Inspection report ID",
              "units": 0.95
            },
            {
              "key": "claim_reference",
              "label": "Claim or service record",
              "units": 1.05
            },
            {
              "key": "inspection_date",
              "label": "Inspection date and time",
              "units": 1.0
            },
            {
              "key": "inspector",
              "label": "Inspector and qualification ref",
              "units": 1.15
            },
            {
              "key": "assignment_source",
