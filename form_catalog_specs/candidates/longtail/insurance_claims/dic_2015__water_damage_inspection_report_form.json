            {
              "key": "report_status",
              "label": "Report status",
              "units": 0.85,
              "field_type": "choice",
              "options": [
                "Scheduled",
                "Partial",
                "Complete",
                "Review hold"
              ]
            }
          ],
          "guidance": "Use the same record identifiers in evidence, communications, and handoff."
        },
        {
          "key": "domain_identity",
          "type": "fields",
          "label": "Water Damage subject and event identity",
          "fields": [
            {
              "key": "discovery_time",
              "label": "First observed date and time",
              "units": 1.0
            },
            {
              "key": "source_location",
              "label": "Suspected source and exact location",
              "units": 1.25
