  "source_section": "insurance_claims",
  "source_filename": "dic_2017__water_damage_status_update_form.pdf",
  "slug": "water-damage-status-update-form",
  "title": "Water Damage Status Update Form",
  "subtitle": "A decision-ready water damage status update that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original water damage status update for water source, migration path, and affected materials with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the water-loss claim and mitigation coordination owner must open and control a status update for water source, migration path, and affected materials. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Water Damage status update identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
      "blocks": [
        {
          "key": "record_identity",
          "type": "fields",
          "label": "Water Damage status update record",
          "fields": [
            {
              "key": "update_id",
              "label": "Status update ID",
              "units": 0.9
            },
