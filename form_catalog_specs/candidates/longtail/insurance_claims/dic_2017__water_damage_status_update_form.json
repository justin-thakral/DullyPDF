              "units": 1.1
            },
            {
              "key": "overall_stage",
              "label": "Overall stage",
              "units": 0.95,
              "field_type": "choice",
              "options": [
                "Intake",
                "Investigation",
                "Decision",
                "Payment",
                "Closed"
              ]
            }
          ],
          "guidance": "Use the same record identifiers in evidence, communications, and handoff."
        },
        {
