  "slug": "workers-comp-claim-intake-form",
  "title": "Workers Comp Claim Intake Form",
  "subtitle": "A decision-ready workers comp claim intake that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original workers comp claim intake for reported workplace injury or illness and employment event with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the workers compensation claim and workplace reporting owner must open and control a claim intake for reported workplace injury or illness and employment event. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Workers Comp claim intake identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
