            {
              "key": "reporting_ref",
              "label": "Employer/reporting ref",
              "units": 1.1
            }
          ]
        },
        {
          "key": "triage_indicators",
          "type": "checklist",
          "label": "Workers Comp triage indicators",
          "items": [
            "Emergency response, hospitalization, fatality, or severe event reported",
            "Employee reports injury, illness, exposure, or repetitive condition",
            "Equipment, vehicle, chemical, ergonomic, or environmental factor involved",
            "Work restriction, time away, modified duty, or return-to-work issue exists",
            "Temporary worker, contractor, multiple employer, or remote work involved",
            "Witness, camera, training, maintenance, or job record may be relevant",
            "Privacy-concern information requires a restricted record route",
            "Regulatory, carrier, administrator, or jurisdiction deadline may apply"
          ],
          "guidance": "Check only conditions reported or directly observed; explain source and uncertainty in the narrative."
        },
        {
          "key": "event_narrative",
          "type": "textarea",
          "label": "Chronological notice and loss narrative",
          "fields": [
            {
              "key": "narrative",
