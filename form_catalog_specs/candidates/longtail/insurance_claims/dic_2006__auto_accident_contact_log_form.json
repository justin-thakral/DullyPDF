            },
            {
              "key": "period_start",
              "label": "Log period start",
              "units": 0.85
            },
            {
              "key": "period_end",
              "label": "Log period end",
              "units": 0.85
            },
            {
              "key": "log_owner",
              "label": "Contact-log owner",
              "units": 1.0
            },
            {
              "key": "communication_stage",
              "label": "Communication stage",
              "units": 1.05,
              "field_type": "choice",
              "options": [
                "Initial",
                "Investigation",
                "Decision",
                "Follow-up",
                "Closed"
              ]
            }
          ],
          "guidance": "Use the same record identifiers in evidence, communications, and handoff."
        },
        {
          "key": "domain_identity",
          "type": "fields",
          "label": "Auto Accident subject and event identity",
          "fields": [
            {
              "key": "loss_date_time",
