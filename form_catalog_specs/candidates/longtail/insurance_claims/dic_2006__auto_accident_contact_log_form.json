          "type": "checklist",
          "label": "Auto Accident contact roles",
          "items": [
            "Named insured or reporting driver",
            "Other driver, owner, or claimant",
            "Witness or passenger",
            "Police, tow, storage, or repair facility",
            "Adjuster, appraiser, or authorized vendor",
            "Legal, injury, fraud, or recovery review route"
