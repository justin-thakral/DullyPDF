{
  "schema_version": 1,
  "catalog_id": "insurance_claims/dic_2006__auto_accident_contact_log_form",
  "source_section": "insurance_claims",
  "source_filename": "dic_2006__auto_accident_contact_log_form.pdf",
  "slug": "auto-accident-contact-log-form",
  "title": "Auto Accident Contact Log Form",
  "subtitle": "A decision-ready auto accident contact log that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original auto accident contact log for collision event and involved vehicle with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the auto claim intake or adjusting owner must open and control a contact log for collision event and involved vehicle. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Auto Accident contact log identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
      "blocks": [
        {
          "key": "record_identity",
          "type": "fields",
          "label": "Auto Accident contact log record",
          "fields": [
            {
              "key": "log_id",
              "label": "Contact log ID",
              "units": 0.85
            },
            {
              "key": "claim_reference",
              "label": "Claim or service record",
