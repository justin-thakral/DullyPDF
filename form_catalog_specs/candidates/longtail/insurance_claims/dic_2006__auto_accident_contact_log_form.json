    {
      "key": "exceptions_escalation",
      "title": "Auto Accident communication exceptions, disputes, and escalation",
      "guidance": "Preserve disputed facts as disputed and route threats, complaints, deadlines, representation, and privacy concerns immediately.",
      "blocks": [
        {
          "key": "exception_screen",
          "type": "checklist",
          "label": "Auto Accident communication exception screen",
          "items": [
            "Vehicle location or ownership cannot be verified",
            "Loss date, driver identity, or trip use conflicts across sources",
            "Injury, child restraint, or accessibility issue lacks a route",
            "Potential fraud indicator requires authorized special review",
            "Tow, storage, salvage, or evidence-preservation deadline is near",
            "Lawsuit, demand, citation, or government notice was received"
