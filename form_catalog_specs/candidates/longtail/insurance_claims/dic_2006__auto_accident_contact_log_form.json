          ],
          "rows": 4
        },
        {
          "key": "communication_controls",
          "type": "checklist",
          "label": "Communication controls",
          "items": [
            "Identity and authority were verified before disclosure",
            "Facts, estimates, pending review, and final decisions were distinguished",
            "No unauthorized coverage, liability, value, or payment promise was made",
            "Sensitive attachments used an approved secure route",
            "Language, disability, or communication access need was routed",
            "Complaint, attorney, regulator, or do-not-contact instruction was honored",
            "Required explanation or next-step information was provided",
            "The exact next update and responsible owner are recorded"
