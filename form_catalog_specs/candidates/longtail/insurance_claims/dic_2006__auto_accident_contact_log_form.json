              "units": 1.15
            },
            {
              "key": "driver_relation",
              "label": "Driver and relationship",
              "units": 1.05
            },
            {
              "key": "operability",
              "label": "Operability and tow site",
              "units": 1.0
            },
            {
              "key": "trip_context",
              "label": "Trip purpose or use at time of event",
              "units": 1.1
            }
          ],
          "guidance": "Police agency and report reference"
        },
        {
          "key": "scope_statement",
          "type": "textarea",
          "label": "Contact Log scope and opening facts",
          "fields": [
            {
              "key": "scope_detail",
              "label": "Auto Accident purpose, source wording, requested outcome, known limitations, and excluded work",
              "multiline": true
            }
