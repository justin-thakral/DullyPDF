  "slug": "water-damage-evidence-checklist-form",
  "title": "Water Damage Evidence Checklist Form",
  "subtitle": "A decision-ready water damage evidence checklist that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original water damage evidence checklist for water source, migration path, and affected materials with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the water-loss claim and mitigation coordination owner must open and control a evidence checklist for water source, migration path, and affected materials. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Water Damage evidence checklist identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
