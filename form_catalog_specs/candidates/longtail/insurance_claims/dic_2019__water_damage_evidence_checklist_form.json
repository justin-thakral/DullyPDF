          "height": 50
        }
      ]
    },
    {
      "key": "evidence_plan",
      "title": "Water Damage evidence plan, issues, and preservation priorities",
      "guidance": "Tie evidence collection to specific questions; do not collect sensitive or irrelevant material merely because it exists.",
      "blocks": [
        {
          "key": "issue_evidence_map",
          "type": "table",
          "label": "Issue-to-evidence plan",
          "columns": [
            {
              "key": "issue",
              "label": "Question or issue",
              "units": 1.25
            },
            {
              "key": "evidence",
              "label": "Evidence needed",
              "units": 1.25
            },
            {
              "key": "source",
              "label": "Likely source",
              "units": 1.0
            },
            {
              "key": "priority",
              "label": "Priority / expiry risk",
              "units": 0.95
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            }
          ],
          "rows": 5
        },
        {
          "key": "domain_evidence",
          "type": "checklist",
          "label": "Water Damage evidence checklist",
          "items": [
            "Source and affected-area photographs before material removal",
            "Moisture readings with location, instrument, date, and operator",
            "Plumber, appliance, roofer, utility, or mitigation report",
            "Water bills, alarms, maintenance, or prior leak records",
            "Drying, extraction, equipment-placement, and monitoring logs",
            "Removed material, contents, sample, or disposal authorization log",
            "Repair, mitigation, temporary lodging, and utility receipts",
            "Adjoining unit, landlord, tenant, or property-manager notices"
          ],
          "guidance": "Check only when the item is received, verified, or preservation is documented."
        },
        {
          "key": "preservation_control",
          "type": "fields",
          "label": "Preservation and collection control",
          "fields": [
