              "key": "expiry_risk",
              "label": "Earliest expiry or overwrite risk",
              "units": 1.1
            },
            {
              "key": "legal_hold_ref",
              "label": "Hold or instruction ref, if any",
              "units": 1.1
            },
            {
              "key": "collection_method",
              "label": "Approved collection method",
              "units": 1.1
