            {
              "key": "restricted_route",
              "label": "Restricted evidence route",
              "units": 1.05
            }
          ]
        },
        {
          "key": "evidence_boundary",
          "type": "notice",
          "label": "Evidence and decision boundary",
          "guidance": "This record does not classify water, diagnose contamination, authorize entry into electrical or structurally unsafe areas, or determine coverage. Stop unsafe work and route source control, sampling, demolition, and claim decisions to qualified authority."
        }
      ]
    },
