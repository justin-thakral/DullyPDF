  "slug": "roof-damage-inspection-report-form",
  "title": "Roof Damage Inspection Report Form",
  "subtitle": "A decision-ready roof damage inspection report that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original roof damage inspection report for roof area, weather event, and interior water path with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the roof-loss claim and qualified inspection owner must open and control a inspection report for roof area, weather event, and interior water path. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Roof Damage inspection report identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
