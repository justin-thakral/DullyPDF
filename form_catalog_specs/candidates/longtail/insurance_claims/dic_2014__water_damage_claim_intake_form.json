            {
              "key": "triage_priority",
              "label": "Triage priority",
              "units": 0.9,
              "field_type": "choice",
              "options": [
                "Routine",
                "Prompt",
                "Urgent",
                "Emergency routed"
              ]
            }
          ],
          "guidance": "Use the same record identifiers in evidence, communications, and handoff."
