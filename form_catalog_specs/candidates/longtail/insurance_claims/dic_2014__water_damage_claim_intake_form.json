  "slug": "water-damage-claim-intake-form",
  "title": "Water Damage Claim Intake Form",
  "subtitle": "A decision-ready water damage claim intake that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original water damage claim intake for water source, migration path, and affected materials with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the water-loss claim and mitigation coordination owner must open and control a claim intake for water source, migration path, and affected materials. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Water Damage claim intake identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
      "blocks": [
        {
          "key": "record_identity",
          "type": "fields",
          "label": "Water Damage claim intake record",
          "fields": [
            {
              "key": "intake_id",
              "label": "Claim intake record ID",
              "units": 0.95
            },
            {
              "key": "notice_received",
              "label": "Notice received date and time",
