          "guidance": "Source, affected level, and moisture-map reference"
        },
        {
          "key": "scope_statement",
          "type": "textarea",
          "label": "Claim Intake scope and opening facts",
          "fields": [
            {
              "key": "scope_detail",
              "label": "Water Damage purpose, source wording, requested outcome, known limitations, and excluded work",
              "multiline": true
            }
          ],
          "height": 50
        }
      ]
    },
    {
      "key": "notice_and_response",
      "title": "Water Damage notice, immediate response, and factual account",
      "guidance": "Separate direct observations from reported information and document urgent routing before ordinary intake.",
      "blocks": [
        {
          "key": "initial_observations",
          "type": "fields",
          "label": "Water Damage initial observations",
          "fields": [
            {
              "key": "visible_water",
              "label": "Standing or visible water extent",
              "units": 1.0
            },
            {
              "key": "migration",
              "label": "Migration and adjoining areas",
              "units": 1.25
            },
            {
              "key": "materials",
              "label": "Wet materials and contents",
              "units": 1.15
            },
            {
              "key": "utility_control",
              "label": "Utility or source-isolation action",
              "units": 1.05
            },
            {
              "key": "moisture_ref",
              "label": "Moisture survey ref",
              "units": 1.0
            },
            {
              "key": "prior_event",
              "label": "Prior leak or repair ref",
              "units": 1.1
            }
          ]
        },
        {
          "key": "triage_indicators",
          "type": "checklist",
          "label": "Water Damage triage indicators",
          "items": [
            "Active flow, standing water, or inaccessible shutoff remains",
            "Electrical equipment, outlets, or wiring may be wet",
            "Ceiling sag, structural movement, or falling material is present",
            "Sewage, groundwater, chemicals, or unknown contamination suspected",
            "Visible growth, odor, prolonged wetness, or hidden cavity concern",
            "Multiple rooms, units, floors, or adjoining properties affected",
            "Contents or moisture-sensitive equipment needs controlled movement",
            "Emergency drying, extraction, containment, or temporary relocation began"
          ],
          "guidance": "Check only conditions reported or directly observed; explain source and uncertainty in the narrative."
        },
        {
          "key": "event_narrative",
          "type": "textarea",
          "label": "Chronological notice and loss narrative",
          "fields": [
            {
              "key": "narrative",
              "label": "Water Damage facts, source of each fact, sequence, immediate action, and unresolved questions",
              "multiline": true
            }
          ],
          "height": 78
        },
        {
          "key": "intake_boundary",
          "type": "notice",
          "label": "Claim intake boundary",
          "guidance": "This record does not classify water, diagnose contamination, authorize entry into electrical or structurally unsafe areas, or determine coverage. Stop unsafe work and route source control, sampling, demolition, and claim decisions to qualified authority."
        }
      ]
    },
    {
