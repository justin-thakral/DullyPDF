          "key": "domain_evidence",
          "type": "checklist",
          "label": "Claim Status evidence checklist",
          "items": [
            "Claim-system status and assigned-owner confirmation",
            "Diary, task, milestone, and promised-update records",
            "Coverage correspondence and controlling-policy reference",
            "Inspection, estimate, invoice, valuation, or expert report",
            "Payment, deductible, recovery, salvage, or subrogation record",
            "Customer, claimant, insured, or representative correspondence",
            "Management, legal, fraud, complaint, or regulatory-review reference",
            "Closure notice, reopen condition, and retention reference"
          ],
          "guidance": "Check only when the item is received, verified, or preservation is documented."
        },
