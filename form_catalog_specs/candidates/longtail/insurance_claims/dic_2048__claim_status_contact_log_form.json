  "slug": "claim-status-contact-log-form",
  "title": "Claim Status Contact Log Form",
  "subtitle": "A decision-ready claim status contact log that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original claim status contact log for claim-file stage, outstanding work, and next accountable milestone with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the claim status communication and diary owner must open and control a contact log for claim-file stage, outstanding work, and next accountable milestone. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Claim Status contact log identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
