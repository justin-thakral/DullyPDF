{
  "schema_version": 1,
  "catalog_id": "insurance_claims/dic_2005__auto_accident_evidence_checklist_form",
  "source_section": "insurance_claims",
  "source_filename": "dic_2005__auto_accident_evidence_checklist_form.pdf",
  "slug": "auto-accident-evidence-checklist-form",
  "title": "Auto Accident Evidence Checklist Form",
  "subtitle": "A decision-ready auto accident evidence checklist that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original auto accident evidence checklist for collision event and involved vehicle with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the auto claim intake or adjusting owner must open and control a evidence checklist for collision event and involved vehicle. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Auto Accident evidence checklist identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
      "blocks": [
        {
          "key": "record_identity",
          "type": "fields",
          "label": "Auto Accident evidence checklist record",
          "fields": [
            {
              "key": "review_id",
              "label": "Evidence review ID",
              "units": 0.9
            },
            {
              "key": "claim_reference",
              "label": "Claim or service record",
              "units": 1.05
            },
            {
              "key": "review_cutoff",
              "label": "Evidence cutoff date and time",
              "units": 1.0
            },
            {
              "key": "reviewer",
              "label": "Evidence reviewer",
              "units": 0.95
            },
            {
              "key": "decision_owner",
              "label": "Decision or investigation owner",
              "units": 1.1
            },
            {
              "key": "package_status",
              "label": "Evidence package status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Collecting",
                "Ready for review",
                "Gap hold",
                "Accepted"
              ]
            }
          ],
          "guidance": "Use the same record identifiers in evidence, communications, and handoff."
        },
        {
          "key": "domain_identity",
          "type": "fields",
          "label": "Auto Accident subject and event identity",
          "fields": [
            {
              "key": "loss_date_time",
              "label": "Collision date and time",
              "units": 1.0
