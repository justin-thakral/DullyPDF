            {
              "key": "vehicle_identity",
              "label": "Vehicle and VIN suffix",
              "units": 1.15
            },
            {
              "key": "driver_relation",
              "label": "Driver and relationship",
              "units": 1.05
            },
            {
              "key": "operability",
              "label": "Operability and tow site",
              "units": 1.0
            },
            {
              "key": "trip_context",
              "label": "Trip purpose or use at time of event",
              "units": 1.1
            }
          ],
          "guidance": "Police agency and report reference"
        },
        {
          "key": "scope_statement",
          "type": "textarea",
          "label": "Evidence Checklist scope and opening facts",
          "fields": [
            {
              "key": "scope_detail",
              "label": "Auto Accident purpose, source wording, requested outcome, known limitations, and excluded work",
              "multiline": true
            }
          ],
          "height": 50
        }
      ]
    },
    {
      "key": "evidence_plan",
      "title": "Auto Accident evidence plan, issues, and preservation priorities",
      "guidance": "Tie evidence collection to specific questions; do not collect sensitive or irrelevant material merely because it exists.",
      "blocks": [
        {
          "key": "issue_evidence_map",
          "type": "table",
          "label": "Issue-to-evidence plan",
          "columns": [
            {
              "key": "issue",
              "label": "Question or issue",
              "units": 1.25
            },
            {
              "key": "evidence",
              "label": "Evidence needed",
              "units": 1.25
            },
            {
              "key": "source",
              "label": "Likely source",
              "units": 1.0
            },
            {
              "key": "priority",
              "label": "Priority / expiry risk",
              "units": 0.95
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            }
          ],
          "rows": 5
        },
        {
          "key": "domain_evidence",
          "type": "checklist",
          "label": "Auto Accident evidence checklist",
          "items": [
            "Scene overview and traffic-control photographs",
            "All vehicle sides and close damage photographs",
            "Driver, registration, and insurance exchange reference",
            "Police or incident report request and receipt reference",
            "Witness contact and statement source reference",
            "Tow, storage, repair, rental, or appraisal documents",
            "Dashcam, telematics, or camera-preservation reference",
            "Injury, expense, wage, or passenger documents routed securely"
          ],
          "guidance": "Check only when the item is received, verified, or preservation is documented."
        },
        {
          "key": "preservation_control",
          "type": "fields",
          "label": "Preservation and collection control",
          "fields": [
            {
              "key": "preservation_owner",
              "label": "Preservation owner",
              "units": 1.0
            },
            {
              "key": "first_request",
              "label": "First request date and time",
              "units": 1.0
            },
            {
              "key": "expiry_risk",
              "label": "Earliest expiry or overwrite risk",
              "units": 1.1
            },
            {
              "key": "legal_hold_ref",
              "label": "Hold or instruction ref, if any",
              "units": 1.1
            },
            {
              "key": "collection_method",
              "label": "Approved collection method",
              "units": 1.1
            },
            {
              "key": "restricted_route",
              "label": "Restricted evidence route",
              "units": 1.05
            }
          ]
        },
        {
          "key": "evidence_boundary",
          "type": "notice",
          "label": "Evidence and decision boundary",
          "guidance": "This record does not determine fault, liability, value, or coverage. Address emergencies first, avoid admissions or promises, preserve evidence, and route decisions to the authorized adjuster under the controlling policy and applicable requirements."
        }
      ]
    },
    {
      "key": "receipt_quality",
      "title": "Auto Accident evidence receipt, authenticity, and quality review",
      "guidance": "Preserve the original source and distinguish a complete record from an unreadable, altered, partial, or unsupported item.",
      "blocks": [
        {
          "key": "evidence_register",
          "type": "table",
          "label": "Evidence receipt and quality register",
          "columns": [
            {
              "key": "evidence_id",
