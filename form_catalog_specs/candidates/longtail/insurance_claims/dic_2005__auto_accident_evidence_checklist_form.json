              "units": 0.75
            },
            {
              "key": "description",
              "label": "Item and exact source",
              "units": 1.35
            },
            {
              "key": "received",
              "label": "Received date and method",
              "units": 1.0
            },
            {
              "key": "storage",
              "label": "Approved storage ref",
              "units": 1.15
            },
            {
              "key": "quality",
              "label": "Quality and verification",
              "units": 1.15
            },
            {
              "key": "reviewer",
              "label": "Reviewer",
              "units": 0.8
            }
          ],
          "rows": 6
        },
        {
          "key": "quality_checks",
          "type": "checklist",
          "label": "Evidence quality checks",
          "items": [
            "Source identity and authority are recorded",
            "Original file, record, or unaltered copy is retained",
            "Relevant dates, times, locations, and subjects are visible",
            "Metadata or system provenance is preserved when material",
            "Corrections and annotations do not obscure the original",
            "Duplicate and superseded versions are linked",
            "Sensitive content is limited to approved access",
            "Known limitations and missing pages are documented"
          ]
        },
        {
          "key": "quality_notes",
          "type": "textarea",
          "label": "Evidence quality, authenticity questions, and limitations",
          "fields": [
            {
              "key": "quality_detail",
              "label": "Auto Accident source reliability, missing context, contradictions, alteration concerns, and follow-up needed",
              "multiline": true
            }
          ],
          "height": 68
        }
      ]
    },
    {
      "key": "custody_disclosure",
      "title": "Auto Accident custody, privacy, disclosure, and access control",
      "guidance": "Document who handled evidence and prevent unnecessary duplication or disclosure of restricted information.",
      "blocks": [
        {
          "key": "custody_log",
          "type": "table",
          "label": "Custody and access log",
