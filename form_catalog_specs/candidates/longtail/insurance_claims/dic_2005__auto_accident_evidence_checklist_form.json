    {
      "key": "package_handoff",
      "title": "Auto Accident evidence-package decision readiness and handoff",
      "guidance": "The package can close only when evidence, gaps, access limits, and the receiving decision owner are explicit.",
      "blocks": [
        {
          "key": "readiness_check",
          "type": "checklist",
          "label": "Evidence-package readiness",
          "items": [
            "Every material issue maps to supporting evidence or a stated gap",
            "Evidence IDs, source, storage, and quality are traceable",
            "Conflicts and unavailable evidence are not hidden",
            "Restricted material has an authorized access route",
            "No checklist item implies a coverage or legal conclusion",
            "The qualified decision owner accepted the package"
          ]
        },
        {
