            {
              "key": "evidence_id",
              "label": "Evidence ID",
              "units": 0.8
            },
            {
              "key": "from_to",
              "label": "From / to or access role",
              "units": 1.15
            },
            {
              "key": "date_time",
              "label": "Date and time",
              "units": 0.9
            },
            {
              "key": "purpose",
              "label": "Purpose and authority",
              "units": 1.2
            },
            {
              "key": "location",
              "label": "Storage / transfer ref",
              "units": 1.1
            },
            {
              "key": "ack",
              "label": "Receipt or audit ref",
              "units": 0.85
            }
          ],
          "rows": 5
        },
        {
          "key": "privacy_controls",
          "type": "checklist",
          "label": "Privacy and disclosure controls",
          "items": [
            "Only necessary personal information was collected",
            "Identity and authority were verified before disclosure",
            "Medical, financial, credential, or legal material uses a restricted route",
            "Public or shared copies omit unnecessary identifiers",
            "Consent, subpoena, policy, or other disclosure authority is recorded",
            "Third-party records retain source and permitted-use limits",
            "Retention and deletion requirements are identified",
            "An access or disclosure error has an incident route"
          ]
        },
        {
          "key": "access_summary",
          "type": "fields",
          "label": "Evidence access summary",
          "fields": [
            {
              "key": "system_owner",
              "label": "System or repository owner",
              "units": 1.1
            },
            {
              "key": "access_group",
              "label": "Authorized access group",
              "units": 1.05
            },
            {
              "key": "retention_ref",
              "label": "Retention rule reference",
              "units": 1.1
            },
            {
              "key": "disclosure_owner",
              "label": "Disclosure decision owner",
              "units": 1.05
            },
            {
              "key": "last_audit",
              "label": "Last access audit date",
              "units": 0.95
            },
            {
              "key": "incident_ref",
              "label": "Privacy incident ref, if any",
              "units": 1.0
