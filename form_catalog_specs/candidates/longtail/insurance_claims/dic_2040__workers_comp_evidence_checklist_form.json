              "multiline": true
            }
          ],
          "height": 68
        }
      ]
    },
    {
      "key": "custody_disclosure",
      "title": "Workers Comp custody, privacy, disclosure, and access control",
      "guidance": "Document who handled evidence and prevent unnecessary duplication or disclosure of restricted information.",
