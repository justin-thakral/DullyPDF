            }
          ],
          "rows": 5
        },
        {
          "key": "domain_evidence",
          "type": "checklist",
          "label": "Workers Comp evidence checklist",
          "items": [
            "Employee report and exact source wording reference",
            "Supervisor, witness, and first-response factual account",
            "Scene, equipment, material, task, or condition photographs",
            "Training, authorization, procedure, maintenance, or job records",
            "Time, schedule, payroll, assignment, and employer relationship reference",
            "Authorized work-status or restriction document stored securely",
            "Carrier, administrator, jurisdiction, and incident-report references",
            "Corrective action and return-to-work coordination records"
          ],
          "guidance": "Check only when the item is received, verified, or preservation is documented."
        },
        {
          "key": "preservation_control",
          "type": "fields",
          "label": "Preservation and collection control",
