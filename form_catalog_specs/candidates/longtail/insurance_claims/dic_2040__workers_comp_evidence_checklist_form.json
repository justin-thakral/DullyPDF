              "units": 1.1
            },
            {
              "key": "legal_hold_ref",
              "label": "Hold or instruction ref, if any",
              "units": 1.1
            },
            {
              "key": "collection_method",
              "label": "Approved collection method",
              "units": 1.1
            },
            {
              "key": "restricted_route",
              "label": "Restricted evidence route",
              "units": 1.05
            }
          ]
        },
        {
          "key": "evidence_boundary",
          "type": "notice",
          "label": "Evidence and decision boundary",
          "guidance": "This record does not diagnose, determine compensability, replace an emergency route, or substitute for required jurisdiction forms. Protect employee privacy, support reporting without retaliation, and route medical, legal, benefit, and work-status decisions appropriately."
        }
      ]
    },
    {
