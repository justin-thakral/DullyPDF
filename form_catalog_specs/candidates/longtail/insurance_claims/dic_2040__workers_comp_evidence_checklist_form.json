    {
      "key": "gaps_conflicts",
      "title": "Workers Comp evidence gaps, conflicting sources, and escalation",
      "guidance": "Do not convert missing or inconsistent evidence into an unsupported conclusion.",
      "blocks": [
        {
          "key": "exception_screen",
          "type": "checklist",
          "label": "Workers Comp evidence exception screen",
          "items": [
            "Emergency, severe event, or regulatory reporting route is unconfirmed",
            "Employee reporting could be deterred, delayed, or treated inconsistently",
            "Sensitive medical details appear outside the restricted claim record",
            "Employer, worksite, employment, or jurisdiction responsibility conflicts",
            "Work status, restriction, schedule, or modified-duty handoff is unclear",
            "Evidence, equipment, training, or scene condition may be altered"
          ]
        },
