  "slug": "workers-comp-evidence-checklist-form",
  "title": "Workers Comp Evidence Checklist Form",
  "subtitle": "A decision-ready workers comp evidence checklist that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original workers comp evidence checklist for reported workplace injury or illness and employment event with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the workers compensation claim and workplace reporting owner must open and control a evidence checklist for reported workplace injury or illness and employment event. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Workers Comp evidence checklist identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
