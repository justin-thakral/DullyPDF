  "slug": "liability-incident-claim-intake-form",
  "title": "Liability Incident Claim Intake Form",
  "subtitle": "A decision-ready liability incident claim intake that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original liability incident claim intake for reported third-party incident and premises or activity with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the liability claim intake and investigation owner must open and control a claim intake for reported third-party incident and premises or activity. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Liability Incident claim intake identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
