        },
        {
          "key": "triage_indicators",
          "type": "checklist",
          "label": "Liability Incident triage indicators",
          "items": [
            "Emergency care, injury, or immediate welfare concern was reported",
            "Premises, product, vehicle, professional service, or completed work involved",
            "Condition changed, was repaired, or was removed after the event",
            "Camera footage, access log, transaction, or device data may expire",
            "Witness, employee, contractor, or customer account is available",
            "Demand, attorney contact, summons, complaint, or government notice received",
            "Property, product, equipment, or sample needs preservation",
            "Multiple organizations, contracts, or insurers may require notice"
          ],
          "guidance": "Check only conditions reported or directly observed; explain source and uncertainty in the narrative."
        },
