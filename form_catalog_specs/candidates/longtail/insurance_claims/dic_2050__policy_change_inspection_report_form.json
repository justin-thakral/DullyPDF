  "slug": "policy-change-inspection-report-form",
  "title": "Policy Change Inspection Report Form",
  "subtitle": "A decision-ready policy change inspection report that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original policy change inspection report for prospective policy-administration request and requested effective date with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the policy service, underwriting, or authorized change owner must open and control a inspection report for prospective policy-administration request and requested effective date. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Policy Change inspection report identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
      "blocks": [
        {
          "key": "record_identity",
          "type": "fields",
          "label": "Policy Change inspection report record",
          "fields": [
            {
              "key": "inspection_id",
              "label": "Inspection report ID",
              "units": 0.95
            },
            {
              "key": "claim_reference",
              "label": "Claim or service record",
              "units": 1.05
            },
            {
              "key": "inspection_date",
              "label": "Inspection date and time",
              "units": 1.0
