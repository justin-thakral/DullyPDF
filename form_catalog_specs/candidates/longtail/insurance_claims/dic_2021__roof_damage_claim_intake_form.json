        {
          "key": "triage_indicators",
          "type": "checklist",
          "label": "Roof Damage triage indicators",
          "items": [
            "Unprotected edge, unsafe ladder, steep slope, or fragile surface",
            "Wet, icy, hot, loose, unstable, or storm-affected roof",
            "Opening, missing material, displaced flashing, or active entry",
            "Ceiling sag, wet electrical area, or falling material below",
            "Hail, wind, tree, debris, animal, or contractor activity reported",
            "Pre-existing wear, patch, prior leak, or maintenance issue visible",
            "Solar, HVAC, antenna, skylight, or other penetration involved",
            "Emergency tarp, seal, drain clearing, or temporary work occurred"
          ],
          "guidance": "Check only conditions reported or directly observed; explain source and uncertainty in the narrative."
