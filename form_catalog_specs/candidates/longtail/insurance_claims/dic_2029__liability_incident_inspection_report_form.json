  "slug": "liability-incident-inspection-report-form",
  "title": "Liability Incident Inspection Report Form",
  "subtitle": "A decision-ready liability incident inspection report that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original liability incident inspection report for reported third-party incident and premises or activity with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the liability claim intake and investigation owner must open and control a inspection report for reported third-party incident and premises or activity. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Liability Incident inspection report identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
      "blocks": [
        {
          "key": "record_identity",
          "type": "fields",
          "label": "Liability Incident inspection report record",
          "fields": [
            {
              "key": "inspection_id",
              "label": "Inspection report ID",
              "units": 0.95
            },
            {
              "key": "claim_reference",
              "label": "Claim or service record",
              "units": 1.05
            },
            {
              "key": "inspection_date",
              "label": "Inspection date and time",
              "units": 1.0
            },
            {
