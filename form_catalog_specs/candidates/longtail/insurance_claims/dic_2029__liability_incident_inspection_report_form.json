          "type": "textarea",
          "label": "Inspection Report scope and opening facts",
          "fields": [
            {
              "key": "scope_detail",
              "label": "Liability Incident purpose, source wording, requested outcome, known limitations, and excluded work",
              "multiline": true
            }
          ],
          "height": 50
        }
      ]
    },
    {
      "key": "inspection_plan",
      "title": "Liability Incident inspection authority, access, and evidence plan",
      "guidance": "Confirm the approved scope, safe access, evidence method, and conditions that require the inspection to stop.",
      "blocks": [
        {
          "key": "preinspection_check",
          "type": "checklist",
          "label": "Pre-inspection controls",
          "items": [
            "Assignment scope and exact subject were verified",
            "Access permission and site contact were confirmed",
            "Required qualification, equipment, and protective controls were confirmed",
            "Known hazards and restricted areas were reviewed",
            "Photograph, measurement, sample, and data permissions were confirmed",
            "Preservation or custody expectations were documented",
            "Potential conflicts of interest were disclosed",
            "Stop-work and emergency route were understood"
          ]
        },
        {
          "key": "inspection_conditions",
          "type": "fields",
          "label": "Inspection conditions",
          "fields": [
            {
              "key": "arrival_departure",
