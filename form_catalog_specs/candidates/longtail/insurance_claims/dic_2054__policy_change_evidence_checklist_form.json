              "units": 1.25
            },
            {
              "key": "source",
              "label": "Likely source",
              "units": 1.0
            },
            {
              "key": "priority",
              "label": "Priority / expiry risk",
              "units": 0.95
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            }
          ],
          "rows": 5
        },
        {
          "key": "domain_evidence",
          "type": "checklist",
          "label": "Policy Change evidence checklist",
          "items": [
            "Dated requester instruction and authenticated source reference",
            "Current declarations, schedule, or policy-data snapshot",
            "Supporting ownership, registration, address, or interest document",
            "Vehicle, property, payroll, operations, or exposure detail",
            "Underwriting question, inspection, valuation, or approval record",
            "Quote, premium, billing, payment, or finance acknowledgment",
            "Issued endorsement, revised declarations, or transaction confirmation",
            "Delivery, consent, rejection, withdrawal, and retention record"
          ],
          "guidance": "Check only when the item is received, verified, or preservation is documented."
        },
        {
          "key": "preservation_control",
          "type": "fields",
          "label": "Preservation and collection control",
