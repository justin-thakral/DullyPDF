  "slug": "policy-change-evidence-checklist-form",
  "title": "Policy Change Evidence Checklist Form",
  "subtitle": "A decision-ready policy change evidence checklist that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original policy change evidence checklist for prospective policy-administration request and requested effective date with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the policy service, underwriting, or authorized change owner must open and control a evidence checklist for prospective policy-administration request and requested effective date. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_control",
      "title": "Policy Change evidence checklist identity and routing",
      "guidance": "Tie this record to one subject, dated source, and accountable owner.",
