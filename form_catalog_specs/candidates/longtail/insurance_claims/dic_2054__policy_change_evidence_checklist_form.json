    {
      "key": "gaps_conflicts",
      "title": "Policy Change evidence gaps, conflicting sources, and escalation",
      "guidance": "Do not convert missing or inconsistent evidence into an unsupported conclusion.",
      "blocks": [
        {
          "key": "exception_screen",
          "type": "checklist",
          "label": "Policy Change evidence exception screen",
          "items": [
            "Requester identity or authority is unverified",
            "Requested effective date is backdated, ambiguous, or conflicts with a known loss",
            "Current and requested policy states cannot be reconciled",
            "Required underwriting, signature, payment, or supporting evidence is missing",
            "Requested wording or certificate representation exceeds policy terms",
            "Transaction was quoted, bound, issued, delivered, or declined without clear authority"
          ]
        },
