  "slug": "certificate-request-inspection-report-form",
  "title": "Certificate Request Inspection Report Form",
  "subtitle": "A decision-ready certificate request inspection report that preserves identity, facts, evidence, authorization, exceptions, and accountable handoff without replacing the controlling policy or qualified judgment.",
  "description": "An original certificate request inspection report for request for authorized evidence of existing insurance with domain-specific intake, investigation, evidence, decision, escalation, audit, and closeout controls.",
  "use_case": "Use when the licensed or authorized certificate-service owner must open and control a inspection report for request for authorized evidence of existing insurance. The record closes only after evidence and limitations are visible, authorized decisions are distinguishable from pending review, exceptions have owners, and the next recipient accepts the handoff.",
  "risk_tier": "B",
  "sections": [
    {
