  "slug": "appliance-repair-service-call-intake-form",
  "title": "Appliance Repair Service Call Intake and Resolution Record",
  "subtitle": "Capture the request, equipment identity, symptoms, dispatch, diagnosis, authorization, completed work, testing, and follow-up in one accountable record.",
  "description": "A workflow-complete appliance repair service record covering customer intake, equipment identification, safety triage, dispatch, diagnostic findings, estimate authorization, repair documentation, testing, and closeout.",
  "use_case": "Use when a service coordinator and technician need one fillable record for routing an appliance call, preserving diagnostic evidence, authorizing parts and labor, and documenting customer handoff.",
  "risk_tier": "A",
