          "fields": [
            {"key": "affected_trade", "label": "Affected trade", "units": 0.9},
            {"key": "successor_trade", "label": "Successor trade", "units": 0.9},
            {"key": "inspection_contact", "label": "Inspector or permit contact", "units": 1.05},
            {"key": "supplier_contact", "label": "Supplier contact", "units": 0.9},
            {"key": "resident_contact", "label": "Resident coordination contact", "units": 1.05}
          ]
        }
      ]
    },
