{
  "schema_version": 1,
  "catalog_id": "construction_trades/dct_1009__home_remodel_change_order_request_form",
  "source_section": "construction_trades",
  "source_filename": "dct_1009__home_remodel_change_order_request_form.pdf",
  "slug": "home-remodel-change-order-request-form",
  "title": "Home Remodel Change Order Request and Owner Decision",
  "subtitle": "Document the room-level change, compare the approved baseline, reconcile selections and allowances, price household and schedule effects, authorize the decision, and verify restoration.",
  "description": "A workflow-complete home remodel change request covering homeowner requests, concealed conditions, inspection corrections, room and finish effects, photographs and field evidence, selection substitutions, allowance reconciliation, direct cost, occupied-home disruption, temporary arrangements, option review, written authorization, implementation evidence, property restoration, and closeout.",
  "use_case": "Use whenever remodeling work may depart from the executed scope and the homeowner, contractor, or designer needs a fillable record that makes room impacts, product decisions, allowance credits, cost, schedule, access, and final authorization visible before work proceeds.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "change_identity",
      "title": "Change identity, home, and authorization path",
      "guidance": "Create a traceable request and identify who may review and authorize it.",
      "blocks": [
        {
          "key": "change_reference",
          "type": "fields",
          "label": "Change request reference",
          "fields": [
            {"key": "change_number", "label": "Change request number", "units": 0.85},
            {"key": "date_identified", "label": "Date identified", "units": 0.7},
            {"key": "response_due", "label": "Decision due", "units": 0.7},
            {"key": "prepared_by", "label": "Prepared by", "units": 0.85},
            {"key": "change_owner", "label": "Change manager", "units": 0.85},
            {"key": "status", "label": "Request status", "units": 0.8, "field_type": "choice", "options": ["Draft", "Pricing", "Owner review", "Approved", "Rejected", "On hold", "Implemented", "Closed"]}
          ]
        },
        {
          "key": "property_reference",
          "type": "fields",
          "label": "Home and contract reference",
          "fields": [
            {"key": "homeowner_names", "label": "Homeowner names", "units": 1.05},
            {"key": "property_address", "label": "Property address", "units": 1.35},
            {"key": "contract_number", "label": "Contract number", "units": 0.8},
            {"key": "work_order", "label": "Work order", "units": 0.7},
            {"key": "affected_rooms", "label": "Affected rooms or areas", "units": 1.1}
          ]
        },
        {
          "key": "origin_routing",
          "type": "fields",
          "label": "Origin, urgency, and decision routing",
          "fields": [
            {"key": "requested_by", "label": "Requested or identified by", "units": 1.05},
            {"key": "origin", "label": "Change origin", "units": 0.95, "field_type": "choice", "options": ["Homeowner request", "Selection revision", "Concealed condition", "Code or inspection", "Design clarification", "Product unavailable", "Property damage repair", "Contractor proposal"]},
            {"key": "field_urgency", "label": "Field urgency", "units": 0.8, "field_type": "choice", "options": ["Routine", "Decision blocks work", "Protection work needed", "Emergency stabilization"]},
            {"key": "homeowner_reviewer", "label": "Homeowner reviewer", "units": 0.9},
            {"key": "design_reviewer", "label": "Design reviewer", "units": 0.9},
            {"key": "submission_method", "label": "Submission method", "units": 0.85}
          ]
        },
        {
          "key": "authorization_notice",
          "type": "notice",
          "label": "Authorization control",
          "guidance": "Submitting or pricing this request does not authorize changed work. Perform only protective or investigative measures allowed by the agreement until the required homeowner, contractor, design, lender, or association approval is documented."
        }
      ]
    },
    {
      "key": "condition_scope",
      "title": "Changed condition, room scope, and evidence",
      "guidance": "Separate the approved baseline from the new observation, request, or desired result.",
