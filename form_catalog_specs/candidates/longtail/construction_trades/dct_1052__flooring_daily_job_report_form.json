    {
      "key": "quality_safety",
      "title": "Flooring quality, safety, and environmental observations",
      "guidance": "Capture observed conditions, evidence, corrections, and escalation without replacing required inspections.",
      "blocks": [
        {
          "key": "quality_observations",
          "type": "checklist",
          "label": "Flooring quality checkpoints observed",
          "items": [
            "Hazard release and substrate acceptance are documented",
            "Moisture, RH, alkalinity, flatness, and environmental data are accepted",
            "Product, lot, acclimation, storage, and area assignment are traceable",
            "Layout, pattern, direction, seams, joints, and transitions are approved",
            "Primer, adhesive, trowel, open time, rolling, and cure are recorded",
            "Alignment, lippage, bond, seams, edges, and surface are accepted",
            "Base, transitions, stairs, doors, equipment, and accessibility details work",
            "Cleaning, protection, attic stock, care, and closeout are complete"
          ]
        },
        {
