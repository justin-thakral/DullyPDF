  "slug": "roofing-material-request-form",
  "title": "Roofing Material Request and Receiving Control",
  "subtitle": "Connect the approved roofing requirement to quantities, submittals, procurement and delivery dates, receiving inspection, storage, release, exceptions, and cost closeout.",
  "description": "A complete Roofing material request covering project and cost routing, technical requirements, approved products and substitutions, takeoff and waste, vendor and lead time, submittal and approval status, delivery planning, receiving evidence, lot and serial traceability, storage, nonconformance, returns, field release, and reconciliation.",
  "use_case": "Use when the roofing foreperson, project manager, purchasing, submittal reviewer, warehouse or receiver, quality, and accounts payable need one traceable Roofing material record from request through accepted field custody.",
  "risk_tier": "A",
