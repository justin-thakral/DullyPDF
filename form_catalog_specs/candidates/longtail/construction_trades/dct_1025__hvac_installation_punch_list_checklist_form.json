    {
      "key": "acceptance_criteria",
      "title": "HVAC Installation acceptance criteria and readiness",
      "guidance": "Confirm readiness and observable criteria for the equipment, air distribution, refrigerant circuit, controls, and startup.",
      "blocks": [
        {
          "key": "quality_criteria",
          "type": "checklist",
          "label": "HVAC Installation acceptance checkpoints",
          "items": [
            "Equipment identity, orientation, capacity, and clearances verified",
            "Duct joints, supports, sealing, insulation, and access accepted",
            "Refrigerant piping is supported, protected, clean, and insulated",
            "Pressure test, evacuation, decay, and refrigerant records complete",
            "Condensate slope, trap, overflow, and discharge are proven",
            "Power, control wiring, safeties, sensors, and sequences function",
            "Airflow, static pressure, temperature, and balance are documented",
            "Startup, commissioning, labels, training, and manuals complete"
          ]
        },
        {
          "key": "test_criteria",
          "type": "checklist",
          "label": "HVAC Installation required test and verification status",
          "items": [
            "Refrigerant pressure and leak test",
            "Evacuation level and standing vacuum",
            "Condensate flow and overflow test",
            "Airflow and external static pressure",
            "Temperature and humidity performance",
            "Electrical current and voltage",
            "Controls, safeties, and sequence test",
            "Testing and balancing acceptance"
          ]
        },
        {
          "key": "area_readiness",
