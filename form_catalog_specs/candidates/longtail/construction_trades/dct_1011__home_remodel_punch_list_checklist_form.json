{
  "schema_version": 1,
  "catalog_id": "construction_trades/dct_1011__home_remodel_punch_list_checklist_form",
  "source_section": "construction_trades",
  "source_filename": "dct_1011__home_remodel_punch_list_checklist_form.pdf",
  "slug": "home-remodel-punch-list-checklist-form",
  "title": "Home Remodel Punch List and Room Acceptance Register",
  "subtitle": "Plan the homeowner walkthrough, record room-specific finish and function items, separate preference from contract deficiency, coordinate occupied-home corrections, verify rework, and close out turnover.",
  "description": "A workflow-complete home remodel punch list covering walkthrough authority, room readiness, selection and sample references, deficiencies and incomplete work, finish matching, homeowner preferences, access constraints, furniture and contents protection, correction ownership, evidence, reinspection, reopened items, deferred work, manuals and warranties, spare materials, keys, cleaning, and final acceptance.",
  "use_case": "Use near substantial or final completion when a remodeler and homeowner need one fillable register that turns a room-by-room walkthrough into findable correction assignments and distinguishes required contract completion from preferences, deferred work, and warranty follow-up.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "walk_identity",
      "title": "Walkthrough, home, and milestone identity",
      "guidance": "Define the residence, inspection purpose, participants, authority, and correction deadline.",
      "blocks": [
