          "key": "punch_reference",
          "type": "fields",
          "label": "Punch list reference",
          "fields": [
            {"key": "punch_list_number", "label": "Punch list number", "units": 0.8},
            {"key": "walk_date", "label": "Walk date", "units": 0.65},
            {"key": "walk_start_time", "label": "Start time", "units": 0.55},
            {"key": "issued_date", "label": "Issued date", "units": 0.65},
            {"key": "correction_due", "label": "Correction response due", "units": 0.8},
            {"key": "list_manager", "label": "List manager", "units": 0.85}
          ]
        },
        {
