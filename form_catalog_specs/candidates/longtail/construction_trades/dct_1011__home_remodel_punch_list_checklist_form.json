          "label": "Walkthrough type and home status",
          "fields": [
            {"key": "walk_type", "label": "Walkthrough type", "units": 1.0, "field_type": "choice", "options": ["Contractor pre-punch", "Homeowner walkthrough", "Designer walkthrough", "Substantial completion", "Final completion", "Warranty walk", "Reinspection"]},
            {"key": "completion_claimed", "label": "Completion claimed", "units": 0.85},
            {"key": "occupancy_status", "label": "Occupancy status", "units": 0.85, "field_type": "choice", "options": ["Occupied", "Partially occupied", "Temporary move-out", "Vacant"]},
            {"key": "overall_readiness", "label": "Overall readiness", "units": 0.9, "field_type": "choice", "options": ["Ready", "Ready with exclusions", "Not ready", "Reinspection only"]},
            {"key": "target_close_date", "label": "Target close date", "units": 0.75}
          ]
        },
        {
          "key": "participants",
          "type": "table",
          "label": "Walkthrough participants and decision authority",
          "columns": [
            {"key": "name", "label": "Name", "units": 1.0},
            {"key": "company_role", "label": "Company or role", "units": 1.0},
            {"key": "rooms", "label": "Rooms represented", "units": 1.0},
