  "slug": "plumbing-estimate-request-form",
  "title": "Plumbing Estimate Request and Bid Review",
  "subtitle": "Qualify the plumbing opportunity, verify field inputs, define scope and exclusions, price labor and materials, review risk, and control the bid handoff.",
  "description": "A workflow-complete Plumbing estimate request covering customer and site routing, bid documents, field measurements, specialty scope, quantity and cost build-up, assumptions, safety and technical risks, approval, submission, clarifications, and post-bid handoff.",
  "use_case": "Use when an estimator, plumbing foreperson, project manager, and authorized reviewer need one accountable Plumbing estimate record that distinguishes verified facts from allowances and produces a reviewable bid decision.",
  "risk_tier": "A",
