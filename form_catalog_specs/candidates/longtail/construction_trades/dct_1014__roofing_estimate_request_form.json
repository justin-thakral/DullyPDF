  "slug": "roofing-estimate-request-form",
  "title": "Roofing Estimate Request and Bid Review",
  "subtitle": "Qualify the roofing opportunity, verify field inputs, define scope and exclusions, price labor and materials, review risk, and control the bid handoff.",
  "description": "A workflow-complete Roofing estimate request covering customer and site routing, bid documents, field measurements, specialty scope, quantity and cost build-up, assumptions, safety and technical risks, approval, submission, clarifications, and post-bid handoff.",
  "use_case": "Use when an estimator, roofing foreperson, project manager, and authorized reviewer need one accountable Roofing estimate record that distinguishes verified facts from allowances and produces a reviewable bid decision.",
  "risk_tier": "A",
