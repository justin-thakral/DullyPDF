        {
          "key": "change_boundary",
          "type": "notice",
          "label": "Electrical change boundary",
          "guidance": "This record does not authorize energized work or energization and does not replace qualified-person decisions, energy control, permits, engineering studies, code inspection, or approved test procedures. This request does not authorize changed work until the designated authority records a disposition."
        }
