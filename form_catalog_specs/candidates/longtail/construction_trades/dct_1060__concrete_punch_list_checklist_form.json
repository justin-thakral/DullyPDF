  "source_section": "construction_trades",
  "source_filename": "dct_1060__concrete_punch_list_checklist_form.pdf",
  "slug": "concrete-punch-list-checklist-form",
  "title": "Concrete Punch List and Acceptance Checklist",
  "subtitle": "Define the concrete acceptance basis, log location-specific deficiencies, assign corrections, retain reinspection evidence, resolve exceptions, and record final handoff.",
  "description": "A controlled Concrete punch list covering inspection identity and document basis, system-specific acceptance criteria, a detailed deficiency register, responsible owners and due dates, containment and access, correction evidence, failed reinspection, deferred items, customer decisions, final acceptance, and closeout.",
  "use_case": "Use when the concrete placement foreperson, quality reviewer, project manager, affected trades, and customer need one location-based Concrete completion register that stays open until every item has a supported disposition.",
  "risk_tier": "A",
  "sections": [
    {
