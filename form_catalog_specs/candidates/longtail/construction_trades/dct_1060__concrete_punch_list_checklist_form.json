        {
          "key": "inspection_boundary",
          "type": "notice",
          "label": "Concrete inspection boundary",
          "guidance": "This record does not approve formwork, shoring, excavation, mix design, placement loads, stripping, or structural acceptance and does not replace engineered plans, inspections, or competent-person duties. A visual punch review does not certify concealed work, design, or code compliance."
        }
