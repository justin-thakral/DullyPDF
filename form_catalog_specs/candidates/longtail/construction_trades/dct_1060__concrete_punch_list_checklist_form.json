    {
      "key": "acceptance_criteria",
      "title": "Concrete acceptance criteria and readiness",
      "guidance": "Confirm readiness and observable criteria for the excavation, base, forms, reinforcement, concrete, finish, and cure.",
      "blocks": [
        {
          "key": "quality_criteria",
          "type": "checklist",
          "label": "Concrete acceptance checkpoints",
          "items": [
            "Survey, excavation, subgrade, base, compaction, and elevations accepted",
            "Forms, dimensions, bracing, release, and placement access accepted",
            "Reinforcement, cover, splices, embeds, sleeves, and joints accepted",
            "Mix, ticket, time, water addition, slump, air, and temperature recorded",
            "Placement sequence, lift, consolidation, elevation, and slope controlled",
            "Finish, tolerance, edge, texture, joint, and saw-cut timing accepted",
            "Cure method, duration, temperature, protection, and strength tracked",
            "Repairs, tests, form removal, loading release, and as-builts accepted"
          ]
        },
        {
          "key": "test_criteria",
          "type": "checklist",
          "label": "Concrete required test and verification status",
          "items": [
            "Subgrade or base compaction",
            "Pre-placement inspection",
            "Delivery ticket and batch time",
            "Slump, air, and temperature",
            "Strength cylinders or samples",
            "Elevation, flatness, and tolerance",
            "Cure temperature and duration",
            "Repair and final acceptance"
          ]
        },
        {
