  "title": "General Contractor Estimate Request and Bid Review",
  "subtitle": "Qualify the opportunity, define the bid package, collect takeoffs and quotes, price risk, review the estimate, and document submission ownership.",
  "description": "A workflow-complete general contractor estimate request covering bid routing, project requirements, scope boundaries, quantity takeoffs, subcontractor pricing, cost build-up, risk review, approval, and submission closeout.",
  "use_case": "Use when a contractor needs one accountable fillable record to turn an invitation or customer request into a reviewed estimate with traceable assumptions, exclusions, pricing evidence, and a clear bid decision.",
  "risk_tier": "A",
