  "slug": "general-contractor-change-order-request-form",
  "title": "General Contractor Change Order Request and Decision Log",
  "subtitle": "Document the origin and scope of a proposed change, substantiate cost and time effects, route review and negotiation, authorize implementation, and reconcile contract closeout.",
  "description": "A workflow-complete construction change order request covering source direction, supporting evidence, scope definition, itemized pricing, schedule impact, risk and mitigation, review comments, approval conditions, implementation tracking, and contract reconciliation.",
  "use_case": "Use when a contractor must preserve why a change arose, what it affects, how price and time were calculated, who authorized it, and whether the approved change reached field execution and contract records.",
  "risk_tier": "A",
