  "slug": "concrete-daily-job-report-form",
  "title": "Concrete Daily Job Report and Shift Handoff",
  "subtitle": "Capture the concrete shift, labor and equipment, delivered materials, measured production, inspections, hazards, delays, decisions, and next-shift ownership.",
  "description": "A daily Concrete field report covering site and weather identity, crew time, equipment and deliveries, work areas and production, technical readings, quality and safety observations, incidents and delays, RFIs and directives, photos, outstanding actions, and verified shift handoff.",
  "use_case": "Use at the end of each Concrete shift when the concrete placement foreperson, project management, payroll or cost control, quality, safety, and the next crew need a factual contemporaneous record without using it to authorize unapproved work.",
  "risk_tier": "A",
