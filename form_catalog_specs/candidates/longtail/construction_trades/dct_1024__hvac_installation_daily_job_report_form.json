  "slug": "hvac-installation-daily-job-report-form",
  "title": "HVAC Installation Daily Job Report and Shift Handoff",
  "subtitle": "Capture the hvac installation shift, labor and equipment, delivered materials, measured production, inspections, hazards, delays, decisions, and next-shift ownership.",
  "description": "A daily HVAC Installation field report covering site and weather identity, crew time, equipment and deliveries, work areas and production, technical readings, quality and safety observations, incidents and delays, RFIs and directives, photos, outstanding actions, and verified shift handoff.",
  "use_case": "Use at the end of each HVAC Installation shift when the HVAC installation lead, project management, payroll or cost control, quality, safety, and the next crew need a factual contemporaneous record without using it to authorize unapproved work.",
  "risk_tier": "A",
