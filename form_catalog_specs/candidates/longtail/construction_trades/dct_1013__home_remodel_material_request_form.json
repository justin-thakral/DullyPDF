{
  "schema_version": 1,
  "catalog_id": "construction_trades/dct_1013__home_remodel_material_request_form",
  "source_section": "construction_trades",
  "source_filename": "dct_1013__home_remodel_material_request_form.pdf",
  "slug": "home-remodel-material-request-form",
  "title": "Home Remodel Material Request and Selection Control",
  "subtitle": "Carry room-specific material needs from field measurement and homeowner selection through allowance approval, occupied-home delivery, receiving inspection, installation custody, and final reconciliation.",
  "description": "A workflow-complete material request for occupied-home remodeling covering residence and room routing, measured quantities, matching existing finishes, approved selections and samples, owner-furnished items, allowances and upgrade decisions, substitution approval, long-lead planning, protected delivery and storage, children and pets, receiving evidence, damage or shortage disposition, installer issue, returns and spares, invoice reconciliation, warranty records, homeowner handoff, and accountable closeout.",
  "use_case": "Use when a remodeler, designer, supplier, installer, and homeowner need one fillable record that protects an approved room selection and budget while materials are sourced, delivered into an occupied residence, inspected, controlled through installation, and closed out.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "request_home_identity",
      "title": "Request, residence, room, and need-by routing",
      "guidance": "Identify the controlling request, household setting, exact installation area, schedule need, and people accountable for the material decision.",
