            {"key": "priority", "label": "Priority", "units": 0.85, "field_type": "choice", "options": ["Routine", "Selection deadline", "Schedule critical", "Expedite", "Emergency repair", "Hold for decision"]},
            {"key": "request_status", "label": "Request status", "units": 0.9, "field_type": "choice", "options": ["Draft", "Submitted", "Pricing", "Owner decision", "Approved", "Ordered", "Partially received", "Closed"]},
