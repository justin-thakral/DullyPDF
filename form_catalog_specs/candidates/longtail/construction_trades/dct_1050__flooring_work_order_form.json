    {
      "key": "safe_work_release",
      "title": "Flooring safe-work readiness and field release",
      "guidance": "Record the route to controlling safety processes before work begins or conditions change.",
      "blocks": [
        {
          "key": "hazard_controls",
          "type": "checklist",
          "label": "Flooring hazard and control verification",
          "items": [
            "Asbestos, lead, silica, mold, and existing-material status addressed",
            "Grinding, cutting, scraping, dust collection, and exposure controls verified",
            "Adhesive, primer, solvent, SDS, ventilation, and ignition controls verified",
            "Knee, lifting, handling, ergonomic, and repetitive-work controls addressed",
            "Blades, saws, grinders, cords, GFCI, guards, and PPE controlled",
            "Occupied-area separation, egress, trip, access, and signage maintained",
            "Temperature, humidity, odor, cure, and reentry restrictions communicated",
            "Waste, sharp debris, containers, spills, and housekeeping controlled",
            "Stair, edge, elevation change, and unfinished transition hazards controlled",
            "Material storage, rolling loads, floor capacity, and cart paths reviewed"
          ]
        },
