            "Temporary power de-energized as needed",
            "Windows closed or protected",
            "Exterior doors locked",
            "Alarm armed as agreed",
            "Keys or access devices accounted for",
            "Emergency contact information current"
          ]
        },
        {
          "key": "open_action_log",
          "type": "table",
          "label": "Open action, resident issue, and decision log",
          "columns": [
            {"key": "action_decision", "label": "Action or decision", "units": 1.35},
            {"key": "room_reference", "label": "Room or reference", "units": 1.0},
            {"key": "owner", "label": "Owner", "units": 0.75},
            {"key": "due", "label": "Due", "units": 0.65},
            {"key": "interim_condition", "label": "Interim condition", "units": 1.1},
            {"key": "status", "label": "Status", "units": 0.65}
          ],
          "rows": 3
        },
        {
          "key": "next_day_plan",
          "type": "table",
          "label": "Next-day work and household readiness plan",
          "columns": [
            {"key": "planned_task", "label": "Planned task", "units": 1.25},
            {"key": "room_area", "label": "Room or area", "units": 0.9},
            {"key": "crew_trade", "label": "Crew or trade", "units": 0.9},
            {"key": "prerequisite", "label": "Prerequisite", "units": 1.0},
            {"key": "resident_need", "label": "Resident need or notice", "units": 1.15},
            {"key": "owner", "label": "Owner", "units": 0.65}
          ],
          "rows": 3
        },
        {
          "key": "handoff_notes",
          "type": "textarea",
          "label": "Next-day access, utility or shutdown needs, household commitments, priority follow-up, and emergency restriction",
