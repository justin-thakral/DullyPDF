        },
        {
          "key": "utility_security_close",
          "type": "checklist",
          "label": "Utility, fire, and security closeout",
          "items": [
            "Water restored or outage posted",
            "Power restored or outage posted",
            "Gas status confirmed",
            "Heating or cooling status confirmed",
            "Smoke alarms restored or temporary plan active",
