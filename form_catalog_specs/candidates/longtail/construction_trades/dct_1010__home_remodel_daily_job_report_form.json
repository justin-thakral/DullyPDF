          "label": "Daily cleanup and room release",
          "items": [
            "Loose debris removed",
            "Floors vacuumed or cleaned",
            "Sharp objects removed",
            "Tools and cords secured",
            "Openings covered or guarded",
            "Wet finishes protected",
            "Cabinets and fixtures protected",
            "Resident route cleared",
            "Bathroom left usable as planned",
            "Kitchen left usable as planned",
            "Exterior gates secured",
            "Waste container secured",
            "Work-zone sign or barrier posted",
            "Resident received restrictions"
