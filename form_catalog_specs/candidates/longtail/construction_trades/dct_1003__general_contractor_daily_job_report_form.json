  "slug": "general-contractor-daily-job-report-form",
  "title": "General Contractor Daily Job Report and Handoff",
  "subtitle": "Record site conditions, labor and equipment, installed work, deliveries, inspections, safety and quality events, delays, decisions, and the next-shift plan.",
  "description": "A workflow-complete daily construction report covering project and shift identity, weather, workforce by trade, completed quantities, equipment and deliveries, visitors and inspections, safety and quality observations, delays, directives, evidence, next-day planning, and superintendent certification.",
  "use_case": "Use when a superintendent or field lead needs an objective same-day record that supports progress verification, payroll and cost review, schedule analysis, issue escalation, customer communication, and the next crew handoff.",
  "risk_tier": "A",
