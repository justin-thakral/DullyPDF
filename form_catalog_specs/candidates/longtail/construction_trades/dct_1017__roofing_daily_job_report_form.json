      "title": "Roofing quality, safety, and environmental observations",
      "guidance": "Capture observed conditions, evidence, corrections, and escalation without replacing required inspections.",
      "blocks": [
        {
          "key": "quality_observations",
          "type": "checklist",
          "label": "Roofing quality checkpoints observed",
          "items": [
            "Deck and substrate accepted before concealment",
            "Layout, laps, exposure, and edge zones match approved details",
            "Fastener, plate, adhesive, and securement pattern recorded",
            "Seams, welds, laps, and terminations inspected",
            "Curbs, penetrations, transitions, and wall flashings complete",
            "Drains, scuppers, gutters, and overflow paths unobstructed",
            "Completed work remains dry, clean, and protected",
            "Manufacturer inspection and warranty evidence complete"
