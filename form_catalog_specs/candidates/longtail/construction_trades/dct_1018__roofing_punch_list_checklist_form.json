    {
      "key": "acceptance_criteria",
      "title": "Roofing acceptance criteria and readiness",
      "guidance": "Confirm readiness and observable criteria for the roof area, drainage path, assembly, and weather exposure.",
      "blocks": [
        {
          "key": "quality_criteria",
          "type": "checklist",
          "label": "Roofing acceptance checkpoints",
          "items": [
            "Deck and substrate accepted before concealment",
            "Layout, laps, exposure, and edge zones match approved details",
            "Fastener, plate, adhesive, and securement pattern recorded",
            "Seams, welds, laps, and terminations inspected",
            "Curbs, penetrations, transitions, and wall flashings complete",
            "Drains, scuppers, gutters, and overflow paths unobstructed",
            "Completed work remains dry, clean, and protected",
            "Manufacturer inspection and warranty evidence complete"
          ]
        },
        {
          "key": "test_criteria",
          "type": "checklist",
          "label": "Roofing required test and verification status",
          "items": [
            "Seam probe or lap inspection",
            "Fastener or adhesion verification",
            "Substrate moisture acceptance",
            "Drainage and overflow observation",
            "Electronic or flood test if specified",
            "Manufacturer punch inspection",
            "Weather-tightness observation",
            "Warranty documentation review"
          ]
        },
        {
          "key": "area_readiness",
