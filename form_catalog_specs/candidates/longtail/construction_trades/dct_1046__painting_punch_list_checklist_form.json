    {
      "key": "acceptance_criteria",
      "title": "Painting acceptance criteria and readiness",
      "guidance": "Confirm readiness and observable criteria for the substrate, preparation, coating system, color, and occupied-area protection.",
      "blocks": [
        {
          "key": "quality_criteria",
          "type": "checklist",
          "label": "Painting acceptance checkpoints",
          "items": [
            "Substrate is dry, sound, clean, and accepted before coating",
            "Preparation, repairs, profile, and cleanliness meet the approved system",
            "Product, batch, tint, color, sheen, and mix records are traceable",
            "Environmental readings and recoat windows are recorded",
            "Coverage, wet film, dry film, adhesion, and coat count are accepted",
            "Edges, cut lines, repairs, and transitions are uniform",
            "Runs, sags, holidays, debris, overspray, and damage are corrected",
            "Cure, protection, touchup, maintenance stock, and closeout are complete"
          ]
        },
        {
          "key": "test_criteria",
          "type": "checklist",
          "label": "Painting required test and verification status",
          "items": [
            "Substrate moisture and condition",
            "Environmental temperature and humidity",
            "Surface profile or cleanliness",
            "Wet-film thickness",
            "Dry-film thickness",
            "Adhesion or pull test if specified",
            "Color, sheen, and mockup match",
            "Cure and final visual acceptance"
          ]
        },
        {
          "key": "area_readiness",
          "type": "table",
          "label": "Area and system readiness review",
