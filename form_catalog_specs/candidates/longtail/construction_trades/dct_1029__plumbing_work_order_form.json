  "slug": "plumbing-work-order-form",
  "title": "Plumbing Work Order and Completion Record",
  "subtitle": "Authorize plumbing work, translate scope into a controlled field plan, verify safe release and technical hold points, resolve exceptions, and close the order.",
  "description": "A field-ready Plumbing work order covering customer and contract authority, site and crew routing, planned tasks and quantities, materials and dependencies, safe-work release, inspections and tests, changed conditions, completion evidence, customer handoff, and accountable closeout.",
  "use_case": "Use when dispatch, a project manager, the plumbing foreperson, quality reviewers, and the customer need one authorized Plumbing work record from assignment through verified completion without treating the work order as a safety permit.",
  "risk_tier": "A",
