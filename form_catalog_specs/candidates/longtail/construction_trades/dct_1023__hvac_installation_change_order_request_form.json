  "slug": "hvac-installation-change-order-request-form",
  "title": "HVAC Installation Change Order Request and Impact Decision",
  "subtitle": "Preserve the hvac installation baseline, document the changed condition and evidence, price scope and schedule effects, obtain a clear decision, and control implementation.",
  "description": "A decision-ready HVAC Installation change order request covering contract and baseline identity, requester direction, field evidence, revised technical scope, quantity and cost support, schedule and safety effects, alternatives, authorization, rejection or hold handling, implementation, and closeout.",
  "use_case": "Use when the HVAC installation lead, project manager, estimator, customer, and authorized approver need a traceable HVAC Installation change record before changed work proceeds, except for separately controlled emergency stabilization.",
  "risk_tier": "A",
