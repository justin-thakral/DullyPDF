  "slug": "general-contractor-work-order-form",
  "title": "General Contractor Work Order and Completion Record",
  "subtitle": "Authorize a defined construction scope, mobilize the responsible crew, control site requirements and changes, verify work, and close the order with accountable acceptance.",
  "description": "A workflow-complete contractor work order covering commercial authorization, site and scope identity, crew and resource planning, permits and safety, execution requirements, change control, progress, testing, customer acceptance, and closeout.",
  "use_case": "Use when a general contractor needs one fillable control record to issue work to a crew or subcontractor, prevent unauthorized scope drift, document completion evidence, and route unresolved items to a named owner.",
  "risk_tier": "A",
