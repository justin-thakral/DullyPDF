      "title": "Pre-open decision and stop conditions",
      "guidance": "Make unresolved readiness gaps visible before service begins.",
      "blocks": [
        {
          "key": "stop_conditions",
          "type": "checklist",
          "label": "Stop and escalate when",
          "items": [
            "Current approved order or revision is unavailable",
            "Responsible-review conditions are not understood",
            "Station route or workspace creates an unresolved concern",
            "Product custody or opening count cannot be reconciled",
            "Required nonalcoholic or water support is unavailable",
            "Age-verification or service-refusal route is unclear",
            "Payment or hosted-limit control is not ready",
            "Responsible service lead is not available"
          ]
        },
