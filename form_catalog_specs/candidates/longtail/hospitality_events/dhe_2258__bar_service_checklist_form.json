      "key": "station_readiness",
      "title": "Station and product readiness",
      "guidance": "Confirm the physical station matches the current order before opening.",
      "blocks": [
        {
          "key": "station_checks",
          "type": "checklist",
          "label": "Station setup checks",
          "items": [
            "Station ID and service scope match the current order",
            "Guest queue and accessible route are clear",
            "Required power, water, ice, and waste support are ready",
            "Glassware, service tools, and supplies are staged",
            "Product allocation matches the inventory issue record",
            "Nonalcoholic choices and water are stocked and visible",
            "Menu and hosted-limit information are current",
            "Secure product, key, cash, and device custody is assigned",
            "Station-close and return locations are identified"
          ]
        },
        {
          "key": "station_results",
