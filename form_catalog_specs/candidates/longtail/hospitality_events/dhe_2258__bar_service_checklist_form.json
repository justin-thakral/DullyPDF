          "key": "briefing_topics",
          "type": "checklist",
          "label": "Briefing topics",
          "items": [
            "Authorized menu, stations, and service periods reviewed",
            "Applicable age-verification process reviewed",
            "Service-refusal and responsible-manager route reviewed",
            "Guest concern and incident-reporting route reviewed",
            "Nonalcoholic choices and water support reviewed",
            "Ingredient questions route to the responsible team",
            "Hosted limits, tickets, or payment workflow reviewed",
            "Product, cash, key, and device custody reviewed",
            "Last-service cue and closeout assignments reviewed"
