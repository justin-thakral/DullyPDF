              "field_type": "choice",
              "options": [
                "Not stated",
                "Conference or seminar",
                "Corporate meeting",
                "Banquet or gala",
                "Wedding or celebration",
                "Social gathering",
                "Trade or consumer show",
                "Community or civic",
                "Other"
              ]
            },
            {
              "key": "preferred_date",
              "label": "Preferred date",
              "units": 0.8
            },
            {
              "key": "alternate_date",
              "label": "Alternate date",
              "units": 0.8
            },
            {
              "key": "date_flexibility",
              "label": "Date flexibility",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Not stated",
                "Fixed date only",
                "Flexible within the week",
                "Flexible within the month",
