              "key": "setup_note",
              "label": "Setup or service note",
              "units": 1.2
            }
          ],
          "rows": 5,
          "guidance": "One row per distinct time block. Continue on a linked inquiry record when a multi-day pattern needs more rows."
        },
        {
          "key": "requirement_flags",
          "type": "checklist",
          "label": "Services the requester raised at inquiry",
          "items": [
            "Food service requested",
            "Bar or beverage service requested",
            "Guest-room block requested",
            "Audio-visual or production support requested",
            "Accessibility accommodation requested",
            "Dietary or allergen accommodation raised",
            "Outside vendor, rental, or delivery expected",
            "Loading dock or freight access needed",
            "Signage or branding placement requested",
            "Parking, valet, or shuttle requested"
          ],
          "guidance": "Tick only what the requester actually raised. Each ticked item must appear in the screening notes or the exception register."
        }
      ]
    },
    {
      "key": "availability_screen",
      "title": "Availability and hold screening",
      "guidance": "Screen the request against the calendar before any commitment.",
      "blocks": [
        {
          "key": "availability_result",
          "type": "fields",
          "label": "Availability screening result",
          "fields": [
            {
              "key": "space_availability",
              "label": "Space availability",
              "units": 1.1,
              "field_type": "choice",
              "options": [
                "Not yet checked",
                "Available",
                "Tentative hold exists",
                "Conflict - alternate offered",
                "Not available"
              ]
            },
            {
              "key": "conflicting_hold",
              "label": "Conflicting hold ID",
              "units": 0.95
            },
            {
              "key": "hold_offered",
              "label": "Hold offered",
              "units": 0.9,
              "field_type": "choice",
              "options": [
                "None",
                "First hold",
                "Second hold",
                "Third hold",
                "Definite space"
              ]
            },
            {
              "key": "hold_expires",
              "label": "Hold expires",
              "units": 0.8
            },
            {
              "key": "rate_range",
              "label": "Rate range quoted",
              "units": 1.0
            }
          ],
          "guidance": "A rate range quoted at inquiry is indicative only until the order and signed agreement are issued."
        },
        {
          "key": "screening_confirmations",
          "type": "checklist",
          "label": "Screening evidence recorded",
          "items": [
            "Requested dates checked against the master space calendar",
            "Existing holds and definite bookings reviewed for conflict",
            "Capacity and egress limits for the requested setup confirmed with the responsible manager",
            "Minimum revenue or headcount threshold reviewed against the request",
            "Blackout dates, city-wide events, and rate periods reviewed",
            "Food and beverage feasibility discussed with the culinary or beverage lead",
            "Guest-room availability checked with rooms control when a block was requested",
            "Accessibility accommodation request routed to the responsible manager"
          ]
        },
        {
          "key": "screening_notes",
          "type": "textarea",
          "label": "Screening findings, alternates offered, and client reaction",
          "fields": [
            {
              "key": "screening_detail",
              "label": "Availability screening findings"
            }
          ],
          "height": 52
        }
      ]
    },
    {
      "key": "qualification_decision",
      "title": "Qualification decision and authorization",
      "guidance": "Decide what happens next and who authorized it.",
      "blocks": [
        {
          "key": "decision_record",
          "type": "fields",
          "label": "Qualification decision",
          "fields": [
            {
              "key": "decision",
              "label": "Decision",
              "units": 1.35,
              "field_type": "choice",
              "options": [
                "Pending",
                "Qualified - proposal to follow",
                "Qualified - site visit first",
                "Referred to an alternate date",
                "Referred to another property",
                "Declined - no availability",
                "Declined - outside venue scope"
