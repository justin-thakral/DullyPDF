            {
              "key": "decision_date",
              "label": "Decision date",
              "units": 0.75
            },
            {
              "key": "authorized_by",
              "label": "Authorized by",
              "units": 1.0
            },
            {
              "key": "next_step_owner",
              "label": "Next step owner",
              "units": 1.0
            },
            {
              "key": "next_step_due",
              "label": "Next step due",
              "units": 0.8
            }
          ]
        },
        {
          "key": "decision_rationale",
          "type": "textarea",
          "label": "Decision rationale and what the client was told",
          "fields": [
            {
              "key": "rationale_detail",
              "label": "Qualification rationale"
            }
          ],
          "height": 46
        },
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Scope of this inquiry record",
          "guidance": "This record captures requested requirements and availability screening. It is not a contract, a rate guarantee, a capacity determination, or a confirmed booking. Confirm capacity and egress limits, licensing, insurance, accessibility obligations, and pricing with the responsible manager before any commitment is communicated to the client."
        }
      ]
    },
    {
      "key": "inquiry_exceptions",
      "title": "Unresolved requirements and escalation",
      "guidance": "Keep anything that blocks a response visible until it is disposed of.",
      "blocks": [
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Exception triggers",
          "items": [
            "Requested date unavailable and no alternate accepted",
            "Headcount exceeds the confirmed capacity of the requested space",
            "Accessibility accommodation cannot be met in the requested space",
            "Dietary, allergen, or beverage service cannot be confirmed",
            "Outside vendor insurance or licensing status unknown",
            "Requested load-in window conflicts with another event",
            "Deposit, credit, or payment terms unresolved",
            "Response window missed or at risk"
          ],
          "guidance": "Tick every applicable trigger and open a register row for each one."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Unresolved requirement register",
          "columns": [
            {
              "key": "trigger",
              "label": "Trigger or gap",
              "units": 1.2
            },
            {
              "key": "immediate_action",
              "label": "Action taken",
              "units": 1.15
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "escalated_to",
              "label": "Escalated to",
              "units": 0.9
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 4,
          "guidance": "Do not close a row until its disposition and accountable owner are explicit."
        }
      ]
    },
    {
