              "units": 0.8
            },
            {
              "key": "guests_minimum",
              "label": "Guests minimum",
              "units": 0.8
            },
            {
              "key": "guest_basis",
              "label": "Headcount basis",
              "units": 0.95,
              "field_type": "choice",
              "options": [
                "Not stated",
                "Requester estimate",
                "Prior-year actual",
                "Registration to date",
                "Guaranteed count"
              ]
            },
            {
              "key": "setup_style",
              "label": "Requested setup",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Not stated",
                "Rounds",
                "Theater",
                "Classroom",
                "U-shape",
                "Hollow square",
                "Standing reception",
                "Exhibit floor",
                "Mixed by session"
              ]
            },
            {
              "key": "space_requested",
              "label": "Space requested",
              "units": 1.05
            }
          ]
        },
        {
          "key": "session_requirements",
          "type": "table",
          "label": "Requested schedule by time block",
          "columns": [
            {
              "key": "block_date",
              "label": "Date",
              "units": 0.75
            },
            {
              "key": "time_block",
              "label": "Time block",
              "units": 0.85
            },
            {
              "key": "function",
              "label": "Function",
              "units": 1.05
            },
            {
              "key": "space_requested",
              "label": "Space requested",
              "units": 1.0
            },
            {
              "key": "headcount",
              "label": "Guests",
              "units": 0.5
            },
