        {
          "key": "handoff_confirmations",
          "type": "checklist",
          "label": "Handoff confirmations",
          "items": [
            "Requirements confirmed in writing with the requester",
            "Hold status and expiry communicated to the requester",
            "Open exceptions transferred with named owners",
            "Accessibility and allergen requests carried into the event file",
            "Lost-business reason recorded for pipeline review",
            "Source and referral credit recorded"
          ],
          "guidance": "An unticked item stays part of the open handoff."
        },
        {
          "key": "handoff_notes",
          "type": "textarea",
          "label": "Outcome, remaining limitations, and handoff detail",
          "fields": [
            {
              "key": "handoff_detail",
              "label": "Inquiry handoff detail"
            }
          ],
          "height": 62
        },
        {
          "key": "accountable_review",
          "type": "signatures",
          "label": "Preparation and review",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by",
              "units": 1.15
            },
            {
              "key": "prepared_date",
              "label": "Prepared date",
              "units": 0.7
            },
            {
              "key": "reviewed_by",
              "label": "Reviewed by sales manager",
              "units": 1.15
            },
