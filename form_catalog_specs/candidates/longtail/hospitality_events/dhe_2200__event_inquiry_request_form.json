{
  "schema_version": 1,
  "catalog_id": "hospitality_events/dhe_2200__event_inquiry_request_form",
  "source_section": "hospitality_events",
  "source_filename": "dhe_2200__event_inquiry_request_form.pdf",
  "slug": "event-inquiry-request-form",
  "title": "Event Inquiry Request Form",
  "subtitle": "Capture an inbound event inquiry, screen the requested dates and spaces against existing holds, and route it to a named seller with a response commitment.",
  "description": "An original intake record for inbound event enquiries. It captures requester identity and routing, the requested schedule and space profile, availability and hold screening evidence, the qualification decision, unresolved requirements, and the response handoff that closes the inquiry.",
  "use_case": "Use when an event inquiry arrives by phone, web form, email, referral, or walk-in and a coordinator must record what was asked for, screen it against the master space calendar, and hand a qualified lead to a seller. The record closes when the response has been sent and every unresolved requirement has a named owner.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "inquiry_intake",
      "title": "Inquiry intake and requester routing",
      "guidance": "Record how the inquiry arrived and who owns the response.",
      "blocks": [
        {
          "key": "intake_routing",
          "type": "fields",
          "label": "Inquiry record and response routing",
          "fields": [
            {
              "key": "inquiry_id",
              "label": "Inquiry record ID",
              "units": 0.85
            },
            {
              "key": "received_at",
              "label": "Received date and time",
              "units": 1.0
            },
            {
              "key": "intake_channel",
              "label": "Intake channel",
              "units": 0.95,
              "field_type": "choice",
              "options": [
                "Not recorded",
                "Phone",
                "Web inquiry form",
                "Email",
                "Walk-in",
                "Referral",
                "Partner or listing site",
                "Repeat client"
              ]
            },
            {
              "key": "assigned_seller",
              "label": "Assigned seller",
              "units": 0.95
            },
            {
              "key": "response_due",
              "label": "Response due",
              "units": 0.8
            }
          ],
          "guidance": "Use this inquiry record ID on every quote, hold, and follow-up so the lead can be reconstructed later."
        },
        {
          "key": "requester_identity",
          "type": "fields",
          "label": "Requester and organization",
          "fields": [
            {
              "key": "organization",
              "label": "Organization or host",
              "units": 1.15
            },
            {
              "key": "contact_name",
              "label": "Primary contact",
              "units": 1.0
            },
            {
              "key": "contact_role",
              "label": "Contact role",
              "units": 0.85
            },
            {
              "key": "contact_phone",
              "label": "Phone",
              "units": 0.75
            },
            {
              "key": "contact_email",
              "label": "Email",
              "units": 1.15
            }
          ]
        },
        {
          "key": "decision_profile",
          "type": "fields",
          "label": "Buying context",
          "fields": [
            {
              "key": "preferred_contact",
              "label": "Preferred contact method",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Not stated",
                "Phone",
                "Email",
                "Text message",
                "In person"
              ]
            },
            {
              "key": "decision_maker",
              "label": "Decision maker",
              "units": 1.0
            },
            {
              "key": "decision_by",
              "label": "Client decides by",
              "units": 0.85
            },
            {
              "key": "budget_discussed",
              "label": "Budget range discussed",
              "units": 1.0
            },
            {
              "key": "competing_venues",
              "label": "Other venues considered",
              "units": 1.1
            }
          ],
          "guidance": "Record only what the requester volunteered; do not infer budget or authority."
        }
      ]
    },
    {
