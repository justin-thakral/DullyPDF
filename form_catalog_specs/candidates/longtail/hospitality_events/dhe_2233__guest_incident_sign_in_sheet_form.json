              "units": 1.15
            },
            {
              "key": "people_present",
              "label": "People present",
              "units": 1.1
            },
            {
              "key": "scene_cleared_at",
              "label": "Scene cleared at",
              "units": 1.25
            }
          ]
        }
      ]
    },
    {
      "key": "witness_register",
      "title": "Witness register",
      "guidance": "Minimum detail, recorded before people leave.",
      "blocks": [
        {
          "key": "witness_rows",
          "type": "table",
          "label": "Witnesses present",
          "columns": [
            {
              "key": "name",
              "label": "Name",
              "units": 1.2
            },
            {
              "key": "relationship",
              "label": "Guest, staff, or visitor",
              "units": 1.2
