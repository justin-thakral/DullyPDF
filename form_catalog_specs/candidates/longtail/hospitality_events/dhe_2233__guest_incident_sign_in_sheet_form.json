              "label": "Contact for follow-up",
              "units": 1.3
            },
            {
              "key": "saw_directly",
              "label": "Saw it",
              "units": 0.65
            },
            {
              "key": "statement",
              "label": "Statement",
              "units": 0.8
            }
          ],
          "rows": 8,
          "guidance": "Collect a name and one contact method only. Do not record identification numbers, addresses, or dates of birth."
        },
        {
          "key": "witness_totals",
          "type": "fields",
          "label": "Witness reconciliation",
          "fields": [
            {
              "key": "witnesses_listed",
              "label": "Witnesses listed",
              "units": 1.2
            },
            {
              "key": "saw_directly_count",
              "label": "Saw it directly",
              "units": 1.2
            },
            {
              "key": "statements_taken",
              "label": "Statements taken",
              "units": 1.25
            },
            {
              "key": "declined_count",
              "label": "Declined to give details",
              "units": 1.6
            }
          ]
        }
      ]
    },
    {
      "key": "responder_register",
      "title": "Responders and external attendees",
      "guidance": "Who attended, from when to when.",
      "blocks": [
        {
          "key": "responder_rows",
          "type": "table",
          "label": "Responders on scene",
          "columns": [
            {
              "key": "name",
              "label": "Name",
              "units": 1.15
            },
            {
              "key": "role",
              "label": "Role",
