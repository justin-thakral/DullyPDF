              "key": "final_status",
              "label": "Final status",
              "units": 1.25,
              "field_type": "choice",
              "options": [
                "Open",
                "Closed - all recorded",
                "Closed with exception",
                "Closed - no witnesses"
              ]
            },
            {
              "key": "closed_at",
              "label": "Closed at",
              "units": 0.8
            },
            {
              "key": "closed_by",
              "label": "Closed by",
              "units": 1.0
            },
            {
              "key": "handed_to",
              "label": "Handed to",
              "units": 1.0
            },
            {
              "key": "retain_until",
              "label": "Retain until",
              "units": 0.9
            }
          ]
        },
        {
          "key": "handoff_confirmations",
          "type": "checklist",
          "label": "Handoff confirmations",
          "items": [
            "Every person present is on the register or recorded as an exception",
            "Responder on-scene and off-scene times recorded",
            "External attendance references captured",
            "Witness accounts recorded in their own terms",
            "Register linked to the incident report and the response checklist",
            "Access restricted and retention period set under applicable policy"
          ]
        },
        {
