            },
            {
              "key": "on_scene",
              "label": "On scene",
              "units": 0.7
            },
            {
              "key": "off_scene",
              "label": "Off scene",
              "units": 0.75
            },
            {
              "key": "what_they_did",
              "label": "What they did",
              "units": 1.4
            }
          ],
          "rows": 6
        },
        {
          "key": "external_attendance",
          "type": "checklist",
          "label": "External attendance recorded",
          "items": [
            "Emergency medical service attended and the unit reference recorded",
            "Police or public authority attended and the reference recorded",
            "Fire service attended and the reference recorded",
            "A contractor or vendor was present and is recorded",
            "The group organizer or companion attended",
            "No external party attended"
          ],
          "guidance": "Record the attendance and reference number only. Do not summarize what an external responder concluded."
        }
      ]
    },
    {
      "key": "statement_status",
      "title": "Statement status and what each person saw",
      "guidance": "A witness list without content is barely a list.",
      "blocks": [
        {
          "key": "observation_rows",
          "type": "table",
          "label": "What each witness described",
          "columns": [
            {
              "key": "witness",
              "label": "Witness",
              "units": 1.15
            },
            {
              "key": "what_described",
              "label": "What they described",
              "units": 1.9
            },
            {
              "key": "taken_by",
              "label": "Taken by",
              "units": 1.0
            },
            {
              "key": "taken_at",
              "label": "Taken at",
              "units": 0.8
            }
          ],
          "rows": 6,
          "guidance": "Record their words as given. Do not prompt a witness toward a conclusion or ask them to agree with another account."
        },
        {
          "key": "register_notes",
          "type": "textarea",
          "label": "Scene conditions at the time the register was taken, and who could not be reached",
          "fields": [
            {
              "key": "register_detail",
              "label": "Register notes"
            }
          ],
          "height": 58
        }
      ]
    },
    {
      "key": "register_exceptions",
      "title": "Exceptions and escalation",
      "guidance": "People leaving is the normal failure mode here.",
      "blocks": [
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Exception triggers",
          "items": [
            "A witness left before their details could be recorded",
            "A witness declined to give any contact detail",
            "A witness gave an account that conflicts with another",
            "A witness recorded video or photographs of the scene",
            "A companion or representative spoke on the guest's behalf",
            "A staff member present was not recorded at the time",
            "An external responder attended and no reference was captured"
          ]
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception register",
          "columns": [
            {
              "key": "exception",
              "label": "Exception",
              "units": 1.2
            },
            {
              "key": "action_taken",
              "label": "Action taken",
              "units": 1.15
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 3
        },
        {
          "key": "register_boundary",
          "type": "notice",
          "label": "Purpose and limits of this register",
          "guidance": "This register exists to know who was present and what they said they saw. Giving details is voluntary and a witness may decline. It is not a formal statement process, an interview record, or an investigation finding, and it does not establish cause or fault. Keep it out of guest view, restrict access, and retain it only as applicable privacy and retention policy allows."
        }
      ]
    },
    {
      "key": "register_closeout",
      "title": "Closeout and handoff to the case owner",
      "guidance": "Hand the register over before the scene is released.",
      "blocks": [
