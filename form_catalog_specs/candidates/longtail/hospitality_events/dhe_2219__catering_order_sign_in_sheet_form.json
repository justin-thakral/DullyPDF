    {
      "key": "onsite_record",
      "title": "On-site record and access",
      "guidance": "What the crew found when it arrived.",
      "blocks": [
        {
          "key": "onsite_checks",
          "type": "checklist",
          "label": "On-site checks at arrival",
          "items": [
            "Reported to the named site contact on arrival",
            "Loading position and access route as described in the order",
            "Client-provided tables and surfaces available as agreed",
            "Power available where the order assumed it",
            "Arrival temperature readings taken and recorded",
            "Restricted portions handed to the named person and confirmed",
            "Buffet positioned clear of doorways and walkways",
            "Waste removal responsibility confirmed with the site contact"
          ]
        },
        {
          "key": "onsite_notes",
          "type": "textarea",
          "label": "Site conditions found, deviations from the order, and how they were handled",
          "fields": [
            {
              "key": "onsite_detail",
              "label": "On-site conditions and deviations"
            }
          ],
          "height": 56
        }
      ]
    },
    {
      "key": "register_exceptions",
      "title": "Exceptions and escalation",
      "guidance": "A refused signature is recorded, not argued.",
      "blocks": [
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Exception triggers",
          "items": [
            "No one at the site would accept or sign for the delivery",
            "Delivered counts differ from the order and were accepted anyway",
            "A crew member was not logged back to the kitchen",
            "The crew was on site materially longer than planned",
            "Site access differed from the order and delayed setup",
            "A crew member reported illness or injury during the delivery",
            "Restricted portions could not be handed to a named person"
          ],
          "guidance": "An illness or injury is routed on the incident record, not resolved on this sheet."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception register",
          "columns": [
            {
              "key": "exception",
              "label": "Exception",
              "units": 1.2
            },
            {
              "key": "action_taken",
              "label": "Action taken",
              "units": 1.15
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 3
        },
        {
          "key": "register_boundary",
          "type": "notice",
          "label": "Purpose and limits of this register",
          "guidance": "This register exists to know who travelled, how long the crew was on site, and who accepted the delivery. It is not a payroll record, a performance evaluation, a waiver of any claim by the client, or a record of any employment decision. Route pay, discipline, and medical matters to the responsible manager under applicable policy."
        }
      ]
    },
    {
