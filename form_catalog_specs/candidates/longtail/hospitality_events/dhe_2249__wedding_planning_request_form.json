          "label": "Couple and decision contacts",
          "fields": [
            {
              "key": "primary_contact",
              "label": "Primary contact",
              "units": 1.1
            },
            {
              "key": "partner_contact",
              "label": "Partner contact",
              "units": 1.1
            },
            {
              "key": "planner_name",
              "label": "Planner or coordinator",
              "units": 1.1
            },
            {
              "key": "contact_method",
              "label": "Preferred contact",
              "units": 0.9,
              "field_type": "choice",
              "options": [
                "Not stated",
                "Email",
                "Phone",
                "Text",
                "Planner"
              ]
            },
            {
              "key": "decision_contact",
              "label": "Final decision contact",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "celebration_brief",
      "title": "Celebration brief and guest experience",
      "guidance": "Record the requested experience before testing venue feasibility.",
      "blocks": [
        {
          "key": "event_profile",
          "type": "fields",
          "label": "Date, attendance, and format",
          "fields": [
            {
              "key": "wedding_date",
              "label": "Requested wedding date",
              "units": 1.0
            },
            {
              "key": "alternate_date",
              "label": "Alternate date",
