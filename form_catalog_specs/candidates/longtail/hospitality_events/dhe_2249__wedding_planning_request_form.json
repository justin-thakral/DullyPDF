              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Not started",
                "In preparation",
                "Ready to send",
                "Sent",
                "Not proceeding"
              ]
            },
            {
              "key": "decision_by",
              "label": "Decision reviewed by",
              "units": 1.0
            },
            {
              "key": "decision_date",
              "label": "Decision date",
              "units": 0.8
            }
          ]
        },
        {
          "key": "decision_basis",
          "type": "textarea",
          "label": "Decision basis and options offered",
          "fields": [
            {
              "key": "decision_detail",
              "label": "Feasibility findings and requester options"
            }
          ],
          "height": 58
        },
        {
          "key": "commitment_boundary",
          "type": "notice",
          "label": "Request-stage boundary",
          "guidance": "This request records preferences and venue screening only. It does not reserve a date, approve capacity or egress, confirm an accommodation, approve alcohol service, or authorize a supplier. Route those decisions to the responsible venue role and use the issued agreement and planning order for approved commitments."
        }
      ]
    },
    {
      "key": "planning_exceptions",
      "title": "Constraints, exceptions, and escalation",
      "guidance": "Make each unresolved planning constraint visible before proposal handoff.",
      "blocks": [
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Exception triggers",
          "items": [
            "Requested date or space is unavailable",
            "Guest count conflicts with reviewed setup range",
            "Weather alternate is unresolved",
            "Accessibility request needs responsible-role review",
            "Dietary or allergen request needs responsible-role review",
            "Bar scope or service hours remain unresolved",
            "Outside supplier requirement remains unresolved",
            "Budget, deposit, or minimum commitment remains unresolved"
          ]
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Planning exception register",
          "columns": [
            {
              "key": "constraint",
              "label": "Constraint",
              "units": 1.2
            },
            {
              "key": "immediate_action",
