            },
            {
              "key": "guest_count",
              "label": "Expected guests",
              "units": 0.75
            },
            {
              "key": "ceremony_site",
              "label": "Ceremony site",
              "units": 1.1
            },
            {
              "key": "reception_site",
              "label": "Reception site",
              "units": 1.1
            },
            {
              "key": "event_style",
              "label": "Celebration style",
              "units": 1.3,
              "field_type": "choice",
              "options": [
                "Not stated",
                "Ceremony only",
                "Reception only",
                "Ceremony + reception",
                "Multi-event weekend",
                "Other"
              ]
            }
          ]
        },
        {
          "key": "requested_program",
          "type": "table",
          "label": "Requested program by time block",
          "columns": [
            {
              "key": "event_part",
              "label": "Event part",
              "units": 1.15
            },
            {
              "key": "date_time",
              "label": "Date and time",
              "units": 1.0
            },
            {
              "key": "space",
              "label": "Space",
              "units": 1.0
            },
            {
              "key": "guests",
              "label": "Guests",
              "units": 0.55
            },
            {
              "key": "setup",
              "label": "Setup need",
              "units": 1.2
            }
          ],
          "rows": 5,
          "guidance": "List ceremony, cocktail period, reception, rehearsal, or other distinct blocks."
        },
        {
          "key": "experience_needs",
          "type": "checklist",
          "label": "Experience requirements raised",
          "items": [
            "Private preparation space requested",
            "Ceremony rehearsal requested",
            "Weather alternate requested",
            "Accessible route or accommodation raised",
            "Dietary or allergen accommodation raised",
            "Cultural or religious setup requirement raised",
            "Childcare, quiet room, or family space requested",
            "Late-night, after-party, or send-off requested"
          ],
          "guidance": "Tick only requirements raised by the requester and route each sensitive need to the responsible venue role."
        }
      ]
    },
    {
      "key": "supplier_dependencies",
      "title": "Supplier and service dependencies",
      "guidance": "Identify the teams whose availability controls the planning outcome.",
      "blocks": [
        {
