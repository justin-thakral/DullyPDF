{
  "schema_version": 1,
  "catalog_id": "hospitality_events/dhe_2249__wedding_planning_request_form",
  "source_section": "hospitality_events",
  "source_filename": "dhe_2249__wedding_planning_request_form.pdf",
  "slug": "wedding-planning-request-form",
  "title": "Wedding Planning Request Form",
  "subtitle": "Turn a couple's first planning brief into a routed venue request with dated decisions, open constraints, and a clear proposal handoff.",
  "description": "An original wedding-planning intake record for the ceremony, reception, guest experience, supplier dependencies, schedule, and venue review. It keeps preliminary wishes separate from approved commitments and gives every unresolved requirement an owner and due point.",
  "use_case": "Use when a couple, planner, or host asks a venue team to scope a wedding. Close the request only when feasibility has been reviewed, the outcome has been communicated, and an approved request is linked to the next planning order or a declined request has a recorded reason.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "request_intake",
      "title": "Planning request and routing",
      "guidance": "Identify the celebration, decision contacts, and response owner.",
      "blocks": [
        {
          "key": "request_record",
          "type": "fields",
          "label": "Request record",
          "fields": [
            {
              "key": "request_id",
              "label": "Request ID",
              "units": 0.8
            },
            {
              "key": "received_at",
              "label": "Received date and time",
              "units": 1.0
            },
            {
              "key": "intake_channel",
              "label": "Intake channel",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Not recorded",
                "Venue inquiry",
                "Planner referral",
                "Phone or email",
                "Site visit",
                "Existing client"
              ]
            },
            {
              "key": "planning_owner",
              "label": "Planning owner",
              "units": 1.0
            },
            {
              "key": "response_due",
              "label": "Response due",
              "units": 0.8
            }
          ]
        },
        {
          "key": "decision_contacts",
