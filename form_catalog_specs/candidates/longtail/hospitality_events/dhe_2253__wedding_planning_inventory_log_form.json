{
  "schema_version": 1,
  "catalog_id": "hospitality_events/dhe_2253__wedding_planning_inventory_log_form",
  "source_section": "hospitality_events",
  "source_filename": "dhe_2253__wedding_planning_inventory_log_form.pdf",
  "slug": "wedding-planning-inventory-log-form",
  "title": "Wedding Planning Inventory Log Form",
  "subtitle": "Track wedding decor, rentals, gifts, supplies, and personal items from receipt through placement, return, discrepancy resolution, and handoff.",
  "description": "An original event inventory and custody log for items that cross venue, supplier, client, and event-team boundaries. It records expected quantity, receipt condition, storage location, issued use, return status, exceptions, and accountable release.",
  "use_case": "Use for wedding property or rented items that need a documented receiving and return trail. Create a linked continuation for larger inventories and close only after counts reconcile or every variance has a disposition and handoff owner.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "log_control",
      "title": "Inventory log control",
      "guidance": "Identify the event, count basis, and people responsible for custody.",
      "blocks": [
        {
          "key": "log_identity",
          "type": "fields",
          "label": "Log identity",
          "fields": [
            {
              "key": "inventory_id",
              "label": "Inventory log ID",
              "units": 0.95
            },
            {
              "key": "event_id",
              "label": "Wedding or event ID",
              "units": 1.0
            },
            {
              "key": "wedding_date",
              "label": "Wedding date",
              "units": 0.8
            },
            {
              "key": "log_owner",
              "label": "Inventory owner",
              "units": 1.0
            },
            {
              "key": "receiving_contact",
              "label": "Receiving contact",
              "units": 1.05
            },
            {
              "key": "return_contact",
              "label": "Return contact",
              "units": 1.0
            }
          ]
        },
        {
          "key": "scope_control",
