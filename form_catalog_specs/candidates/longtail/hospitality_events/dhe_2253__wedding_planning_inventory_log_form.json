            }
          ]
        }
      ]
    },
    {
      "key": "variance_control",
      "title": "Variance and damage control",
      "guidance": "Keep discrepancies open until a responsible disposition is recorded.",
      "blocks": [
        {
          "key": "variance_register",
          "type": "table",
          "label": "Inventory variance register",
          "columns": [
            {
              "key": "item_id",
              "label": "Item ID",
              "units": 0.7
            },
            {
              "key": "variance",
              "label": "Short, excess, or damage",
              "units": 1.35
            },
            {
              "key": "immediate_action",
              "label": "Immediate action",
              "units": 1.2
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.0
            }
          ],
          "rows": 5
        },
        {
          "key": "variance_notes",
          "type": "textarea",
          "label": "Variance evidence and communication",
          "fields": [
            {
              "key": "variance_detail",
              "label": "Count evidence, condition facts, and notifications"
            }
          ],
          "height": 58
        },
        {
          "key": "custody_boundary",
          "type": "notice",
          "label": "Custody record boundary",
          "guidance": "This log records item movements and observed condition. It does not determine ownership, assign fault, accept liability, or authorize payment. Route disputed ownership, significant damage, missing property, or compensation decisions to the responsible role."
        }
      ]
    },
    {
      "key": "inventory_closeout",
      "title": "Reconciliation and accountable closeout",
      "guidance": "Close only on a verified count or documented variance handoff.",
      "blocks": [
