            },
            {
              "key": "condition",
              "label": "Condition",
              "units": 1.0
            },
            {
              "key": "received_at",
              "label": "Received at",
              "units": 0.85
            },
            {
              "key": "stored_at",
              "label": "Storage location",
              "units": 1.1
            },
            {
              "key": "received_by",
              "label": "Received by",
              "units": 0.9
            }
          ],
          "rows": 7,
          "guidance": "Use a new row for a partial receipt or materially different condition."
        },
        {
          "key": "receipt_exceptions",
          "type": "checklist",
          "label": "Receipt exception checks",
          "items": [
            "Quantity differs from the expected record",
            "Item arrived damaged or incomplete",
            "Item has no usable identifier",
            "Packaging is insufficient for return",
            "Storage location differs from the custody plan",
            "Unscheduled item requires acceptance decision",
            "High-value item needs controlled-access storage"
          ],
          "guidance": "Open a variance row for every checked condition."
        }
      ]
    },
    {
