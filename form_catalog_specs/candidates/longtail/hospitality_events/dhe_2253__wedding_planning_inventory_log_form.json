          "label": "Inventory scope",
          "fields": [
            {
              "key": "scope",
              "label": "Inventory scope",
              "units": 1.2,
              "field_type": "choice",
              "options": [
                "Not selected",
                "Client-owned decor",
                "Venue inventory",
                "Rental inventory",
                "Supplier equipment",
                "Gifts or personal items",
                "Mixed event inventory"
              ]
            },
            {
              "key": "count_basis",
              "label": "Count basis",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Not recorded",
                "Packing list",
                "Rental order",
                "Physical count",
                "Client declaration"
              ]
            },
            {
              "key": "receiving_window",
              "label": "Receiving window",
              "units": 1.0
            },
            {
              "key": "return_deadline",
              "label": "Return deadline",
              "units": 0.9
            },
            {
              "key": "linked_order",
              "label": "Linked order",
              "units": 1.0
            }
          ]
        }
      ]
    },
    {
      "key": "expected_inventory",
      "title": "Expected items and custody plan",
      "guidance": "Record expected items before receiving begins.",
      "blocks": [
        {
          "key": "expected_items",
          "type": "table",
          "label": "Expected inventory",
          "columns": [
            {
              "key": "item_id",
              "label": "Item ID",
              "units": 0.75
            },
            {
              "key": "description",
              "label": "Item description",
              "units": 1.45
            },
            {
              "key": "owner",
              "label": "Owner or supplier",
              "units": 1.05
            },
            {
              "key": "expected_qty",
              "label": "Expected qty",
              "units": 0.75
            },
            {
              "key": "destination",
              "label": "Planned location",
              "units": 1.1
            }
          ],
          "rows": 7
        },
        {
          "key": "custody_plan",
          "type": "checklist",
          "label": "Custody plan confirmations",
          "items": [
            "Each high-value or unique item has an identifier",
            "Receiving and return contacts are confirmed",
            "Secure storage location is assigned where needed",
            "Setup and strike custodians are named",
            "Gift and personal-item access is limited to named roles",
            "Rental return deadline and carrier handoff are recorded",
            "Packaging and empty-case storage location is assigned"
          ]
        }
      ]
    },
    {
      "key": "receiving",
      "title": "Receipt, condition, and storage",
      "guidance": "Count and inspect at the moment custody transfers.",
      "blocks": [
        {
          "key": "receipt_log",
          "type": "table",
          "label": "Receiving log",
          "columns": [
            {
              "key": "item_id",
              "label": "Item ID",
              "units": 0.7
            },
            {
              "key": "received_qty",
              "label": "Received",
