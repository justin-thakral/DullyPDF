              "label": "How it is plated and marked",
              "units": 1.5
            },
            {
              "key": "confirmed_by",
              "label": "Confirmed by",
              "units": 0.95
            }
          ],
          "rows": 5,
          "guidance": "Every restricted cover needs a seat reference and a marking method so the right plate reaches the right guest."
        },
        {
          "key": "allergen_boundary",
          "type": "notice",
          "label": "Allergen and dietary boundary",
          "guidance": "This order records the dietary and allergen requirements the client provided and how the kitchen intends to plate them. It does not certify that any dish is free of an allergen and it is not a medical or food-safety determination. Re-confirm each requirement with the client contact and the chef on duty before service, and stop and route any requirement that cannot be met safely to the responsible manager."
        }
      ]
    },
    {
      "key": "order_authorization",
      "title": "Authorization and guarantee",
      "guidance": "Record the guarantee and who committed the venue to it.",
      "blocks": [
        {
          "key": "authorization_record",
          "type": "fields",
          "label": "Order authorization",
          "fields": [
