            }
          ],
          "rows": 8,
          "guidance": "One row per cue, from door open through last course and teardown."
        },
        {
          "key": "set_requirements",
          "type": "checklist",
          "label": "Set requirements",
          "items": [
            "Head table set and positioned per the diagram",
            "Podium and microphone positions confirmed",
            "Dance floor size and position confirmed",
            "Registration or gift table set as ordered",
            "Buffet and station positions confirmed clear of exit paths",
            "Aisle widths and exit routes confirmed with the responsible manager",
            "Accessible seating positions set where requested",
            "Entrance signage and seating chart placed"
