        {
          "key": "order_boundary",
          "type": "notice",
          "label": "Stop conditions and record boundary",
          "guidance": "Stop and route to the responsible manager before serving if the dietary plan is unconfirmed, if a holding temperature cannot be verified, if the set blocks an exit path, or if covers exceed the room's confirmed capacity. This order is an operating record; it does not determine occupancy limits, certify food safety, or interpret the signed agreement, and the applicable venue policy and signed agreement govern where they differ."
        },
        {
          "key": "authorization_notes",
          "type": "textarea",
          "label": "Approved conditions, deviations from the request, and client instructions",
          "fields": [
            {
              "key": "authorization_detail",
              "label": "Authorization detail"
            }
          ],
          "height": 50
        }
      ]
    },
