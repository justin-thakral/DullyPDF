            },
            {
              "key": "credit_review",
              "label": "Credit review",
              "units": 0.95,
              "field_type": "choice",
              "options": [
                "Not required",
                "Requested",
                "Approved",
                "Approved with deposit",
                "Declined"
              ]
            },
            {
              "key": "client_accepted",
              "label": "Client accepted on",
              "units": 0.9
            }
          ]
        },
        {
          "key": "commercial_boundary",
          "type": "notice",
          "label": "Order scope and record boundary",
          "guidance": "This order records the internal booking scope agreed with the client. It is not the signed contract and does not interpret cancellation, attrition, insurance, or liability terms. Where this order and the signed agreement differ, the agreement governs. Route pricing, credit, contract-language, and insurance questions to the responsible manager before acting on them."
        },
        {
          "key": "authorization_notes",
          "type": "textarea",
          "label": "Approved conditions, deviations, and what the client accepted",
          "fields": [
            {
              "key": "authorization_detail",
              "label": "Authorization detail"
            }
          ],
          "height": 46
        }
      ]
    },
    {
      "key": "order_conditions",
      "title": "Open conditions, exceptions, and escalation",
      "guidance": "An order can be definite and still carry unresolved conditions.",
      "blocks": [
        {
          "key": "condition_triggers",
          "type": "checklist",
          "label": "Open condition triggers",
          "items": [
            "Signed agreement or countersignature outstanding",
