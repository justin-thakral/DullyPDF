{
  "schema_version": 1,
  "catalog_id": "hospitality_events/dhe_2201__event_inquiry_order_form",
  "source_section": "hospitality_events",
  "source_filename": "dhe_2201__event_inquiry_order_form.pdf",
  "slug": "event-inquiry-order-form",
  "title": "Event Inquiry Order Form",
  "subtitle": "Convert a qualified inquiry into an internal definite-booking order that operations can build from, with contracted scope, billing routing, and turnover evidence.",
  "description": "An original booking order that turns a screened inquiry into a definite internal order. It records order identity and routing, contracted dates, spaces and rates, the operational build data each department needs, authorization and client acceptance, open commercial conditions, and the turnover handoff to operations.",
  "use_case": "Use when an inquiry has been qualified and the venue is ready to commit space. The seller records contracted scope, deposit and billing routing, and the dependencies each department must acknowledge. The order closes only when it has been turned over to operations and every open condition has an owner.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "order_identity",
      "title": "Booking order identity and routing",
      "guidance": "Bind this order to its source inquiry and its accountable owners.",
      "blocks": [
        {
          "key": "order_routing",
          "type": "fields",
          "label": "Order identity and routing",
          "fields": [
            {
              "key": "order_number",
              "label": "Order number",
              "units": 0.85
            },
            {
              "key": "source_inquiry",
              "label": "Source inquiry ID",
              "units": 0.95
            },
            {
              "key": "definite_date",
              "label": "Definite date",
              "units": 0.8
            },
            {
              "key": "sales_owner",
              "label": "Sales owner",
              "units": 0.95
            },
            {
              "key": "service_owner",
              "label": "Service owner",
              "units": 0.95
            }
          ],
          "guidance": "The sales owner owns commercial terms; the service owner owns delivery."
        },
        {
          "key": "client_contacts",
          "type": "fields",
          "label": "Client and billing contacts",
          "fields": [
            {
              "key": "client_organization",
              "label": "Client organization",
              "units": 1.2
            },
            {
              "key": "billing_contact",
              "label": "Billing contact",
              "units": 1.0
            },
            {
              "key": "onsite_contact",
              "label": "On-site contact",
              "units": 1.0
            },
            {
              "key": "onsite_phone",
              "label": "On-site phone",
              "units": 0.85
            },
            {
              "key": "client_reference",
              "label": "Client PO or reference",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "contracted_scope",
      "title": "Contracted dates, spaces, and commercial terms",
      "guidance": "Record only what the venue has actually committed.",
      "blocks": [
        {
          "key": "space_schedule",
          "type": "table",
          "label": "Contracted space schedule",
          "columns": [
            {
              "key": "event_date",
              "label": "Date",
              "units": 0.7
            },
            {
              "key": "time_block",
              "label": "Time block",
              "units": 0.85
            },
            {
              "key": "space_assigned",
              "label": "Space assigned",
              "units": 1.05
            },
            {
              "key": "function_type",
              "label": "Function",
              "units": 1.0
            },
            {
              "key": "headcount",
              "label": "Guests",
              "units": 0.5
            },
            {
              "key": "rate_basis",
              "label": "Rate or minimum",
              "units": 0.95
            }
          ],
          "rows": 6,
          "guidance": "Space names must match the master calendar exactly so operations and accounting reconcile to the same inventory."
        },
        {
          "key": "commercial_terms",
          "type": "fields",
          "label": "Commercial terms",
          "fields": [
            {
              "key": "agreement_status",
              "label": "Agreement status",
              "units": 1.25,
              "field_type": "choice",
              "options": [
                "Pending client signature",
                "Pending venue countersignature",
                "Signed agreement on file",
                "Letter of agreement only",
                "Internal - no client"
              ]
            },
            {
              "key": "guaranteed_minimum",
              "label": "Guaranteed minimum",
              "units": 1.0
            },
            {
              "key": "deposit_due",
              "label": "Deposit due",
              "units": 0.8
            },
            {
              "key": "balance_due",
              "label": "Balance due",
              "units": 0.8
            },
            {
              "key": "payment_route",
              "label": "Payment route",
              "units": 1.05,
              "field_type": "choice",
              "options": [
                "Not yet set",
                "Invoice - approved credit",
                "Card authorization on file",
                "Bank transfer",
                "Prepaid in full",
                "Split billing"
              ]
            }
          ],
          "guidance": "Record the routing only. Do not write card numbers or bank details on this form; hold them in the system of record."
        },
        {
          "key": "order_inclusions",
          "type": "checklist",
          "label": "Services included in this order",
          "items": [
            "Banquet or plated food service",
            "Beverage or bar service",
            "Guest-room block",
            "Audio-visual or production",
            "Rental furniture, linen, or decor",
            "Parking, valet, or shuttle",
            "Signage or branding placement",
            "Dedicated staffing beyond standard service",
            "Outside vendor load-in",
            "Security or crowd management"
          ],
          "guidance": "Every ticked service needs an owning department in the dependency schedule below."
        }
      ]
    },
