              "units": 1.0
            },
            {
              "key": "evidence_reference",
              "label": "Evidence reference",
              "units": 1.0
            }
          ],
          "rows": 5,
          "guidance": "An unconfirmed dependency at turnover becomes an open condition, not a verbal promise."
        },
        {
          "key": "build_notes",
          "type": "textarea",
          "label": "Build sequence, shared-wall constraints, and service notes",
          "fields": [
            {
              "key": "build_detail",
              "label": "Operational build detail"
            }
          ],
          "height": 50
        }
      ]
    },
    {
      "key": "order_authorization",
      "title": "Authorization and client acceptance",
      "guidance": "Record who committed the venue and when the client accepted.",
      "blocks": [
        {
          "key": "authorization_record",
          "type": "fields",
          "label": "Order authorization",
          "fields": [
            {
              "key": "order_status",
              "label": "Order status",
              "units": 1.2,
              "field_type": "choice",
              "options": [
                "Pending approval",
                "Approved - definite",
                "Approved with conditions",
                "Held for credit review",
                "Declined"
              ]
            },
            {
              "key": "approval_date",
              "label": "Approval date",
              "units": 0.8
            },
            {
              "key": "authorized_by",
              "label": "Authorized by",
