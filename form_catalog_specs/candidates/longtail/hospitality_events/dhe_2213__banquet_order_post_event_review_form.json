        },
        {
          "key": "review_boundary",
          "type": "notice",
          "label": "Record boundary for this review",
          "guidance": "This review is an internal operating and billing record. It does not settle a billing dispute, determine liability for an incident, evaluate an individual employee, or authorize compensation. Route account adjustments, claims, and personnel matters to the responsible manager under applicable policy."
        }
      ]
    },
    {
      "key": "review_findings",
      "title": "Findings requiring action and escalation",
      "guidance": "A finding without an owner will recur next function.",
      "blocks": [
        {
          "key": "escalation_triggers",
          "type": "checklist",
          "label": "Escalation triggers",
          "items": [
            "A restricted plate reached the wrong guest during the function",
            "A holding temperature outside the standard was recorded during service",
            "Billed covers differ from served covers without an agreed reason",
            "An open incident report from this function is unresolved",
            "The client complaint is still open at review",
            "Covers served exceeded the room's confirmed capacity",
            "The same finding appeared in a prior function review"
