            {
              "key": "review_before_release",
              "label": "Release review by",
              "units": 1.3
            }
          ]
        },
        {
          "key": "order_boundary",
          "type": "notice",
          "label": "Order scope and record boundary",
          "guidance": "This order records the inventory, rate, and routing the venue has committed. It does not interpret attrition, cancellation, or no-show terms, and it does not guarantee a specific room number or an upgrade. Where this order and the signed agreement differ, the agreement governs. Route rate, attrition, credit, and accessibility commitments to the responsible manager before confirming them to the group."
        },
        {
          "key": "authorization_notes",
          "type": "textarea",
          "label": "Approved conditions, deviations, and what the group was told",
          "fields": [
            {
              "key": "authorization_detail",
              "label": "Authorization detail"
            }
          ],
          "height": 50
        }
      ]
