          "rows": 8
        },
        {
          "key": "briefing_items",
          "type": "checklist",
          "label": "Pre-shift briefing given",
          "items": [
            "Service timeline and cue times walked through",
            "Menu, course order, and item descriptions covered",
            "Restricted plates, marking method, and affected seats identified",
            "Buffet and station positions and traffic flow shown",
            "Exit routes and the assembly point pointed out",
            "Spill, breakage, and guest-request escalation path stated",
            "Break rotation and coverage confirmed with each station owner",
            "Uniform, hygiene, and handwashing expectations stated"
          ],
          "guidance": "This records that a briefing was given. It is not a training record or a certification of any kind."
        }
      ]
    },
    {
      "key": "break_coverage",
      "title": "Break and coverage log",
      "guidance": "A covered station is the only kind that may be left.",
