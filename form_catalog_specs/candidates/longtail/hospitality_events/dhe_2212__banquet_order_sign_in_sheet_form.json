              "label": "Time out",
              "units": 0.6
            },
            {
              "key": "initials",
              "label": "Initials",
              "units": 0.6
            }
          ],
          "rows": 12,
          "guidance": "Collect name, role, and times only. Payroll identifiers and personal contact details belong in the staffing system, not on the floor sheet."
        },
