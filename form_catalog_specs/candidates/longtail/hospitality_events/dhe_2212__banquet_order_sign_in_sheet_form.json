    {
      "key": "shift_exceptions",
      "title": "Exceptions and escalation",
      "guidance": "Staffing gaps are recorded, not absorbed silently.",
      "blocks": [
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Exception triggers",
          "items": [
            "A scheduled person did not arrive and was not replaced",
            "A station ran without an assigned owner",
            "A break was taken without recorded cover",
            "A person did not sign out",
            "Covers per server exceeded the planned ratio",
            "A person reported illness or injury during the shift",
            "A person was sent home before the shift ended"
          ],
          "guidance": "An illness or injury during a shift is routed on the incident record, not resolved on this sheet."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception register",
          "columns": [
            {
              "key": "exception",
              "label": "Exception",
              "units": 1.2
            },
            {
              "key": "action_taken",
              "label": "Action taken",
              "units": 1.15
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 3
        },
        {
          "key": "register_boundary",
          "type": "notice",
          "label": "Purpose and limits of this register",
          "guidance": "This register exists to run one banquet shift: who is present, which station they own, and who covers a break. It is not a payroll record, a performance evaluation, a training certification, or a record of any employment decision. Route pay, discipline, and medical matters to the responsible manager under applicable policy."
        }
      ]
    },
    {
      "key": "shift_closeout",
      "title": "Closeout and handoff",
      "guidance": "Account for everyone before the sheet closes.",
