    {
      "key": "staff_register",
      "title": "Staff sign-in and sign-out",
      "guidance": "One row per person, signed out before the sheet closes.",
      "blocks": [
        {
          "key": "staff_rows",
          "type": "table",
          "label": "Staff register",
          "columns": [
