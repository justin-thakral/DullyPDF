        {
          "key": "operating_context",
          "type": "fields",
          "label": "Requested operating context",
          "fields": [
            {
              "key": "entry_point",
              "label": "Entry point",
              "units": 1.0
            },
            {
              "key": "dock_or_curb",
              "label": "Dock or curb",
              "units": 1.0
            },
            {
              "key": "staging_area",
              "label": "Staging area",
              "units": 1.0
            },
            {
              "key": "venue_contact",
              "label": "Venue contact",
              "units": 1.0
            }
          ]
        }
      ]
    },
    {
      "key": "decision_control",
      "title": "Feasibility decision and conflicts",
      "guidance": "Confirm that the proposed movement can be supported as scoped.",
      "blocks": [
        {
          "key": "decision_checks",
          "type": "checklist",
          "label": "Review decisions",
          "items": [
            "Arrival window checked against other dock activity",
            "Vehicle route and clearance reviewed by venue operations",
            "Freight lift or alternate path availability confirmed",
            "Floor, wall, or door protection need assigned",
            "Storage and unattended-item ownership assigned",
            "Conflicts have owners and resolution due points"
          ]
        },
        {
