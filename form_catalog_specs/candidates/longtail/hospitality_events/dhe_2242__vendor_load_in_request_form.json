  "slug": "vendor-load-in-request-form",
  "title": "Vendor Load-In Request Form",
  "subtitle": "Scope a vendor arrival, reserve the right route and staging resources, and hand an approved request into a load-in order.",
  "description": "An original vendor load-in request that captures the delivery scope, vehicles, crew, equipment, arrival window, receiving route, operational dependencies, conflicts, approval decision, and accountable handoff.",
  "use_case": "Use before a vendor is scheduled to bring equipment or goods onto a hospitality property. Close when the request is declined or an approved scope is linked to an issued load-in order.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Request intake and ownership",
      "guidance": "Identify the event, vendor, requested movement, and reviewer.",
      "blocks": [
        {
          "key": "record_identity",
          "type": "fields",
          "label": "Record identity and routing",
          "fields": [
            {
              "key": "request_id",
              "label": "Request ID",
              "units": 0.8
            },
            {
              "key": "requested_by",
              "label": "Requested by",
              "units": 1.0
            },
            {
              "key": "event_date",
              "label": "Event date",
              "units": 0.85
            },
            {
              "key": "vendor_name",
              "label": "Vendor",
              "units": 1.2
            }
          ]
        },
        {
          "key": "intake_requirements",
          "type": "checklist",
          "label": "Scope details received",
          "items": [
            "Vendor contact and day-of contact are recorded",
            "Requested arrival and completion windows are stated",
            "Vehicle count and largest vehicle are described",
            "Equipment, cases, pallets, or goods are summarized",
            "Destination rooms and staging needs are identified",
            "Power, freight lift, or storage dependencies are noted"
          ]
        }
      ]
    },
    {
