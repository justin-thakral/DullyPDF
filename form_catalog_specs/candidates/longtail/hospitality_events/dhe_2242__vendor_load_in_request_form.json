          "type": "textarea",
          "label": "Approved scope, limitations, and unresolved dependencies",
          "fields": [
            {
              "key": "decision_detail",
              "label": "Decision detail and limitations"
            }
          ],
          "height": 62
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Operational review boundary",
          "guidance": "Record observed facts and venue instructions. Stop an unresolved movement, protect the affected area, and route safety, access, damage, or capacity decisions to the responsible venue role under applicable policy."
        }
      ]
    },
