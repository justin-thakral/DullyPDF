          "rows": 4
        },
        {
          "key": "service_boundary",
          "type": "notice",
          "label": "Specialist review boundary",
          "guidance": "A checked item confirms that the current record was reviewed and routed; it does not certify accessibility, food or allergen controls, alcohol service, or legal compliance. Record only the decision supplied by the responsible role and its source record."
        }
      ]
    },
    {
