    {
      "key": "service_readiness",
      "title": "Food, beverage, and guest-service readiness",
      "guidance": "Confirm routed decisions without claiming specialist authority.",
      "blocks": [
        {
          "key": "service_checks",
          "type": "checklist",
          "label": "Service checks",
          "items": [
            "Meal format and service timing match the current order",
            "Guaranteed count and update deadline are recorded",
            "Dietary and allergen requests are routed to the responsible team",
            "Bar order and responsible-service plan are separately approved",
            "Nonalcoholic beverage choices and water service are confirmed",
            "Cake or specialty-food delivery and custody are assigned",
            "Guest-room, transportation, or parking handoffs are confirmed",
            "Childcare, quiet-room, or family-space request is routed",
            "Guest communication owner and release time are assigned"
