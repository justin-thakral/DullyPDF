      "key": "program_readiness",
      "title": "Program and space readiness",
      "guidance": "Verify the event sequence and the spaces that support it.",
      "blocks": [
        {
          "key": "program_checks",
          "type": "checklist",
          "label": "Program checks",
          "items": [
            "Ceremony and reception dates and times match the current order",
            "Guest-count basis and update deadline are recorded",
            "Every program block has an assigned space and lead",
            "Weather alternate and decision time are recorded",
            "Guest routes between spaces are documented",
            "Accessible routes and requested accommodations are routed",
            "Private preparation spaces and access boundaries are assigned",
            "Room transition and reset owners are assigned",
            "Final departure and venue-clear time are recorded"
          ]
        },
