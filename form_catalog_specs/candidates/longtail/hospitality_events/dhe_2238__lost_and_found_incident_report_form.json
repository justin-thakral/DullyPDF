              "units": 1.55
            },
            {
              "key": "found_date",
              "label": "Found on",
              "units": 0.8
            },
            {
              "key": "storage_location",
              "label": "Storage location",
              "units": 1.15
            },
            {
              "key": "claimant_name",
              "label": "Claimant affected",
              "units": 1.2
            }
          ]
        },
        {
          "key": "classification",
          "type": "fields",
          "label": "Incident classification",
          "fields": [
            {
              "key": "incident_type",
              "label": "What happened",
              "units": 1.7,
              "field_type": "choice",
              "options": [
                "Not yet classified",
                "Item missing from storage",
                "Contents missing from an item",
                "Released to the wrong person",
                "Released without an ownership check",
                "Storage accessed without authorization",
                "Cash count does not reconcile",
                "Item disposed of before its holding period ended",
                "Item damaged in storage",
                "Shipment lost in transit",
                "Suspected theft"
              ]
            },
            {
              "key": "severity",
              "label": "Assessed severity",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Pending assessment",
                "Minor - item recovered",
                "Moderate - item not recovered",
                "Major - high value or documents",
                "Critical - suspected theft"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "custody_break",
      "title": "Where the chain of custody broke",
      "guidance": "Work back from the last verified position.",
