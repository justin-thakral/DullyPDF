{
  "schema_version": 1,
  "catalog_id": "hospitality_events/dhe_2238__lost_and_found_incident_report_form",
  "source_section": "hospitality_events",
  "source_filename": "dhe_2238__lost_and_found_incident_report_form.pdf",
  "slug": "lost-and-found-incident-report-form",
  "title": "Lost and Found Incident Report Form",
  "subtitle": "Record a custody failure: an item missing from storage, a release to the wrong person, missing contents, or a storage area breach.",
  "description": "An original incident record for lost-and-found custody failures. It captures the incident identity and the item affected, the last known good custody position and where the chain broke, the immediate containment of the storage area, qualified review with any authority referral, corrective actions with verification, and a closeout naming residual risk.",
  "use_case": "Use when the venue cannot account for stored property, an item was handed to the wrong person, contents are missing from a logged item, or the storage area was accessed without authorization. The report closes only after the responsible manager reviews it and corrective actions are verified.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "incident_identity",
      "title": "Incident identity and item affected",
      "guidance": "Fix the failure to a tag and a time.",
      "blocks": [
        {
          "key": "incident_routing",
          "type": "fields",
          "label": "Incident record and routing",
          "fields": [
            {
