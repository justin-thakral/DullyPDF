              "label": "Discovered at",
              "units": 0.9
            },
            {
              "key": "discovered_by",
              "label": "Discovered by",
              "units": 0.95
            },
            {
              "key": "reported_to",
              "label": "Reported to",
              "units": 0.9
            },
            {
