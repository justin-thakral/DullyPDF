          ],
          "height": 54
        }
      ]
    },
    {
      "key": "qualified_review",
      "title": "Qualified review and referral",
      "guidance": "The manager decides on referral, not the storage keeper.",
      "blocks": [
        {
          "key": "review_record",
          "type": "fields",
          "label": "Qualified review",
          "fields": [
