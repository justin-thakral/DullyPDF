          "label": "Custody timeline reconstruction",
          "columns": [
            {
              "key": "event_time",
              "label": "Time",
              "units": 0.7
            },
            {
              "key": "what_the_record_shows",
              "label": "What the record shows",
              "units": 1.7
            },
            {
              "key": "who_had_access",
              "label": "Who had access",
              "units": 1.2
            },
            {
              "key": "source",
              "label": "Source of the entry",
              "units": 1.2
            }
          ],
          "rows": 6,
          "guidance": "Use the intake log, access log, release orders, and camera coverage. Mark which entries are records and which are recollections."
        },
        {
          "key": "factual_account",
          "type": "textarea",
          "label": "Factual account: what the records show and where they stop agreeing",
          "fields": [
            {
              "key": "account_detail",
              "label": "Factual account of the custody failure"
            }
          ],
          "height": 72,
          "guidance": "Record what the records show. Do not name a suspect, allege theft, or draw a conclusion about any individual."
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Record boundary for this report",
          "guidance": "Record facts, times, and record states only. Do not accuse an individual, record a suspicion as a finding, or describe anyone's conduct as theft. Do not record identification or payment card numbers. Where a criminal act may have occurred, route it to the responsible manager, who decides on any authority contact under applicable policy."
        }
      ]
    },
    {
      "key": "containment",
      "title": "Containment of storage and access",
      "guidance": "Secure what remains before investigating what is gone.",
      "blocks": [
