              "units": 1.3,
              "field_type": "choice",
              "options": [
                "Pending review",
                "Reviewed - process gap",
                "Reviewed - record error",
                "Referred to security",
                "Referred to leadership"
              ]
            },
            {
              "key": "reviewed_by",
              "label": "Reviewed by",
              "units": 1.0
            },
            {
              "key": "review_date",
              "label": "Review date",
              "units": 0.8
            },
            {
              "key": "referral",
              "label": "Referral made",
              "units": 1.2,
              "field_type": "choice",
              "options": [
                "None",
                "Internal security",
                "Insurer notified",
                "Police - by manager",
                "Human resources"
              ]
            },
            {
              "key": "referral_reference",
              "label": "Referral reference",
              "units": 1.15
            }
          ]
        },
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Stop conditions and authority boundary",
          "guidance": "Stop and involve the responsible manager before contacting any authority, before questioning a staff member about a missing item, and before telling a claimant that their property was taken. This report does not establish that a theft occurred, identify a responsible person, accept liability for the loss, or authorize compensation, and it does not replace the review or notification applicable policy requires."
        },
        {
          "key": "review_rationale",
          "type": "textarea",
          "label": "Review rationale, requirements applied, and limits of the decision",
          "fields": [
            {
              "key": "rationale_detail",
              "label": "Qualified review rationale"
            }
          ],
          "height": 52
        }
      ]
    },
