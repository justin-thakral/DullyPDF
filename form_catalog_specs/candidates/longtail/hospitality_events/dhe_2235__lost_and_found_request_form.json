          "fields": [
            {
              "key": "detail_description",
              "label": "Distinguishing detail of the lost item"
            }
          ],
          "height": 62,
          "guidance": "Take this before showing any item. Detail that only the owner would know is what makes a later ownership check meaningful."
        },
        {
          "key": "special_handling_flags",
          "type": "checklist",
          "label": "Special handling flags raised by the claimant",
          "items": [
