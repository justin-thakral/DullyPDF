          ]
        },
        {
          "key": "match_boundary",
          "type": "notice",
          "label": "How a match is handled",
          "guidance": "A description that resembles a stored item is a possible match, not proof of ownership. Do not describe a stored item to a claimant, show it to them, or release it on the strength of a category and color alone. Ownership is tested on the release order by the responsible manager, and identification documents, medication, payment cards, and high-value items are never released without that check."
        },
        {
          "key": "decision_notes",
          "type": "textarea",
          "label": "Why the item was or was not matched, and what the claimant was told",
          "fields": [
            {
              "key": "decision_detail",
              "label": "Match decision notes"
            }
          ],
          "height": 50
        }
      ]
    },
