          ],
          "rows": 5
        },
        {
          "key": "interim_controls",
          "type": "checklist",
          "label": "Interim controls while work is open",
          "items": [
            "Area secured, barriered, or signed until the work is complete",
            "Affected room or space taken out of service",
            "Equipment tagged out where it contributed to the incident",
            "Staff briefed on the interim control and how long it applies",
            "Recheck scheduled and assigned to a named person",
            "Condition logged in the maintenance system, not only on this order",
            "Similar locations checked for the same condition"
          ],
          "guidance": "An interim control with no recheck date becomes a permanent hazard."
        }
      ]
    },
