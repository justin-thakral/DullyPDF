            },
            {
              "key": "status",
              "label": "Status",
              "units": 0.95
            }
          ],
          "rows": 6,
          "guidance": "Record the basis, not a justification of fault: what the guest needs to be made whole operationally."
        },
        {
          "key": "approval_limits",
          "type": "fields",
