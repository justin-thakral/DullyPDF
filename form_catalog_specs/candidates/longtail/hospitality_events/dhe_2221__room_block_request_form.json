  "source_section": "hospitality_events",
  "source_filename": "dhe_2221__room_block_request_form.pdf",
  "slug": "room-block-request-form",
  "title": "Room Block Request Form",
  "subtitle": "Ask rooms control to hold guest-room inventory for a group: nights, room types, rate expectation, and the displacement it would cause.",
  "description": "An original internal request to create a guest-room block. It captures requester routing, the group profile and the pattern of nights and room types requested, the rooms-control screen against forecast and displacement, the hold decision with rate and cutoff, unresolved conditions, and the handoff into a room block order.",
  "use_case": "Use when a seller needs rooms control to hold sleeping-room inventory for a group before a rate is quoted. The request closes when rooms control has decided, the hold and cutoff are recorded, and either a block order is raised or the request is declined.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "request_routing",
      "title": "Block request routing",
      "guidance": "Name the requester, the group, and who decides.",
