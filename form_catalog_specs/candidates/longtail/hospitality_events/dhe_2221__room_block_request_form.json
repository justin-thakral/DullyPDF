            },
            {
              "key": "comp_ratio",
              "label": "Complimentary ratio",
              "units": 1.2
            },
            {
              "key": "block_order_number",
              "label": "Block order number",
              "units": 1.25
            }
          ]
        },
        {
          "key": "request_boundary",
          "type": "notice",
          "label": "Scope of this request",
          "guidance": "This request records the pattern asked for and what rooms control decided to hold. It is not a contract, a rate guarantee, or a commitment on attrition, cancellation, or comp terms. The signed agreement governs those terms; route rate, attrition, and credit questions to the responsible manager before quoting them to the group."
        }
      ]
    },
    {
      "key": "request_exceptions",
      "title": "Unresolved conditions and escalation",
      "guidance": "Peak-night gaps are the usual reason a block fails later.",
      "blocks": [
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Exception triggers",
          "items": [
            "Requested rooms exceed available inventory on a peak night",
            "Accessible room request cannot be met from current inventory",
            "Requested rate is below the strategy floor for those dates",
            "Connecting or suite request cannot be met",
            "Cutoff date requested is inside the standard window",
            "Complimentary ratio requested exceeds venue standard",
            "Group cannot confirm a reservation method",
            "Credit or master-account approval unresolved"
          ]
        },
        {
