              "key": "incident_type",
              "label": "What happened",
              "units": 1.7,
              "field_type": "choice",
              "options": [
                "Not yet classified",
                "Guest walked to another property",
                "Guest relocated within the property",
                "Block oversold against inventory",
                "Accessible room not delivered",
                "Connecting rooms not delivered",
                "Reservation missing at arrival",
                "Rate charged differs from the block rate",
                "Charges routed to the wrong account",
                "Attrition or no-show charge disputed",
                "Rooming list not honored",
                "Room not ready at arrival"
              ]
            },
            {
              "key": "severity",
              "label": "Assessed severity",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Pending assessment",
                "Minor - resolved at desk",
                "Moderate - guest inconvenienced",
                "Major - guest displaced",
                "Critical - group relationship"
              ]
            }
          ]
        }
      ]
    },
