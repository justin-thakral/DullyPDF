              ]
            },
            {
              "key": "approval_reference",
              "label": "Approval reference",
              "units": 1.05
            }
          ]
        },
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Stop conditions and authority boundary",
          "guidance": "Route to the responsible manager before turning any guest away, before reassigning a committed accessible room, and before reversing or waiving a contracted charge. This report does not interpret the group agreement, determine liability, decide an accessibility obligation, or authorize compensation beyond the approver's limit, and it does not replace the review applicable policy requires."
        },
