              "key": "incident_type",
              "label": "What went wrong",
              "units": 1.7,
              "field_type": "choice",
              "options": [
                "Not yet classified",
                "Double-sold hold or space",
                "Hold released in error",
                "Response window missed",
                "Rate or minimum misquoted",
                "Headcount or setup recorded wrong",
                "Accessibility request not recorded",
                "Allergen request not recorded",
                "Deposit or billing routed wrong",
                "Same inquiry sold twice",
                "Recorded against the wrong client"
              ]
            },
            {
              "key": "severity",
