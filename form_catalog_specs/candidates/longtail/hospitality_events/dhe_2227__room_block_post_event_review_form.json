              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Unknown",
                "Rebooked already",
                "Likely - same terms",
                "Likely - revised terms",
                "Unlikely",
                "Will not return"
              ]
            },
            {
              "key": "next_contact_due",
              "label": "Next contact due",
              "units": 1.05
            }
          ]
        },
        {
          "key": "group_feedback",
          "type": "textarea",
          "label": "Group feedback and what was promised in response",
          "fields": [
            {
              "key": "feedback_detail",
              "label": "Group feedback record"
            }
          ],
          "height": 58,
          "guidance": "Record what was said and who said it. Do not record health information or judgments about individual staff."
        },
        {
          "key": "review_boundary",
          "type": "notice",
          "label": "Record boundary for this review",
          "guidance": "This review is an internal commercial and operating record. It does not settle an attrition or billing dispute, determine liability for an incident, evaluate an individual employee, or authorize compensation. Route account adjustments, contract questions, and personnel matters to the responsible manager under applicable policy."
        }
      ]
    },
    {
      "key": "review_findings",
      "title": "Findings requiring action and escalation",
      "guidance": "Terms that did not work should not be repeated by default.",
      "blocks": [
        {
          "key": "escalation_triggers",
          "type": "checklist",
          "label": "Escalation triggers",
          "items": [
            "A guest from the block was relocated or turned away",
            "A committed accessible room was not delivered",
            "Pickup fell materially below the contracted pattern",
            "Attrition is chargeable and the group is disputing it",
            "Displacement of higher-rated demand exceeded the estimate",
            "An open incident report from this stay is unresolved",
            "The same failure appeared on a prior stay by this group"
          ]
        },
        {
