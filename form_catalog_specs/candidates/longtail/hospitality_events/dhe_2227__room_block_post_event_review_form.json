        },
        {
          "key": "performance_findings",
          "type": "checklist",
          "label": "Performance findings",
          "items": [
            "Rooming list arrived by the contracted due date",
            "Every guest had a reservation on arrival",
            "Every committed accessible room was delivered",
            "No guest from the block was relocated or turned away",
            "Rooms were ready at the agreed check-in time",
            "Billing routing held through the stay without desk corrections",
            "Group contact had a single named point of contact throughout"
          ]
        },
