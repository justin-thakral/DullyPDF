          ]
        },
        {
          "key": "billing_checks",
          "type": "checklist",
          "label": "Billing checks",
          "items": [
            "Consumed nights reconciled to the night audit records",
            "No-show and early-departure charges applied per the agreement",
            "Attrition position calculated against the contracted pattern",
            "Master account charges reconciled against the billing route",
            "Complimentary rooms applied at the contracted ratio",
            "Approved incident remedies and adjustments applied with references",
            "Final account reviewed with the group contact"
          ]
        }
      ]
    },
    {
      "key": "stay_performance",
      "title": "Arrival and service performance",
      "guidance": "The block can meet its numbers and still deliver a bad stay.",
