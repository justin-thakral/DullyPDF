        {
          "key": "emergency_boundary",
          "type": "notice",
          "label": "Emergency and service boundary",
          "guidance": "Address urgent needs first under applicable procedures. This report does not determine intoxication, diagnose a condition, establish age, or replace individual service judgment. Do not delay assistance or keep serving while an unresolved concern is being documented; stop and route it to the responsible role."
        }
      ]
    },
