{
  "schema_version": 1,
  "catalog_id": "hospitality_events/dhe_2240__lost_and_found_sign_in_sheet_form",
  "source_section": "hospitality_events",
  "source_filename": "dhe_2240__lost_and_found_sign_in_sheet_form.pdf",
  "slug": "lost-and-found-sign-in-sheet-form",
  "title": "Lost and Found Sign-In Sheet Form",
  "subtitle": "Log every entry to the storage area and every signature that moves property, so custody can be reconstructed from one sheet.",
  "description": "An original access and custody signature log for a lost-and-found storage area. It records the log period and access control basis, every entry to the area with reason and items touched, the release signature log, dual-control events for cash and valuables, access exceptions, and an accountable period closeout.",
  "use_case": "Use as the running access and signature record for a storage area, so that when an item cannot be found the venue can say exactly who was in the room and what they moved. The log closes at the end of the period with every entry signed out.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "log_identity",
      "title": "Log period and access basis",
      "guidance": "State who is allowed in and how the area is secured.",
      "blocks": [
        {
          "key": "log_routing",
          "type": "fields",
          "label": "Log identity and routing",
          "fields": [
            {
              "key": "sheet_id",
              "label": "Sheet record ID",
              "units": 0.95
            },
            {
              "key": "period_start",
              "label": "Period start",
              "units": 0.85
            },
            {
              "key": "period_end",
              "label": "Period end",
              "units": 0.85
            },
            {
              "key": "storage_location",
              "label": "Storage location",
              "units": 1.2
            },
            {
              "key": "log_owner",
              "label": "Storage owner",
              "units": 1.0
            }
          ]
        },
        {
          "key": "access_basis",
          "type": "fields",
          "label": "Access control basis",
          "fields": [
            {
              "key": "access_method",
              "label": "Access method",
              "units": 1.25,
              "field_type": "choice",
              "options": [
                "Not set",
                "Key held at the desk",
                "Coded lock",
                "Card access",
                "Escorted access only"
              ]
            },
            {
              "key": "authorized_count",
              "label": "People on access list",
              "units": 1.55
            },
            {
              "key": "list_reviewed",
              "label": "Access list reviewed",
              "units": 1.4
            },
            {
              "key": "camera_coverage",
              "label": "Camera coverage",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "access_register",
      "title": "Storage access register",
      "guidance": "One row per entry, signed out before leaving.",
      "blocks": [
        {
          "key": "access_rows",
          "type": "table",
          "label": "Access register",
          "columns": [
            {
              "key": "name",
              "label": "Name",
              "units": 1.1
            },
            {
              "key": "role",
              "label": "Role",
              "units": 0.85
            },
            {
              "key": "time_in",
              "label": "In",
              "units": 0.55
            },
            {
              "key": "time_out",
              "label": "Out",
              "units": 0.55
            },
            {
              "key": "reason",
              "label": "Reason for entry",
              "units": 1.3
            },
            {
              "key": "tags_touched",
              "label": "Tags touched",
              "units": 0.9
            }
          ],
          "rows": 12,
          "guidance": "Recording which tags were handled is what makes this log useful after a discrepancy."
        },
        {
          "key": "access_totals",
          "type": "fields",
          "label": "Access reconciliation",
          "fields": [
            {
              "key": "entries_logged",
              "label": "Entries logged",
              "units": 1.15
            },
            {
              "key": "all_signed_out",
