              "key": "released_by",
              "label": "Released by",
              "units": 1.05
            },
            {
              "key": "signature",
              "label": "Signature",
              "units": 0.9
            }
          ],
          "rows": 8
        },
        {
          "key": "release_controls",
          "type": "checklist",
          "label": "Release controls",
          "items": [
            "Every release has an approved release order reference",
            "Ownership check recorded before the item left storage",
            "Recipient signed at the point of handover",
            "Shipped items recorded with a tracking reference instead of a signature",
            "Restricted item classes released only with manager authorization",
            "Storage register updated so the tag no longer shows as held"
          ]
        }
      ]
    },
    {
      "key": "dual_control",
      "title": "Dual-control events",
      "guidance": "Cash, valuables, and disposals need two people.",
      "blocks": [
        {
          "key": "dual_rows",
          "type": "table",
          "label": "Dual-control event log",
