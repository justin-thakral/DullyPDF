            },
            {
              "key": "first_person",
              "label": "First person",
              "units": 1.1
            },
            {
              "key": "second_person",
              "label": "Second person",
              "units": 1.15
            },
            {
              "key": "outcome",
              "label": "Outcome recorded",
              "units": 1.25
            }
          ],
          "rows": 6
        },
        {
          "key": "dual_notes",
          "type": "textarea",
          "label": "Anything observed during a dual-control event that needs following up",
          "fields": [
            {
              "key": "dual_detail",
              "label": "Dual-control observations"
            }
          ],
          "height": 52
        }
      ]
    },
    {
      "key": "access_exceptions",
      "title": "Access exceptions and escalation",
      "guidance": "An unexplained entry is the earliest warning available.",
      "blocks": [
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Exception triggers",
          "items": [
            "An entry has no sign-out time",
            "Someone not on the access list entered the area",
            "The area was found unlocked or open",
            "A cash or valuables event was completed by one person",
            "An item left storage without a release order reference",
            "A recipient refused or was not asked to sign",
            "Tags touched during an entry were not recorded",
            "Camera coverage was obstructed or unavailable"
          ]
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Access exception register",
          "columns": [
            {
              "key": "exception",
              "label": "Exception",
              "units": 1.2
            },
            {
              "key": "action_taken",
              "label": "Action taken",
              "units": 1.15
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "escalated_to",
              "label": "Escalation route",
              "units": 0.95
            },
            {
              "key": "disposition",
              "label": "Disposition",
              "units": 1.1
            }
          ],
          "rows": 4
        },
        {
          "key": "log_boundary",
          "type": "notice",
          "label": "Purpose and limits of this log",
          "guidance": "This log exists to reconstruct who was in the storage area and what moved. It is not an accusation of anyone recorded in it, a performance record, or proof that an item was or was not taken. Restrict access to it, retain it only as applicable privacy and retention policy allows, and route any unexplained entry or missing item to the responsible manager on an incident record."
        }
      ]
    },
    {
      "key": "log_closeout",
      "title": "Period closeout and handoff",
      "guidance": "Close the period with every entry and release accounted for.",
      "blocks": [
        {
          "key": "closeout_status",
          "type": "fields",
          "label": "Period closeout",
          "fields": [
            {
              "key": "final_status",
              "label": "Final status",
              "units": 1.25,
              "field_type": "choice",
              "options": [
                "Open",
                "Closed - all accounted",
                "Closed with exception",
                "Transferred"
              ]
            },
            {
              "key": "closed_at",
              "label": "Closed at",
              "units": 0.8
            },
            {
              "key": "verified_by",
              "label": "Verified by",
              "units": 1.0
            },
            {
              "key": "record_location",
              "label": "Record location",
              "units": 1.05
            },
            {
              "key": "next_owner",
              "label": "Next accountable owner",
              "units": 1.15
            }
          ]
        },
        {
          "key": "handoff_confirmations",
          "type": "checklist",
          "label": "Handoff confirmations",
          "items": [
            "Every access row has a matching sign-out time",
            "Every release row has an order reference and a signature or tracking",
