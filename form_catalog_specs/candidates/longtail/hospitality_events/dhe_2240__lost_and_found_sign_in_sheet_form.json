              "units": 1.15
            },
            {
              "key": "escorted_entries",
              "label": "Escorted entries",
              "units": 1.25
            },
            {
              "key": "unlisted_entries",
              "label": "Entries off the list",
              "units": 1.5
            }
          ]
        }
      ]
    },
    {
      "key": "release_signatures",
      "title": "Property release signature log",
      "guidance": "Every item that leaves has a name against it.",
      "blocks": [
        {
          "key": "release_rows",
          "type": "table",
          "label": "Release signature log",
          "columns": [
            {
              "key": "tag_number",
              "label": "Tag",
              "units": 0.6
            },
            {
              "key": "item",
