      "guidance": "Translate reviewed requirements into observable station controls.",
      "blocks": [
        {
          "key": "service_controls",
          "type": "checklist",
          "label": "Operating controls",
          "items": [
            "Current order and escalation contacts are at each station",
            "Age-verification process from applicable policy is briefed",
            "Service-refusal and manager-escalation route is briefed",
            "Nonalcoholic choices and water are visible and available",
            "Hosted limits, tickets, or payment model are configured",
            "Guest flow and accessible route remain unobstructed",
            "Product, cash, key, and device custody owners are assigned",
            "Incident-reporting route is available to the team",
            "Last-service and station-close cues are assigned"
          ]
        },
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Service-order authority boundary",
          "guidance": "This order communicates decisions already reviewed by the responsible role. It does not itself grant a license, determine age, direct service to a specific guest, or replace professional judgment and applicable policy. Staff should stop and escalate an unresolved service, identification, safety, or guest concern."
        }
