          "height": 72
        },
        {
          "key": "intake_boundary",
          "type": "notice",
          "label": "Record boundary at intake",
          "guidance": "Record only the facts needed to handle this case: what happened, when, where, who was involved, and what the venue did. Do not record a diagnosis, a medical history, treatment detail, an opinion about cause, an admission of fault, or a statement about staff discipline. Collect the minimum contact detail needed to complete follow-up and handle it under applicable privacy and retention policy."
        }
      ]
    },
    {
      "key": "urgency_triage",
      "title": "Urgency triage and immediate safety",
      "guidance": "Some requests cannot wait for a case to be assigned.",
      "blocks": [
        {
          "key": "triage_checks",
          "type": "checklist",
          "label": "Triage checks at intake",
          "items": [
            "Asked whether anyone needs medical attention now",
            "Offered to call emergency services and recorded the response",
            "Checked whether the hazard or condition is still present on site",
            "Notified the manager on duty where a hazard is still present",
            "Confirmed whether an incident report already exists for this event",
            "Checked whether the guest is still on property",
            "Asked whether the guest has a mobility or access need for follow-up",
            "Confirmed whether other guests were affected"
          ],
          "guidance": "Intake staff record and route. They do not assess injury or give any medical guidance."
        },
