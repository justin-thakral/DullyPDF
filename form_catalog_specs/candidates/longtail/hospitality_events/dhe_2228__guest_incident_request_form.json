        },
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Stop conditions and authority boundary",
          "guidance": "Stop and involve the responsible manager immediately when anyone may need medical attention, when a hazard is still present, when a guest alleges injury, or when the request involves an insurance claim or a legal demand. This request does not accept liability, admit fault, authorize compensation, or commit the venue to any remedy, and it does not replace the review that applicable policy requires."
        },
        {
          "key": "decision_rationale",
          "type": "textarea",
          "label": "Why the case was accepted, referred, or declined, and what the requester was told",
          "fields": [
            {
              "key": "rationale_detail",
              "label": "Acceptance rationale"
            }
          ],
          "height": 50
        }
      ]
