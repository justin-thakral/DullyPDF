      "guidance": "A case opened on incomplete facts stays visible here.",
      "blocks": [
        {
          "key": "gap_triggers",
          "type": "checklist",
          "label": "Information gap triggers",
          "items": [
            "The date, time, or location of the incident is not established",
            "It is unclear whether the incident occurred on venue property",
            "No staff member witnessed or was told about it at the time",
            "The guest has left and cannot currently be reached",
            "The requester is not the guest and consent to discuss is unclear",
            "Property described cannot be identified or located",
            "Charges disputed cannot be matched to a folio",
            "Camera, log, or maintenance evidence may already be overwritten"
          ]
        },
