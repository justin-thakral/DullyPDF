          "key": "condition_checks",
          "type": "checklist",
          "label": "Condition closure checks",
          "items": [
            "Every condition recorded in the report has a disposition here",
            "Permanent fix verified in place, not only ordered",
            "Interim controls removed only after the permanent fix was verified",
            "Inspection or cleaning frequency reviewed for the location",
            "Signage or layout change considered where the condition can recur",
            "Similar locations checked for the same condition",
            "Maintenance history for the location reviewed for earlier warnings"
          ]
        }
