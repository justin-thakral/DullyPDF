        },
        {
          "key": "review_boundary",
          "type": "notice",
          "label": "Record boundary for this review",
          "guidance": "This review is an internal prevention record. It does not determine the cause of an injury or illness, decide liability, evaluate an individual employee, settle a claim, or authorize compensation. Where a claim is open, route the review through the responsible manager before it is shared, and keep it under applicable privacy, retention, and insurance policy."
        }
      ]
