            },
            {
              "key": "checked_by",
              "label": "Checked by",
              "units": 1.0
            }
          ],
          "rows": 4
        },
        {
          "key": "handoff_confirmations",
          "type": "checklist",
          "label": "Handoff confirmations",
          "items": [
            "Set variances either corrected or recorded as accepted",
            "Exit path status confirmed and recorded before doors opened",
            "Holding readings and actions filed with the function record",
            "Dietary plan confirmation obtained from the chef on duty",
            "Open findings transferred to the captain with named owners",
            "Walk record retained as required by applicable policy"
          ]
        },
        {
          "key": "handoff_notes",
