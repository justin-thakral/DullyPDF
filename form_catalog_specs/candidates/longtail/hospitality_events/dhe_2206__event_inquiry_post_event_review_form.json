            {
              "key": "next_contact_due",
              "label": "Next contact due",
              "units": 1.0
            },
            {
              "key": "referral_asked",
              "label": "Referral asked",
              "units": 0.9,
              "field_type": "choice",
              "options": [
                "Not asked",
                "Yes",
                "No"
              ]
            }
          ]
        },
        {
          "key": "client_feedback",
          "type": "textarea",
          "label": "Client feedback in the client's own terms",
          "fields": [
            {
              "key": "feedback_detail",
              "label": "Client feedback record"
            }
          ],
          "height": 58,
          "guidance": "Record what was said and who said it. Do not record health information, judgments about individual staff, or commitments the venue has not approved."
        },
        {
          "key": "review_boundary",
          "type": "notice",
          "label": "Record boundary for this review",
          "guidance": "This review is an internal learning record. It does not settle a billing dispute, determine liability for an incident, evaluate an individual employee, or authorize compensation. Route pricing adjustments, claims, and personnel matters to the responsible manager under applicable policy."
        }
      ]
    },
    {
      "key": "review_findings",
      "title": "Findings requiring action and escalation",
      "guidance": "A finding without an owner is an observation, not an improvement.",
      "blocks": [
        {
          "key": "escalation_triggers",
          "type": "checklist",
          "label": "Escalation triggers",
          "items": [
            "A requirement captured at inquiry was never delivered",
            "An accessibility or allergen request was lost between inquiry and delivery",
            "Revenue fell materially below the inquiry forecast",
            "A hold was released or a date lost through process failure",
            "The client raised a complaint that is still open",
            "An incident report from this event is still open",
            "The same finding has appeared in a prior review"
          ]
        },
        {
