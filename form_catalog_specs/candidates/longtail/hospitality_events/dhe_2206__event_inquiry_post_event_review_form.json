              "key": "proposal_revisions",
              "label": "Proposal revisions",
              "units": 1.05
            }
          ]
        },
        {
          "key": "process_findings",
          "type": "checklist",
          "label": "Process findings",
          "items": [
            "Response window met at first contact",
            "Qualification review completed before the quote was issued",
            "Feasibility confirmations obtained from every owning role",
            "Hold expiry managed without an unplanned release",
            "Turnover to operations acknowledged by every department",
            "Open conditions at turnover were closed before the event"
          ]
        },
        {
          "key": "process_notes",
          "type": "textarea",
          "label": "Where the process worked, where it leaked, and what it cost",
          "fields": [
            {
              "key": "process_detail",
              "label": "Process performance detail"
            }
          ],
          "height": 52
        }
      ]
    },
    {
      "key": "client_outcome",
      "title": "Client outcome and repeat potential",
      "guidance": "Record what the client said, not what the team hopes they meant.",
      "blocks": [
