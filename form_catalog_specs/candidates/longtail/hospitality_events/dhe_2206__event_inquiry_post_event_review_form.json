{
  "schema_version": 1,
  "catalog_id": "hospitality_events/dhe_2206__event_inquiry_post_event_review_form",
  "source_section": "hospitality_events",
  "source_filename": "dhe_2206__event_inquiry_post_event_review_form.pdf",
  "slug": "event-inquiry-post-event-review-form",
  "title": "Event Inquiry Post-Event Review Form",
  "subtitle": "After the event, compare what the inquiry captured against what was delivered, and record what the sales process should change.",
  "description": "An original post-event review that closes the loop on an inquiry. It reconciles what was recorded at inquiry against what was actually delivered, measures the inquiry process itself, records the client outcome and repeat potential, opens actions for findings that need work, and captures the learning that should change the next inquiry.",
  "use_case": "Use after an event that originated from this inquiry, when sales and event services need to know whether the inquiry captured reality and where the process leaked. The review closes when every finding has an owner and the learning has been recorded where the next seller will actually see it.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "review_identity",
      "title": "Review identity and routing",
      "guidance": "Bind the review to the inquiry, the order, and the delivered event.",
      "blocks": [
