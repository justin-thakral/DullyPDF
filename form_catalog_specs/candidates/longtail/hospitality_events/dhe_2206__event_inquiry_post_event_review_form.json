              "units": 1.0
            }
          ]
        }
      ]
    },
    {
      "key": "sold_versus_delivered",
      "title": "Recorded at inquiry versus delivered",
      "guidance": "Compare the inquiry record with what the event actually became.",
      "blocks": [
        {
          "key": "variance_matrix",
          "type": "table",
          "label": "Inquiry-to-delivery variance matrix",
          "columns": [
            {
              "key": "element",
              "label": "Element",
              "units": 1.0
            },
            {
              "key": "at_inquiry",
              "label": "Recorded at inquiry",
              "units": 1.15
            },
            {
              "key": "delivered",
              "label": "Actually delivered",
              "units": 1.15
            },
            {
              "key": "cause",
              "label": "Variance cause",
              "units": 1.1
            },
            {
              "key": "revenue_effect",
              "label": "Revenue effect",
              "units": 0.9
            }
          ],
          "rows": 6,
          "guidance": "Cover space, headcount, setup, food and beverage, and any accommodation captured at inquiry."
        },
        {
          "key": "quantitative_variance",
          "type": "fields",
          "label": "Quantitative variance",
          "fields": [
            {
              "key": "headcount_inquiry",
              "label": "Headcount at inquiry",
              "units": 1.1
            },
            {
              "key": "headcount_final",
              "label": "Headcount delivered",
              "units": 1.1
            },
            {
              "key": "revenue_forecast",
              "label": "Revenue forecast",
              "units": 1.0
            },
            {
              "key": "revenue_actual",
              "label": "Revenue actual",
              "units": 0.95
            },
            {
              "key": "variance_percent",
              "label": "Variance percent",
              "units": 1.0
            }
          ]
        },
        {
          "key": "accuracy_checks",
          "type": "checklist",
          "label": "Inquiry accuracy checks",
          "items": [
            "Spaces requested at inquiry matched the spaces delivered",
            "Headcount basis at inquiry was within tolerance of the guaranteed count",
            "Every service flagged at inquiry appeared on the order",
            "Accessibility requests captured at inquiry were delivered",
            "Allergen and dietary requests captured at inquiry reached the culinary team",
            "Rate quoted at inquiry matched the contracted rate",
            "Load-in window discussed at inquiry matched what operations delivered"
          ]
        }
      ]
    },
    {
      "key": "process_performance",
      "title": "Inquiry process performance",
      "guidance": "Measure the process, not only the outcome.",
      "blocks": [
        {
          "key": "process_metrics",
          "type": "fields",
          "label": "Process metrics",
          "fields": [
