          "fields": [
            {
              "key": "feedback_detail",
              "label": "Client feedback record"
            }
          ],
          "height": 58,
          "guidance": "Record what was said and who said it. Do not record health information or judgments about individual staff."
        },
        {
          "key": "review_boundary",
          "type": "notice",
          "label": "Record boundary for this review",
          "guidance": "This review is an internal operating and billing record. It does not settle a billing dispute, determine liability for an incident, evaluate an individual employee, or authorize compensation. Route invoice adjustments, claims, and personnel matters to the responsible manager under applicable policy."
        }
      ]
    },
    {
      "key": "review_findings",
      "title": "Findings requiring action and escalation",
      "guidance": "The site surprises repeat unless someone owns them.",
      "blocks": [
        {
          "key": "escalation_triggers",
          "type": "checklist",
          "label": "Escalation triggers",
          "items": [
            "A temperature reading outside the venue standard was recorded",
            "A restricted portion could not be confirmed as correctly handed over",
            "Actual cost exceeded the quote beyond the accepted tolerance",
            "An open incident report from this delivery is unresolved",
            "The client complaint is still open at review",
            "Returnable equipment is still missing at review",
            "The same site problem has appeared on a prior delivery"
          ]
        },
