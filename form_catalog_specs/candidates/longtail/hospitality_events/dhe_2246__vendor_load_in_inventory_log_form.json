              "units": 1.05
            }
          ]
        },
        {
          "key": "intake_requirements",
          "type": "checklist",
          "label": "Ledger setup checks",
          "items": [
            "Vendor packing list or expected-unit list is attached",
            "Reusable cases, carts, pallets, and rentals are included",
            "High-value or fragile units are separately identifiable",
            "Keys, badges, passes, and access devices are included",
            "Starting condition evidence is linked where needed",
            "Return or strike ownership and timing are recorded"
          ]
        }
      ]
    },
