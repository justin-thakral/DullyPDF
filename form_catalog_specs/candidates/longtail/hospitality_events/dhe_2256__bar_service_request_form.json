  "source_filename": "dhe_2256__bar_service_request_form.pdf",
  "slug": "bar-service-request-form",
  "title": "Bar Service Request Form",
  "subtitle": "Scope a proposed beverage service, route licensing and responsible-service decisions, test venue feasibility, and hand an approved request to ordering.",
  "description": "An original bar-service intake record for event schedule, attendance, service model, beverage preferences, nonalcoholic program, station needs, venue constraints, responsible-role review, exceptions, and proposal handoff.",
  "use_case": "Use when a client or event planner requests hosted, cash, ticketed, or limited beverage service. Record preferences without promising service, route licensing and policy checks to the responsible role, and close when the request is declined or linked to an authorized bar service order.",
  "risk_tier": "B",
