              "label": "Review date",
              "units": 0.8
            }
          ]
        },
        {
          "key": "service_boundary",
          "type": "notice",
          "label": "Request-stage authority boundary",
          "guidance": "This request records a proposed service only. It does not confirm licensing, authorize alcohol service, establish age-verification or refusal decisions, certify ingredients, or promise a service period. The responsible role must review applicable requirements and issue the authorized order before service."
        }
      ]
    },
    {
