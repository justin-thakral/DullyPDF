    {
      "key": "venue_feasibility",
      "title": "Venue feasibility and responsible-role review",
      "guidance": "Screen locations and operating dependencies before a proposal is issued.",
      "blocks": [
        {
          "key": "feasibility_checks",
          "type": "checklist",
          "label": "Feasibility review",
          "items": [
            "Requested service period reviewed against event schedule",
            "Service locations reviewed with venue operations",
            "Station footprint, guest flow, and accessible route reviewed",
            "Water, power, ice, storage, and waste needs reviewed",
            "Delivery, secure storage, and return custody assigned",
            "Responsible-service staffing basis routed for review",
            "Applicable licensing, permit, and venue-policy checks routed",
            "Payment, cash, or point-of-sale needs routed",
            "Final-service time and closeout window routed"
