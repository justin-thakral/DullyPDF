      "key": "count_variances",
      "title": "Count variances, exceptions, and escalation",
      "guidance": "A variance is escalated, never adjusted away.",
      "blocks": [
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Exception triggers",
          "items": [
            "A tagged item in the log cannot be found in storage",
            "An item in storage has no matching log entry",
            "Cash closing balance does not reconcile",
            "An item is past its holding period with no disposition decision",
            "An item was disposed of before its holding period ended",
            "A release has no ownership check recorded",
            "Storage access log shows an entry outside the access list",
            "A high-value item is held outside the safe"
          ]
        },
        {
          "key": "variance_register",
