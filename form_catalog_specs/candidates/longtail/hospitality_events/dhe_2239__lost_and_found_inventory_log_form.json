            },
            {
              "key": "period_end",
              "label": "Period end",
              "units": 0.85
            },
            {
              "key": "log_owner",
              "label": "Storage owner",
              "units": 1.0
            },
            {
              "key": "counted_by",
              "label": "Counted by",
              "units": 0.95
            }
          ]
        },
