              "label": "Disposition",
              "units": 1.1
            }
          ],
          "rows": 4
        },
        {
          "key": "inventory_boundary",
          "type": "notice",
          "label": "What this log does not decide",
          "guidance": "This log records what is held, for how long, and what happened to it. It does not value property, transfer ownership, authorize destruction of documents or medication, or settle a claim for a missing item. Any unexplained variance goes to the responsible manager on an incident record rather than being corrected in this log."
        }
      ]
    },
