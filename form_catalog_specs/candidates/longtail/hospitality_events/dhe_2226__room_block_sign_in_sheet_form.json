      "title": "Exceptions and escalation",
      "guidance": "Desk failures are recorded here, not absorbed at the counter.",
      "blocks": [
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Exception triggers",
          "items": [
            "A guest arrived with no reservation in the block",
            "A room was not ready when the guest arrived",
            "A committed accessible room could not be issued",
            "A guest was relocated or turned away",
            "A guest was charged a rate other than the block rate",
            "Charges were routed to the wrong account at check-in",
            "Keys were issued for the wrong room",
            "A rooming-list line had no arrival and no explanation"
          ],
          "guidance": "A relocated or turned-away guest is routed on the incident record, not resolved on this sheet."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception register",
          "columns": [
            {
              "key": "exception",
              "label": "Exception",
              "units": 1.2
            },
            {
              "key": "action_taken",
              "label": "Action taken",
              "units": 1.15
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "disposition",
