              "key": "reference",
              "label": "Reference",
              "units": 1.0
            },
            {
              "key": "held_by",
              "label": "Held by",
              "units": 1.1
            },
            {
              "key": "status",
              "label": "Status",
              "units": 1.0
            }
          ],
          "rows": 5,
          "guidance": "Link the response checklist, remediation order, witness register, property log, and any maintenance work order."
        },
        {
          "key": "closeout_confirmations",
          "type": "checklist",
          "label": "Closeout confirmations",
          "items": [
            "Sequence, conditions, and guest account recorded without conclusions",
            "Photographs and footage confirmed as retained and referenced",
            "Witness details recorded and the witness register linked",
            "Referrals made and recorded per applicable policy",
            "Corrective work order raised where a condition contributed",
            "Access restricted to the roles that need it",
            "Retention period set under applicable privacy and retention policy"
          ]
        },
        {
          "key": "closeout_notes",
