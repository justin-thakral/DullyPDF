    {
      "key": "service_closeout",
      "title": "Restoration, handoff, and service closeout",
      "guidance": "Confirm the RTU, roof, records, and customer communication are complete.",
      "blocks": [
        {
          "key": "departure_checklist",
          "type": "checklist",
          "label": "Departure and restoration checks",
          "items": [
            "Disconnect left in authorized state",
            "Locks and tags cleared or transferred",
            "All panels and fasteners secured",
            "Tools, rags, and replaced parts removed",
            "Roof membrane protected and debris removed",
            "Access hatch, ladder, gate, and keys secured",
            "Active alarms communicated",
            "Facility contact briefed",
            "Service report and evidence uploaded",
            "Open repair item assigned"
          ]
        },
        {
          "key": "completion_record",
          "type": "fields",
          "label": "Completion and handoff",
          "fields": [
            {
              "key": "departure_time",
              "label": "Departure time",
              "units": 0.6
            },
            {
              "key": "labor_hours",
              "label": "Total labor hours",
              "units": 0.7
            },
            {
              "key": "report_recipient",
              "label": "Report delivered to",
              "units": 1.0
            },
            {
              "key": "customer_notification",
