    {
      "key": "prework_control",
      "title": "Pre-work condition and safety control",
      "guidance": "Capture baseline operation and establish safe access before maintenance begins.",
      "blocks": [
        {
          "key": "site_conditions",
          "type": "fields",
          "label": "Roof and operating conditions",
          "fields": [
            {
              "key": "weather",
              "label": "Weather and roof condition",
              "units": 1.15
            },
            {
              "key": "outdoor_temperature",
              "label": "Outdoor temperature",
              "units": 0.75
            },
            {
              "key": "operating_mode",
              "label": "Mode on arrival",
              "units": 0.85,
              "field_type": "choice",
              "options": [
                "Cooling",
                "Heating",
                "Ventilation",
                "Standby",
                "Off",
                "Alarm or lockout"
              ]
            },
            {
              "key": "active_alarm",
              "label": "Active alarm or complaint",
              "units": 1.15
            }
          ]
        },
        {
          "key": "safety_controls",
          "type": "checklist",
          "label": "Pre-work safety controls completed",
          "items": [
            "Roof access authorized",
            "Walking path and fall hazards assessed",
            "Required PPE and fall protection used",
            "Work area protected from dropped objects",
            "Disconnect identified",
            "Energy sources identified",
            "Lockout or tagout applied when required",
            "Absence of voltage verified when required",
            "Stored mechanical energy controlled",
            "Hot surfaces and sharp edges identified",
            "Chemical SDS available when products are used",
            "Emergency communication available"
          ]
        },
        {
          "key": "isolation_record",
          "type": "fields",
          "label": "Isolation and authorization record",
          "fields": [
            {
              "key": "disconnect_state",
              "label": "Disconnect state",
              "units": 0.9,
              "field_type": "choice",
              "options": [
                "Energized observation",
                "De-energized",
                "Locked and tagged",
                "Qualified live test",
                "Work stopped"
              ]
            },
            {
              "key": "lock_tag_number",
              "label": "Lock or tag number",
              "units": 0.75
            },
            {
              "key": "isolation_by",
              "label": "Isolation performed by",
              "units": 1.0
            },
            {
              "key": "authorization",
              "label": "Authorization or permit",
              "units": 1.0
            },
            {
              "key": "baseline_photo_set",
              "label": "Baseline photo set",
              "units": 0.9
            }
          ]
        },
        {
          "key": "preexisting_condition",
          "type": "textarea",
          "label": "Pre-existing damage, alarm history, tenant complaint, unusual noise, leak evidence, or access limitation",
          "fields": [
            {
              "key": "preexisting_condition_detail",
              "label": "Pre-existing condition and limitation detail"
            }
          ],
          "height": 160
        },
        {
          "key": "maintenance_scope_boundary",
          "type": "notice",
          "label": "Maintenance scope boundary",
          "guidance": "This preventive maintenance visit does not authorize repair work or make deferred safety or service issues acceptable. Stop and obtain approval whenever work exceeds the assigned scope."
        }
      ]
    },
    {
      "key": "maintenance_execution",
      "title": "Planned maintenance tasks performed",
      "guidance": "Mark only work completed during this visit and explain deferred or inaccessible items.",
      "blocks": [
        {
          "key": "airside_tasks",
          "type": "checklist",
          "label": "Airside and condensate maintenance performed",
          "items": [
            "Filters inspected",
            "Filters replaced",
            "Filter rack and bypass gaps corrected",
            "Indoor coil inspected",
            "Indoor coil cleaned as authorized",
            "Drain pan cleaned",
            "Condensate trap and line cleared",
            "Blower wheel inspected",
            "Blower wheel cleaned as authorized",
            "Belts inspected and adjusted",
            "Belt replaced",
            "Pulleys aligned and secured",
            "Bearings inspected or lubricated",
            "Supply and return connection condition checked"
          ]
        },
        {
          "key": "outdoor_mechanical_tasks",
          "type": "checklist",
          "label": "Outdoor and mechanical maintenance performed",
          "items": [
            "Outdoor coil inspected",
            "Outdoor coil cleaned as authorized",
            "Condenser fan blades and guards checked",
            "Motor mounts and vibration isolation checked",
            "Cabinet panels and weather seals checked",
            "Fasteners tightened",
            "Corrosion condition documented",
            "Refrigerant piping supports checked",
            "Visible oil or refrigerant evidence checked",
            "Economizer dampers and linkage exercised",
            "Outdoor-air screens cleaned",
            "Powered exhaust or relief components checked"
          ]
        },
        {
          "key": "electrical_control_tasks",
          "type": "checklist",
          "label": "Electrical, controls, and heating tasks performed within authorization",
          "items": [
            "Electrical compartment visually inspected",
            "Terminations checked as authorized",
            "Contactors and relays inspected",
            "Capacitors inspected or tested",
            "Control transformer and wiring checked",
            "Thermostat or BAS command checked",
            "Sensors inspected",
            "Alarm history reviewed",
            "Safety controls identified or tested as authorized",
            "Burner and heat exchanger area visually inspected",
            "Ignition and flame signal checked as authorized",
            "Electric heat components visually inspected"
          ]
        },
        {
          "key": "task_exception",
          "type": "textarea",
          "label": "Required PM task not completed, reason, risk, temporary control, approver, and reschedule commitment",
          "fields": [
            {
              "key": "task_exception_detail",
              "label": "Deferred task and escalation detail"
            }
          ],
          "height": 64
        }
      ]
    },
    {
      "key": "materials_parts",
