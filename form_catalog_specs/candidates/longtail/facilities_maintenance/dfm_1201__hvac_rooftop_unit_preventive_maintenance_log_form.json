            {
              "key": "cleaner",
              "label": "Cleaner and dilution",
              "units": 0.95
            }
          ]
        },
        {
          "key": "evidence_checklist",
          "type": "checklist",
          "label": "Maintenance evidence retained",
          "items": [
            "Nameplate image",
            "Before-condition photos",
            "After-condition photos",
            "Filter or belt label image",
            "Instrument readings",
            "Alarm history",
            "Material receipt",
            "Deficiency close-up"
          ]
        }
      ]
