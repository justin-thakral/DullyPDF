                "PM complete - normal operation",
                "Operate with monitoring",
                "Repair required",
                "Restricted operation",
                "Shutdown or isolated",
                "PM incomplete"
              ]
            },
            {
              "key": "repair_authorization",
              "label": "Repair authorization or NTE",
