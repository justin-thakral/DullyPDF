              "units": 0.9
            },
            {
              "key": "evidence_folder",
              "label": "Evidence folder or link",
              "units": 1.15
            }
          ]
        },
        {
          "key": "maintenance_notice",
          "type": "notice",
          "label": "Maintenance record limitation",
          "guidance": "This log records work performed during the stated visit. It does not replace manufacturer instructions, energy-control procedures, electrical safe-work practices, refrigerant certification, combustion-safety requirements, or repair authorization."
        },
        {
