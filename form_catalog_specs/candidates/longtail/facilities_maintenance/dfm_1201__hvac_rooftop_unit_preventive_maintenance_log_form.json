{
  "schema_version": 1,
  "catalog_id": "facilities_maintenance/dfm_1201__hvac_rooftop_unit_preventive_maintenance_log_form",
  "source_section": "facilities_maintenance",
  "source_filename": "dfm_1201__hvac_rooftop_unit_preventive_maintenance_log_form.pdf",
  "slug": "hvac-rooftop-unit-preventive-maintenance-log-form",
  "title": "HVAC Rooftop Unit Preventive Maintenance Service Log",
  "subtitle": "Record the planned PM visit, safe isolation, baseline condition, maintenance tasks, materials, before-and-after readings, exceptions, follow-up ownership, and service closeout.",
  "description": "A service-focused HVAC rooftop unit preventive maintenance log that documents the maintenance cycle, technician authorization, energy control, work actually performed, consumables and parts, before-and-after performance, discovered deficiencies, and next scheduled action.",
  "use_case": "Use for each recurring RTU preventive maintenance visit when a facilities team needs proof of completed tasks, traceable materials and readings, documented deviations from scope, repair escalation, and a reliable next-service date.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "service_identity",
      "title": "PM visit, contract, and equipment identity",
      "guidance": "Identify the exact maintenance cycle, service provider, and rooftop unit.",
      "blocks": [
        {
          "key": "visit_reference",
          "type": "fields",
          "label": "Preventive maintenance visit",
          "fields": [
            {
              "key": "pm_record_number",
              "label": "PM record number",
