  "slug": "hvac-rooftop-unit-incident-report-form",
  "title": "HVAC Rooftop Unit Incident Response and Investigation Report",
  "subtitle": "Document an RTU incident from immediate life-safety response and equipment isolation through factual evidence, affected people and property, notifications, investigation, corrective action, return-to-service authorization, and closure.",
  "description": "A safety-conscious HVAC rooftop unit incident report for smoke, fire, electrical events, releases, water damage, equipment failure, roof hazards, injuries, indoor-environment impacts, and service interruptions, with evidence preservation and accountable corrective-action tracking.",
  "use_case": "Use after an RTU-related event that harmed or could have harmed people, property, operations, or the environment and requires one factual record for emergency response, equipment status, notifications, investigation, repair decisions, verification, and final closure.",
  "risk_tier": "B",
