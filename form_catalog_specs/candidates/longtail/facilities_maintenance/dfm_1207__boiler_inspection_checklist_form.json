  "slug": "boiler-inspection-checklist-form",
  "title": "Boiler Condition and Safety Inspection Checklist",
  "subtitle": "Document boiler condition, safeguards, operating evidence, defects, disposition, and accountable closeout.",
  "description": "A boiler-specific inspection record for facility teams and qualified inspectors to capture pressure, fuel, combustion, water, control, and safety-device findings without substituting for required inspection procedures.",
  "use_case": "Use for a scheduled, turnover, pre-service, or condition inspection when the organization needs traceable observations, readings, evidence, escalation decisions, and return-to-service authorization.",
  "risk_tier": "B",
