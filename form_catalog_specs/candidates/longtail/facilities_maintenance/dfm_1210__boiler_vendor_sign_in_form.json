  "slug": "boiler-vendor-sign-in-form",
  "title": "Boiler Vendor Access and Service Sign-In Record",
  "subtitle": "Control vendor access to boiler work and preserve personnel, scope, safety, activity, evidence, and exit records.",
  "description": "A boiler-specific vendor sign-in and service-control record for documenting authorized personnel, credentials, work boundaries, boiler hazards, readings, materials, exceptions, handoff, and departure.",
  "use_case": "Use when an outside vendor enters a boiler room or performs boiler-related inspection, maintenance, treatment, testing, repair, or support that requires accountable access and service closeout.",
  "risk_tier": "B",
