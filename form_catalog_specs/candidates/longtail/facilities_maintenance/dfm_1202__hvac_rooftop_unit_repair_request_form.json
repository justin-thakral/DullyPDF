  "slug": "hvac-rooftop-unit-repair-request-form",
  "title": "HVAC Rooftop Unit Repair Request and Resolution Record",
  "subtitle": "Route an RTU failure from the original complaint through safety triage, evidence, dispatch, repair authorization, diagnosis, completed work, verification, and requester handoff.",
  "description": "A complete HVAC rooftop unit repair request workflow for identifying the affected asset and business impact, preserving symptoms and alarms, controlling immediate hazards, preparing vendor access, authorizing scope and cost, and documenting final repair results.",
  "use_case": "Use when occupants, property staff, or monitoring systems identify an RTU problem and facilities personnel need one accountable record for priority, dispatch, approval, technician findings, exceptions, return-to-service, and closure.",
  "risk_tier": "B",
