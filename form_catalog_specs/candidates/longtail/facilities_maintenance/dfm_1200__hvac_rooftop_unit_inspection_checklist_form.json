  "slug": "hvac-rooftop-unit-inspection-checklist-form",
  "title": "HVAC Rooftop Unit Condition and Safety Inspection Checklist",
  "subtitle": "Document rooftop access, equipment identity, visible condition, electrical and mechanical observations, operating readings, deficiencies, disposition, and accountable closeout.",
  "description": "A structured HVAC rooftop unit inspection record covering safe roof access, RTU identification, cabinet and airside condition, electrical and control observations, operating readings, evidence, deficiency classification, and return-to-service decisions.",
  "use_case": "Use for a periodic or problem-focused RTU inspection when facilities personnel need defensible observations, measurement records, repair priorities, escalation decisions, and proof that the unit and roof area were left secure.",
  "risk_tier": "B",
  "sections": [
    {
