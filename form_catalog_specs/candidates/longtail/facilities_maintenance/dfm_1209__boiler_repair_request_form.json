  "slug": "boiler-repair-request-form",
  "title": "Boiler Repair Request and Resolution Record",
  "subtitle": "Route a boiler defect from initial request through safe work control, diagnosis, repair, verification, and closeout.",
  "description": "A boiler-specific repair workflow for documenting the reported problem, interim risk controls, qualified diagnosis, authorized repair scope, evidence, testing, return-to-service decisions, and facility handoff.",
  "use_case": "Use when a boiler, burner, fuel train, water system, pressure control, safety device, or venting concern requires formal triage, repair authorization, execution tracking, and accountable resolution.",
  "risk_tier": "B",
