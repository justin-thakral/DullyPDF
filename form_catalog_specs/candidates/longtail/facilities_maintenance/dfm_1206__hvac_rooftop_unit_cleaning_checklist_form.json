    {
      "key": "cleaning_execution",
      "title": "Component cleaning execution record",
      "guidance": "Record completed tasks and the actual method used; a checked task means it was performed and visually verified, not merely planned.",
      "blocks": [
        {
          "key": "dry_removal",
          "type": "checklist",
          "label": "Dry debris removal and preparation",
          "items": [
            "Large loose debris removed and bagged before washing",
            "Coil faces vacuumed or brushed with airflow direction",
            "Cabinet vacuumed; controls and insulation protected",
            "Blower compartment loose material captured",
            "Outdoor-air screen and hood debris removed",
            "Drain pan solids removed before flushing",
            "Electrical, control, and sensor components protected",
            "Bent fins or fragile surfaces identified before contact"
          ]
        },
        {
          "key": "coil_cleaning",
          "type": "checklist",
          "label": "Evaporator and condenser coil cleaning",
          "items": [
            "Correct coil side and airflow direction confirmed",
            "Product compatibility checked against coil and coating",
            "Cleaner applied at documented dilution and dwell time",
            "Water pressure controlled to avoid fin and coating damage",
            "Coil rinsed free of residue and loosened material",
            "Runoff captured through the approved recovery path",
            "Fin condition rechecked and significant damage documented",
            "Coil face and accessible depth visually verified clean"
          ]
        },
        {
          "key": "airside_cleaning",
          "type": "checklist",
          "label": "Airside, blower, filter, and cabinet cleaning",
          "items": [
            "Blower and housing cleaned; balance weights protected",
            "Motor exterior and vents cleaned without wetting",
            "Belt residue and accessible sheave surfaces cleaned",
            "Filter rack, tracks, clips, and bypass surfaces cleaned",
            "Filters installed in the correct airflow direction",
            "Economizer screens, blades, linkage, and hood cleaned",
            "Cabinet floor, walls, doors, and accessible liner cleaned",
            "Door seals, gaskets, fasteners, and mating surfaces clean"
          ]
        },
        {
          "key": "drain_cleaning",
          "type": "checklist",
          "label": "Drain pan, trap, and condensate path cleaning",
          "items": [
            "Drain pan cleaned without damaging coating or slope",
            "Trap and drain line cleared by approved method",
            "Drain opening and fittings checked for damage or leaks",
            "Drain line flushed to the intended discharge",
            "Standing water removed and pan dried where practicable",
            "Treatment product used only when approved and recorded",
            "Overflow protection and float device left unobstructed",
            "Leaks, poor slope, or recurring blockage escalated"
          ]
        },
        {
          "key": "task_result_table",
          "type": "table",
          "label": "Cleaning method and result by component",
