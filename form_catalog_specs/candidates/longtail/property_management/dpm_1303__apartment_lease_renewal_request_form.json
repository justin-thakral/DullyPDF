  "slug": "apartment-lease-renewal-request-form",
  "title": "Apartment Lease Renewal Request and Decision Record",
  "subtitle": "Track resident intent, lease context, requested changes, consistent property review, offer terms, approvals, delivery, response, execution, exceptions, and accountable closeout.",
  "description": "A workflow-complete apartment lease renewal record for resident preferences, household and contact updates, accommodation routing, neutral eligibility review, proposed terms, authorization, offer delivery, negotiation history, document execution, and unresolved-action ownership.",
  "use_case": "Use when a resident or property team starts a renewal workflow and needs one fillable record that preserves the request, applies consistent review criteria, separates accommodation handling, documents approved terms and communications, and confirms final execution or non-renewal routing.",
  "risk_tier": "A",
