  "slug": "apartment-maintenance-request-form",
  "title": "Apartment Maintenance Request and Resolution Record",
  "subtitle": "Route a resident-reported issue from safety triage and access planning through inspection, authorization, repair, verification, communication, and accountable closeout.",
  "description": "A workflow-complete apartment maintenance record for resident intake, hazard screening, entry coordination, observed conditions, work assignment, repair authorization, completion testing, resident updates, and unresolved-item ownership.",
  "use_case": "Use when property staff need one fillable record to receive an apartment repair request, distinguish urgent safety routing from routine service, coordinate lawful access, document evidence and work, and close the loop with the resident.",
  "risk_tier": "A",
  "sections": [
