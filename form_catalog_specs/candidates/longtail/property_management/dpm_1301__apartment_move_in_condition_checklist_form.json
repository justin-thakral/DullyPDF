        {
          "key": "condition_code_notice",
          "type": "notice",
          "label": "Condition coding",
          "guidance": "Suggested codes: G for good or serviceable, W for worn or marked, D for damaged or not operating, C for cleaning needed, and NI for not inspected. Describe observable facts rather than assigning fault or making a legal conclusion."
        },
        {
          "key": "inspection_scope",
