    {
      "key": "inspection_exceptions",
      "title": "Crop Scouting exceptions and escalation",
      "guidance": "Escalate uncertainty and conditions outside the reviewer\u2019s authority.",
      "blocks": [
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Inspection authority boundary",
          "guidance": "This record captures observations and evidence; it is not a diagnosis or treatment recommendation. Route uncertain, regulated, or consequential findings to a qualified crop professional or applicable authority before action."
        },
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Crop Scouting exception triggers",
          "items": [
            "Field or sample identity cannot be reconciled",
            "Area is inaccessible or route coverage is incomplete",
            "Sample, photo, trap, or map evidence is missing",
            "Observation conflicts with prior findings or threshold source",
            "Potential regulated or high-consequence finding needs review",
            "Recommendation, treatment, or handoff authority is unclear"
          ]
        },
        {
          "key": "escalation_record",
          "type": "textarea",
          "label": "Escalation facts, immediate action, owner, due point, and disposition",
          "fields": [
