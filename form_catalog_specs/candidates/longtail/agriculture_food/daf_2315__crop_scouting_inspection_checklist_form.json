              "units": 1.0
            },
            {
              "key": "weather_soil",
              "label": "Weather and soil context",
              "units": 1.1
            }
          ]
        },
        {
          "key": "preparation_checks",
          "type": "checklist",
          "label": "Preparation and prior-record review",
          "items": [
            "Route and sampled area were recorded",
            "Crop stage and stand condition were observed",
            "Insects, disease symptoms, and weeds were recorded separately",
            "Beneficial organisms and non-target effects were noted",
            "Water, nutrient, weather, and physical stress signs were noted",
            "Counts, incidence, severity, or distribution basis was stated",
            "Hot spots, boundaries, photos, and samples were referenced",
            "Threshold source and qualified review need were identified"
          ]
        }
      ]
    },
    {
      "key": "condition_findings",
      "title": "Crop Scouting condition findings",
      "guidance": "Separate observed condition from disposition.",
      "blocks": [
        {
          "key": "inspection_points",
          "type": "checklist",
          "label": "Crop Scouting inspection points",
          "items": [
            "Field identity and route coverage were verified",
            "Crop stage, stand, and vigor observations were recorded",
            "Insect presence, life stage, and distribution were observed",
            "Disease symptoms and affected plant parts were described",
            "Weed species or growth pattern was described without unsupported diagnosis",
            "Beneficial and non-target organisms were noted",
            "Water, nutrient, weather, and physical stress signs were distinguished",
            "Counts, sample size, and scouting method were recorded",
            "Photos, samples, trap IDs, and map points were linked",
            "Prior findings, trend, and unresolved hot spots were compared"
          ]
        },
