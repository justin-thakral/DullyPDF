  "slug": "crop-scouting-inspection-checklist-form",
  "title": "Crop Scouting Inspection Checklist Form",
  "subtitle": "Crop Scouting prepare the inspection, examine domain-specific conditions, record findings, assign corrections, decide status, and close the review.",
  "description": "An original, workflow-complete crop scouting inspection checklist covering identity and routing, domain observations and evidence, accountable decisions, exceptions and escalation, and completion handoff without replacing qualified judgment.",
  "use_case": "Use for a planned or triggered inspection that must preserve observed condition, finding severity, correction ownership, and an authorized disposition. The record is owned by the crop management owner and closes only after evidence, exceptions, disposition, and the next accountable handoff are documented.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "inspection_routing",
      "title": "Crop Scouting inspection routing",
      "guidance": "Identify the inspection, subject, inspector, and review route.",
