            }
          ],
          "guidance": "Preserve the identifiers used by the controlling farm, facility, or partner record."
        }
      ]
    },
    {
      "key": "inspection_preparation",
      "title": "Irrigation inspection preparation",
      "guidance": "Record conditions and evidence sources before making findings.",
      "blocks": [
        {
          "key": "inspection_context",
          "type": "fields",
          "label": "Inspection context",
          "fields": [
            {
              "key": "run_purpose",
              "label": "Run purpose",
              "units": 1.0
            },
            {
              "key": "schedule_ref",
              "label": "Schedule or plan reference",
              "units": 1.0
            },
            {
              "key": "meter_start",
              "label": "Starting meter reading",
              "units": 0.85
            },
            {
              "key": "pressure_ref",
              "label": "Pressure target reference",
              "units": 1.0
            },
            {
              "key": "operator",
              "label": "Assigned operator",
              "units": 0.85
            }
          ]
        },
        {
          "key": "preparation_checks",
          "type": "checklist",
          "label": "Preparation and prior-record review",
          "items": [
            "Source, pump, meter, and zone identity were recorded",
            "Schedule or agronomic instruction reference was recorded",
            "Starting and ending meter values were captured",
            "Pressure, flow, and distribution observations were recorded",
            "Filter, valve, emitter, or sprinkler condition was noted",
            "Runoff, ponding, leaks, or blocked areas were identified",
            "Weather, rainfall, and soil or crop context was noted",
            "Variance, shutdown, and follow-up ownership were recorded"
          ]
        }
      ]
    },
    {
      "key": "condition_findings",
      "title": "Irrigation condition findings",
      "guidance": "Separate observed condition from disposition.",
      "blocks": [
        {
          "key": "inspection_points",
          "type": "checklist",
          "label": "Irrigation inspection points",
          "items": [
            "Water source, pump, meter, and control identity are legible",
            "Valves, filters, regulators, and gauges were observed",
            "Mainlines, laterals, fittings, and visible leaks were observed",
            "Emitters, nozzles, sprinklers, or outlets were sampled",
            "Pressure and flow evidence was compared with the plan reference",
            "Distribution gaps, runoff, ponding, and erosion signs were mapped",
            "Sensors, timers, alarms, and remote controls were function-checked",
            "Backflow or injection components were routed for qualified review",
            "Water-quality or sampling records were checked when applicable",
            "Open repairs and prior zone restrictions were compared"
          ]
        },
        {
          "key": "findings_register",
          "type": "table",
          "label": "Findings and evidence register",
          "columns": [
            {
              "key": "inspection_point",
              "label": "Point or location",
              "units": 1.15
            },
            {
              "key": "observed_condition",
              "label": "Observed condition",
              "units": 1.35
            },
            {
              "key": "evidence_ref",
              "label": "Evidence ref",
              "units": 0.9
            },
            {
              "key": "severity_status",
              "label": "Severity or status",
              "units": 1.0
            }
          ],
          "rows": 4
        }
      ]
    },
