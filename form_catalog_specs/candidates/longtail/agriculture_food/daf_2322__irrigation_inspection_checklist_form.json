  "slug": "irrigation-inspection-checklist-form",
  "title": "Irrigation Inspection Checklist Form",
  "subtitle": "Irrigation prepare the inspection, examine domain-specific conditions, record findings, assign corrections, decide status, and close the review.",
  "description": "An original, workflow-complete irrigation inspection checklist covering identity and routing, domain observations and evidence, accountable decisions, exceptions and escalation, and completion handoff without replacing qualified judgment.",
  "use_case": "Use for a planned or triggered inspection that must preserve observed condition, finding severity, correction ownership, and an authorized disposition. The record is owned by the irrigation operations owner and closes only after evidence, exceptions, disposition, and the next accountable handoff are documented.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "inspection_routing",
      "title": "Irrigation inspection routing",
      "guidance": "Identify the inspection, subject, inspector, and review route.",
      "blocks": [
        {
          "key": "record_routing",
          "type": "fields",
          "label": "Inspection Checklist identity and routing",
          "fields": [
            {
              "key": "inspection_id",
              "label": "Inspection ID",
              "units": 0.8
            },
            {
