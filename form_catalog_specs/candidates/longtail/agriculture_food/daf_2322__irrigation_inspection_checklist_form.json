            },
            {
              "key": "inspection_type",
              "label": "Inspection type",
              "units": 0.95,
              "field_type": "choice",
              "options": [
                "Routine",
                "Pre-use",
                "Follow-up",
                "Triggered",
                "Other"
              ]
            },
