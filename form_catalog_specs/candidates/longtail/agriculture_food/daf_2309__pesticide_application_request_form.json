  "slug": "pesticide-application-request-form",
  "title": "Pesticide Application Request Form",
  "subtitle": "Pesticide Application define the operational need, compare requirements and options, document review, authorize the response, manage exceptions, and verify fulfillment.",
  "description": "An original, workflow-complete pesticide application request workflow covering identity and routing, domain observations and evidence, accountable decisions, exceptions and escalation, and completion handoff without replacing qualified judgment.",
  "use_case": "Use when a requester needs an accountable decision and scheduled operational response supported by scope, evidence, constraints, and completion records. The record is owned by the application program owner and closes only after evidence, exceptions, disposition, and the next accountable handoff are documented.",
  "risk_tier": "B",
