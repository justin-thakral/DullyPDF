      "title": "Pesticide Application constraints and escalation",
      "guidance": "Keep blockers and changed conditions visible through fulfillment.",
      "blocks": [
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Stop, hold, and authority boundary",
          "guidance": "This form does not recommend or authorize pesticide use. A qualified and authorized person must follow the current product label, site instructions, and applicable requirements. Stop, hold the affected area or record, and escalate any mismatch, exposure, spill, drift, or uncertain direction."
        },
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Pesticide Application exception triggers",
          "items": [
            "Product, label, or registration reference mismatch",
            "Field, crop, target, rate, or method is unresolved",
            "Weather, wind, buffer, or sensitive-area concern",
            "Calibration, equipment, spill, or container issue",
            "Applicator authorization or handler requirement gap",
            "Entry, harvest, notification, or application record gap"
          ],
          "guidance": "Mark each applicable trigger and explain any uncertainty in the exception record."
        },
