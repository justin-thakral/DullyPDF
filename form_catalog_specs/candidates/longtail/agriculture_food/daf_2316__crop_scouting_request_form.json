  "slug": "crop-scouting-request-form",
  "title": "Crop Scouting Request Form",
  "subtitle": "Crop Scouting define the operational need, compare requirements and options, document review, authorize the response, manage exceptions, and verify fulfillment.",
  "description": "An original, workflow-complete crop scouting request workflow covering identity and routing, domain observations and evidence, accountable decisions, exceptions and escalation, and completion handoff without replacing qualified judgment.",
  "use_case": "Use when a requester needs an accountable decision and scheduled operational response supported by scope, evidence, constraints, and completion records. The record is owned by the crop management owner and closes only after evidence, exceptions, disposition, and the next accountable handoff are documented.",
  "risk_tier": "A",
