          "label": "Source identifiers",
          "fields": [
            {
              "key": "water_source",
              "label": "Water source ID",
              "units": 0.85
            },
            {
              "key": "source_record",
              "label": "Source or allocation record",
              "units": 1.05
            },
            {
              "key": "pump_meter",
              "label": "Pump and meter ID",
              "units": 0.9
            },
            {
              "key": "run_id",
              "label": "Irrigation run ID",
              "units": 0.8
            },
            {
              "key": "field_zone",
              "label": "Field or zone ID",
              "units": 0.9
            },
            {
              "key": "sample_record",
              "label": "Water sample reference",
              "units": 1.0
            }
          ]
        },
        {
          "key": "source_evidence",
          "type": "checklist",
          "label": "Source-record evidence",
          "items": [
            "Irrigation Run Or Zone identifier matches the controlling source record",
            "Source document, prior record, or transaction reference is retrievable",
            "Event date, time, location, and responsible person are attributable",
            "Serial, lot, sample, container, or equivalent linking identifier is preserved",
            "Corrections retain the original value, reason, person, and time",
            "Missing, conflicting, or assumed source information is explicitly flagged"
          ]
        }
      ]
    },
