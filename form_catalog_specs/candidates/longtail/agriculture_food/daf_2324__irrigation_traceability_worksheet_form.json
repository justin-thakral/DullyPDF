    },
    {
      "key": "trace_review",
      "title": "Irrigation trace decision",
      "guidance": "Document the evidence threshold, qualified review, and next action.",
      "blocks": [
        {
          "key": "trace_decision",
          "type": "fields",
          "label": "Trace decision",
          "fields": [
