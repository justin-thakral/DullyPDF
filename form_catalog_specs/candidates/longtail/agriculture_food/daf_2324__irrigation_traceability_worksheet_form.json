            },
            {
              "key": "accounted_scope",
              "label": "Accounted quantity or scope",
              "units": 1.05
            },
            {
              "key": "variance",
              "label": "Unreconciled variance",
              "units": 0.9
            },
            {
              "key": "last_verified_point",
