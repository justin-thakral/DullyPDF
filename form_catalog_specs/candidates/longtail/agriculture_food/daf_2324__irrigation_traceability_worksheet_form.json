            {
              "key": "system_type",
              "label": "System type",
              "units": 0.9,
              "field_type": "choice",
              "options": [
                "Drip",
                "Micro-sprinkler",
                "Sprinkler",
                "Pivot",
                "Surface",
                "Other"
              ]
            },
            {
              "key": "water_source",
              "label": "Water source ID",
              "units": 0.9
            },
            {
              "key": "pump_station",
              "label": "Pump or station ID",
              "units": 0.9
            },
            {
              "key": "crop_stage",
              "label": "Crop and growth stage",
              "units": 1.15
            }
          ],
          "guidance": "Preserve the identifiers used by the controlling farm, facility, or partner record."
        }
      ]
    },
    {
      "key": "source_identity",
      "title": "Irrigation source identity",
      "guidance": "Anchor the trace to stable source identifiers and evidence.",
      "blocks": [
        {
          "key": "source_identifiers",
