              "key": "decision_status",
              "label": "Decision status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Trace complete",
                "Complete with gap",
                "Search continuing",
                "Hold or escalation"
              ]
            },
            {
              "key": "decision_date",
              "label": "Decision date",
              "units": 0.75
            },
            {
              "key": "authorized_by",
              "label": "Authorized by",
              "units": 1.0
            },
            {
              "key": "evidence_reference",
              "label": "Decision evidence reference",
              "units": 1.2
            },
            {
              "key": "followup_due",
              "label": "Follow-up due",
              "units": 0.8
            }
          ]
        },
        {
          "key": "decision_basis",
          "type": "checklist",
          "label": "Trace decision basis",
          "items": [
            "Verified facts are distinguished from assumptions",
            "Irrigation source, event, and destination links are supported",
            "Quantities or scope, transformations, and gaps reconcile",
            "Hold, release, or continued-search decision has a qualified owner",
            "Applicable record, correction-history, and retention prompts were reviewed"
          ]
        },
        {
          "key": "trace_conclusion",
          "type": "textarea",
          "label": "Verified conclusion, unresolved gap, affected scope, and next action",
          "fields": [
            {
              "key": "conclusion_detail",
              "label": "Trace conclusion and limitations"
            }
          ],
          "height": 52
        }
      ]
    },
    {
      "key": "trace_exceptions",
      "title": "Irrigation gaps, holds, and escalation",
      "guidance": "Do not release an unresolved identity or disposition decision by inference.",
      "blocks": [
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Stop, hold, and authority boundary",
          "guidance": "This record supports irrigation operations but does not set agronomic, water-quality, electrical, backflow, or injection requirements. Stop and route abnormal conditions to the qualified owner under current site procedures."
        },
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Irrigation exception triggers",
          "items": [
            "Source, meter, pump, or zone identity mismatch",
            "Pressure, flow, volume, or run-time variance",
            "Leak, blockage, runoff, ponding, or distribution gap",
            "Sensor, controller, valve, or alarm failure",
            "Water-quality, backflow, or injection concern",
            "Allocation, access, crop instruction, or repair authority gap"
          ],
          "guidance": "Mark each applicable trigger and explain any uncertainty in the exception record."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Irrigation trace-gap register",
          "columns": [
            {
              "key": "trigger",
              "label": "Trigger or issue",
              "units": 1.2
            },
            {
              "key": "immediate_action",
              "label": "Immediate action",
              "units": 1.2
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "final_disposition",
              "label": "Final disposition",
              "units": 1.25
            }
          ],
          "rows": 3,
          "guidance": "Do not close a row until its disposition and accountable owner are explicit."
        }
      ]
    },
