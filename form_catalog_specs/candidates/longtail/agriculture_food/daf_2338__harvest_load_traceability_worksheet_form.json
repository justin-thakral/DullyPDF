        },
        {
          "key": "handoff_confirmations",
          "type": "checklist",
          "label": "Harvest Load handoff confirmations",
          "items": [
            "Starting scope, accounted scope, and variance were reconciled",
            "Source, event, transformation, and destination links were packaged",
            "Holds, gaps, and continued-search tasks retain accountable owners",
            "Qualified trace reviewer acknowledged the conclusion and limitations",
            "Harvest Load trace evidence and correction history were filed"
          ],
          "guidance": "Unchecked items remain part of the open handoff."
        },
