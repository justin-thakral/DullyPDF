              "key": "grower_location",
              "label": "Grower or farm location",
              "units": 1.05
            },
            {
              "key": "harvest_datetime",
              "label": "Harvest date and time",
              "units": 1.0
            },
            {
              "key": "crew_harvester",
              "label": "Crew or harvester ID",
              "units": 1.0
            },
            {
              "key": "container_range",
              "label": "Container or tag range",
              "units": 1.05
            }
          ]
        },
        {
          "key": "source_evidence",
          "type": "checklist",
          "label": "Source-record evidence",
          "items": [
            "Harvest Lot Or Outbound Load identifier matches the controlling source record",
            "Source document, prior record, or transaction reference is retrievable",
            "Event date, time, location, and responsible person are attributable",
            "Serial, lot, sample, container, or equivalent linking identifier is preserved",
            "Corrections retain the original value, reason, person, and time",
            "Missing, conflicting, or assumed source information is explicitly flagged"
          ]
        }
      ]
    },
