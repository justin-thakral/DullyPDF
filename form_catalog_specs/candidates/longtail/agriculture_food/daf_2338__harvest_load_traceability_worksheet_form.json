{
  "schema_version": 1,
  "catalog_id": "agriculture_food/daf_2338__harvest_load_traceability_worksheet_form",
  "source_section": "agriculture_food",
  "source_filename": "daf_2338__harvest_load_traceability_worksheet_form.pdf",
  "slug": "harvest-load-traceability-worksheet-form",
  "title": "Harvest Load Traceability Worksheet Form",
  "subtitle": "Harvest Load link source identity, event records, transformations, destinations, quantities, gaps, hold decisions, and the final trace package.",
  "description": "An original, workflow-complete harvest load traceability worksheet covering identity and routing, domain observations and evidence, accountable decisions, exceptions and escalation, and completion handoff without replacing qualified judgment.",
  "use_case": "Use to reconstruct or verify movement and custody across linked events while keeping assumptions, unresolved gaps, holds, and authorized disposition visible. The record is owned by the harvest and shipping owner and closes only after evidence, exceptions, disposition, and the next accountable handoff are documented.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "trace_routing",
      "title": "Harvest Load trace routing",
      "guidance": "Define the trace question, subject, trigger, and accountable owner.",
      "blocks": [
        {
          "key": "record_routing",
          "type": "fields",
          "label": "Traceability Worksheet identity and routing",
          "fields": [
            {
              "key": "worksheet_id",
              "label": "Trace worksheet ID",
              "units": 0.9
            },
