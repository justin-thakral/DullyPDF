              "units": 0.8
            }
          ]
        },
        {
          "key": "decision_basis",
          "type": "checklist",
          "label": "Trace decision basis",
          "items": [
            "Verified facts are distinguished from assumptions",
            "Crop Scouting source, event, and destination links are supported",
            "Quantities or scope, transformations, and gaps reconcile",
            "Hold, release, or continued-search decision has a qualified owner",
            "Applicable record, correction-history, and retention prompts were reviewed"
          ]
        },
        {
          "key": "trace_conclusion",
          "type": "textarea",
          "label": "Verified conclusion, unresolved gap, affected scope, and next action",
          "fields": [
            {
              "key": "conclusion_detail",
              "label": "Trace conclusion and limitations"
            }
          ],
          "height": 52
        }
      ]
    },
    {
      "key": "trace_exceptions",
      "title": "Crop Scouting gaps, holds, and escalation",
      "guidance": "Do not release an unresolved identity or disposition decision by inference.",
      "blocks": [
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Stop, hold, and authority boundary",
          "guidance": "This record captures observations and evidence; it is not a diagnosis or treatment recommendation. Route uncertain, regulated, or consequential findings to a qualified crop professional or applicable authority before action."
        },
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Crop Scouting exception triggers",
          "items": [
            "Field or sample identity cannot be reconciled",
            "Area is inaccessible or route coverage is incomplete",
            "Sample, photo, trap, or map evidence is missing",
            "Observation conflicts with prior findings or threshold source",
            "Potential regulated or high-consequence finding needs review",
            "Recommendation, treatment, or handoff authority is unclear"
          ],
          "guidance": "Mark each applicable trigger and explain any uncertainty in the exception record."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Crop Scouting trace-gap register",
          "columns": [
            {
              "key": "trigger",
              "label": "Trigger or issue",
              "units": 1.2
            },
            {
              "key": "immediate_action",
              "label": "Immediate action",
              "units": 1.2
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "final_disposition",
              "label": "Final disposition",
              "units": 1.25
            }
          ],
          "rows": 3,
          "guidance": "Do not close a row until its disposition and accountable owner are explicit."
        }
      ]
