  "source_section": "agriculture_food",
  "source_filename": "daf_2317__crop_scouting_traceability_worksheet_form.pdf",
  "slug": "crop-scouting-traceability-worksheet-form",
  "title": "Crop Scouting Traceability Worksheet Form",
  "subtitle": "Crop Scouting link source identity, event records, transformations, destinations, quantities, gaps, hold decisions, and the final trace package.",
  "description": "An original, workflow-complete crop scouting traceability worksheet covering identity and routing, domain observations and evidence, accountable decisions, exceptions and escalation, and completion handoff without replacing qualified judgment.",
  "use_case": "Use to reconstruct or verify movement and custody across linked events while keeping assumptions, unresolved gaps, holds, and authorized disposition visible. The record is owned by the crop management owner and closes only after evidence, exceptions, disposition, and the next accountable handoff are documented.",
  "risk_tier": "B",
  "sections": [
