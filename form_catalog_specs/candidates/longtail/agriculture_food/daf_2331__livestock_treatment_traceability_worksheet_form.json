      "title": "Livestock Treatment gaps, holds, and escalation",
      "guidance": "Do not release an unresolved identity or disposition decision by inference.",
      "blocks": [
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Stop, hold, and authority boundary",
          "guidance": "This record does not diagnose, prescribe, set a dose, or release an animal or food product. Follow current veterinary or authorized instructions and applicable requirements. Hold and escalate any identity, treatment, adverse response, withdrawal, discard, or release uncertainty."
        },
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Livestock Treatment exception triggers",
          "items": [
            "Animal or group identity is uncertain",
            "Authorization, protocol, label, or prescription is missing",
            "Product, lot, expiry, dose, route, or time discrepancy",
            "Adverse response, missed dose, or treatment failure",
            "Withdrawal, discard, or food-product hold is uncertain",
            "Inventory, storage, administration, or record mismatch"
          ],
          "guidance": "Mark each applicable trigger and explain any uncertainty in the exception record."
        },
