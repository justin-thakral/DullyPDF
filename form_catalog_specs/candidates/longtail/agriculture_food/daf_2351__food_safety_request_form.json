  "slug": "food-safety-request-form",
  "title": "Food Safety Request Form",
  "subtitle": "Food Safety define the operational need, compare requirements and options, document review, authorize the response, manage exceptions, and verify fulfillment.",
  "description": "An original, workflow-complete food safety request workflow covering identity and routing, domain observations and evidence, accountable decisions, exceptions and escalation, and completion handoff without replacing qualified judgment.",
  "use_case": "Use when a requester needs an accountable decision and scheduled operational response supported by scope, evidence, constraints, and completion records. The record is owned by the food-safety program owner and closes only after evidence, exceptions, disposition, and the next accountable handoff are documented.",
  "risk_tier": "B",
