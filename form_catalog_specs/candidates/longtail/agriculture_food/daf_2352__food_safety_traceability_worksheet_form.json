                "Transferred",
                "Open exception"
              ]
            },
            {
              "key": "closed_date",
              "label": "Closed date",
              "units": 0.75
            },
            {
              "key": "record_location",
              "label": "Record or evidence location",
              "units": 1.2
            },
            {
              "key": "next_owner",
              "label": "Next accountable owner",
              "units": 1.0
            },
            {
              "key": "next_due",
              "label": "Next action due",
              "units": 0.8
            }
          ]
        },
        {
          "key": "open_commitments",
          "type": "table",
          "label": "Food Safety open actions and limitations",
          "columns": [
            {
              "key": "open_item",
              "label": "Open action or limitation",
              "units": 1.3
            },
            {
              "key": "evidence_needed",
              "label": "Evidence needed",
              "units": 1.1
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "status_handoff",
              "label": "Status or handoff",
              "units": 1.15
            }
          ],
          "rows": 5,
          "guidance": "Carry forward every item that is not fully resolved at closeout."
        },
        {
          "key": "handoff_confirmations",
          "type": "checklist",
          "label": "Food Safety handoff confirmations",
          "items": [
            "Starting scope, accounted scope, and variance were reconciled",
            "Source, event, transformation, and destination links were packaged",
            "Holds, gaps, and continued-search tasks retain accountable owners",
            "Qualified trace reviewer acknowledged the conclusion and limitations",
            "Food Safety trace evidence and correction history were filed"
          ],
          "guidance": "Unchecked items remain part of the open handoff."
        },
        {
          "key": "final_handoff_notes",
          "type": "textarea",
          "label": "Final outcome, remaining limits, communications, and acceptance notes",
          "fields": [
            {
              "key": "handoff_detail",
              "label": "Food Safety final handoff detail"
            }
          ],
          "height": 70
        },
        {
