            },
            {
              "key": "reference",
              "label": "Reference document",
              "units": 1.0
            }
          ],
          "rows": 4
        },
        {
          "key": "quantity_reconciliation",
          "type": "fields",
          "label": "Trace reconciliation",
          "fields": [
            {
              "key": "starting_scope",
              "label": "Starting quantity or scope",
              "units": 1.0
            },
            {
              "key": "accounted_scope",
              "label": "Accounted quantity or scope",
              "units": 1.05
            },
            {
              "key": "variance",
              "label": "Unreconciled variance",
              "units": 0.9
            },
            {
              "key": "last_verified_point",
              "label": "Last verified point",
              "units": 1.05
            },
            {
              "key": "next_search_owner",
              "label": "Next search owner",
              "units": 1.0
            }
          ]
        }
      ]
    },
    {
      "key": "trace_review",
      "title": "Food Safety trace decision",
      "guidance": "Document the evidence threshold, qualified review, and next action.",
      "blocks": [
        {
          "key": "trace_decision",
          "type": "fields",
          "label": "Trace decision",
          "fields": [
            {
              "key": "decision_status",
              "label": "Decision status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Trace complete",
                "Complete with gap",
                "Search continuing",
                "Hold or escalation"
              ]
            },
            {
              "key": "decision_date",
              "label": "Decision date",
              "units": 0.75
            },
            {
              "key": "authorized_by",
              "label": "Authorized by",
              "units": 1.0
            },
            {
              "key": "evidence_reference",
              "label": "Decision evidence reference",
              "units": 1.2
            },
            {
              "key": "followup_due",
              "label": "Follow-up due",
              "units": 0.8
            }
          ]
        },
        {
          "key": "decision_basis",
          "type": "checklist",
          "label": "Trace decision basis",
          "items": [
            "Verified facts are distinguished from assumptions",
            "Food Safety source, event, and destination links are supported",
            "Quantities or scope, transformations, and gaps reconcile",
            "Hold, release, or continued-search decision has a qualified owner",
            "Applicable record, correction-history, and retention prompts were reviewed"
          ]
        },
        {
          "key": "trace_conclusion",
          "type": "textarea",
          "label": "Verified conclusion, unresolved gap, affected scope, and next action",
          "fields": [
            {
              "key": "conclusion_detail",
              "label": "Trace conclusion and limitations"
            }
          ],
          "height": 52
        }
      ]
    },
    {
      "key": "trace_exceptions",
      "title": "Food Safety gaps, holds, and escalation",
      "guidance": "Do not release an unresolved identity or disposition decision by inference.",
      "blocks": [
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Stop, hold, and authority boundary",
          "guidance": "This template records a facility workflow and does not replace a food-safety plan or qualified hazard decision. Apply current procedures and applicable requirements. Hold affected product and escalate whenever control status, product scope, or authorized disposition is uncertain."
        },
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Food Safety exception triggers",
          "items": [
            "Monitoring point, limit source, or reading is missing",
            "Process, sanitation, allergen, label, or supply-chain deviation",
            "Instrument, method, sample, or verification concern",
            "Affected product or lot scope is uncertain",
            "Hold, rework, release, disposal, or return decision is pending",
            "Record, notification, qualified review, or corrective action gap"
          ],
          "guidance": "Mark each applicable trigger and explain any uncertainty in the exception record."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Food Safety trace-gap register",
          "columns": [
            {
              "key": "trigger",
              "label": "Trigger or issue",
              "units": 1.2
            },
            {
              "key": "immediate_action",
              "label": "Immediate action",
              "units": 1.2
            },
            {
              "key": "owner_due",
              "label": "Owner and due",
              "units": 1.0
            },
            {
              "key": "final_disposition",
              "label": "Final disposition",
              "units": 1.25
            }
          ],
          "rows": 3,
          "guidance": "Do not close a row until its disposition and accountable owner are explicit."
        }
      ]
    },
    {
      "key": "trace_closeout",
      "title": "Food Safety trace package and handoff",
      "guidance": "Package source evidence, linked events, decisions, and remaining work.",
