      "key": "destination_reconciliation",
      "title": "Food Safety destination and quantity reconciliation",
      "guidance": "Trace forward, reconcile movement, and identify unaccounted scope.",
      "blocks": [
        {
          "key": "destination_events",
          "type": "table",
          "label": "Destination, custody, or downstream records",
          "columns": [
            {
              "key": "date_time",
