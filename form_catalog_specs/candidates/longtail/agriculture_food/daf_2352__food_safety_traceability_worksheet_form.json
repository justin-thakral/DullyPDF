{
  "schema_version": 1,
  "catalog_id": "agriculture_food/daf_2352__food_safety_traceability_worksheet_form",
  "source_section": "agriculture_food",
  "source_filename": "daf_2352__food_safety_traceability_worksheet_form.pdf",
  "slug": "food-safety-traceability-worksheet-form",
  "title": "Food Safety Traceability Worksheet Form",
  "subtitle": "Food Safety link source identity, event records, transformations, destinations, quantities, gaps, hold decisions, and the final trace package.",
  "description": "An original, workflow-complete food safety traceability worksheet covering identity and routing, domain observations and evidence, accountable decisions, exceptions and escalation, and completion handoff without replacing qualified judgment.",
  "use_case": "Use to reconstruct or verify movement and custody across linked events while keeping assumptions, unresolved gaps, holds, and authorized disposition visible. The record is owned by the food-safety program owner and closes only after evidence, exceptions, disposition, and the next accountable handoff are documented.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "trace_routing",
      "title": "Food Safety trace routing",
      "guidance": "Define the trace question, subject, trigger, and accountable owner.",
      "blocks": [
        {
          "key": "record_routing",
          "type": "fields",
          "label": "Traceability Worksheet identity and routing",
          "fields": [
            {
              "key": "worksheet_id",
              "label": "Trace worksheet ID",
              "units": 0.9
            },
            {
              "key": "opened_date",
              "label": "Opened date",
              "units": 0.75
            },
            {
              "key": "trigger_reference",
              "label": "Trigger or case reference",
              "units": 1.1
            },
            {
              "key": "site_name",
              "label": "Farm, facility, or site",
              "units": 1.15
            },
            {
              "key": "trace_owner",
              "label": "Assigned trace owner",
              "units": 1.0
            }
          ],
          "guidance": "Assign one owner and use the same record ID in attachments and follow-up."
        },
        {
          "key": "subject_identity",
          "type": "fields",
          "label": "Food-Safety Monitoring Event identity",
          "fields": [
            {
              "key": "facility_area",
              "label": "Facility and area",
              "units": 1.0
            },
            {
              "key": "process_step",
              "label": "Process step",
              "units": 1.0
            },
            {
              "key": "product_lot",
              "label": "Product or lot",
              "units": 1.0
            },
            {
              "key": "line_shift",
              "label": "Line and shift",
              "units": 0.85
            },
            {
              "key": "plan_control_ref",
              "label": "Plan or control reference",
              "units": 1.15
            }
          ],
          "guidance": "Preserve the identifiers used by the controlling farm, facility, or partner record."
        }
      ]
    },
    {
      "key": "source_identity",
      "title": "Food Safety source identity",
      "guidance": "Anchor the trace to stable source identifiers and evidence.",
      "blocks": [
