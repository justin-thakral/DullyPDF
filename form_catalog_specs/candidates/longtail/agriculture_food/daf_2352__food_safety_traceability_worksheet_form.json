          "key": "source_identifiers",
          "type": "fields",
          "label": "Source identifiers",
          "fields": [
            {
              "key": "product_lot",
              "label": "Product lot or batch",
              "units": 0.95
            },
            {
              "key": "ingredient_lot",
              "label": "Ingredient or material lot",
              "units": 1.0
            },
            {
              "key": "process_batch",
              "label": "Process batch or run",
              "units": 0.95
            },
            {
              "key": "packaging_code",
              "label": "Packaging or label code",
              "units": 1.0
            },
            {
              "key": "line_shift",
              "label": "Line and shift",
              "units": 0.8
            },
            {
              "key": "control_record",
              "label": "Control record reference",
              "units": 1.1
            }
          ]
        },
        {
          "key": "source_evidence",
          "type": "checklist",
          "label": "Source-record evidence",
          "items": [
            "Food-Safety Monitoring Event identifier matches the controlling source record",
            "Source document, prior record, or transaction reference is retrievable",
            "Event date, time, location, and responsible person are attributable",
            "Serial, lot, sample, container, or equivalent linking identifier is preserved",
            "Corrections retain the original value, reason, person, and time",
            "Missing, conflicting, or assumed source information is explicitly flagged"
          ]
        }
      ]
    },
    {
