      "title": "Harvest Load exceptions and escalation",
      "guidance": "Escalate uncertainty and conditions outside the reviewer\u2019s authority.",
      "blocks": [
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Inspection authority boundary",
          "guidance": "This form records harvest and load evidence; it does not certify product condition, food safety, weight, or transport suitability. Hold exceptions and route release or disposition to the authorized owner under applicable plans."
        },
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Harvest Load exception triggers",
          "items": [
            "Field, lot, container, load, or seal identity mismatch",
            "Count, weight, scale, or document discrepancy",
            "Product condition, damage, or foreign-material concern",
            "Temperature, cooling, delay, or capacity exception",
            "Transport, destination, receiver, or route change",
            "Held, rejected, diverted, or commingled product gap"
          ]
        },
