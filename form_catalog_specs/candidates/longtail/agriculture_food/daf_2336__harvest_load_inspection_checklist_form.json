          ]
        },
        {
          "key": "preparation_checks",
          "type": "checklist",
          "label": "Preparation and prior-record review",
          "items": [
            "Field, crop, harvest lot, and crew were recorded",
            "Start, finish, and load departure times were captured",
            "Container, pallet, bin, or package IDs were assigned",
            "Count, gross, tare, and net measures were reconciled as applicable",
            "Product condition and temperature were noted under the facility plan",
            "Transport unit, seal, driver, and destination were recorded",
            "Rejected, held, reworked, or diverted product remained identifiable",
            "Harvest, packing, and shipping references were linked"
          ]
        }
      ]
    },
    {
      "key": "condition_findings",
      "title": "Harvest Load condition findings",
      "guidance": "Separate observed condition from disposition.",
      "blocks": [
        {
          "key": "inspection_points",
          "type": "checklist",
          "label": "Harvest Load inspection points",
          "items": [
            "Field, crop, variety, and harvest lot identity match the plan",
            "Crew, harvester, and scheduled window are identified",
            "Containers, bins, pallets, and labels are suitable under site procedure",
            "Harvest equipment and product-contact condition were observed",
            "Product condition, foreign-material concern, and damage were recorded",
            "Count, weight, scale, and measurement references were reviewed",
            "Temperature or cooling instruction was reviewed when applicable",
            "Transport unit, cleanliness record, and load area were observed",
            "Seal, destination, receiver, and shipping documents were prepared",
            "Prior holds, rejected product, and open lot exceptions were checked"
          ]
