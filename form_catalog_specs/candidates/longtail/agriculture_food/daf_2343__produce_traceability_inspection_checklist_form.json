      "key": "inspection_exceptions",
      "title": "Produce Traceability exceptions and escalation",
      "guidance": "Escalate uncertainty and conditions outside the reviewer\u2019s authority.",
      "blocks": [
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Inspection authority boundary",
          "guidance": "This original worksheet supports trace investigation but does not determine regulatory coverage or authorize a hold, release, or recall. A qualified owner must apply the current traceability plan and applicable requirements, preserve record history, and escalate any gap affecting lot identity or disposition."
        },
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Produce Traceability exception triggers",
          "items": [
            "Lot code, code source, or product identity is missing",
            "Quantity, unit, split, or transformation does not reconcile",
            "Event date, location, source, or recipient is missing",
            "Reference document or system link cannot be retrieved",
            "Label, case, pallet, invoice, or shipment mismatch",
            "Held, recalled, corrected, or commingled lot remains unresolved"
          ]
        },
