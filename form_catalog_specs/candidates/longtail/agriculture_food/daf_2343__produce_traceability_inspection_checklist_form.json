        {
          "key": "preparation_checks",
          "type": "checklist",
          "label": "Preparation and prior-record review",
          "items": [
            "Produce description, variety, quantity, and unit were recorded",
            "Traceability lot code and code-source location were captured",
            "Tracking event type, date, time, and location were captured",
            "Immediate previous source or next recipient was identified",
            "Reference document type and number were linked",
            "Transformation, repacking, or commingling links were preserved",
            "Corrections retain the original record and responsible person",
            "Held, recalled, or unreconciled lots remain visible"
          ]
        }
      ]
    },
    {
      "key": "condition_findings",
      "title": "Produce Traceability condition findings",
      "guidance": "Separate observed condition from disposition.",
      "blocks": [
        {
          "key": "inspection_points",
          "type": "checklist",
          "label": "Produce Traceability inspection points",
          "items": [
            "Produce description and quantity match the physical lot",
            "Traceability lot code is present, legible, and linked",
            "Code-source location or responsible source is identified",
            "Tracking event, date, time, and location are recorded",
            "Previous source or next recipient record is available",
            "Reference document type and number are linked",
            "Transformation or repacking preserves input-output relationships",
            "Commingled lots remain traceable to contributing sources",
            "Held, recalled, corrected, or split quantities are reconciled",
            "One-step-back and one-step-forward retrieval was tested"
