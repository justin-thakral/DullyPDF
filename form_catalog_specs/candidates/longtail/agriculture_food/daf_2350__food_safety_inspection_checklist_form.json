    {
      "key": "inspection_exceptions",
      "title": "Food Safety exceptions and escalation",
      "guidance": "Escalate uncertainty and conditions outside the reviewer\u2019s authority.",
      "blocks": [
        {
          "key": "authority_boundary",
          "type": "notice",
          "label": "Inspection authority boundary",
          "guidance": "This template records a facility workflow and does not replace a food-safety plan or qualified hazard decision. Apply current procedures and applicable requirements. Hold affected product and escalate whenever control status, product scope, or authorized disposition is uncertain."
        },
        {
          "key": "exception_triggers",
          "type": "checklist",
          "label": "Food Safety exception triggers",
          "items": [
            "Monitoring point, limit source, or reading is missing",
            "Process, sanitation, allergen, label, or supply-chain deviation",
            "Instrument, method, sample, or verification concern",
            "Affected product or lot scope is uncertain",
            "Hold, rework, release, disposal, or return decision is pending",
            "Record, notification, qualified review, or corrective action gap"
          ]
        },
        {
          "key": "escalation_record",
          "type": "textarea",
          "label": "Escalation facts, immediate action, owner, due point, and disposition",
          "fields": [
