              "units": 0.95
            }
          ]
        },
        {
          "key": "preparation_checks",
          "type": "checklist",
          "label": "Preparation and prior-record review",
          "items": [
            "Current plan, procedure, and monitoring point were identified",
            "Product, lot, line, shift, and process step were recorded",
            "Facility limit or target source was recorded without inventing a value",
            "Observation or measurement and instrument identity were captured",
            "Deviation, correction, and affected-product scope were identified",
            "Product hold or segregation was routed when status was uncertain",
            "Verification and records-review owner was assigned",
            "Corrective action, disposition, and recurrence follow-up were linked"
          ]
        }
      ]
    },
    {
      "key": "condition_findings",
      "title": "Food Safety condition findings",
      "guidance": "Separate observed condition from disposition.",
      "blocks": [
        {
          "key": "inspection_points",
          "type": "checklist",
          "label": "Food Safety inspection points",
          "items": [
            "Facility, area, process step, line, and shift were identified",
            "Personnel practices and access conditions were observed",
            "Cleaning, sanitation, and product-contact conditions were observed",
            "Allergen, label, rework, and changeover controls were reviewed",
            "Ingredient, packaging, and supply-chain status were reviewed",
            "Pest, waste, condensation, and environmental conditions were observed",
            "Equipment condition, maintenance, and instrument checks were reviewed",
            "Process readings and monitoring records were compared to the plan",
            "Held, rejected, reworked, or returned product remained identified",
            "Prior deviations and corrective actions were verified for closure"
          ]
        },
