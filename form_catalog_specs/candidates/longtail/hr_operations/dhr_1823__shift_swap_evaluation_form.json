      "title": "Shift Swap calibration, bias check, and exception review",
      "guidance": "Challenge unsupported assumptions and route material exceptions before a final conclusion.",
      "blocks": [
        {
          "key": "calibration_checks",
          "type": "checklist",
          "label": "Calibration and decision-quality checks",
          "items": [
