    {
      "key": "information_presented",
      "title": "Shift Swap information and responsibilities presented",
      "guidance": "Record what was actually explained; do not use a signature as a substitute for delivery.",
      "blocks": [
        {
          "key": "presented_topics",
          "type": "checklist",
          "label": "Shift Swap acknowledgment topics",
          "items": [
            "Both workers confirmed the exact original and proposed shift segments",
            "Agreement was voluntary and no payment or coercion occurred outside policy",
            "Role, location, credential, and task qualification were checked",
            "Rest interval, consecutive-work, and fatigue constraints were reviewed",
            "Overtime, premium, differential, and timekeeping effects were explained",
            "Approval is not effective until the scheduling system reflects the change",
            "Call-off, cancellation, and no-show duties were communicated to both workers",
            "Manager and scheduler contacts for a failed handoff were provided"
          ]
        },
