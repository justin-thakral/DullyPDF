      "key": "exceptions_privacy",
      "title": "Shift Swap exception, privacy, and escalation routing",
      "guidance": "Protect restricted information and preserve any concern requiring qualified review.",
      "blocks": [
        {
          "key": "ack_boundary",
          "type": "notice",
          "label": "Acknowledgment stop and escalation boundary",
          "guidance": "Pause any action outside documented authority. Protect privacy, preserve the original evidence, and route urgent, safety, security, retaliation, or legal concerns to the authorized scheduling, payroll, operations, or HR reviewer under the current schedule, role-qualification matrix, rest and overtime rules, labor agreement, and applicable scheduling policy."
        },
        {
          "key": "ack_triggers",
          "type": "checklist",
          "label": "Shift Swap exception and escalation triggers",
          "items": [
            "Approved change was not entered or appeared differently in a system",
            "Worker reported to the wrong time, role, unit, or location",
            "No-show or uncovered interval followed the exchange",
            "Worker lacked required qualification, access, or supervision",
            "Rest, fatigue, overtime, premium, or agreement constraint was missed",
            "Worker reports coercion, retaliation, side payment, or false consent",
            "Cancellation or reversal was not communicated to every affected party",
            "Timekeeping or payroll result does not match the approved schedule"
          ]
        },
