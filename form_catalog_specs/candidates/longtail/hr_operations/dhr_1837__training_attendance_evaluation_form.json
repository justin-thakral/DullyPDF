    {
      "key": "calibration_exceptions",
      "title": "Training Attendance calibration, bias check, and exception review",
      "guidance": "Challenge unsupported assumptions and route material exceptions before a final conclusion.",
      "blocks": [
        {
          "key": "calibration_checks",
          "type": "checklist",
          "label": "Calibration and decision-quality checks",
          "items": [
            "Criteria and rating definitions were established before the conclusion",
            "Evidence belongs to the stated subject, period, and decision",
            "Missing evidence is not treated as a negative fact",
            "Similar cases or records were assessed using the same standard",
            "Potential conflict of interest or prior involvement is disclosed",
            "Contrary evidence and the subject's response receive documented consideration",
            "Sensitive or protected information is excluded or separately routed",
            "Independent reviewer can reproduce the conclusion from the cited record"
          ]
        },
