      "key": "exceptions_privacy",
      "title": "Candidate Interview exception, privacy, and escalation routing",
      "guidance": "Protect restricted information and preserve any concern requiring qualified review.",
      "blocks": [
        {
          "key": "ack_boundary",
          "type": "notice",
          "label": "Acknowledgment stop and escalation boundary",
          "guidance": "Pause any action outside documented authority. Protect privacy, preserve the original evidence, and route urgent, safety, security, retaliation, or legal concerns to the qualified recruiting or HR reviewer under the approved requisition, structured interview plan, privacy rules, and applicable equal-employment requirements."
        },
        {
          "key": "ack_triggers",
          "type": "checklist",
          "label": "Candidate Interview exception and escalation triggers",
          "items": [
            "Inappropriate or non-job-related question was asked",
            "Candidate information reached an unintended recipient",
            "Interview recording occurred without required authorization",
            "Technology failure materially reduced the candidate's opportunity",
            "Panel conflict of interest or prior relationship was disclosed",
            "Approved interview questions or scoring anchors were not used",
            "Candidate reported harassment, bias, retaliation, or unsafe conduct",
            "Work sample, notes, or scorecard was lost, altered, or misattributed"
          ]
        },
