  "slug": "dhr-1807-employee-equipment-request-form-b866da34",
  "title": "Employee Equipment Request Form",
  "subtitle": "Use this request to route the need, test readiness, document review, authorize a bounded action, and verify implementation for a employee equipment workflow.",
  "description": "An original operational employee equipment request form that controls a employee asset and access package from identity and routing through evidence, qualified decision, exception management, implementation, handoff, and final verification.",
  "use_case": "Use when the hiring manager, workplace coordinator, or asset custodian needs a traceable request so the authorized workplace, IT, security, or HR reviewer can issue, ship, substitute, repair, recover, or deny the requested equipment package under the approved role profile, asset standard, security baseline, purchasing policy, and accommodation route without relying on an informal email, spreadsheet, or unreviewed narrative.",
  "risk_tier": "B",
