  "source_filename": "dhr_1821__shift_swap_request_form.pdf",
  "slug": "shift-swap-request-form",
  "title": "Shift Swap Request Form",
  "subtitle": "Use this request to route the need, test readiness, document review, authorize a bounded action, and verify implementation for a shift swap workflow.",
  "description": "An original operational shift swap request form that controls a paired schedule-change and coverage record from identity and routing through evidence, qualified decision, exception management, implementation, handoff, and final verification.",
  "use_case": "Use when the requesting workers, scheduler, or shift manager needs a traceable request so the authorized scheduling, payroll, operations, or HR reviewer can approve, conditionally approve, deny, cancel, reverse, or correct the proposed shift exchange under the current schedule, role-qualification matrix, rest and overtime rules, labor agreement, and applicable scheduling policy without relying on an informal email, spreadsheet, or unreviewed narrative.",
  "risk_tier": "B",
