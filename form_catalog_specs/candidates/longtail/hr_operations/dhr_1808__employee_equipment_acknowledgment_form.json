      "guidance": "Protect restricted information and preserve any concern requiring qualified review.",
      "blocks": [
        {
          "key": "ack_boundary",
          "type": "notice",
          "label": "Acknowledgment stop and escalation boundary",
          "guidance": "Pause any action outside documented authority. Protect privacy, preserve the original evidence, and route urgent, safety, security, retaliation, or legal concerns to the authorized workplace, IT, security, or HR reviewer under the approved role profile, asset standard, security baseline, purchasing policy, and accommodation route."
        },
        {
          "key": "ack_triggers",
          "type": "checklist",
          "label": "Employee Equipment exception and escalation triggers",
          "items": [
            "Device, badge, key, token, or accessory is lost or stolen",
            "Equipment is damaged, unsafe, contaminated, or unusable",
            "Asset tag, serial, assignment, or location record is inconsistent",
            "Suspected unauthorized access, malware, or data exposure occurred",
            "Shipment was misdirected, opened, incomplete, or not received",
            "Unapproved software, peripheral, account, or configuration was identified",
            "Return deadline was missed or recovered equipment remains unaccounted for",
            "Equipment failure prevented a critical assigned task or safe work"
          ]
