  "source_filename": "dhr_1800__candidate_interview_request_form.pdf",
  "slug": "candidate-interview-request-form",
  "title": "Candidate Interview Request Form",
  "subtitle": "Use this request to route the need, test readiness, document review, authorize a bounded action, and verify implementation for a candidate interview workflow.",
  "description": "An original operational candidate interview request form that controls a interview stage and candidate record from identity and routing through evidence, qualified decision, exception management, implementation, handoff, and final verification.",
  "use_case": "Use when the recruiting coordinator or interview lead needs a traceable request so the qualified recruiting or HR reviewer can advance, hold, decline, reschedule, or obtain additional job-related evidence under the approved requisition, structured interview plan, privacy rules, and applicable equal-employment requirements without relying on an informal email, spreadsheet, or unreviewed narrative.",
  "risk_tier": "B",
