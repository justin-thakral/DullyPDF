    {
      "key": "cause_evidence",
      "title": "Inventory Count adjustment reason and evidence",
      "guidance": "Use a reason supported by transaction and physical evidence, not a balancing convenience.",
      "blocks": [
        {
          "key": "reason_codes",
          "type": "checklist",
          "label": "Inventory Count supported adjustment reasons",
          "items": [
            "Verified physical count difference",
            "Unit-of-measure or pack conversion correction",
            "Unposted receipt, shipment, transfer, or production issue",
            "Wrong location, lot, serial, owner, or status correction",
            "Damage, scrap, expiry, or obsolescence disposition",
            "Duplicate transaction or count record reversal",
            "Consignment or customer-owned inventory correction",
            "Approved rounding, weight, or volume conversion"
          ]
        },
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Conditions requiring investigation or escalation",
          "items": [
            "Unlabeled, duplicate, or inaccessible location",
            "Unknown item, lot, serial, owner, or inventory status",
            "Mixed unit of measure or pack conversion is uncertain",
            "Physical movement occurred outside the documented cutoff",
            "First count and recount remain outside the threshold",
            "System shows stock where location is empty or the reverse",
            "Damaged, hold, consigned, or customer-owned quantity is commingled",
            "Count sheet or scan batch is missing, altered, or duplicated",
            "Scale, scanner, or system interface is unavailable",
            "Potential fraud, diversion, or deliberate record override requires escalation"
          ]
        },
