    {
      "key": "cause_evidence",
      "title": "Trailer adjustment reason and evidence",
      "guidance": "Use a reason supported by transaction and physical evidence, not a balancing convenience.",
      "blocks": [
        {
          "key": "reason_codes",
          "type": "checklist",
          "label": "Trailer supported adjustment reasons",
          "items": [
            "Trailer assigned or returned to fleet inventory",
            "Yard location corrected after physical verification",
            "Seal, lock, load bar, strap, or accessory count corrected",
            "Damage or defect moved trailer to maintenance hold",
            "Owner, carrier, or customer custody corrected",
            "Duplicate unit or interchange posting reversed",
            "Retired, sold, leased, or substituted trailer status posted",
            "Maintenance release restored available status"
          ]
        },
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Conditions requiring investigation or escalation",
          "items": [
            "Trailer identity, ownership, plate, or assignment mismatch",
            "Brake, light, tire, wheel, coupling, pin, or slider concern",
            "Landing gear, rail, frame, crossmember, roof, wall, floor, or door damage",
            "Leak, odor, debris, pest, contamination, or incompatible prior cargo",
            "Maintenance due, open work order, or out-of-service status",
            "Seal, lock, securement equipment, or accessory discrepancy",
            "Pre-existing damage or interchange responsibility is disputed",
            "Temperature-control or cargo-compatibility requirement cannot be met",
            "Yard location or custody transfer cannot be verified",
            "Road-service release lacks qualified authorization"
          ]
        },
        {
