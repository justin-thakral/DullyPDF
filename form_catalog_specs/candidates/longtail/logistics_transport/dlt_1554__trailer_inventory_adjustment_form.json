        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Record boundary and stop condition",
          "guidance": "This trailer inventory adjustment is an operational record, not a substitute for applicable law, contract terms, safety or product requirements, or professional judgment. Stop the affected movement, transfer, release, posting, or disposition when identity, evidence, authorization, or control is uncertain. A qualified qualified fleet maintenance or safety supervisor must review the exception and document the controlling decision."
        },
        {
          "key": "closeout_approval",
