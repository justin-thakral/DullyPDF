{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1554__trailer_inventory_adjustment_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1554__trailer_inventory_adjustment_form.pdf",
  "slug": "trailer-inventory-adjustment-form",
  "title": "Trailer Inventory Adjustment Form",
  "subtitle": "Reconcile the trailer source state to verified evidence, explain every variance, control affected inventory, authorize exact postings, and verify the ledger.",
  "description": "An original, fillable trailer inventory adjustment form for controlling trailer asset, interchange, load space, and road-readiness record through inventory adjustment identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use when trailer, equipment, seal, and accessory count or related identity, location, status, or ownership differs from the system and a controlled adjustment must remain traceable from physical evidence through approval, posting, and after-state verification.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Trailer inventory adjustment identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Trailer record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Inventory Adjustment record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Trailer unit, VIN, and interchange number",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Plate, seal, work-order, or yard-location ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned fleet or yard coordinator",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Driver, Yard Hostler, Or Receiving Carrier",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Owning yard, customer dock, or prior carrier",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Assigned route, customer, carrier, or return yard",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the trailer master, inspection criteria, maintenance record, and interchange terms."
        }
      ]
    },
    {
      "key": "adjustment_boundary",
      "title": "Trailer inventory boundary and source state",
      "guidance": "Freeze the affected identity, location, cutoff, and source balances before proposing a posting.",
      "blocks": [
        {
          "key": "source_state",
          "type": "fields",
          "label": "Source inventory state",
          "fields": [
            {
              "key": "system_snapshot",
              "label": "System snapshot date and time",
              "units": 1.15
            },
            {
              "key": "transaction_cutoff",
              "label": "Transaction cutoff or through-time",
              "units": 1.2
            },
            {
              "key": "location",
              "label": "Owning yard, customer dock, or prior carrier",
              "units": 1.35
            },
            {
              "key": "record_owner",
              "label": "Source record owner or fleet or yard coordinator",
              "units": 1.25
            }
          ]
        },
        {
          "key": "boundary_controls",
          "type": "checklist",
          "label": "Trailer adjustment controls",
          "items": [
            "Trailer unit, VIN, plate, owner, type, dimensions, and capacity are matched",
            "Assigned tractor, driver, route, cargo, and customer requirements are compatible",
            "Brake connections, lights, tires, coupling, landing gear, doors, and structure are checked",
            "Interior, roof, floor, walls, drain, odor, debris, and prior-cargo condition are reviewed",
            "Maintenance due, out-of-service status, open work order, and defect history are known",
            "Seal, lock, securement equipment, spare equipment, and document pouch are reconciled",
            "Yard location, pickup time, return expectation, and custody parties are recorded",
            "Unsafe defect, damage dispute, contamination, and alternate-equipment routes are defined"
          ],
          "guidance": "Do not post until movement, unit, ownership, status, and evidence boundaries are understood."
        },
        {
          "key": "approval_threshold",
          "type": "fields",
          "label": "Authority and posting threshold",
          "fields": [
            {
              "key": "adjustment_type",
              "label": "Adjustment type",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Quantity",
                "Location",
                "Status",
                "Lot or serial",
                "Ownership",
                "Reversal"
              ]
            },
            {
              "key": "threshold",
              "label": "Value or quantity approval threshold",
              "units": 1.25
            },
            {
              "key": "posting_system",
              "label": "System or ledger to update",
              "units": 1.2
            },
            {
              "key": "restricted_period",
              "label": "Closed period or restriction",
              "units": 1.15
            }
          ]
        }
      ]
    },
