            {
              "key": "details",
              "label": "Delivery location, recipient authority, custody, and condition facts",
              "multiline": true
            }
          ],
          "height": 58
        }
      ]
    },
    {
      "key": "delivery_exceptions",
      "title": "Courier exception, containment, and escalation",
      "guidance": "Make the trigger, affected scope, immediate control, owner, deadline, and escalation reconstructable.",
      "blocks": [
        {
          "key": "delivery_exception_types",
          "type": "checklist",
          "label": "Courier exception indicators",
          "items": [
            "Sender is not ready at committed pickup time",
            "Envelope, parcel, pouch, or seal identity differs from manifest",
            "Package condition suggests opening, tampering, or damage",
            "Courier cannot access the pickup or delivery control point",
            "Named recipient or permitted alternate is unavailable",
            "Delivery deadline is at risk or missed",
            "Security screening conflicts with handling instruction",
            "Tracking scan or signature capture is unavailable",
            "Unplanned custody transfer or vehicle change is required",
            "Sender, recipient, or dispatcher disputes the recorded piece count"
          ],
          "guidance": "Select every observed condition; do not use a generic exception mark when the actual trigger is known."
        },
        {
          "key": "delivery_action_log",
