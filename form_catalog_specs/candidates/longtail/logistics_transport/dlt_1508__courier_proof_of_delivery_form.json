{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1508__courier_proof_of_delivery_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1508__courier_proof_of_delivery_form.pdf",
  "slug": "courier-proof-of-delivery-form",
  "title": "Courier Proof of Delivery Form",
  "subtitle": "Authenticate the courier delivery through unit identity, custody events, recipient authority, location, timing, condition, and privacy-conscious proof.",
  "description": "An original, fillable courier proof of delivery form for controlling time-critical document or parcel consignment through proof of delivery identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use after a courier delivery or failed attempt when operations must establish what was delivered, to whom, where, when, under which control, and how any evidence gap or dispute was routed.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Courier proof of delivery identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
