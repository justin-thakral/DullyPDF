              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Identified Courier",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Pickup contact and controlled pickup point",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Named recipient and exact handoff point",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the dispatch order, tracking record, and custody manifest."
        }
      ]
    },
    {
      "key": "proof_commitment",
      "title": "Courier delivery obligation and proof standard",
      "guidance": "Define the promised event and acceptable evidence before evaluating whether delivery was completed.",
      "blocks": [
        {
          "key": "delivery_obligation",
          "type": "fields",
          "label": "Delivery obligation",
          "fields": [
            {
              "key": "promised_window",
              "label": "Promised delivery window",
              "units": 1.1
            },
            {
              "key": "actual_completion",
              "label": "Actual completion date and time",
              "units": 1.1
            },
            {
              "key": "proof_standard",
              "label": "Required proof method",
              "units": 1.2
            },
            {
              "key": "authorized_recipient",
              "label": "Named Recipient Or Controlled Mailroom",
              "units": 1.3
            }
          ]
        },
        {
          "key": "proof_controls",
          "type": "checklist",
          "label": "Courier custody and proof controls",
          "items": [
            "Direct service with no intermediate stop",
            "Tamper-evident pouch or seal",
            "Named-recipient-only delivery",
            "Identification verification under applicable policy",
            "Continuous chain of custody",
            "Do not x-ray or special screening instruction",
            "Return signed document or receipt",
            "Wait-and-return service"
          ],
          "guidance": "Select the controls actually required for this delivery, not every available service feature."
        },
        {
          "key": "route_assignment",
          "type": "fields",
          "label": "Route, custodian, and destination assignment",
          "fields": [
            {
              "key": "route",
