        {
          "key": "proof_evidence",
          "type": "checklist",
          "label": "Courier proof package",
          "items": [
            "Dispatch acceptance timestamp",
            "Pickup scan and sender handoff confirmation",
            "Seal or pouch identity image",
            "Courier location or milestone timestamp",
            "Security desk or controlled transfer record",
            "Recipient identity method and signature reference",
            "Attempt, refusal, or return scan",
            "Final tracking and custody reconciliation"
          ],
          "guidance": "Capture only the evidence needed to authenticate the event and follow privacy, access, and retention policy."
        },
        {
          "key": "delivery_facts",
          "type": "textarea",
          "label": "Delivery location, recipient authority, custody, and condition facts",
