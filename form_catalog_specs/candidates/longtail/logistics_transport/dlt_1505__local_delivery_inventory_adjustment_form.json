              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Balanced",
                "Balanced with correction",
                "Pending evidence",
                "Unresolved"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "cause_evidence",
      "title": "Local Delivery adjustment reason and evidence",
      "guidance": "Use a reason supported by transaction and physical evidence, not a balancing convenience.",
      "blocks": [
        {
          "key": "reason_codes",
          "type": "checklist",
          "label": "Local Delivery supported adjustment reasons",
          "items": [
            "Route load count corrected before departure",
            "Mis-sort moved to the correct stop",
            "Short pick or unavailable item confirmed",
            "Customer refusal or canceled order returned",
            "Damaged item moved to hold",
            "Reusable tote or container balance corrected",
            "Substitution or partial fulfillment documented",
            "Duplicate scan or system posting corrected"
          ]
        },
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Conditions requiring investigation or escalation",
          "items": [
            "Address or access point cannot be located",
            "Recipient unavailable or refuses delivery",
            "Package is missing, extra, mislabeled, or assigned to another stop",
            "Packaging or contents show visible damage or leakage",
            "Delivery window will be missed",
            "Identity, signature, or age condition cannot be completed",
            "Unsafe parking, property condition, animal, or other site hazard",
            "Customer requests an unapproved alternate delivery location",
            "Proof capture fails or conflicts with the delivered stop",
            "Return item or reusable container cannot be reconciled"
          ]
        },
        {
