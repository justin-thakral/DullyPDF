{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1505__local_delivery_inventory_adjustment_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1505__local_delivery_inventory_adjustment_form.pdf",
  "slug": "local-delivery-inventory-adjustment-form",
  "title": "Local Delivery Inventory Adjustment Form",
  "subtitle": "Reconcile the local delivery source state to verified evidence, explain every variance, control affected inventory, authorize exact postings, and verify the ledger.",
  "description": "An original, fillable local delivery inventory adjustment form for controlling multi-stop local order through inventory adjustment identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use when expected and delivered pieces or related identity, location, status, or ownership differs from the system and a controlled adjustment must remain traceable from physical evidence through approval, posting, and after-state verification.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Local Delivery inventory adjustment identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Local Delivery record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Inventory Adjustment record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Route and stop number",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Order, tote, or package ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned route dispatcher",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Assigned Driver",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Origin store, hub, or pickup point",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Delivery address and stop access point",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the route plan, customer order, and package labels."
        }
      ]
    },
    {
      "key": "adjustment_boundary",
      "title": "Local Delivery inventory boundary and source state",
      "guidance": "Freeze the affected identity, location, cutoff, and source balances before proposing a posting.",
      "blocks": [
        {
          "key": "source_state",
          "type": "fields",
          "label": "Source inventory state",
          "fields": [
            {
              "key": "system_snapshot",
              "label": "System snapshot date and time",
              "units": 1.15
            },
            {
              "key": "transaction_cutoff",
              "label": "Transaction cutoff or through-time",
              "units": 1.2
            },
            {
              "key": "location",
              "label": "Origin store, hub, or pickup point",
              "units": 1.35
            },
            {
              "key": "record_owner",
              "label": "Source record owner or route dispatcher",
              "units": 1.25
            }
          ]
        },
        {
          "key": "boundary_controls",
          "type": "checklist",
          "label": "Local Delivery adjustment controls",
          "items": [
            "Stop sequence matches promised delivery windows and traffic constraints",
            "Every order is matched to route, stop, package, and recipient identifiers",
            "Vehicle capacity and package placement support the planned stop sequence",
            "Driver has access instructions, contact method, and failed-attempt rules",
            "Age, identity, signature, or photo requirements are explicit where applicable",
            "Fragile, upright, temperature, and no-unattended-delivery controls are visible",
            "Returns, exchanges, cash handling, or reusable containers have separate custody",
            "Dispatcher has a communication and escalation path for route disruption"
          ],
          "guidance": "Do not post until movement, unit, ownership, status, and evidence boundaries are understood."
        },
        {
          "key": "approval_threshold",
          "type": "fields",
          "label": "Authority and posting threshold",
          "fields": [
            {
              "key": "adjustment_type",
              "label": "Adjustment type",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Quantity",
                "Location",
                "Status",
                "Lot or serial",
                "Ownership",
                "Reversal"
              ]
            },
            {
              "key": "threshold",
              "label": "Value or quantity approval threshold",
              "units": 1.25
            },
            {
              "key": "posting_system",
              "label": "System or ledger to update",
              "units": 1.2
            },
            {
              "key": "restricted_period",
              "label": "Closed period or restriction",
              "units": 1.15
            }
          ]
        }
      ]
    },
    {
