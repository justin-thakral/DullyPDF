    {
      "key": "closeout_handoff",
      "title": "Courier dispatch sheet closeout and accountable handoff",
      "guidance": "Close only when outcome, remaining limitation, next action, evidence, and receiving ownership agree.",
      "blocks": [
        {
          "key": "remaining_actions",
          "type": "table",
          "label": "Remaining action and follow-up register",
          "columns": [
            {
              "key": "action",
