{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1510__courier_dispatch_sheet_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1510__courier_dispatch_sheet_form.pdf",
  "slug": "courier-dispatch-sheet-form",
  "title": "Courier Dispatch Sheet Form",
  "subtitle": "Turn the courier request into a capacity-checked manifest, assigned route, custody plan, handling controls, exception path, and authorized release.",
  "description": "An original, fillable courier dispatch sheet form for controlling time-critical document or parcel consignment through dispatch sheet identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use before on-demand courier movement when the courier dispatcher, identified courier, and receiving owner need one executable dispatch record from commitment through manifest, sequence, variance management, and return handoff.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Courier dispatch sheet identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Courier record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Dispatch Sheet record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Dispatch and tracking number",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Envelope, parcel, pouch, or seal ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned courier dispatcher",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Identified Courier",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Pickup contact and controlled pickup point",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Named recipient and exact handoff point",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the dispatch order, tracking record, and custody manifest."
        }
      ]
    },
    {
      "key": "dispatch_commitment",
      "title": "Courier service commitment and assignment",
      "guidance": "Convert the request into an executable assignment with clear timing, capacity, and accountable custody.",
      "blocks": [
        {
          "key": "service_assignment",
          "type": "fields",
          "label": "Dispatch assignment",
          "fields": [
            {
              "key": "requested_by",
              "label": "Requested by",
              "units": 1.0
            },
            {
              "key": "ready_time",
              "label": "Ready date and time",
              "units": 1.0
            },
            {
              "key": "required_completion",
              "label": "Required completion",
              "units": 1.05
            },
            {
              "key": "priority",
              "label": "Priority or service level",
              "units": 1.05
            },
            {
              "key": "assigned_custodian",
              "label": "Identified Courier",
              "units": 1.25
            }
          ]
        },
        {
          "key": "dispatch_readiness",
          "type": "checklist",
          "label": "Courier dispatch readiness",
          "items": [
            "Named pickup and recipient contacts match the dispatch instruction",
            "Each envelope, parcel, pouch, or seal has a unique manifest identity",
            "Ready time, delivery deadline, and permitted intermediate stops are explicit",
            "Courier identity, vehicle or route, and communication method are assigned",
            "Signature, identification, chain-of-custody, or photo proof is specified",
            "Secure pouch, tamper seal, orientation, and environmental controls are available",
            "Building access, security desk, floor, and after-hours instructions are confirmed",
            "Refusal, unreachable contact, and return-to-sender routing are defined"
          ],
          "guidance": "Resolve failed readiness controls before authorization or record the approved alternate."
        },
        {
          "key": "equipment_capacity",
          "type": "fields",
          "label": "Equipment, capacity, and route constraint",
          "fields": [
            {
              "key": "equipment",
              "label": "Assigned vehicle, equipment, or work area",
              "units": 1.35
            },
            {
              "key": "capacity",
              "label": "Capacity or available space",
              "units": 1.0
            },
            {
              "key": "route_constraint",
              "label": "Route, cutoff, or site constraint",
              "units": 1.25
            },
            {
              "key": "communication",
              "label": "Primary communication method",
              "units": 1.05
            }
          ]
        }
      ]
    },
    {
      "key": "dispatch_manifest",
      "title": "Courier dispatch manifest and control assignment",
      "guidance": "Tie each movement unit to its quantity, custody, destination, and handling control.",
      "blocks": [
        {
          "key": "manifest_lines",
          "type": "table",
          "label": "Courier Envelopes, Parcels, Seals, And Custody Units dispatch manifest",
          "columns": [
            {
              "key": "unit_id",
              "label": "Envelope, parcel, pouch, or seal ID",
              "units": 1.35
            },
            {
              "key": "quantity",
              "label": "Manifested and accepted pieces",
              "units": 1.0
            },
            {
              "key": "origin",
              "label": "Origin or source point",
              "units": 1.05
            },
            {
              "key": "destination",
              "label": "Destination or handoff",
              "units": 1.1
            },
            {
              "key": "control",
              "label": "Service level and custody restriction",
              "units": 1.15
            },
            {
              "key": "proof",
              "label": "Required proof or scan",
              "units": 1.0
            }
          ],
          "rows": 7
        },
        {
          "key": "manifest_totals",
          "type": "fields",
          "label": "Manifest and capacity totals",
          "fields": [
            {
              "key": "unit_total",
              "label": "Total units",
              "units": 0.85
            },
            {
              "key": "quantity_total",
              "label": "Total quantity",
              "units": 0.9
            },
            {
              "key": "weight_volume",
              "label": "Weight, volume, or capacity use",
              "units": 1.2
            },
            {
              "key": "manifest_status",
              "label": "Manifest status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Reconciled",
                "Pending verification",
                "Partial assignment",
                "On hold"
              ]
            },
            {
              "key": "control_reference",
              "label": "Control or instruction reference",
              "units": 1.25
            }
          ]
        }
      ]
    },
    {
      "key": "route_handoff_plan",
      "title": "Courier route, sequence, and custody plan",
      "guidance": "Plan each control point and define the handoff evidence before execution begins.",
      "blocks": [
        {
          "key": "route_stops",
          "type": "table",
          "label": "Route, work sequence, and handoff plan",
          "columns": [
            {
              "key": "sequence",
              "label": "Sequence",
              "units": 0.65
            },
            {
              "key": "location",
              "label": "Location or control point",
              "units": 1.3
            },
            {
              "key": "window",
              "label": "Planned window",
              "units": 0.9
            },
            {
              "key": "contact",
              "label": "Contact or custodian",
              "units": 1.05
            },
            {
              "key": "action",
              "label": "Required action",
              "units": 1.25
            },
            {
              "key": "proof",
              "label": "Proof or completion ref",
              "units": 1.05
            }
          ],
          "rows": 6
        },
        {
          "key": "handling_controls",
          "type": "checklist",
          "label": "Courier assigned handling controls",
          "items": [
            "Direct service with no intermediate stop",
            "Tamper-evident pouch or seal",
            "Named-recipient-only delivery",
            "Identification verification under applicable policy",
            "Continuous chain of custody",
            "Do not x-ray or special screening instruction",
            "Return signed document or receipt",
            "Wait-and-return service"
          ]
        },
        {
          "key": "dispatch_instructions",
          "type": "textarea",
          "label": "Access, loading, custody, contingency, and return instructions",
          "fields": [
            {
              "key": "details",
              "label": "Access, loading, custody, contingency, and return instructions",
              "multiline": true
            }
          ],
          "height": 58,
          "guidance": "Write only instructions the assignee cannot reliably infer from labels, route data, or standard procedure."
        }
      ]
    },
    {
      "key": "dispatch_exceptions",
      "title": "Courier exception, containment, and escalation",
      "guidance": "Make the trigger, affected scope, immediate control, owner, deadline, and escalation reconstructable.",
      "blocks": [
        {
          "key": "dispatch_exception_types",
          "type": "checklist",
          "label": "Courier exception indicators",
          "items": [
            "Sender is not ready at committed pickup time",
            "Envelope, parcel, pouch, or seal identity differs from manifest",
            "Package condition suggests opening, tampering, or damage",
            "Courier cannot access the pickup or delivery control point",
            "Named recipient or permitted alternate is unavailable",
            "Delivery deadline is at risk or missed",
            "Security screening conflicts with handling instruction",
            "Tracking scan or signature capture is unavailable",
            "Unplanned custody transfer or vehicle change is required",
            "Sender, recipient, or dispatcher disputes the recorded piece count"
          ],
          "guidance": "Select every observed condition; do not use a generic exception mark when the actual trigger is known."
        },
        {
          "key": "dispatch_action_log",
          "type": "table",
          "label": "Exception containment and action log",
          "columns": [
            {
              "key": "issue_scope",
              "label": "Issue and affected ID",
              "units": 1.35
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.25
            },
            {
              "key": "owner",
              "label": "Action owner",
              "units": 0.9
            },
            {
              "key": "due",
              "label": "Due point",
              "units": 0.8
            },
            {
              "key": "escalation",
              "label": "Escalation or proof ref",
              "units": 1.2
            }
          ],
          "rows": 4
        },
        {
          "key": "dispatch_decision",
          "type": "fields",
          "label": "Dispatch variance, alternate assignment, or stop-work decision",
          "fields": [
