              "units": 1.15
            }
          ],
          "rows": 4
        },
        {
          "key": "disposition",
          "type": "fields",
          "label": "Temperature-control disposition",
          "fields": [
            {
              "key": "decision",
              "label": "Disposition",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Accepted within range",
                "Released after qualified review",
                "Restricted use or movement",
                "Continue hold",
                "Reject or return"
              ]
            },
            {
              "key": "authorized_scope",
              "label": "Authorized lot, quantity, or interval",
              "units": 1.35
            },
            {
              "key": "remaining_restriction",
              "label": "Remaining restriction",
              "units": 1.25
            },
            {
              "key": "decision_reference",
              "label": "Decision and rationale reference",
              "units": 1.35
            }
          ]
        },
        {
          "key": "disposition_signoff",
          "type": "signatures",
          "label": "Monitoring review and disposition authorization",
          "fields": [
            {
              "key": "log_preparer",
              "label": "Log prepared by and date",
              "units": 1.2
            },
            {
              "key": "qualified_reviewer",
              "label": "Courier Service Supervisor decision",
              "units": 1.5
            },
            {
              "key": "custody_owner",
              "label": "Custody owner acknowledgment",
              "units": 1.25
            }
          ]
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Courier temperature log closeout and accountable handoff",
      "guidance": "Close only when outcome, remaining limitation, next action, evidence, and receiving ownership agree.",
      "blocks": [
        {
          "key": "remaining_actions",
          "type": "table",
          "label": "Remaining action and follow-up register",
          "columns": [
            {
              "key": "action",
              "label": "Remaining action",
              "units": 1.4
            },
            {
              "key": "owner",
              "label": "Responsible owner",
              "units": 1.0
            },
            {
              "key": "due",
              "label": "Due date or trigger",
              "units": 1.0
            },
            {
              "key": "evidence",
              "label": "Completion evidence",
              "units": 1.2
            }
          ],
          "rows": 4
        },
        {
          "key": "final_outcome",
          "type": "fields",
          "label": "Final outcome, handoff, and record location",
          "fields": [
            {
              "key": "outcome",
              "label": "Final outcome",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Range maintained and closed",
                "Excursion reviewed and released",
                "Restricted disposition completed",
                "Held for further evidence",
                "Rejected, returned, or removed"
              ]
            },
            {
              "key": "handoff_to",
              "label": "Handoff accepted by",
              "units": 1.15
            },
            {
              "key": "record_location",
              "label": "Evidence package location",
              "units": 1.35
            },
            {
              "key": "closed_at",
              "label": "Closed date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Record boundary and stop condition",
          "guidance": "This courier temperature log is an operational record, not a substitute for applicable law, contract terms, safety or product requirements, or professional judgment. Stop the affected movement, transfer, release, posting, or disposition when identity, evidence, authorization, or control is uncertain. A qualified courier service supervisor must review the exception and document the controlling decision."
        },
        {
          "key": "closeout_approval",
          "type": "signatures",
          "label": "Prepared, reviewed, and accepted",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by and date",
              "units": 1.2
            },
            {
              "key": "reviewed_by",
              "label": "Reviewed by courier service supervisor",
              "units": 1.45
            },
            {
              "key": "accepted_by",
              "label": "Receiving owner acceptance",
              "units": 1.25
            }
          ],
          "guidance": "A signature records accountability for the stated decision; it does not cure missing evidence or override a stop condition."
        }
      ]
    }
  ]
