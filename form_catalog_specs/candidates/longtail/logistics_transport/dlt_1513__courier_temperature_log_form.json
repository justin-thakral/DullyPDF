{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1513__courier_temperature_log_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1513__courier_temperature_log_form.pdf",
  "slug": "courier-temperature-log-form",
  "title": "Courier Temperature Log Form",
  "subtitle": "Define the courier temperature range and monitoring setup, record chronological readings and events, contain excursions, and obtain qualified disposition.",
  "description": "An original, fillable courier temperature log form for controlling time-critical document or parcel consignment through temperature log identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use during on-demand courier movement when temperature or related environmental control must be reconstructed from identified devices, checkpoints, readings, custody events, equipment observations, excursion response, and final review.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Courier temperature log identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Courier record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Temperature Log record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Dispatch and tracking number",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Envelope, parcel, pouch, or seal ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned courier dispatcher",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Identified Courier",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Pickup contact and controlled pickup point",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Named recipient and exact handoff point",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the dispatch order, tracking record, and custody manifest."
        }
      ]
    },
    {
      "key": "temperature_requirements",
      "title": "Courier temperature requirements and monitoring setup",
      "guidance": "Record the controlling range, method, devices, and responsibilities before relying on readings.",
      "blocks": [
        {
          "key": "range_requirement",
          "type": "fields",
          "label": "Approved range and exposure boundary",
          "fields": [
            {
              "key": "lower_limit",
              "label": "Approved lower limit and units",
              "units": 1.15
            },
            {
              "key": "upper_limit",
              "label": "Approved upper limit and units",
              "units": 1.15
            },
            {
              "key": "exposure_limit",
              "label": "Maximum exposure or excursion rule",
              "units": 1.25
            },
            {
              "key": "requirements_source",
              "label": "Protocol, label, or requirement source",
              "units": 1.4
            }
          ]
        },
        {
          "key": "monitoring_equipment",
          "type": "fields",
          "label": "Monitoring equipment and verification",
          "fields": [
            {
              "key": "device_id",
              "label": "Logger, probe, display, or meter ID",
              "units": 1.35
            },
            {
              "key": "calibration",
              "label": "Calibration or verification status",
              "units": 1.2
            },
            {
              "key": "accuracy",
              "label": "Accuracy or uncertainty",
              "units": 1.0
            },
            {
              "key": "placement",
              "label": "Device placement or measurement point",
              "units": 1.35
            }
          ]
        },
        {
          "key": "required_checkpoints",
          "type": "checklist",
          "label": "Courier required temperature checkpoints",
          "items": [
            "Sender holding point",
            "Courier container before acceptance",
            "Pickup product surface or package",
            "First custody transfer",
            "Mid-route container check",
            "Delivery arrival",
            "Recipient acceptance",
            "Returned consignment"
          ],
          "guidance": "Use the reading table for actual values; this list defines the intended monitoring coverage."
        }
      ]
    },
    {
      "key": "temperature_readings",
      "title": "Courier chronological temperature readings",
      "guidance": "Record readings as observed with location, device, responsible person, and relevant event.",
      "blocks": [
        {
          "key": "reading_log",
          "type": "table",
          "label": "Temperature reading log",
          "columns": [
            {
              "key": "date_time",
              "label": "Date and time",
              "units": 0.9
            },
            {
              "key": "point",
              "label": "Location or checkpoint",
              "units": 1.2
            },
            {
              "key": "device",
              "label": "Device ID",
              "units": 0.9
            },
            {
              "key": "reading",
              "label": "Reading and units",
              "units": 0.95
            },
            {
              "key": "event",
              "label": "Door, transfer, delay, or event",
              "units": 1.25
            },
            {
              "key": "observer",
              "label": "Observer or source",
              "units": 1.0
            }
          ],
          "rows": 8
        },
        {
          "key": "reading_summary",
          "type": "fields",
          "label": "Reading and exposure summary",
          "fields": [
            {
              "key": "minimum",
              "label": "Minimum observed",
              "units": 0.95
            },
            {
              "key": "maximum",
              "label": "Maximum observed",
              "units": 0.95
            },
            {
              "key": "out_of_range",
              "label": "Out-of-range duration",
              "units": 1.05
            },
            {
              "key": "missing_interval",
              "label": "Missing-data interval",
              "units": 1.1
            },
            {
              "key": "summary_status",
              "label": "Initial status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Within range",
                "Potential excursion",
                "Confirmed excursion",
                "Data incomplete",
                "Device unreliable"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "control_observations",
      "title": "Courier environmental and handling observations",
      "guidance": "Connect readings to the operational conditions that can explain or affect temperature control.",
      "blocks": [
        {
          "key": "handling_controls",
          "type": "checklist",
          "label": "Courier temperature-control practices",
          "items": [
            "Direct service with no intermediate stop",
            "Tamper-evident pouch or seal",
            "Named-recipient-only delivery",
            "Identification verification under applicable policy",
            "Continuous chain of custody",
            "Do not x-ray or special screening instruction",
            "Return signed document or receipt",
            "Wait-and-return service"
          ]
        },
        {
          "key": "readiness_controls",
          "type": "checklist",
          "label": "Equipment, custody, and response readiness",
          "items": [
            "Named pickup and recipient contacts match the dispatch instruction",
            "Each envelope, parcel, pouch, or seal has a unique manifest identity",
            "Ready time, delivery deadline, and permitted intermediate stops are explicit",
            "Courier identity, vehicle or route, and communication method are assigned",
            "Signature, identification, chain-of-custody, or photo proof is specified",
            "Secure pouch, tamper seal, orientation, and environmental controls are available",
            "Building access, security desk, floor, and after-hours instructions are confirmed",
            "Refusal, unreachable contact, and return-to-sender routing are defined"
          ]
        },
        {
          "key": "observation_notes",
          "type": "textarea",
          "label": "Equipment status, packaging condition, door events, delays, and other observations",
          "fields": [
            {
              "key": "details",
              "label": "Equipment status, packaging condition, door events, delays, and other observations",
              "multiline": true
            }
          ],
          "height": 62,
          "guidance": "Do not infer product suitability from an ambient reading alone; preserve the measurement context."
        }
      ]
    },
    {
      "key": "excursion_response",
      "title": "Courier temperature excursion and immediate response",
      "guidance": "Stop affected release or use, protect evidence, and assign qualified disposition when control is uncertain.",
      "blocks": [
        {
          "key": "excursion_indicators",
          "type": "checklist",
          "label": "Excursion or monitoring failure indicators",
          "items": [
            "Reading above the approved upper limit",
            "Reading below the approved lower limit",
            "Freeze exposure or freeze indicator",
            "Alarm, logger, probe, display, or meter failure",
            "Missing, overwritten, delayed, or conflicting temperature data",
            "Unplanned door opening, transfer, delay, or power interruption",
            "Packaging, seal, coolant, compartment, tank, or equipment damage",
            "Product or controlled material condition concern",
            "Monitoring responsibility or custody interval cannot be established",
            "No excursion or monitoring failure observed"
          ]
        },
        {
          "key": "excursion_actions",
          "type": "table",
          "label": "Excursion containment and investigation log",
          "columns": [
            {
              "key": "affected_scope",
              "label": "Affected lot, unit, or interval",
              "units": 1.35
            },
            {
              "key": "immediate_action",
              "label": "Immediate action or hold",
              "units": 1.25
            },
            {
              "key": "owner",
              "label": "Action owner",
              "units": 0.9
            },
            {
              "key": "due",
              "label": "Review due",
              "units": 0.8
            },
            {
              "key": "evidence",
              "label": "Logger, probe, photo, or record ref",
              "units": 1.25
            }
          ],
          "rows": 5
        },
        {
          "key": "notification",
          "type": "fields",
          "label": "Excursion notification and custody",
          "fields": [
            {
              "key": "notified",
              "label": "Qualified reviewer notified",
              "units": 1.2
            },
            {
              "key": "notification_time",
              "label": "Notification date and time",
              "units": 1.1
            },
            {
              "key": "hold_location",
              "label": "Hold, quarantine, or controlled location",
              "units": 1.35
            },
            {
              "key": "custody_owner",
              "label": "Current custody owner",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "temperature_disposition",
      "title": "Courier temperature assessment and disposition",
      "guidance": "Document the evidence reviewed, authorized scope, restrictions, and rationale for the final decision.",
      "blocks": [
        {
          "key": "assessment_evidence",
          "type": "table",
          "label": "Qualified assessment evidence",
          "columns": [
            {
              "key": "evidence",
              "label": "Evidence or requirement",
              "units": 1.45
            },
            {
              "key": "scope",
              "label": "Affected scope",
              "units": 1.0
            },
            {
              "key": "finding",
              "label": "Finding or limitation",
              "units": 1.3
            },
            {
              "key": "reviewer",
              "label": "Reviewer",
              "units": 0.9
            },
            {
              "key": "reference",
