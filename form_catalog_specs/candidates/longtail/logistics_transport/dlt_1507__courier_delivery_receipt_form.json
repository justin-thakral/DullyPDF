          "guidance": "Manifested and accepted pieces"
        }
      ]
    },
    {
      "key": "condition_evidence",
      "title": "Courier condition inspection and receipt evidence",
      "guidance": "Preserve observations made before the receiver changes packaging, custody, or physical condition.",
      "blocks": [
        {
          "key": "condition_checks",
          "type": "checklist",
          "label": "Courier receipt inspection",
          "items": [
            "Dispatch number and tracking identity agree across label and manifest",
            "Piece count and package identifiers agree with the pickup record",
            "Tamper seal, pouch closure, and package surfaces show no unexplained change",
            "Recipient name and acceptable alternate recipient rules are explicit",
            "Required delivery deadline and escalation trigger are visible",
            "Courier can preserve custody through access screening or security handoff",
            "No prohibited or undeclared contents are apparent under applicable policy",
            "Tracking scan can be captured at pickup, transfer, attempt, and delivery",
            "Proof method protects confidential information unrelated to the delivery",
            "Any seal, identity, count, deadline, or access discrepancy is stopped and routed"
          ]
        },
        {
          "key": "evidence_index",
          "type": "table",
          "label": "Receipt evidence index",
          "columns": [
            {
              "key": "evidence",
              "label": "Evidence or observation",
              "units": 1.45
            },
            {
              "key": "unit",
              "label": "Affected unit ID",
              "units": 1.1
            },
            {
              "key": "captured_by",
              "label": "Captured by",
              "units": 0.9
            },
            {
              "key": "reference",
              "label": "Photo, scan, or record ref",
              "units": 1.3
            }
          ],
          "rows": 4,
          "guidance": "Record only necessary proof and preserve privacy or security restrictions."
        },
        {
          "key": "condition_narrative",
          "type": "textarea",
          "label": "Condition, count, custody, and acceptance narrative",
          "fields": [
            {
              "key": "details",
              "label": "Condition, count, custody, and acceptance narrative",
              "multiline": true
            }
          ],
          "height": 54,
          "guidance": "Describe facts that cannot be reconstructed from the line table or evidence reference."
        }
      ]
    },
    {
      "key": "receipt_exceptions",
      "title": "Courier exception, containment, and escalation",
      "guidance": "Make the trigger, affected scope, immediate control, owner, deadline, and escalation reconstructable.",
      "blocks": [
        {
          "key": "receipt_exception_types",
          "type": "checklist",
          "label": "Courier exception indicators",
          "items": [
            "Sender is not ready at committed pickup time",
            "Envelope, parcel, pouch, or seal identity differs from manifest",
            "Package condition suggests opening, tampering, or damage",
            "Courier cannot access the pickup or delivery control point",
            "Named recipient or permitted alternate is unavailable",
            "Delivery deadline is at risk or missed",
            "Security screening conflicts with handling instruction",
            "Tracking scan or signature capture is unavailable",
            "Unplanned custody transfer or vehicle change is required",
            "Sender, recipient, or dispatcher disputes the recorded piece count"
          ],
          "guidance": "Select every observed condition; do not use a generic exception mark when the actual trigger is known."
        },
        {
          "key": "receipt_action_log",
