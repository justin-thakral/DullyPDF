              "key": "service_level",
              "label": "Service level and custody restriction",
              "units": 1.35
            },
            {
              "key": "recipient",
              "label": "Named Recipient Or Controlled Mailroom",
              "units": 1.25
            }
          ]
        },
        {
          "key": "handling_requirements",
          "type": "checklist",
          "label": "Courier delivery and receiving controls",
          "items": [
            "Direct service with no intermediate stop",
            "Tamper-evident pouch or seal",
            "Named-recipient-only delivery",
            "Identification verification under applicable policy",
            "Continuous chain of custody",
            "Do not x-ray or special screening instruction",
            "Return signed document or receipt",
            "Wait-and-return service"
          ],
          "guidance": "Confirm applicable controls before unloading, opening, moving, or accepting the delivered units."
        },
        {
          "key": "receiving_conditions",
          "type": "fields",
          "label": "Receiving point and custody condition",
          "fields": [
