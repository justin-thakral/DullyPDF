  "slug": "courier-delivery-receipt-form",
  "title": "Courier Delivery Receipt Form",
  "subtitle": "Reconcile the promised courier delivery with actual units, condition, custody, evidence, exceptions, receiving decision, and accountable handoff.",
  "description": "An original, fillable courier delivery receipt form for controlling time-critical document or parcel consignment through delivery receipt identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use at Named recipient and exact handoff point when named recipient or controlled mailroom and the delivering custodian need one receipt that separates physical handoff from inspection, hold, commercial acceptance, and exception resolution.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Courier delivery receipt identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
