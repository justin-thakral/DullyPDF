            },
            {
              "key": "owner",
              "label": "Record owner",
              "units": 0.9
            },
            {
              "key": "date",
              "label": "Record date",
              "units": 0.8
            },
            {
              "key": "location",
              "label": "Evidence location",
              "units": 1.25
            }
          ],
          "rows": 5
        }
      ]
    },
    {
