              "units": 1.05
            },
            {
              "key": "reconciliation_status",
              "label": "Reconciliation status",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Balanced",
                "Balanced with correction",
                "Pending evidence",
                "Unresolved"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "cause_evidence",
      "title": "Freight adjustment reason and evidence",
      "guidance": "Use a reason supported by transaction and physical evidence, not a balancing convenience.",
      "blocks": [
        {
          "key": "reason_codes",
          "type": "checklist",
          "label": "Freight supported adjustment reasons",
          "items": [
            "Receiving shortage or overage confirmed",
            "Freight damage moved quantity to hold",
            "Unit-of-measure or packaging conversion corrected",
            "Mis-shipped handling unit transferred to correct owner",
            "Carrier return or refusal reversed expected receipt",
            "Cycle count confirmed a freight staging variance",
            "Duplicate receipt or shipment posting corrected",
            "Authorized salvage, scrap, or rework disposition posted"
          ]
        },
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Conditions requiring investigation or escalation",
          "items": [
            "Handling-unit or piece shortage, overage, or substitution",
            "Visible crush, puncture, collapse, tilt, water, or contamination damage",
            "Pallet, crate, wrap, banding, or securement is compromised",
            "Trailer or seal identity differs from the shipment record",
            "Weight, dimension, freight description, or equipment is inconsistent",
            "Appointment is missed or consignee cannot unload",
            "Freight is refused, partially accepted, or redirected",
            "Temperature, food, hazardous, or special handling control is uncertain",
            "Carrier document, purchase order, or packing list cannot be reconciled",
            "Salvage, rework, return, or disposal instruction is unresolved"
          ]
        },
        {
          "key": "evidence_index",
          "type": "table",
          "label": "Adjustment evidence and source-record index",
          "columns": [
            {
              "key": "evidence",
