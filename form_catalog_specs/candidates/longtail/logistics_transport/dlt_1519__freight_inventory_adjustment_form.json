{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1519__freight_inventory_adjustment_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1519__freight_inventory_adjustment_form.pdf",
  "slug": "freight-inventory-adjustment-form",
  "title": "Freight Inventory Adjustment Form",
  "subtitle": "Reconcile the freight source state to verified evidence, explain every variance, control affected inventory, authorize exact postings, and verify the ledger.",
  "description": "An original, fillable freight inventory adjustment form for controlling palletized, crated, or unitized freight shipment through inventory adjustment identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use when handling units, pieces, and verified weight or related identity, location, status, or ownership differs from the system and a controlled adjustment must remain traceable from physical evidence through approval, posting, and after-state verification.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Freight inventory adjustment identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Freight record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Inventory Adjustment record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Shipment, PRO, or bill-of-lading reference",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Pallet, crate, handling-unit, or seal ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned freight operations coordinator",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Carrier Driver And Terminal Handler",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Shipper dock and pickup appointment",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Consignee dock and delivery appointment",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the shipment record, carrier document, purchase order, and packing list."
        }
      ]
    },
    {
      "key": "adjustment_boundary",
      "title": "Freight inventory boundary and source state",
      "guidance": "Freeze the affected identity, location, cutoff, and source balances before proposing a posting.",
      "blocks": [
        {
          "key": "source_state",
          "type": "fields",
          "label": "Source inventory state",
          "fields": [
            {
              "key": "system_snapshot",
              "label": "System snapshot date and time",
              "units": 1.15
            },
            {
              "key": "transaction_cutoff",
              "label": "Transaction cutoff or through-time",
              "units": 1.2
            },
            {
              "key": "location",
              "label": "Shipper dock and pickup appointment",
              "units": 1.35
            },
            {
              "key": "record_owner",
              "label": "Source record owner or freight operations coordinator",
              "units": 1.25
            }
          ]
        },
        {
          "key": "boundary_controls",
          "type": "checklist",
          "label": "Freight adjustment controls",
          "items": [
            "Shipment, purchase order, and carrier references identify the same freight",
            "Handling-unit count, piece count, weight, and dimensions are reconciled",
            "Pallets, crates, wrap, bands, and labels support ordinary freight handling",
            "Load distribution, blocking, bracing, and securement are assigned for review",
            "Trailer number, seal number, carrier, driver, and appointment are recorded",
            "Dock equipment and labor support the weight and handling configuration",
            "Hazard, food, temperature, high-value, or special handling status is routed",
            "Shortage, overage, damage, refused freight, and redelivery paths are defined"
          ],
          "guidance": "Do not post until movement, unit, ownership, status, and evidence boundaries are understood."
        },
        {
          "key": "approval_threshold",
          "type": "fields",
          "label": "Authority and posting threshold",
          "fields": [
            {
              "key": "adjustment_type",
              "label": "Adjustment type",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Quantity",
                "Location",
                "Status",
                "Lot or serial",
                "Ownership",
                "Reversal"
              ]
            },
            {
              "key": "threshold",
              "label": "Value or quantity approval threshold",
              "units": 1.25
            },
            {
              "key": "posting_system",
              "label": "System or ledger to update",
              "units": 1.2
            },
            {
              "key": "restricted_period",
              "label": "Closed period or restriction",
              "units": 1.15
            }
          ]
        }
      ]
    },
    {
      "key": "variance_schedule",
      "title": "Freight inventory variance schedule",
