            {
              "key": "custody_location",
              "label": "Current custody or hold location",
              "units": 1.35
            },
            {
              "key": "notice_to",
              "label": "Exception notice sent to",
              "units": 1.05
            },
            {
              "key": "notice_time",
              "label": "Notice date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "handoff_attestation",
          "type": "signatures",
          "label": "Delivery and receiving attestation",
          "fields": [
            {
              "key": "delivered_by",
              "label": "Delivered by and date",
              "units": 1.2
            },
            {
              "key": "received_by",
              "label": "Received by and date",
              "units": 1.2
            },
            {
              "key": "witness",
              "label": "Witness or verifier",
              "units": 1.05
            },
            {
              "key": "proof_reference",
              "label": "Receipt proof reference",
              "units": 1.15
            }
          ],
          "guidance": "Attestation confirms the recorded physical event, not waiver of a concealed issue or unresolved review."
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Local Delivery delivery receipt closeout and accountable handoff",
      "guidance": "Close only when outcome, remaining limitation, next action, evidence, and receiving ownership agree.",
      "blocks": [
        {
          "key": "remaining_actions",
          "type": "table",
          "label": "Remaining action and follow-up register",
          "columns": [
            {
              "key": "action",
              "label": "Remaining action",
              "units": 1.4
            },
            {
              "key": "owner",
              "label": "Responsible owner",
              "units": 1.0
            },
            {
              "key": "due",
              "label": "Due date or trigger",
              "units": 1.0
            },
            {
              "key": "evidence",
              "label": "Completion evidence",
              "units": 1.2
            }
          ],
          "rows": 4
        },
        {
          "key": "final_outcome",
          "type": "fields",
          "label": "Final outcome, handoff, and record location",
          "fields": [
            {
              "key": "outcome",
              "label": "Final outcome",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Accepted and reconciled",
                "Accepted with closed exception",
                "Partial receipt closed",
                "Transferred to claim or hold",
                "Refused and returned"
              ]
            },
            {
              "key": "handoff_to",
              "label": "Handoff accepted by",
              "units": 1.15
            },
            {
              "key": "record_location",
              "label": "Evidence package location",
              "units": 1.35
            },
            {
              "key": "closed_at",
              "label": "Closed date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Record boundary and stop condition",
          "guidance": "Use this local delivery delivery receipt with the applicable customer commitment, carrier terms, site policy, and retention requirements. Do not infer acceptance or release from a signature alone; unresolved identity, count, condition, custody, or proof issues require an owner, escalation, and documented disposition."
        },
        {
          "key": "closeout_approval",
          "type": "signatures",
          "label": "Prepared, reviewed, and accepted",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by and date",
              "units": 1.2
            },
            {
              "key": "reviewed_by",
              "label": "Reviewed by local delivery operations lead",
              "units": 1.45
            },
            {
              "key": "accepted_by",
              "label": "Receiving owner acceptance",
              "units": 1.25
            }
          ],
          "guidance": "A signature records accountability for the stated decision; it does not cure missing evidence or override a stop condition."
        }
      ]
    }
  ]
