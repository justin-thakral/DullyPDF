{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1500__local_delivery_receipt_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1500__local_delivery_receipt_form.pdf",
  "slug": "local-delivery-receipt-form",
  "title": "Local Delivery Receipt Form",
  "subtitle": "Reconcile the promised local delivery delivery with actual units, condition, custody, evidence, exceptions, receiving decision, and accountable handoff.",
  "description": "An original, fillable local delivery receipt form for controlling multi-stop local order through delivery receipt identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use at Delivery address and stop access point when stop recipient or receiving contact and the delivering custodian need one receipt that separates physical handoff from inspection, hold, commercial acceptance, and exception resolution.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Local Delivery delivery receipt identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Local Delivery record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Delivery Receipt record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Route and stop number",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Order, tote, or package ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned route dispatcher",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Assigned Driver",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Origin store, hub, or pickup point",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Delivery address and stop access point",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the route plan, customer order, and package labels."
        }
      ]
    },
    {
      "key": "delivery_commitment",
      "title": "Local Delivery delivery commitment and receiving readiness",
      "guidance": "Confirm what was expected, where it was due, and which controls governed acceptance.",
      "blocks": [
        {
          "key": "commitment",
          "type": "fields",
          "label": "Delivery commitment",
          "fields": [
            {
              "key": "scheduled_window",
              "label": "Scheduled delivery window",
              "units": 1.15
            },
            {
              "key": "actual_arrival",
              "label": "Actual arrival date and time",
              "units": 1.1
            },
            {
              "key": "service_level",
              "label": "Service window and handling instruction",
              "units": 1.35
            },
            {
              "key": "recipient",
              "label": "Stop Recipient Or Receiving Contact",
              "units": 1.25
            }
          ]
        },
        {
          "key": "handling_requirements",
          "type": "checklist",
          "label": "Local Delivery delivery and receiving controls",
          "items": [
            "Direct-to-recipient handoff",
            "Photo proof without personal information",
            "Recipient signature",
            "Identity or age check under applicable policy",
            "No unattended delivery",
            "Keep upright or fragile handling",
            "Return tote or container pickup",
            "Failed-attempt return to origin"
          ],
          "guidance": "Confirm applicable controls before unloading, opening, moving, or accepting the delivered units."
        },
        {
          "key": "receiving_conditions",
          "type": "fields",
          "label": "Receiving point and custody condition",
          "fields": [
            {
              "key": "receiving_point",
              "label": "Actual receiving point",
              "units": 1.25
            },
            {
              "key": "arriving_custodian",
              "label": "Arriving custodian",
              "units": 1.15
            },
            {
              "key": "recipient_authority",
              "label": "Recipient authority or role",
              "units": 1.2
            },
            {
              "key": "initial_status",
              "label": "Initial receiving status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Ready to inspect",
                "Held at receiving",
                "Partial unload",
                "Refused before unload"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "receipt_reconciliation",
      "title": "Local Delivery delivered-unit reconciliation",
      "guidance": "Reconcile each delivered identity and quantity before relying on totals or signatures.",
      "blocks": [
        {
          "key": "delivered_units",
          "type": "table",
          "label": "Local Delivery Packages And Stop Quantities received",
          "columns": [
            {
              "key": "unit_id",
              "label": "Order, tote, or package ID",
              "units": 1.35
            },
            {
              "key": "expected",
              "label": "Expected quantity",
              "units": 0.85
            },
            {
              "key": "received",
              "label": "Received quantity",
              "units": 0.85
            },
            {
              "key": "condition",
              "label": "Package and product condition",
              "units": 1.15
            },
            {
              "key": "control",
              "label": "Service window and handling instruction",
              "units": 1.15
            },
            {
              "key": "variance",
              "label": "Variance or evidence ref",
              "units": 1.2
            }
          ],
          "rows": 7
        },
        {
          "key": "receipt_totals",
          "type": "fields",
          "label": "Receipt totals and reconciliation",
          "fields": [
            {
              "key": "expected_total",
              "label": "Expected total",
              "units": 0.9
            },
            {
              "key": "received_total",
              "label": "Received total",
              "units": 0.9
            },
            {
              "key": "accepted_total",
              "label": "Accepted total",
              "units": 0.9
            },
            {
              "key": "held_total",
              "label": "Held or refused total",
              "units": 1.0
            },
            {
              "key": "variance_total",
              "label": "Unresolved variance total",
              "units": 1.1
            }
          ],
          "guidance": "Expected and delivered pieces"
        }
      ]
    },
    {
      "key": "condition_evidence",
      "title": "Local Delivery condition inspection and receipt evidence",
      "guidance": "Preserve observations made before the receiver changes packaging, custody, or physical condition.",
      "blocks": [
        {
          "key": "condition_checks",
          "type": "checklist",
          "label": "Local Delivery receipt inspection",
          "items": [
            "Route label and customer order identify the same stop and recipient",
            "Piece count agrees with the staged order and driver manifest",
            "Packaging is closed, dry, stable, and free of visible crushing or puncture",
            "Fragile and orientation markings remain legible and correctly placed",
            "Time-window and contact-on-arrival instructions are available to the driver",
            "Address, unit, gate, loading zone, and parking details are complete",
            "Restricted-delivery and unattended-drop rules are understood",
            "Return goods and reusable assets are segregated from outbound orders",
            "Proof method can be captured without exposing unrelated customer information",
            "Unresolved count, label, condition, or access issue is held before departure"
          ]
        },
        {
          "key": "evidence_index",
          "type": "table",
          "label": "Receipt evidence index",
          "columns": [
            {
              "key": "evidence",
              "label": "Evidence or observation",
              "units": 1.45
            },
            {
              "key": "unit",
              "label": "Affected unit ID",
              "units": 1.1
            },
            {
              "key": "captured_by",
              "label": "Captured by",
              "units": 0.9
            },
            {
              "key": "reference",
              "label": "Photo, scan, or record ref",
              "units": 1.3
            }
          ],
          "rows": 4,
          "guidance": "Record only necessary proof and preserve privacy or security restrictions."
        },
        {
          "key": "condition_narrative",
          "type": "textarea",
          "label": "Condition, count, custody, and acceptance narrative",
          "fields": [
            {
              "key": "details",
              "label": "Condition, count, custody, and acceptance narrative",
              "multiline": true
            }
          ],
          "height": 54,
          "guidance": "Describe facts that cannot be reconstructed from the line table or evidence reference."
        }
      ]
    },
    {
      "key": "receipt_exceptions",
      "title": "Local Delivery exception, containment, and escalation",
      "guidance": "Make the trigger, affected scope, immediate control, owner, deadline, and escalation reconstructable.",
      "blocks": [
        {
          "key": "receipt_exception_types",
          "type": "checklist",
          "label": "Local Delivery exception indicators",
          "items": [
            "Address or access point cannot be located",
            "Recipient unavailable or refuses delivery",
            "Package is missing, extra, mislabeled, or assigned to another stop",
            "Packaging or contents show visible damage or leakage",
            "Delivery window will be missed",
            "Identity, signature, or age condition cannot be completed",
            "Unsafe parking, property condition, animal, or other site hazard",
            "Customer requests an unapproved alternate delivery location",
            "Proof capture fails or conflicts with the delivered stop",
            "Return item or reusable container cannot be reconciled"
          ],
          "guidance": "Select every observed condition; do not use a generic exception mark when the actual trigger is known."
        },
        {
          "key": "receipt_action_log",
          "type": "table",
          "label": "Exception containment and action log",
          "columns": [
            {
              "key": "issue_scope",
              "label": "Issue and affected ID",
              "units": 1.35
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.25
            },
            {
              "key": "owner",
              "label": "Action owner",
              "units": 0.9
            },
            {
              "key": "due",
              "label": "Due point",
              "units": 0.8
            },
            {
              "key": "escalation",
              "label": "Escalation or proof ref",
              "units": 1.2
            }
          ],
          "rows": 4
        },
        {
          "key": "receipt_decision",
          "type": "fields",
          "label": "Receipt hold, partial acceptance, refusal, or resolution",
          "fields": [
            {
              "key": "status",
              "label": "Interim status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Open - controlled",
                "Open - escalated",
                "Pending evidence",
                "Resolved",
                "Rejected"
              ]
            },
            {
              "key": "decision_owner",
              "label": "Decision owner",
              "units": 1.1
            },
            {
              "key": "decision_time",
              "label": "Decision date and time",
              "units": 1.0
            },
            {
              "key": "next_review",
              "label": "Next review or deadline",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "receipt_acceptance",
      "title": "Local Delivery receipt decision and custody transfer",
      "guidance": "Separate physical custody from final commercial, quality, safety, or financial acceptance.",
      "blocks": [
        {
          "key": "acceptance_decision",
          "type": "fields",
          "label": "Receiving decision",
          "fields": [
            {
              "key": "decision",
              "label": "Receipt decision",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Accepted",
