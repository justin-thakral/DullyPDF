              "key": "actual",
              "label": "Actual time",
              "units": 0.8
            },
            {
              "key": "location",
              "label": "Location or control point",
              "units": 1.15
            },
            {
              "key": "party",
              "label": "Responsible party",
              "units": 1.0
            },
