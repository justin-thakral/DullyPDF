{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1515__freight_proof_of_delivery_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1515__freight_proof_of_delivery_form.pdf",
  "slug": "freight-proof-of-delivery-form",
  "title": "Freight Proof of Delivery Form",
  "subtitle": "Authenticate the freight delivery through unit identity, custody events, recipient authority, location, timing, condition, and privacy-conscious proof.",
  "description": "An original, fillable freight proof of delivery form for controlling palletized, crated, or unitized freight shipment through proof of delivery identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use after a freight delivery or failed attempt when operations must establish what was delivered, to whom, where, when, under which control, and how any evidence gap or dispute was routed.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Freight proof of delivery identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Freight record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Proof Of Delivery record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Shipment, PRO, or bill-of-lading reference",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Pallet, crate, handling-unit, or seal ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned freight operations coordinator",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Carrier Driver And Terminal Handler",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Shipper dock and pickup appointment",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Consignee dock and delivery appointment",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the shipment record, carrier document, purchase order, and packing list."
        }
      ]
    },
    {
      "key": "proof_commitment",
      "title": "Freight delivery obligation and proof standard",
      "guidance": "Define the promised event and acceptable evidence before evaluating whether delivery was completed.",
      "blocks": [
        {
          "key": "delivery_obligation",
          "type": "fields",
          "label": "Delivery obligation",
          "fields": [
            {
              "key": "promised_window",
              "label": "Promised delivery window",
              "units": 1.1
            },
            {
              "key": "actual_completion",
              "label": "Actual completion date and time",
              "units": 1.1
            },
            {
              "key": "proof_standard",
              "label": "Required proof method",
              "units": 1.2
            },
            {
              "key": "authorized_recipient",
              "label": "Consignee Receiving Representative",
              "units": 1.3
            }
          ]
        },
        {
          "key": "proof_controls",
          "type": "checklist",
          "label": "Freight custody and proof controls",
          "items": [
            "Keep dry",
            "Do not stack",
            "Top load only",
            "Forklift entry restriction",
            "Liftgate required",
            "Protect from freeze or heat",
            "Seal control and no unauthorized opening",
            "High-value or controlled-access handling"
          ],
          "guidance": "Select the controls actually required for this delivery, not every available service feature."
        },
        {
          "key": "route_assignment",
          "type": "fields",
          "label": "Route, custodian, and destination assignment",
          "fields": [
            {
              "key": "route",
              "label": "Route, trip, or movement reference",
              "units": 1.25
            },
            {
              "key": "custodian",
              "label": "Carrier Driver And Terminal Handler",
              "units": 1.2
            },
            {
              "key": "destination",
              "label": "Consignee dock and delivery appointment",
              "units": 1.4
            },
            {
              "key": "contact_method",
              "label": "Recipient contact method",
              "units": 1.0
            }
          ]
        }
      ]
    },
    {
      "key": "delivery_timeline",
