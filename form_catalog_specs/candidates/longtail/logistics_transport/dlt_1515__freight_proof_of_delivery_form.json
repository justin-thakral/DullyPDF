          ]
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Record boundary and stop condition",
          "guidance": "Use this freight proof of delivery with the applicable customer commitment, carrier terms, site policy, and retention requirements. Do not infer acceptance or release from a signature alone; unresolved identity, count, condition, custody, or proof issues require an owner, escalation, and documented disposition."
        },
        {
          "key": "closeout_approval",
          "type": "signatures",
          "label": "Prepared, reviewed, and accepted",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by and date",
              "units": 1.2
            },
            {
              "key": "reviewed_by",
              "label": "Reviewed by shipping or receiving manager",
              "units": 1.45
            },
            {
              "key": "accepted_by",
              "label": "Receiving owner acceptance",
              "units": 1.25
            }
          ],
          "guidance": "A signature records accountability for the stated decision; it does not cure missing evidence or override a stop condition."
        }
      ]
    }
  ]
