              "units": 1.1
            }
          ],
          "rows": 6
        },
        {
          "key": "timeline_reconciliation",
          "type": "fields",
          "label": "Timeline reconciliation",
          "fields": [
            {
              "key": "first_attempt",
              "label": "First attempt time",
              "units": 1.0
            },
            {
              "key": "completed_time",
              "label": "Completion time",
              "units": 1.0
            },
            {
              "key": "custody_changes",
              "label": "Custody changes",
              "units": 0.9
            },
            {
              "key": "unplanned_stops",
              "label": "Unplanned stops or delays",
              "units": 1.2
            },
            {
              "key": "timeline_status",
              "label": "Timeline status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Complete",
                "Complete with variance",
                "Missing event",
                "Conflicting evidence"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "delivered_scope",
      "title": "Freight delivered scope and recipient verification",
      "guidance": "Tie proof to each relevant unit rather than treating one signature as proof for an unverified shipment.",
      "blocks": [
        {
          "key": "delivered_units",
          "type": "table",
          "label": "Freight Handling Units, Pallets, Crates, Seals, And Weights delivery proof",
          "columns": [
            {
              "key": "unit_id",
              "label": "Pallet, crate, handling-unit, or seal ID",
              "units": 1.35
            },
            {
              "key": "quantity",
              "label": "Delivered quantity",
              "units": 0.8
            },
            {
              "key": "condition",
              "label": "Pallet, crate, wrap, and seal condition",
              "units": 1.15
            },
            {
              "key": "recipient",
              "label": "Recipient or delivery point",
              "units": 1.1
            },
            {
              "key": "proof_method",
              "label": "Proof method",
              "units": 0.95
            },
            {
              "key": "proof_ref",
              "label": "Proof reference",
              "units": 1.1
            }
          ],
          "rows": 6
        },
        {
          "key": "proof_evidence",
          "type": "checklist",
          "label": "Freight proof package",
          "items": [
            "Carrier document and purchase-order reference",
            "Origin pallet or crate condition photographs",
            "Certified or operational weight record",
            "Trailer and seal identity",
            "Dock arrival, loading, departure, and delivery timestamps",
            "Handling-unit scans at each transfer",
            "Destination condition and shortage notation",
            "Exception inspection and mitigation record"
          ],
          "guidance": "Capture only the evidence needed to authenticate the event and follow privacy, access, and retention policy."
        },
        {
          "key": "delivery_facts",
          "type": "textarea",
          "label": "Delivery location, recipient authority, custody, and condition facts",
          "fields": [
            {
              "key": "details",
              "label": "Delivery location, recipient authority, custody, and condition facts",
              "multiline": true
            }
          ],
          "height": 58
        }
      ]
    },
    {
      "key": "delivery_exceptions",
      "title": "Freight exception, containment, and escalation",
      "guidance": "Make the trigger, affected scope, immediate control, owner, deadline, and escalation reconstructable.",
      "blocks": [
        {
          "key": "delivery_exception_types",
          "type": "checklist",
          "label": "Freight exception indicators",
          "items": [
            "Handling-unit or piece shortage, overage, or substitution",
            "Visible crush, puncture, collapse, tilt, water, or contamination damage",
            "Pallet, crate, wrap, banding, or securement is compromised",
            "Trailer or seal identity differs from the shipment record",
            "Weight, dimension, freight description, or equipment is inconsistent",
            "Appointment is missed or consignee cannot unload",
            "Freight is refused, partially accepted, or redirected",
            "Temperature, food, hazardous, or special handling control is uncertain",
            "Carrier document, purchase order, or packing list cannot be reconciled",
            "Salvage, rework, return, or disposal instruction is unresolved"
          ],
          "guidance": "Select every observed condition; do not use a generic exception mark when the actual trigger is known."
        },
        {
          "key": "delivery_action_log",
          "type": "table",
          "label": "Exception containment and action log",
          "columns": [
            {
              "key": "issue_scope",
