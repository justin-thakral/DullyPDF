{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1527__warehouse_pick_temperature_log_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1527__warehouse_pick_temperature_log_form.pdf",
  "slug": "warehouse-pick-temperature-log-form",
  "title": "Warehouse Pick Temperature Log Form",
  "subtitle": "Define the warehouse pick temperature range and monitoring setup, record chronological readings and events, contain excursions, and obtain qualified disposition.",
  "description": "An original, fillable warehouse pick temperature log form for controlling warehouse pick wave, order, carton, and lot allocation through temperature log identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use during pick-pack-stage handoff when temperature or related environmental control must be reconstructed from identified devices, checkpoints, readings, custody events, equipment observations, excursion response, and final review.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Warehouse Pick temperature log identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Warehouse Pick record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Temperature Log record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Wave, pick ticket, and order number",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "SKU, lot, serial, carton, tote, or license-plate ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned warehouse wave coordinator",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Picker, Packer, Or Staging Associate",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Zone, aisle, bin, or reserve location",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Pack station, staging lane, dock, or production point",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the pick ticket, warehouse task, item master, and allocation record."
        }
      ]
    },
    {
      "key": "temperature_requirements",
      "title": "Warehouse Pick temperature requirements and monitoring setup",
      "guidance": "Record the controlling range, method, devices, and responsibilities before relying on readings.",
      "blocks": [
        {
          "key": "range_requirement",
          "type": "fields",
          "label": "Approved range and exposure boundary",
          "fields": [
            {
              "key": "lower_limit",
              "label": "Approved lower limit and units",
              "units": 1.15
            },
            {
              "key": "upper_limit",
              "label": "Approved upper limit and units",
              "units": 1.15
            },
            {
              "key": "exposure_limit",
              "label": "Maximum exposure or excursion rule",
              "units": 1.25
            },
            {
              "key": "requirements_source",
              "label": "Protocol, label, or requirement source",
              "units": 1.4
            }
          ]
        },
        {
          "key": "monitoring_equipment",
          "type": "fields",
          "label": "Monitoring equipment and verification",
          "fields": [
            {
              "key": "device_id",
              "label": "Logger, probe, display, or meter ID",
              "units": 1.35
            },
            {
              "key": "calibration",
              "label": "Calibration or verification status",
              "units": 1.2
            },
            {
              "key": "accuracy",
              "label": "Accuracy or uncertainty",
              "units": 1.0
            },
            {
              "key": "placement",
              "label": "Device placement or measurement point",
              "units": 1.35
            }
          ]
        },
        {
          "key": "required_checkpoints",
          "type": "checklist",
          "label": "Warehouse Pick required temperature checkpoints",
          "items": [
            "Source storage zone",
            "Pick-face product",
            "Pick container before use",
            "Pack station product",
            "Insulated pack after closure",
            "Temperature-controlled staging lane",
            "Dock immediately before loading",
            "Returned short-pick or rejected product"
          ],
          "guidance": "Use the reading table for actual values; this list defines the intended monitoring coverage."
        }
      ]
    },
    {
      "key": "temperature_readings",
      "title": "Warehouse Pick chronological temperature readings",
      "guidance": "Record readings as observed with location, device, responsible person, and relevant event.",
      "blocks": [
        {
          "key": "reading_log",
          "type": "table",
          "label": "Temperature reading log",
          "columns": [
            {
              "key": "date_time",
              "label": "Date and time",
              "units": 0.9
            },
            {
              "key": "point",
              "label": "Location or checkpoint",
              "units": 1.2
            },
            {
              "key": "device",
              "label": "Device ID",
              "units": 0.9
            },
            {
              "key": "reading",
              "label": "Reading and units",
              "units": 0.95
            },
            {
              "key": "event",
              "label": "Door, transfer, delay, or event",
              "units": 1.25
            },
            {
              "key": "observer",
              "label": "Observer or source",
              "units": 1.0
            }
          ],
          "rows": 8
        },
        {
          "key": "reading_summary",
          "type": "fields",
          "label": "Reading and exposure summary",
          "fields": [
            {
              "key": "minimum",
              "label": "Minimum observed",
              "units": 0.95
            },
            {
              "key": "maximum",
              "label": "Maximum observed",
              "units": 0.95
            },
            {
              "key": "out_of_range",
              "label": "Out-of-range duration",
              "units": 1.05
            },
            {
              "key": "missing_interval",
              "label": "Missing-data interval",
              "units": 1.1
            },
            {
              "key": "summary_status",
              "label": "Initial status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Within range",
                "Potential excursion",
                "Confirmed excursion",
                "Data incomplete",
                "Device unreliable"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "control_observations",
      "title": "Warehouse Pick environmental and handling observations",
      "guidance": "Connect readings to the operational conditions that can explain or affect temperature control.",
      "blocks": [
        {
          "key": "handling_controls",
          "type": "checklist",
          "label": "Warehouse Pick temperature-control practices",
          "items": [
            "FIFO allocation",
            "FEFO allocation",
            "Lot-controlled pick",
            "Serial capture",
            "No substitution",
            "Fragile or crush-sensitive pack",
            "Temperature-controlled staging",
            "Controlled or high-value cage handoff"
          ]
        },
        {
          "key": "readiness_controls",
          "type": "checklist",
          "label": "Equipment, custody, and response readiness",
          "items": [
            "Wave, order priority, carrier cutoff, and staging destination are released",
            "SKU, description, unit of measure, lot, serial, and expiry rules are available",
            "Source bins and replenishment dependencies are assigned",
            "Picker equipment, scan device, containers, and labels are ready",
            "FIFO, FEFO, lot allocation, serial capture, and substitution rules are explicit",
            "Fragile, hazardous, food, temperature, and security controls are routed",
            "Short pick, damaged stock, blocked location, and count variance paths are defined",
            "Pack, stage, and shipping handoffs require quantity and identity reconciliation"
          ]
        },
        {
          "key": "observation_notes",
          "type": "textarea",
          "label": "Equipment status, packaging condition, door events, delays, and other observations",
          "fields": [
            {
              "key": "details",
              "label": "Equipment status, packaging condition, door events, delays, and other observations",
              "multiline": true
            }
          ],
          "height": 62,
          "guidance": "Do not infer product suitability from an ambient reading alone; preserve the measurement context."
        }
      ]
    },
    {
      "key": "excursion_response",
      "title": "Warehouse Pick temperature excursion and immediate response",
      "guidance": "Stop affected release or use, protect evidence, and assign qualified disposition when control is uncertain.",
      "blocks": [
        {
          "key": "excursion_indicators",
          "type": "checklist",
          "label": "Excursion or monitoring failure indicators",
          "items": [
            "Reading above the approved upper limit",
            "Reading below the approved lower limit",
            "Freeze exposure or freeze indicator",
            "Alarm, logger, probe, display, or meter failure",
            "Missing, overwritten, delayed, or conflicting temperature data",
            "Unplanned door opening, transfer, delay, or power interruption",
            "Packaging, seal, coolant, compartment, tank, or equipment damage",
            "Product or controlled material condition concern",
            "Monitoring responsibility or custody interval cannot be established",
            "No excursion or monitoring failure observed"
          ]
        },
        {
          "key": "excursion_actions",
          "type": "table",
          "label": "Excursion containment and investigation log",
          "columns": [
            {
              "key": "affected_scope",
              "label": "Affected lot, unit, or interval",
              "units": 1.35
            },
            {
              "key": "immediate_action",
              "label": "Immediate action or hold",
              "units": 1.25
            },
            {
              "key": "owner",
              "label": "Action owner",
              "units": 0.9
            },
            {
              "key": "due",
              "label": "Review due",
              "units": 0.8
            },
            {
              "key": "evidence",
              "label": "Logger, probe, photo, or record ref",
              "units": 1.25
            }
          ],
          "rows": 5
        },
        {
          "key": "notification",
          "type": "fields",
          "label": "Excursion notification and custody",
          "fields": [
            {
              "key": "notified",
              "label": "Qualified reviewer notified",
              "units": 1.2
            },
            {
              "key": "notification_time",
              "label": "Notification date and time",
              "units": 1.1
            },
            {
              "key": "hold_location",
              "label": "Hold, quarantine, or controlled location",
              "units": 1.35
            },
            {
              "key": "custody_owner",
              "label": "Current custody owner",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "temperature_disposition",
      "title": "Warehouse Pick temperature assessment and disposition",
      "guidance": "Document the evidence reviewed, authorized scope, restrictions, and rationale for the final decision.",
      "blocks": [
        {
          "key": "assessment_evidence",
          "type": "table",
          "label": "Qualified assessment evidence",
          "columns": [
            {
              "key": "evidence",
              "label": "Evidence or requirement",
              "units": 1.45
            },
            {
              "key": "scope",
              "label": "Affected scope",
              "units": 1.0
            },
            {
              "key": "finding",
