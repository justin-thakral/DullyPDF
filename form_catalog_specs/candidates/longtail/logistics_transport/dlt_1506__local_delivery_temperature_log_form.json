{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1506__local_delivery_temperature_log_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1506__local_delivery_temperature_log_form.pdf",
  "slug": "local-delivery-temperature-log-form",
  "title": "Local Delivery Temperature Log Form",
  "subtitle": "Define the local delivery temperature range and monitoring setup, record chronological readings and events, contain excursions, and obtain qualified disposition.",
  "description": "An original, fillable local delivery temperature log form for controlling multi-stop local order through temperature log identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use during same-day route execution when temperature or related environmental control must be reconstructed from identified devices, checkpoints, readings, custody events, equipment observations, excursion response, and final review.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Local Delivery temperature log identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Local Delivery record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Temperature Log record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Route and stop number",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Order, tote, or package ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned route dispatcher",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Assigned Driver",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Origin store, hub, or pickup point",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Delivery address and stop access point",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the route plan, customer order, and package labels."
        }
      ]
    },
    {
      "key": "temperature_requirements",
      "title": "Local Delivery temperature requirements and monitoring setup",
      "guidance": "Record the controlling range, method, devices, and responsibilities before relying on readings.",
      "blocks": [
        {
          "key": "range_requirement",
          "type": "fields",
          "label": "Approved range and exposure boundary",
          "fields": [
            {
              "key": "lower_limit",
              "label": "Approved lower limit and units",
              "units": 1.15
            },
            {
              "key": "upper_limit",
              "label": "Approved upper limit and units",
              "units": 1.15
            },
            {
              "key": "exposure_limit",
              "label": "Maximum exposure or excursion rule",
              "units": 1.25
            },
            {
              "key": "requirements_source",
              "label": "Protocol, label, or requirement source",
              "units": 1.4
            }
          ]
        },
        {
          "key": "monitoring_equipment",
          "type": "fields",
          "label": "Monitoring equipment and verification",
          "fields": [
            {
              "key": "device_id",
              "label": "Logger, probe, display, or meter ID",
              "units": 1.35
            },
            {
              "key": "calibration",
              "label": "Calibration or verification status",
              "units": 1.2
            },
            {
              "key": "accuracy",
              "label": "Accuracy or uncertainty",
              "units": 1.0
            },
            {
              "key": "placement",
              "label": "Device placement or measurement point",
              "units": 1.35
            }
          ]
        },
        {
          "key": "required_checkpoints",
          "type": "checklist",
          "label": "Local Delivery required temperature checkpoints",
          "items": [
            "Origin holding area",
            "Vehicle compartment before load",
            "First route stop",
            "Mid-route verification",
            "After extended door opening",
            "Last controlled stop",
            "Return-to-origin product",
            "Final compartment check"
          ],
          "guidance": "Use the reading table for actual values; this list defines the intended monitoring coverage."
        }
      ]
    },
    {
      "key": "temperature_readings",
      "title": "Local Delivery chronological temperature readings",
      "guidance": "Record readings as observed with location, device, responsible person, and relevant event.",
      "blocks": [
        {
          "key": "reading_log",
          "type": "table",
          "label": "Temperature reading log",
          "columns": [
            {
              "key": "date_time",
              "label": "Date and time",
              "units": 0.9
            },
            {
              "key": "point",
              "label": "Location or checkpoint",
              "units": 1.2
            },
            {
              "key": "device",
              "label": "Device ID",
              "units": 0.9
            },
            {
              "key": "reading",
              "label": "Reading and units",
              "units": 0.95
            },
            {
              "key": "event",
              "label": "Door, transfer, delay, or event",
              "units": 1.25
            },
            {
              "key": "observer",
              "label": "Observer or source",
              "units": 1.0
            }
          ],
          "rows": 8
        },
        {
          "key": "reading_summary",
          "type": "fields",
          "label": "Reading and exposure summary",
          "fields": [
            {
              "key": "minimum",
              "label": "Minimum observed",
              "units": 0.95
            },
            {
              "key": "maximum",
              "label": "Maximum observed",
              "units": 0.95
            },
            {
              "key": "out_of_range",
              "label": "Out-of-range duration",
              "units": 1.05
            },
            {
              "key": "missing_interval",
              "label": "Missing-data interval",
              "units": 1.1
            },
            {
              "key": "summary_status",
              "label": "Initial status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Within range",
                "Potential excursion",
                "Confirmed excursion",
                "Data incomplete",
                "Device unreliable"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "control_observations",
      "title": "Local Delivery environmental and handling observations",
      "guidance": "Connect readings to the operational conditions that can explain or affect temperature control.",
      "blocks": [
        {
          "key": "handling_controls",
          "type": "checklist",
          "label": "Local Delivery temperature-control practices",
          "items": [
            "Direct-to-recipient handoff",
            "Photo proof without personal information",
            "Recipient signature",
            "Identity or age check under applicable policy",
            "No unattended delivery",
            "Keep upright or fragile handling",
            "Return tote or container pickup",
            "Failed-attempt return to origin"
          ]
        },
        {
          "key": "readiness_controls",
          "type": "checklist",
          "label": "Equipment, custody, and response readiness",
          "items": [
            "Stop sequence matches promised delivery windows and traffic constraints",
            "Every order is matched to route, stop, package, and recipient identifiers",
            "Vehicle capacity and package placement support the planned stop sequence",
            "Driver has access instructions, contact method, and failed-attempt rules",
            "Age, identity, signature, or photo requirements are explicit where applicable",
            "Fragile, upright, temperature, and no-unattended-delivery controls are visible",
            "Returns, exchanges, cash handling, or reusable containers have separate custody",
            "Dispatcher has a communication and escalation path for route disruption"
          ]
        },
        {
          "key": "observation_notes",
          "type": "textarea",
          "label": "Equipment status, packaging condition, door events, delays, and other observations",
          "fields": [
            {
              "key": "details",
              "label": "Equipment status, packaging condition, door events, delays, and other observations",
              "multiline": true
            }
          ],
          "height": 62,
          "guidance": "Do not infer product suitability from an ambient reading alone; preserve the measurement context."
        }
      ]
    },
    {
      "key": "excursion_response",
      "title": "Local Delivery temperature excursion and immediate response",
      "guidance": "Stop affected release or use, protect evidence, and assign qualified disposition when control is uncertain.",
      "blocks": [
        {
          "key": "excursion_indicators",
          "type": "checklist",
          "label": "Excursion or monitoring failure indicators",
          "items": [
            "Reading above the approved upper limit",
            "Reading below the approved lower limit",
            "Freeze exposure or freeze indicator",
            "Alarm, logger, probe, display, or meter failure",
            "Missing, overwritten, delayed, or conflicting temperature data",
            "Unplanned door opening, transfer, delay, or power interruption",
            "Packaging, seal, coolant, compartment, tank, or equipment damage",
            "Product or controlled material condition concern",
            "Monitoring responsibility or custody interval cannot be established",
            "No excursion or monitoring failure observed"
          ]
        },
        {
          "key": "excursion_actions",
          "type": "table",
          "label": "Excursion containment and investigation log",
          "columns": [
            {
              "key": "affected_scope",
              "label": "Affected lot, unit, or interval",
              "units": 1.35
            },
            {
              "key": "immediate_action",
              "label": "Immediate action or hold",
              "units": 1.25
            },
            {
              "key": "owner",
              "label": "Action owner",
              "units": 0.9
            },
            {
              "key": "due",
              "label": "Review due",
              "units": 0.8
            },
            {
              "key": "evidence",
              "label": "Logger, probe, photo, or record ref",
              "units": 1.25
            }
          ],
          "rows": 5
        },
        {
          "key": "notification",
          "type": "fields",
          "label": "Excursion notification and custody",
          "fields": [
            {
              "key": "notified",
              "label": "Qualified reviewer notified",
              "units": 1.2
            },
            {
              "key": "notification_time",
              "label": "Notification date and time",
              "units": 1.1
            },
            {
              "key": "hold_location",
              "label": "Hold, quarantine, or controlled location",
              "units": 1.35
            },
            {
              "key": "custody_owner",
              "label": "Current custody owner",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "temperature_disposition",
      "title": "Local Delivery temperature assessment and disposition",
      "guidance": "Document the evidence reviewed, authorized scope, restrictions, and rationale for the final decision.",
      "blocks": [
        {
          "key": "assessment_evidence",
          "type": "table",
          "label": "Qualified assessment evidence",
          "columns": [
            {
              "key": "evidence",
              "label": "Evidence or requirement",
              "units": 1.45
            },
            {
              "key": "scope",
              "label": "Affected scope",
              "units": 1.0
            },
            {
              "key": "finding",
              "label": "Finding or limitation",
              "units": 1.3
            },
            {
              "key": "reviewer",
              "label": "Reviewer",
              "units": 0.9
            },
            {
              "key": "reference",
              "label": "Assessment reference",
              "units": 1.15
            }
          ],
          "rows": 4
        },
        {
          "key": "disposition",
          "type": "fields",
          "label": "Temperature-control disposition",
          "fields": [
            {
              "key": "decision",
              "label": "Disposition",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Accepted within range",
                "Released after qualified review",
                "Restricted use or movement",
                "Continue hold",
                "Reject or return"
              ]
            },
            {
              "key": "authorized_scope",
              "label": "Authorized lot, quantity, or interval",
              "units": 1.35
            },
            {
              "key": "remaining_restriction",
              "label": "Remaining restriction",
              "units": 1.25
            },
            {
              "key": "decision_reference",
              "label": "Decision and rationale reference",
              "units": 1.35
            }
          ]
        },
        {
          "key": "disposition_signoff",
          "type": "signatures",
          "label": "Monitoring review and disposition authorization",
          "fields": [
            {
              "key": "log_preparer",
              "label": "Log prepared by and date",
              "units": 1.2
            },
            {
              "key": "qualified_reviewer",
              "label": "Local Delivery Operations Lead decision",
              "units": 1.5
            },
            {
              "key": "custody_owner",
              "label": "Custody owner acknowledgment",
              "units": 1.25
            }
          ]
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Local Delivery temperature log closeout and accountable handoff",
      "guidance": "Close only when outcome, remaining limitation, next action, evidence, and receiving ownership agree.",
      "blocks": [
        {
          "key": "remaining_actions",
          "type": "table",
          "label": "Remaining action and follow-up register",
          "columns": [
            {
              "key": "action",
              "label": "Remaining action",
              "units": 1.4
            },
            {
              "key": "owner",
              "label": "Responsible owner",
              "units": 1.0
            },
            {
              "key": "due",
              "label": "Due date or trigger",
              "units": 1.0
            },
            {
              "key": "evidence",
              "label": "Completion evidence",
              "units": 1.2
            }
          ],
          "rows": 4
        },
        {
          "key": "final_outcome",
          "type": "fields",
          "label": "Final outcome, handoff, and record location",
          "fields": [
            {
              "key": "outcome",
              "label": "Final outcome",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Range maintained and closed",
                "Excursion reviewed and released",
                "Restricted disposition completed",
                "Held for further evidence",
                "Rejected, returned, or removed"
              ]
            },
            {
              "key": "handoff_to",
              "label": "Handoff accepted by",
              "units": 1.15
            },
            {
              "key": "record_location",
              "label": "Evidence package location",
              "units": 1.35
            },
            {
              "key": "closed_at",
              "label": "Closed date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Record boundary and stop condition",
          "guidance": "This local delivery temperature log is an operational record, not a substitute for applicable law, contract terms, safety or product requirements, or professional judgment. Stop the affected movement, transfer, release, posting, or disposition when identity, evidence, authorization, or control is uncertain. A qualified local delivery operations lead must review the exception and document the controlling decision."
        },
        {
          "key": "closeout_approval",
          "type": "signatures",
          "label": "Prepared, reviewed, and accepted",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by and date",
              "units": 1.2
            },
            {
              "key": "reviewed_by",
              "label": "Reviewed by local delivery operations lead",
              "units": 1.45
            },
            {
              "key": "accepted_by",
              "label": "Receiving owner acceptance",
              "units": 1.25
            }
          ],
          "guidance": "A signature records accountability for the stated decision; it does not cure missing evidence or override a stop condition."
        }
      ]
    }
  ]
}
