              "units": 0.8
            },
            {
              "key": "condition",
              "label": "Package and product condition",
              "units": 1.15
            },
            {
              "key": "recipient",
              "label": "Recipient or delivery point",
              "units": 1.1
            },
            {
              "key": "proof_method",
              "label": "Proof method",
              "units": 0.95
            },
            {
              "key": "proof_ref",
              "label": "Proof reference",
              "units": 1.1
            }
          ],
          "rows": 6
        },
        {
          "key": "proof_evidence",
          "type": "checklist",
          "label": "Local Delivery proof package",
          "items": [
            "Route assignment and stop sequence snapshot",
            "Package or tote scan at load",
            "Departure and arrival timestamp",
            "Recipient name or authorized delivery point",
            "Delivery photo or signature reference",
            "Failed-attempt contact record",
            "Shortage, damage, or return image reference",
            "Driver and dispatcher communication reference"
          ],
          "guidance": "Capture only the evidence needed to authenticate the event and follow privacy, access, and retention policy."
        },
        {
          "key": "delivery_facts",
          "type": "textarea",
          "label": "Delivery location, recipient authority, custody, and condition facts",
          "fields": [
            {
              "key": "details",
              "label": "Delivery location, recipient authority, custody, and condition facts",
              "multiline": true
            }
          ],
          "height": 58
        }
      ]
    },
    {
      "key": "delivery_exceptions",
      "title": "Local Delivery exception, containment, and escalation",
      "guidance": "Make the trigger, affected scope, immediate control, owner, deadline, and escalation reconstructable.",
      "blocks": [
        {
          "key": "delivery_exception_types",
          "type": "checklist",
          "label": "Local Delivery exception indicators",
          "items": [
            "Address or access point cannot be located",
            "Recipient unavailable or refuses delivery",
            "Package is missing, extra, mislabeled, or assigned to another stop",
            "Packaging or contents show visible damage or leakage",
            "Delivery window will be missed",
            "Identity, signature, or age condition cannot be completed",
            "Unsafe parking, property condition, animal, or other site hazard",
            "Customer requests an unapproved alternate delivery location",
            "Proof capture fails or conflicts with the delivered stop",
            "Return item or reusable container cannot be reconciled"
          ],
          "guidance": "Select every observed condition; do not use a generic exception mark when the actual trigger is known."
        },
        {
          "key": "delivery_action_log",
          "type": "table",
          "label": "Exception containment and action log",
          "columns": [
            {
              "key": "issue_scope",
