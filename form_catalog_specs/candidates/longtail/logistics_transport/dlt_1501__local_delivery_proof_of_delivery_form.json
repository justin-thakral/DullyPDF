          "rows": 6
        },
        {
          "key": "timeline_reconciliation",
          "type": "fields",
          "label": "Timeline reconciliation",
          "fields": [
            {
              "key": "first_attempt",
              "label": "First attempt time",
              "units": 1.0
            },
            {
              "key": "completed_time",
              "label": "Completion time",
              "units": 1.0
            },
            {
              "key": "custody_changes",
              "label": "Custody changes",
              "units": 0.9
            },
            {
              "key": "unplanned_stops",
              "label": "Unplanned stops or delays",
              "units": 1.2
            },
            {
              "key": "timeline_status",
              "label": "Timeline status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Complete",
