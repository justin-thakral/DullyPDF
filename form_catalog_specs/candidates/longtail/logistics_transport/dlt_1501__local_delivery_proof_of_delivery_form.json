                "Missing event",
                "Conflicting evidence"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "delivered_scope",
      "title": "Local Delivery delivered scope and recipient verification",
      "guidance": "Tie proof to each relevant unit rather than treating one signature as proof for an unverified shipment.",
      "blocks": [
        {
          "key": "delivered_units",
          "type": "table",
          "label": "Local Delivery Packages And Stop Quantities delivery proof",
          "columns": [
