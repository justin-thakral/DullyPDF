{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1501__local_delivery_proof_of_delivery_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1501__local_delivery_proof_of_delivery_form.pdf",
  "slug": "local-delivery-proof-of-delivery-form",
  "title": "Local Delivery Proof of Delivery Form",
  "subtitle": "Authenticate the local delivery delivery through unit identity, custody events, recipient authority, location, timing, condition, and privacy-conscious proof.",
  "description": "An original, fillable local delivery proof of delivery form for controlling multi-stop local order through proof of delivery identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use after a local delivery delivery or failed attempt when operations must establish what was delivered, to whom, where, when, under which control, and how any evidence gap or dispute was routed.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Local Delivery proof of delivery identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Local Delivery record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Proof Of Delivery record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Route and stop number",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Order, tote, or package ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned route dispatcher",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Assigned Driver",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Origin store, hub, or pickup point",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Delivery address and stop access point",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the route plan, customer order, and package labels."
        }
      ]
    },
    {
      "key": "proof_commitment",
      "title": "Local Delivery delivery obligation and proof standard",
      "guidance": "Define the promised event and acceptable evidence before evaluating whether delivery was completed.",
      "blocks": [
        {
          "key": "delivery_obligation",
          "type": "fields",
          "label": "Delivery obligation",
          "fields": [
            {
              "key": "promised_window",
              "label": "Promised delivery window",
              "units": 1.1
            },
            {
              "key": "actual_completion",
              "label": "Actual completion date and time",
              "units": 1.1
            },
            {
              "key": "proof_standard",
              "label": "Required proof method",
              "units": 1.2
            },
            {
              "key": "authorized_recipient",
              "label": "Stop Recipient Or Receiving Contact",
              "units": 1.3
            }
          ]
        },
        {
          "key": "proof_controls",
          "type": "checklist",
          "label": "Local Delivery custody and proof controls",
          "items": [
            "Direct-to-recipient handoff",
            "Photo proof without personal information",
            "Recipient signature",
            "Identity or age check under applicable policy",
            "No unattended delivery",
            "Keep upright or fragile handling",
            "Return tote or container pickup",
            "Failed-attempt return to origin"
          ],
          "guidance": "Select the controls actually required for this delivery, not every available service feature."
        },
        {
          "key": "route_assignment",
          "type": "fields",
          "label": "Route, custodian, and destination assignment",
          "fields": [
            {
              "key": "route",
              "label": "Route, trip, or movement reference",
              "units": 1.25
            },
            {
              "key": "custodian",
              "label": "Assigned Driver",
              "units": 1.2
            },
            {
              "key": "destination",
              "label": "Delivery address and stop access point",
              "units": 1.4
            },
            {
              "key": "contact_method",
              "label": "Recipient contact method",
              "units": 1.0
            }
          ]
        }
      ]
    },
    {
