            "Independent recount",
            "Serial-by-serial capture",
            "Lot and expiry segregation",
            "Weight or volume conversion",
            "Consigned or customer-owned stock",
            "Damaged, hold, or obsolete status",
            "Transaction cutoff exception"
          ],
          "guidance": "Select the controls actually required for this delivery, not every available service feature."
        },
