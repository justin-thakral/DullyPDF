  "slug": "inventory-count-dispatch-sheet-form",
  "title": "Inventory Count Dispatch Sheet Form",
  "subtitle": "Turn the inventory count request into a capacity-checked manifest, assigned route, custody plan, handling controls, exception path, and authorized release.",
  "description": "An original, fillable inventory count dispatch sheet form for controlling controlled physical inventory count and reconciliation package through dispatch sheet identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use before blind count, recount, and ledger reconciliation when the inventory control coordinator, assigned counter and independent verifier, and receiving owner need one executable dispatch record from commitment through manifest, sequence, variance management, and return handoff.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Inventory Count dispatch sheet identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
