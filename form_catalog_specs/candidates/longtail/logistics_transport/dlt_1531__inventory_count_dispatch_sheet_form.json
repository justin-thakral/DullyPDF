              "units": 1.0
            },
            {
              "key": "required_completion",
              "label": "Required completion",
              "units": 1.05
            },
            {
              "key": "priority",
              "label": "Priority or service level",
              "units": 1.05
            },
            {
              "key": "assigned_custodian",
              "label": "Assigned Counter And Independent Verifier",
              "units": 1.25
            }
          ]
        },
        {
          "key": "dispatch_readiness",
          "type": "checklist",
          "label": "Inventory Count dispatch readiness",
          "items": [
            "Count scope, zone boundaries, responsible teams, and timing are frozen",
            "Receiving, shipping, picking, production, and transfer cutoff is documented",
            "Blind count and system-quantity visibility rules are assigned by role",
            "Item, unit-of-measure, pack conversion, lot, and serial references are available",
            "Open containers, mixed lots, consignment, scrap, returns, and holds are marked",
            "Count tags, scan devices, scales, ladders, and safety access are ready",
            "Variance thresholds, recount independence, and approval levels are defined",
            "Completed sheets and electronic records have controlled custody"
          ],
          "guidance": "Resolve failed readiness controls before authorization or record the approved alternate."
        },
        {
          "key": "equipment_capacity",
          "type": "fields",
          "label": "Equipment, capacity, and route constraint",
          "fields": [
            {
              "key": "equipment",
              "label": "Assigned vehicle, equipment, or work area",
              "units": 1.35
            },
            {
              "key": "capacity",
              "label": "Capacity or available space",
              "units": 1.0
            },
            {
              "key": "route_constraint",
              "label": "Route, cutoff, or site constraint",
              "units": 1.25
            },
            {
              "key": "communication",
              "label": "Primary communication method",
              "units": 1.05
            }
          ]
        }
      ]
    },
