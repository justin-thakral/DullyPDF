              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Assigned Counter And Independent Verifier",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Count zone, aisle, bin, cage, or yard location",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Inventory control review and posting queue",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the count plan, item master, location record, and transaction cutoff."
        }
      ]
    },
    {
