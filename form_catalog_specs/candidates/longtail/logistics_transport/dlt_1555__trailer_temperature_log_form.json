{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1555__trailer_temperature_log_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1555__trailer_temperature_log_form.pdf",
  "slug": "trailer-temperature-log-form",
  "title": "Trailer Temperature Log Form",
  "subtitle": "Define the trailer temperature range and monitoring setup, record chronological readings and events, contain excursions, and obtain qualified disposition.",
  "description": "An original, fillable trailer temperature log form for controlling trailer asset, interchange, load space, and road-readiness record through temperature log identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use during trailer assignment, interchange, inspection, and return when temperature or related environmental control must be reconstructed from identified devices, checkpoints, readings, custody events, equipment observations, excursion response, and final review.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Trailer temperature log identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Trailer record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Temperature Log record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Trailer unit, VIN, and interchange number",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Plate, seal, work-order, or yard-location ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned fleet or yard coordinator",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Driver, Yard Hostler, Or Receiving Carrier",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Owning yard, customer dock, or prior carrier",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Assigned route, customer, carrier, or return yard",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the trailer master, inspection criteria, maintenance record, and interchange terms."
        }
      ]
    },
    {
      "key": "temperature_requirements",
      "title": "Trailer temperature requirements and monitoring setup",
      "guidance": "Record the controlling range, method, devices, and responsibilities before relying on readings.",
      "blocks": [
        {
          "key": "range_requirement",
          "type": "fields",
          "label": "Approved range and exposure boundary",
          "fields": [
            {
              "key": "lower_limit",
              "label": "Approved lower limit and units",
              "units": 1.15
            },
            {
              "key": "upper_limit",
              "label": "Approved upper limit and units",
              "units": 1.15
            },
            {
              "key": "exposure_limit",
              "label": "Maximum exposure or excursion rule",
              "units": 1.25
            },
            {
              "key": "requirements_source",
              "label": "Protocol, label, or requirement source",
              "units": 1.4
            }
          ]
        },
        {
          "key": "monitoring_equipment",
          "type": "fields",
          "label": "Monitoring equipment and verification",
          "fields": [
            {
              "key": "device_id",
              "label": "Logger, probe, display, or meter ID",
              "units": 1.35
            },
            {
              "key": "calibration",
              "label": "Calibration or verification status",
              "units": 1.2
            },
            {
              "key": "accuracy",
              "label": "Accuracy or uncertainty",
              "units": 1.0
            },
            {
              "key": "placement",
              "label": "Device placement or measurement point",
              "units": 1.35
            }
          ]
        },
        {
          "key": "required_checkpoints",
          "type": "checklist",
          "label": "Trailer required temperature checkpoints",
          "items": [
            "Refrigeration unit display",
            "Independent reference probe",
            "Front interior air",
            "Center interior air",
            "Rear interior air",
            "Return-air reading",
            "Supply-air reading",
            "Post-door-close recovery"
          ],
          "guidance": "Use the reading table for actual values; this list defines the intended monitoring coverage."
        }
      ]
    },
    {
      "key": "temperature_readings",
      "title": "Trailer chronological temperature readings",
      "guidance": "Record readings as observed with location, device, responsible person, and relevant event.",
      "blocks": [
        {
          "key": "reading_log",
          "type": "table",
          "label": "Temperature reading log",
          "columns": [
            {
              "key": "date_time",
              "label": "Date and time",
              "units": 0.9
            },
            {
              "key": "point",
              "label": "Location or checkpoint",
              "units": 1.2
            },
            {
              "key": "device",
              "label": "Device ID",
              "units": 0.9
            },
            {
              "key": "reading",
              "label": "Reading and units",
              "units": 0.95
            },
            {
              "key": "event",
              "label": "Door, transfer, delay, or event",
              "units": 1.25
            },
            {
              "key": "observer",
              "label": "Observer or source",
              "units": 1.0
            }
          ],
          "rows": 8
        },
        {
          "key": "reading_summary",
          "type": "fields",
          "label": "Reading and exposure summary",
          "fields": [
            {
              "key": "minimum",
              "label": "Minimum observed",
              "units": 0.95
            },
            {
              "key": "maximum",
              "label": "Maximum observed",
              "units": 0.95
            },
            {
              "key": "out_of_range",
              "label": "Out-of-range duration",
              "units": 1.05
            },
            {
              "key": "missing_interval",
              "label": "Missing-data interval",
              "units": 1.1
            },
            {
              "key": "summary_status",
              "label": "Initial status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Within range",
                "Potential excursion",
                "Confirmed excursion",
                "Data incomplete",
                "Device unreliable"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "control_observations",
      "title": "Trailer environmental and handling observations",
      "guidance": "Connect readings to the operational conditions that can explain or affect temperature control.",
      "blocks": [
        {
          "key": "handling_controls",
          "type": "checklist",
          "label": "Trailer temperature-control practices",
          "items": [
            "Road-service assignment",
            "Yard-only movement",
            "Out-of-service hold",
            "Maintenance routing",
            "Sealed-load custody",
            "Food-compatible clean trailer",
            "Temperature-control equipment required",
            "Customer-specific interchange condition"
          ]
        },
        {
          "key": "readiness_controls",
          "type": "checklist",
          "label": "Equipment, custody, and response readiness",
          "items": [
            "Trailer unit, VIN, plate, owner, type, dimensions, and capacity are matched",
            "Assigned tractor, driver, route, cargo, and customer requirements are compatible",
            "Brake connections, lights, tires, coupling, landing gear, doors, and structure are checked",
            "Interior, roof, floor, walls, drain, odor, debris, and prior-cargo condition are reviewed",
            "Maintenance due, out-of-service status, open work order, and defect history are known",
            "Seal, lock, securement equipment, spare equipment, and document pouch are reconciled",
            "Yard location, pickup time, return expectation, and custody parties are recorded",
            "Unsafe defect, damage dispute, contamination, and alternate-equipment routes are defined"
          ]
        },
        {
          "key": "observation_notes",
          "type": "textarea",
          "label": "Equipment status, packaging condition, door events, delays, and other observations",
          "fields": [
            {
              "key": "details",
              "label": "Equipment status, packaging condition, door events, delays, and other observations",
              "multiline": true
            }
          ],
          "height": 62,
          "guidance": "Do not infer product suitability from an ambient reading alone; preserve the measurement context."
        }
      ]
    },
    {
      "key": "excursion_response",
      "title": "Trailer temperature excursion and immediate response",
      "guidance": "Stop affected release or use, protect evidence, and assign qualified disposition when control is uncertain.",
      "blocks": [
        {
          "key": "excursion_indicators",
          "type": "checklist",
          "label": "Excursion or monitoring failure indicators",
          "items": [
            "Reading above the approved upper limit",
            "Reading below the approved lower limit",
            "Freeze exposure or freeze indicator",
            "Alarm, logger, probe, display, or meter failure",
            "Missing, overwritten, delayed, or conflicting temperature data",
            "Unplanned door opening, transfer, delay, or power interruption",
            "Packaging, seal, coolant, compartment, tank, or equipment damage",
            "Product or controlled material condition concern",
            "Monitoring responsibility or custody interval cannot be established",
            "No excursion or monitoring failure observed"
          ]
        },
        {
          "key": "excursion_actions",
          "type": "table",
          "label": "Excursion containment and investigation log",
          "columns": [
            {
              "key": "affected_scope",
              "label": "Affected lot, unit, or interval",
              "units": 1.35
            },
            {
              "key": "immediate_action",
              "label": "Immediate action or hold",
              "units": 1.25
            },
            {
              "key": "owner",
              "label": "Action owner",
              "units": 0.9
            },
            {
              "key": "due",
              "label": "Review due",
              "units": 0.8
            },
            {
              "key": "evidence",
              "label": "Logger, probe, photo, or record ref",
              "units": 1.25
            }
          ],
          "rows": 5
        },
        {
          "key": "notification",
          "type": "fields",
          "label": "Excursion notification and custody",
          "fields": [
            {
              "key": "notified",
              "label": "Qualified reviewer notified",
              "units": 1.2
            },
            {
              "key": "notification_time",
              "label": "Notification date and time",
              "units": 1.1
            },
            {
              "key": "hold_location",
              "label": "Hold, quarantine, or controlled location",
              "units": 1.35
            },
            {
              "key": "custody_owner",
              "label": "Current custody owner",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "temperature_disposition",
      "title": "Trailer temperature assessment and disposition",
      "guidance": "Document the evidence reviewed, authorized scope, restrictions, and rationale for the final decision.",
      "blocks": [
        {
          "key": "assessment_evidence",
          "type": "table",
          "label": "Qualified assessment evidence",
          "columns": [
            {
              "key": "evidence",
              "label": "Evidence or requirement",
              "units": 1.45
            },
            {
              "key": "scope",
              "label": "Affected scope",
              "units": 1.0
            },
            {
              "key": "finding",
              "label": "Finding or limitation",
              "units": 1.3
            },
            {
              "key": "reviewer",
              "label": "Reviewer",
              "units": 0.9
            },
            {
              "key": "reference",
              "label": "Assessment reference",
              "units": 1.15
            }
          ],
          "rows": 4
        },
        {
          "key": "disposition",
          "type": "fields",
          "label": "Temperature-control disposition",
          "fields": [
            {
              "key": "decision",
              "label": "Disposition",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Accepted within range",
                "Released after qualified review",
                "Restricted use or movement",
                "Continue hold",
                "Reject or return"
              ]
            },
            {
              "key": "authorized_scope",
              "label": "Authorized lot, quantity, or interval",
              "units": 1.35
            },
            {
              "key": "remaining_restriction",
              "label": "Remaining restriction",
              "units": 1.25
            },
            {
              "key": "decision_reference",
              "label": "Decision and rationale reference",
              "units": 1.35
            }
          ]
        },
        {
          "key": "disposition_signoff",
          "type": "signatures",
          "label": "Monitoring review and disposition authorization",
          "fields": [
            {
              "key": "log_preparer",
              "label": "Log prepared by and date",
              "units": 1.2
            },
            {
              "key": "qualified_reviewer",
              "label": "Qualified Fleet Maintenance Or Safety Supervisor decision",
              "units": 1.5
            },
            {
              "key": "custody_owner",
              "label": "Custody owner acknowledgment",
              "units": 1.25
            }
          ]
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Trailer temperature log closeout and accountable handoff",
      "guidance": "Close only when outcome, remaining limitation, next action, evidence, and receiving ownership agree.",
      "blocks": [
        {
          "key": "remaining_actions",
          "type": "table",
          "label": "Remaining action and follow-up register",
          "columns": [
            {
              "key": "action",
              "label": "Remaining action",
              "units": 1.4
            },
            {
              "key": "owner",
              "label": "Responsible owner",
              "units": 1.0
            },
            {
              "key": "due",
              "label": "Due date or trigger",
              "units": 1.0
            },
            {
              "key": "evidence",
              "label": "Completion evidence",
              "units": 1.2
            }
          ],
          "rows": 4
        },
        {
          "key": "final_outcome",
          "type": "fields",
          "label": "Final outcome, handoff, and record location",
          "fields": [
            {
              "key": "outcome",
              "label": "Final outcome",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Range maintained and closed",
                "Excursion reviewed and released",
                "Restricted disposition completed",
                "Held for further evidence",
                "Rejected, returned, or removed"
              ]
            },
            {
              "key": "handoff_to",
              "label": "Handoff accepted by",
              "units": 1.15
            },
            {
              "key": "record_location",
              "label": "Evidence package location",
              "units": 1.35
            },
            {
              "key": "closed_at",
              "label": "Closed date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Record boundary and stop condition",
          "guidance": "This trailer temperature log is an operational record, not a substitute for applicable law, contract terms, safety or product requirements, or professional judgment. Stop the affected movement, transfer, release, posting, or disposition when identity, evidence, authorization, or control is uncertain. A qualified qualified fleet maintenance or safety supervisor must review the exception and document the controlling decision."
        },
        {
          "key": "closeout_approval",
          "type": "signatures",
          "label": "Prepared, reviewed, and accepted",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by and date",
              "units": 1.2
            },
            {
              "key": "reviewed_by",
              "label": "Reviewed by qualified fleet maintenance or safety supervisor",
              "units": 1.45
            },
            {
              "key": "accepted_by",
              "label": "Receiving owner acceptance",
              "units": 1.25
            }
          ],
          "guidance": "A signature records accountability for the stated decision; it does not cure missing evidence or override a stop condition."
        }
      ]
    }
  ]
}
