{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1503__local_delivery_dispatch_sheet_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1503__local_delivery_dispatch_sheet_form.pdf",
  "slug": "local-delivery-dispatch-sheet-form",
  "title": "Local Delivery Dispatch Sheet Form",
  "subtitle": "Turn the local delivery request into a capacity-checked manifest, assigned route, custody plan, handling controls, exception path, and authorized release.",
  "description": "An original, fillable local delivery dispatch sheet form for controlling multi-stop local order through dispatch sheet identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use before same-day route execution when the route dispatcher, assigned driver, and receiving owner need one executable dispatch record from commitment through manifest, sequence, variance management, and return handoff.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Local Delivery dispatch sheet identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Local Delivery record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Dispatch Sheet record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Route and stop number",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Order, tote, or package ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned route dispatcher",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Assigned Driver",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Origin store, hub, or pickup point",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Delivery address and stop access point",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the route plan, customer order, and package labels."
        }
      ]
    },
    {
      "key": "dispatch_commitment",
      "title": "Local Delivery service commitment and assignment",
      "guidance": "Convert the request into an executable assignment with clear timing, capacity, and accountable custody.",
      "blocks": [
        {
          "key": "service_assignment",
          "type": "fields",
          "label": "Dispatch assignment",
          "fields": [
            {
              "key": "requested_by",
              "label": "Requested by",
              "units": 1.0
            },
            {
              "key": "ready_time",
              "label": "Ready date and time",
              "units": 1.0
            },
            {
              "key": "required_completion",
              "label": "Required completion",
              "units": 1.05
            },
            {
              "key": "priority",
              "label": "Priority or service level",
              "units": 1.05
            },
            {
              "key": "assigned_custodian",
              "label": "Assigned Driver",
              "units": 1.25
            }
          ]
        },
        {
          "key": "dispatch_readiness",
          "type": "checklist",
          "label": "Local Delivery dispatch readiness",
          "items": [
            "Stop sequence matches promised delivery windows and traffic constraints",
            "Every order is matched to route, stop, package, and recipient identifiers",
            "Vehicle capacity and package placement support the planned stop sequence",
            "Driver has access instructions, contact method, and failed-attempt rules",
            "Age, identity, signature, or photo requirements are explicit where applicable",
            "Fragile, upright, temperature, and no-unattended-delivery controls are visible",
            "Returns, exchanges, cash handling, or reusable containers have separate custody",
            "Dispatcher has a communication and escalation path for route disruption"
          ],
          "guidance": "Resolve failed readiness controls before authorization or record the approved alternate."
        },
        {
          "key": "equipment_capacity",
          "type": "fields",
          "label": "Equipment, capacity, and route constraint",
          "fields": [
            {
              "key": "equipment",
              "label": "Assigned vehicle, equipment, or work area",
              "units": 1.35
            },
            {
              "key": "capacity",
              "label": "Capacity or available space",
              "units": 1.0
            },
            {
              "key": "route_constraint",
              "label": "Route, cutoff, or site constraint",
              "units": 1.25
            },
            {
              "key": "communication",
              "label": "Primary communication method",
              "units": 1.05
            }
          ]
        }
      ]
    },
    {
      "key": "dispatch_manifest",
      "title": "Local Delivery dispatch manifest and control assignment",
      "guidance": "Tie each movement unit to its quantity, custody, destination, and handling control.",
      "blocks": [
        {
          "key": "manifest_lines",
          "type": "table",
          "label": "Local Delivery Packages And Stop Quantities dispatch manifest",
          "columns": [
            {
              "key": "unit_id",
              "label": "Order, tote, or package ID",
              "units": 1.35
            },
            {
              "key": "quantity",
              "label": "Expected and delivered pieces",
              "units": 1.0
            },
            {
              "key": "origin",
              "label": "Origin or source point",
              "units": 1.05
            },
            {
              "key": "destination",
              "label": "Destination or handoff",
              "units": 1.1
            },
            {
              "key": "control",
              "label": "Service window and handling instruction",
              "units": 1.15
            },
            {
              "key": "proof",
              "label": "Required proof or scan",
              "units": 1.0
            }
          ],
          "rows": 7
        },
        {
          "key": "manifest_totals",
          "type": "fields",
          "label": "Manifest and capacity totals",
          "fields": [
            {
              "key": "unit_total",
              "label": "Total units",
              "units": 0.85
            },
            {
              "key": "quantity_total",
              "label": "Total quantity",
              "units": 0.9
            },
            {
              "key": "weight_volume",
              "label": "Weight, volume, or capacity use",
              "units": 1.2
            },
            {
              "key": "manifest_status",
              "label": "Manifest status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Reconciled",
                "Pending verification",
                "Partial assignment",
                "On hold"
              ]
            },
            {
              "key": "control_reference",
              "label": "Control or instruction reference",
              "units": 1.25
            }
          ]
        }
      ]
    },
    {
      "key": "route_handoff_plan",
      "title": "Local Delivery route, sequence, and custody plan",
      "guidance": "Plan each control point and define the handoff evidence before execution begins.",
      "blocks": [
        {
          "key": "route_stops",
          "type": "table",
          "label": "Route, work sequence, and handoff plan",
          "columns": [
            {
              "key": "sequence",
              "label": "Sequence",
              "units": 0.65
            },
            {
              "key": "location",
              "label": "Location or control point",
              "units": 1.3
            },
            {
              "key": "window",
              "label": "Planned window",
              "units": 0.9
            },
            {
              "key": "contact",
              "label": "Contact or custodian",
              "units": 1.05
            },
            {
              "key": "action",
              "label": "Required action",
              "units": 1.25
            },
            {
              "key": "proof",
              "label": "Proof or completion ref",
              "units": 1.05
            }
          ],
          "rows": 6
        },
        {
          "key": "handling_controls",
          "type": "checklist",
          "label": "Local Delivery assigned handling controls",
          "items": [
            "Direct-to-recipient handoff",
            "Photo proof without personal information",
            "Recipient signature",
            "Identity or age check under applicable policy",
            "No unattended delivery",
            "Keep upright or fragile handling",
            "Return tote or container pickup",
            "Failed-attempt return to origin"
          ]
        },
        {
          "key": "dispatch_instructions",
          "type": "textarea",
          "label": "Access, loading, custody, contingency, and return instructions",
          "fields": [
            {
              "key": "details",
              "label": "Access, loading, custody, contingency, and return instructions",
              "multiline": true
            }
          ],
          "height": 58,
          "guidance": "Write only instructions the assignee cannot reliably infer from labels, route data, or standard procedure."
        }
      ]
    },
    {
      "key": "dispatch_exceptions",
      "title": "Local Delivery exception, containment, and escalation",
      "guidance": "Make the trigger, affected scope, immediate control, owner, deadline, and escalation reconstructable.",
      "blocks": [
        {
          "key": "dispatch_exception_types",
          "type": "checklist",
          "label": "Local Delivery exception indicators",
          "items": [
            "Address or access point cannot be located",
            "Recipient unavailable or refuses delivery",
            "Package is missing, extra, mislabeled, or assigned to another stop",
            "Packaging or contents show visible damage or leakage",
            "Delivery window will be missed",
            "Identity, signature, or age condition cannot be completed",
            "Unsafe parking, property condition, animal, or other site hazard",
            "Customer requests an unapproved alternate delivery location",
            "Proof capture fails or conflicts with the delivered stop",
            "Return item or reusable container cannot be reconciled"
          ],
          "guidance": "Select every observed condition; do not use a generic exception mark when the actual trigger is known."
        },
        {
          "key": "dispatch_action_log",
          "type": "table",
          "label": "Exception containment and action log",
          "columns": [
            {
              "key": "issue_scope",
              "label": "Issue and affected ID",
              "units": 1.35
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.25
            },
            {
              "key": "owner",
              "label": "Action owner",
              "units": 0.9
            },
            {
              "key": "due",
              "label": "Due point",
              "units": 0.8
            },
            {
              "key": "escalation",
              "label": "Escalation or proof ref",
              "units": 1.2
            }
          ],
          "rows": 4
        },
        {
          "key": "dispatch_decision",
          "type": "fields",
          "label": "Dispatch variance, alternate assignment, or stop-work decision",
          "fields": [
            {
              "key": "status",
              "label": "Interim status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Open - controlled",
                "Open - escalated",
                "Pending evidence",
                "Resolved",
                "Rejected"
              ]
            },
            {
              "key": "decision_owner",
              "label": "Decision owner",
              "units": 1.1
            },
            {
              "key": "decision_time",
              "label": "Decision date and time",
              "units": 1.0
            },
            {
              "key": "next_review",
              "label": "Next review or deadline",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "dispatch_authorization",
