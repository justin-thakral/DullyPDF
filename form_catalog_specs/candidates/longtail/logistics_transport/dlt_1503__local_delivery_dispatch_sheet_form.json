                "Authorized",
                "Authorized with restriction",
                "Partially authorized",
                "Held",
                "Canceled"
              ]
            },
            {
              "key": "released_scope",
              "label": "Released units or scope",
              "units": 1.25
            },
            {
              "key": "restriction",
              "label": "Continuing restriction",
              "units": 1.25
            },
            {
              "key": "release_time",
              "label": "Release date and time",
              "units": 1.0
            },
            {
              "key": "return_due",
              "label": "Return, update, or check-in due",
              "units": 1.05
            }
          ]
        },
        {
          "key": "dispatch_signoff",
          "type": "signatures",
          "label": "Prepared, accepted, and released",
          "fields": [
            {
              "key": "dispatcher",
              "label": "Route Dispatcher authorization",
              "units": 1.35
            },
            {
              "key": "assignee",
              "label": "Assignee acceptance",
              "units": 1.2
            },
            {
              "key": "reviewer",
              "label": "Local Delivery Operations Lead review",
              "units": 1.35
            }
          ]
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Local Delivery dispatch sheet closeout and accountable handoff",
      "guidance": "Close only when outcome, remaining limitation, next action, evidence, and receiving ownership agree.",
      "blocks": [
        {
          "key": "remaining_actions",
          "type": "table",
          "label": "Remaining action and follow-up register",
          "columns": [
            {
              "key": "action",
              "label": "Remaining action",
              "units": 1.4
            },
            {
              "key": "owner",
              "label": "Responsible owner",
              "units": 1.0
            },
            {
              "key": "due",
              "label": "Due date or trigger",
              "units": 1.0
            },
            {
              "key": "evidence",
              "label": "Completion evidence",
