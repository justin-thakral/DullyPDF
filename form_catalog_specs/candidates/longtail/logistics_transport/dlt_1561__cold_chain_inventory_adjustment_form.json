              "units": 1.05
            },
            {
              "key": "currency_uom",
              "label": "Currency or unit of measure",
              "units": 1.05
            },
            {
              "key": "reconciliation_status",
              "label": "Reconciliation status",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Balanced",
                "Balanced with correction",
                "Pending evidence",
                "Unresolved"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "cause_evidence",
      "title": "Cold Chain adjustment reason and evidence",
      "guidance": "Use a reason supported by transaction and physical evidence, not a balancing convenience.",
      "blocks": [
        {
          "key": "reason_codes",
          "type": "checklist",
          "label": "Cold Chain supported adjustment reasons",
          "items": [
            "Controlled receipt posted after initial acceptance",
            "Excursion quantity transferred to quarantine",
            "Logger or evidence failure moved product to hold",
            "Qualified review released all or part of the quantity",
            "Rejected product returned to shipper control",
            "Damaged, contaminated, or compromised quantity segregated",
            "Lot, expiry, unit-of-measure, or pallet identity corrected",
            "Duplicate shipment or receipt transaction reversed"
          ]
        },
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Conditions requiring investigation or escalation",
          "items": [
            "Product, lot, quantity, range, route, or protocol mismatch",
            "Packaging or coolant configuration differs from the approved pack-out",
            "Logger missing, expired, uncalibrated, failed, stopped, or incorrectly placed",
            "Vehicle or container not clean, compatible, or adequately preconditioned",
            "Seal damage, shipper damage, leakage, contamination, or tampering",
            "Temperature alarm, excursion, freeze event, or missing data interval",
            "Delay, door-open exposure, power interruption, or unplanned transfer",
            "Receiving site cannot maintain quarantine or controlled storage",
            "Product released, moved, sold, or used before qualified disposition",
            "Custody, timing, or evidence cannot reconstruct the exposure history"
          ]
        },
        {
          "key": "evidence_index",
          "type": "table",
          "label": "Adjustment evidence and source-record index",
          "columns": [
            {
              "key": "evidence",
