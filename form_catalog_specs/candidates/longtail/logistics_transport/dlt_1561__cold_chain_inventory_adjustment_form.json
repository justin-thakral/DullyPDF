        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Record boundary and stop condition",
          "guidance": "This cold chain inventory adjustment is an operational record, not a substitute for applicable law, contract terms, safety or product requirements, or professional judgment. Stop the affected movement, transfer, release, posting, or disposition when identity, evidence, authorization, or control is uncertain. A qualified qualified quality, food-safety, pharmacy, or product-integrity reviewer must review the exception and document the controlling decision."
        },
        {
          "key": "closeout_approval",
          "type": "signatures",
          "label": "Prepared, reviewed, and accepted",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by and date",
              "units": 1.2
            },
            {
              "key": "reviewed_by",
              "label": "Reviewed by qualified quality, food-safety, pharmacy, or product-integrity reviewer",
              "units": 1.45
            },
            {
              "key": "accepted_by",
              "label": "Receiving owner acceptance",
              "units": 1.25
            }
          ],
          "guidance": "A signature records accountability for the stated decision; it does not cure missing evidence or override a stop condition."
        }
