{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1561__cold_chain_inventory_adjustment_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1561__cold_chain_inventory_adjustment_form.pdf",
  "slug": "cold-chain-inventory-adjustment-form",
  "title": "Cold Chain Inventory Adjustment Form",
  "subtitle": "Reconcile the cold chain source state to verified evidence, explain every variance, control affected inventory, authorize exact postings, and verify the ledger.",
  "description": "An original, fillable cold chain inventory adjustment form for controlling temperature-controlled consignment and product-integrity record through inventory adjustment identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use when shipped, monitored, received, and disposition quantity or related identity, location, status, or ownership differs from the system and a controlled adjustment must remain traceable from physical evidence through approval, posting, and after-state verification.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Cold Chain inventory adjustment identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Cold Chain record references",
          "fields": [
            {
              "key": "record_number",
              "label": "Inventory Adjustment record number",
              "units": 1.1
            },
            {
              "key": "primary_id",
              "label": "Shipment, order, lane, and protocol reference",
              "units": 1.45
            },
            {
              "key": "secondary_id",
              "label": "Lot, pallet, shipper, logger, sensor, or seal ID",
              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned cold-chain logistics coordinator",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Trained Cold-Chain Shipper, Carrier, And Receiver",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Qualified storage, pack-out, and loading location",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Approved receiving and quarantine location",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the shipping protocol, product requirements, lane plan, and logger instructions."
        }
      ]
    },
    {
      "key": "adjustment_boundary",
      "title": "Cold Chain inventory boundary and source state",
      "guidance": "Freeze the affected identity, location, cutoff, and source balances before proposing a posting.",
      "blocks": [
        {
          "key": "source_state",
          "type": "fields",
          "label": "Source inventory state",
          "fields": [
            {
              "key": "system_snapshot",
              "label": "System snapshot date and time",
              "units": 1.15
            },
            {
              "key": "transaction_cutoff",
              "label": "Transaction cutoff or through-time",
              "units": 1.2
            },
            {
              "key": "location",
              "label": "Qualified storage, pack-out, and loading location",
              "units": 1.35
            },
            {
              "key": "record_owner",
              "label": "Source record owner or cold-chain logistics coordinator",
              "units": 1.25
            }
          ]
        },
        {
          "key": "boundary_controls",
          "type": "checklist",
          "label": "Cold Chain adjustment controls",
          "items": [
            "Product, lot, quantity, approved range, exposure limit, and route are identified",
            "Qualified packaging configuration, coolant, conditioning, and pack-out are confirmed",
            "Vehicle or container is clean, compatible, and preconditioned when required",
            "Calibrated logger or sensor identity, placement, start, and alarm settings are recorded",
            "Loading sequence, door-open control, segregation, and contamination prevention are assigned",
            "Carrier and receiver understand monitoring, delay, power-loss, and handoff responsibilities",
            "Quarantine space and qualified excursion-review contacts are available",
            "No product is released after uncertain control until qualified disposition is documented"
          ],
          "guidance": "Do not post until movement, unit, ownership, status, and evidence boundaries are understood."
        },
        {
          "key": "approval_threshold",
          "type": "fields",
          "label": "Authority and posting threshold",
          "fields": [
            {
              "key": "adjustment_type",
              "label": "Adjustment type",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Quantity",
                "Location",
                "Status",
                "Lot or serial",
                "Ownership",
                "Reversal"
              ]
            },
            {
              "key": "threshold",
              "label": "Value or quantity approval threshold",
              "units": 1.25
            },
            {
              "key": "posting_system",
              "label": "System or ledger to update",
              "units": 1.2
            },
            {
              "key": "restricted_period",
              "label": "Closed period or restriction",
              "units": 1.15
            }
          ]
        }
      ]
    },
    {
