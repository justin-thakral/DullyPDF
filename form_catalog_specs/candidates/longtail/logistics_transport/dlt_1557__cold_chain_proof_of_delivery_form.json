              "key": "origin",
              "label": "Qualified storage, pack-out, and loading location",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Approved receiving and quarantine location",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the shipping protocol, product requirements, lane plan, and logger instructions."
        }
      ]
    },
