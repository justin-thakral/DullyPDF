              "key": "proof_ref",
              "label": "Proof reference",
              "units": 1.1
            }
          ],
          "rows": 6
        },
        {
          "key": "proof_evidence",
          "type": "checklist",
          "label": "Cold Chain proof package",
          "items": [
            "Approved shipping protocol and lane record",
            "Product, lot, quantity, and pack-out record",
            "Coolant conditioning and packaging configuration",
            "Logger identity, calibration, start, and placement",
            "Vehicle preconditioning and loading observation",
            "Custody, seal, delay, and door-open events",
            "Arrival readings and downloaded temperature history",
            "Qualified excursion assessment and product disposition"
          ],
          "guidance": "Capture only the evidence needed to authenticate the event and follow privacy, access, and retention policy."
        },
        {
          "key": "delivery_facts",
          "type": "textarea",
          "label": "Delivery location, recipient authority, custody, and condition facts",
          "fields": [
