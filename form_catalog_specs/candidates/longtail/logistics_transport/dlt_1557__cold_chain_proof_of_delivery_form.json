{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1557__cold_chain_proof_of_delivery_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1557__cold_chain_proof_of_delivery_form.pdf",
  "slug": "cold-chain-proof-of-delivery-form",
  "title": "Cold Chain Proof of Delivery Form",
  "subtitle": "Authenticate the cold chain delivery through unit identity, custody events, recipient authority, location, timing, condition, and privacy-conscious proof.",
  "description": "An original, fillable cold chain proof of delivery form for controlling temperature-controlled consignment and product-integrity record through proof of delivery identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use after a cold chain delivery or failed attempt when operations must establish what was delivered, to whom, where, when, under which control, and how any evidence gap or dispute was routed.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Cold Chain proof of delivery identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
