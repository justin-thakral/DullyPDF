              "units": 1.3
            }
          ]
        },
        {
          "key": "proof_controls",
          "type": "checklist",
          "label": "Cold Chain custody and proof controls",
          "items": [
            "Maintain approved chilled range",
            "Maintain approved frozen range",
            "Protect from freezing",
            "Qualified passive shipper",
            "Active refrigerated equipment",
            "Continuous logger or sensor monitoring",
            "Minimize door-open and staging exposure",
            "Quarantine on alarm, missing data, or uncertain control"
          ],
          "guidance": "Select the controls actually required for this delivery, not every available service feature."
        },
        {
          "key": "route_assignment",
          "type": "fields",
