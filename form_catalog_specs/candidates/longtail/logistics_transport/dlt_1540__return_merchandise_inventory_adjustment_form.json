    {
      "key": "cause_evidence",
      "title": "Return Merchandise adjustment reason and evidence",
      "guidance": "Use a reason supported by transaction and physical evidence, not a balancing convenience.",
      "blocks": [
        {
          "key": "reason_codes",
          "type": "checklist",
          "label": "Return Merchandise supported adjustment reasons",
          "items": [
            "Authorized customer return received",
            "Return quantity differs after item-level inspection",
            "Restockable quantity released",
            "Damaged or unsafe quantity transferred to hold",
            "Repair or refurbishment inventory created",
            "Supplier return or recall route posted",
            "Credit-only or replacement-only transaction reconciled",
            "Duplicate return, refund, or receipt reversed"
          ]
        },
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Conditions requiring investigation or escalation",
          "items": [
            "No valid return authorization or item outside approved scope",
            "SKU, serial, lot, ownership, or original transaction cannot be matched",
            "Received quantity or accessories differ from the return request",
            "Undisclosed use, damage, contamination, modification, or missing parts",
            "Hazardous, leaking, swollen, sharp, or otherwise unsafe condition",
            "Data-bearing device lacks approved privacy handling",
            "Temperature control or product integrity cannot be established",
            "Warranty, recall, return-window, or policy status is disputed",
            "Customer remedy and physical disposition conflict",
            "Duplicate credit, replacement, or return record is suspected"
          ]
        },
        {
