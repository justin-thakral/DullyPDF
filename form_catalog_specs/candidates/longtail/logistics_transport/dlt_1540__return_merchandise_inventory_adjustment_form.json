              "key": "adjustment_type",
              "label": "Adjustment type",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Quantity",
                "Location",
                "Status",
                "Lot or serial",
                "Ownership",
                "Reversal"
              ]
            },
            {
              "key": "threshold",
              "label": "Value or quantity approval threshold",
              "units": 1.25
            },
            {
              "key": "posting_system",
              "label": "System or ledger to update",
              "units": 1.2
            },
            {
              "key": "restricted_period",
              "label": "Closed period or restriction",
              "units": 1.15
            }
          ]
        }
