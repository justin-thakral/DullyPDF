{
  "schema_version": 1,
  "catalog_id": "logistics_transport/dlt_1540__return_merchandise_inventory_adjustment_form",
  "source_section": "logistics_transport",
  "source_filename": "dlt_1540__return_merchandise_inventory_adjustment_form.pdf",
  "slug": "return-merchandise-inventory-adjustment-form",
  "title": "Return Merchandise Inventory Adjustment Form",
  "subtitle": "Reconcile the return merchandise source state to verified evidence, explain every variance, control affected inventory, authorize exact postings, and verify the ledger.",
  "description": "An original, fillable return merchandise inventory adjustment form for controlling returned product, return authorization, and disposition unit through inventory adjustment identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use when authorized, received, accepted, and disposition quantity or related identity, location, status, or ownership differs from the system and a controlled adjustment must remain traceable from physical evidence through approval, posting, and after-state verification.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Return Merchandise inventory adjustment identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
