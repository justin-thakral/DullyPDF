              "units": 1.45
            },
            {
              "key": "record_date_time",
              "label": "Record date and time",
              "units": 1.0
            }
          ]
        },
        {
          "key": "parties_locations",
          "type": "fields",
          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned returns authorization coordinator",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Returns Receiving And Inspection Associate",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Customer, store, field location, or return carrier",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Returns dock, quarantine area, repair, restock, or supplier route",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the return authorization, original sale, product identity, and return policy."
        }
      ]
    },
    {
      "key": "adjustment_boundary",
      "title": "Return Merchandise inventory boundary and source state",
      "guidance": "Freeze the affected identity, location, cutoff, and source balances before proposing a posting.",
      "blocks": [
        {
          "key": "source_state",
          "type": "fields",
          "label": "Source inventory state",
          "fields": [
            {
              "key": "system_snapshot",
              "label": "System snapshot date and time",
              "units": 1.15
            },
            {
              "key": "transaction_cutoff",
              "label": "Transaction cutoff or through-time",
              "units": 1.2
            },
            {
              "key": "location",
              "label": "Customer, store, field location, or return carrier",
              "units": 1.35
            },
            {
              "key": "record_owner",
              "label": "Source record owner or returns authorization coordinator",
              "units": 1.25
            }
          ]
        },
        {
          "key": "boundary_controls",
          "type": "checklist",
          "label": "Return Merchandise adjustment controls",
          "items": [
            "Return authorization, original transaction, customer, and item are matched",
            "Permitted quantity, return reason, return window, and routing are explicit",
            "Serial, lot, warranty, ownership, and recall status can be verified",
            "Required accessories, packaging, manuals, keys, or components are identified",
            "Data-bearing, hazardous, contaminated, food, and temperature-sensitive items are routed",
            "Carrier label, pickup method, and receiving destination are correct",
            "Refund, replacement, repair, restock, supplier return, and disposal authority are separated",
            "Fraud, privacy, safety, and unresolved-condition escalation is assigned"
          ],
          "guidance": "Do not post until movement, unit, ownership, status, and evidence boundaries are understood."
        },
        {
          "key": "approval_threshold",
          "type": "fields",
          "label": "Authority and posting threshold",
          "fields": [
