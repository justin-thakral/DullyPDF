          "label": "Responsible parties and route points",
          "fields": [
            {
              "key": "owner",
              "label": "Assigned warehouse wave coordinator",
              "units": 1.2
            },
            {
              "key": "custodian",
              "label": "Picker, Packer, Or Staging Associate",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Zone, aisle, bin, or reserve location",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Pack station, staging lane, dock, or production point",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the pick ticket, warehouse task, item master, and allocation record."
        }
      ]
    },
