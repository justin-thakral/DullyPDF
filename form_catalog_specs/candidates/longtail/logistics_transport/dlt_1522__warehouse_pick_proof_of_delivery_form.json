          "key": "proof_evidence",
          "type": "checklist",
          "label": "Warehouse Pick proof package",
          "items": [
            "Released pick ticket or warehouse task",
            "Source-bin and item scan",
            "Lot, serial, expiry, or revision capture",
            "Short-pick and replenishment record",
            "Pack verification and carton label",
            "Staging lane or license-plate scan",
            "Exception photograph or hold tag",
            "Shipping or production handoff confirmation"
          ],
          "guidance": "Capture only the evidence needed to authenticate the event and follow privacy, access, and retention policy."
        },
        {
          "key": "delivery_facts",
