              "units": 1.3
            }
          ]
        },
        {
          "key": "proof_controls",
          "type": "checklist",
          "label": "Warehouse Pick custody and proof controls",
          "items": [
            "FIFO allocation",
            "FEFO allocation",
            "Lot-controlled pick",
            "Serial capture",
            "No substitution",
            "Fragile or crush-sensitive pack",
            "Temperature-controlled staging",
            "Controlled or high-value cage handoff"
          ],
          "guidance": "Select the controls actually required for this delivery, not every available service feature."
        },
        {
          "key": "route_assignment",
          "type": "fields",
          "label": "Route, custodian, and destination assignment",
