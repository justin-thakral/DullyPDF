    {
      "key": "cause_evidence",
      "title": "Fleet Fuel adjustment reason and evidence",
      "guidance": "Use a reason supported by transaction and physical evidence, not a balancing convenience.",
      "blocks": [
        {
          "key": "reason_codes",
          "type": "checklist",
          "label": "Fleet Fuel supported adjustment reasons",
          "items": [
            "Metered delivery posted to destination tank",
            "Temperature or density correction documented by source record",
            "Tank gauge and metered volume reconciliation",
            "Wrong-tank or wrong-product transfer prevented before delivery",
            "Spill, leak, overfill, or retained product quantity isolated",
            "Compartment or route carryover reconciled",
            "Fuel issue, return, or supplier correction posted",
            "Duplicate delivery or meter transaction reversed"
          ]
        },
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Conditions requiring investigation or escalation",
          "items": [
            "Wrong fuel grade, destination tank, or fill point",
            "Insufficient tank capacity or unreliable gauge",
            "Broken seal, product appearance concern, or water indication",
            "Leak, loose fitting, damaged hose, cap, vent, or containment",
            "Spill, overfill, fire, vapor, static, or ignition-source concern",
            "Meter failure or delivered volume cannot be reconciled",
            "Unauthorized person, vehicle movement, or uncontrolled site access",
            "Emergency stop, extinguisher, spill kit, or communication unavailable",
            "Receiver refuses product, quantity, or condition",
            "Environmental, safety, or site notification remains incomplete"
          ]
