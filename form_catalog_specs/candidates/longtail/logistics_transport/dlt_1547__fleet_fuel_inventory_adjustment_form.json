  "source_section": "logistics_transport",
  "source_filename": "dlt_1547__fleet_fuel_inventory_adjustment_form.pdf",
  "slug": "fleet-fuel-inventory-adjustment-form",
  "title": "Fleet Fuel Inventory Adjustment Form",
  "subtitle": "Reconcile the fleet fuel source state to verified evidence, explain every variance, control affected inventory, authorize exact postings, and verify the ledger.",
  "description": "An original, fillable fleet fuel inventory adjustment form for controlling bulk or mobile fleet-fuel delivery and tank inventory through inventory adjustment identity, observations, evidence, decision, exceptions, escalation, completion, handoff, and final verification without replacing applicable requirements or professional review.",
  "use_case": "Use when ordered, metered, corrected, and accepted volume or related identity, location, status, or ownership differs from the system and a controlled adjustment must remain traceable from physical evidence through approval, posting, and after-state verification.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "identity_routing",
      "title": "Fleet Fuel inventory adjustment identity and routing",
      "guidance": "Anchor the record to the exact work, parties, locations, and source references.",
