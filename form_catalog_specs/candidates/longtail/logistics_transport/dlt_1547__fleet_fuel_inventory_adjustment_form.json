            },
            {
              "key": "custodian",
              "label": "Fuel Driver And Authorized Site Receiver",
              "units": 1.1
            },
            {
              "key": "origin",
              "label": "Fuel terminal, supplier rack, or mobile unit",
              "units": 1.35
            },
            {
              "key": "destination",
              "label": "Fleet tank, generator, equipment, or authorized vehicle group",
              "units": 1.35
            }
          ],
          "guidance": "Preserve linkage to the fuel order, product record, tank chart, meter ticket, and site procedure."
        }
      ]
    },
    {
      "key": "adjustment_boundary",
