  "slug": "solar-site-survey-incident-report-form",
  "title": "Solar Site Survey Incident Report Form",
  "subtitle": "An original solar site survey workflow that captures an event from emergency routing through corrective-action closeout, with explicit qualified-review, stop-work, escalation, and accountable handoff controls.",
  "description": "A workflow-complete solar site survey incident report form for the proposed photovoltaic site that captures exact identity, domain observations, supporting evidence, decisions, exceptions, responsible owners, and closeout without replacing professional judgment or the organization's controlling procedures.",
  "use_case": "Use after an incident or near miss to record safe initial facts, consequences, chronology, evidence custody, scene restrictions, notifications, qualified review, corrective actions, and final handoff. The survey coordinator owns routing, and closure requires documented evidence, disposition of restrictions, and acceptance by the designated reviewer.",
  "risk_tier": "C",
  "sections": [
    {
      "key": "incident_routing",
      "title": "Solar site survey incident intake and immediate routing",
      "guidance": "Protect people first, route emergencies immediately, and begin a factual record from a safe location.",
