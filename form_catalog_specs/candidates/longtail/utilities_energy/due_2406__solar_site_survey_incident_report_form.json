            {
              "key": "scene_status",
              "label": "Scene status",
              "units": 1.0,
              "field_type": "choice",
              "options": [
                "Select",
                "Emergency active",
                "Restricted",
                "Stable, not released",
                "Released by authority"
              ]
            }
          ]
        },
        {
          "key": "emergency_boundary",
          "type": "notice",
          "label": "Emergency and scene-control boundary",
          "guidance": "This record does not authorize roof access, structural conclusions, or contact with electrical components. Stop the survey when access, weather, damaged components, exposed conductors, or structural conditions are unsafe. Keep unqualified people clear and route the condition to the site's qualified electrical, structural, or safety reviewer. Do not delay emergency contact to complete this form, and do not re-enter, touch, reset, or move equipment to collect evidence. Scene command and designated qualified personnel control access, stabilization, and release."
        }
      ]
    },
