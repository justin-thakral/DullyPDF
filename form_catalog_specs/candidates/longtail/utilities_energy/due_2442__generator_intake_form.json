        {
          "key": "intake_topics",
          "type": "checklist",
          "label": "Requested scope and known conditions",
          "items": [
            "Preventive service, failed exercise, alarm, or no-start request",
            "Generator, engine, controller, battery, charger, and fuel identity",
            "Transfer switch, normal source, emergency source, and critical-load impact",
            "Fuel level, leak, contamination, delivery, and run-time constraints",
            "Ventilation, exhaust, carbon-monoxide, weather, and enclosure conditions",
            "Planned outage, test method, load-bank, and operations authorization",
            "Operating readings, alarm history, test results, and trend evidence",
            "Return-to-auto, transfer readiness, open defect, and site handoff"
          ],
          "guidance": "Check only topics raised by the requester or supported by intake evidence."
        }
      ]
    },
