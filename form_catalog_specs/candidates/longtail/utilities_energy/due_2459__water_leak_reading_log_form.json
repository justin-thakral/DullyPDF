    {
      "key": "reading_entries",
      "title": "Water leak time-series readings and observation evidence",
      "guidance": "Use one row per reading point or event and preserve the context that makes the value meaningful.",
      "blocks": [
        {
          "key": "reading_table",
          "type": "table",
          "label": "Water leak reading log",
          "columns": [
            {
              "key": "read_time",
              "label": "Date / time",
              "units": 0.8
            },
            {
              "key": "meter_zone",
              "label": "Meter / zone",
              "units": 0.95
            },
            {
              "key": "flow_read",
              "label": "Flow / meter read",
              "units": 1.0
            },
            {
              "key": "pressure",
              "label": "Pressure / indicator",
              "units": 1.0
            },
            {
              "key": "isolation",
              "label": "Isolation state",
              "units": 0.95
            },
            {
              "key": "evidence",
              "label": "Area / evidence",
              "units": 1.05
            }
          ],
          "rows": 10,
          "guidance": "Continue under a linked log when more rows are needed; do not overwrite an accepted prior value."
        },
        {
          "key": "entry_quality",
          "type": "checklist",
          "label": "Reading-entry quality checks",
          "items": [
            "Identity and location matched before the value was recorded",
            "Date, time, time zone, method, and data source are traceable",
            "Units, multiplier, scale, decimal, and operating state were checked",
            "Remote or normal-interface data was used where intrusive access was not authorized",
            "Obvious transcription, rollover, missing-data, and stale-value conditions were reviewed",
            "Material variance was repeated or corroborated by another approved source",
            "Unsafe or unreliable observations were stopped and marked unavailable",
            "Corrected entries retain the original value and correction rationale in evidence"
          ]
        },
        {
          "key": "trend_context",
          "type": "textarea",
          "label": "Trend, anomaly, and operating-context narrative",
          "fields": [
            {
              "key": "details",
              "label": "Pattern, external driver, data gap, anomaly, confidence, and supporting chart or evidence reference",
              "multiline": true
            }
          ],
          "height": 58
        }
      ]
    },
    {
      "key": "exceptions_escalation",
      "title": "Water leak exceptions, stop conditions, and escalation",
      "guidance": "Make every unresolved condition visible with an immediate control, owner, due point, and final disposition.",
      "blocks": [
        {
          "key": "stop_condition_screen",
          "type": "checklist",
          "label": "Stop-condition screen",
          "items": [
            "Water contacting electrical equipment, outlets, panels, cords, or machinery",
            "Bulging or sagging ceiling, unstable finish, structural movement, or falling material",
            "Suspected sewage, chemical, fire-water, or other contaminated release",
            "Rapid flooding, washout, sinkhole, severe pressure, or uncontrolled flow",
            "Slip exposure, hidden opening, poor visibility, or unsafe access",
            "Shutoff would impair fire protection, medical, process, or critical service",
            "Gas odor, steam, hot water, refrigerant, or unknown fluid is also present",
            "Condition exceeds responder authority, equipment, training, or protective controls"
          ],
          "guidance": "Check any condition observed or reported; checking an item does not mean the condition is controlled."
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Qualified-person and stop-work boundary",
          "guidance": "Do not enter water near electrical equipment, stand below a sagging ceiling, or handle suspected contaminated water. Keep occupants clear and use the organization's emergency route for rapid flooding, structural movement, gas odor, or critical-service impact. Only authorized personnel may operate shutoffs after evaluating downstream consequences."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception and escalation register",
          "columns": [
            {
              "key": "condition",
              "label": "Condition / location",
              "units": 1.2
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Owner / route",
              "units": 0.95
            },
            {
              "key": "due",
              "label": "Due / update",
              "units": 0.85
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 4,
          "guidance": "Link each reading log exception to supporting evidence and keep it open until disposition is recorded."
        }
      ]
    },
    {
      "key": "decision_handoff",
      "title": "Water leak decision, handoff, and accountable closeout",
      "guidance": "Record the decision, remaining limitations, next action, and the people accountable for acceptance.",
