{
  "schema_version": 1,
  "catalog_id": "utilities_energy/due_2445__generator_reading_log_form",
  "source_section": "utilities_energy",
  "source_filename": "due_2445__generator_reading_log_form.pdf",
  "slug": "generator-reading-log-form",
  "title": "Generator Reading Log Form",
  "subtitle": "An original generator workflow that creates a traceable time series with method, context, variance, and review, with explicit qualified-review, stop-work, escalation, and accountable handoff controls.",
  "description": "A workflow-complete generator reading log form for the standby or prime generator system that captures exact identity, domain observations, supporting evidence, decisions, exceptions, responsible owners, and closeout without replacing professional judgment or the organization's controlling procedures.",
  "use_case": "Use for a defined monitoring period when repeated values need stable identity, units, source, operating context, anomaly escalation, correction history, and accountable period closeout. The generator service coordinator owns routing, and closure requires documented evidence, disposition of restrictions, and acceptance by the designated reviewer.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "log_routing",
      "title": "Generator reading log identity and period",
      "guidance": "Define one measurement period, one system boundary, and an accountable log owner.",
      "blocks": [
        {
          "key": "record_routing",
          "type": "fields",
          "label": "Reading log and assignment",
          "fields": [
            {
              "key": "record_id",
              "label": "Reading log record ID",
              "units": 1.0
