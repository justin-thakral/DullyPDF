              "units": 0.8
            },
            {
              "key": "frequency",
              "label": "Reading frequency",
              "units": 1.0
            },
            {
              "key": "review_cadence",
              "label": "Review cadence",
              "units": 1.0
            },
            {
              "key": "escalation_contact",
              "label": "Escalation contact",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "measurement_context",
      "title": "Generator measurement context and method",
      "guidance": "Preserve the identity, baseline, instrument, method, and operating state needed to interpret each value.",
      "blocks": [
