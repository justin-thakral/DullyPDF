              "units": 1.0
            },
            {
              "key": "controller",
              "label": "Controller and firmware ref",
              "units": 1.15
            },
            {
              "key": "fuel_level",
              "label": "Fuel level and unit",
              "units": 0.95
            },
            {
              "key": "last_service",
              "label": "Last service record ref",
              "units": 1.15
            }
          ]
        },
        {
          "key": "method_control",
          "type": "fields",
          "label": "Method and data-quality control",
          "fields": [
            {
              "key": "method_ref",
