              "units": 1.0
            },
            {
              "key": "prepared_date",
              "label": "Prepared date",
              "units": 0.85
            },
            {
              "key": "reviewed_by",
              "label": "Qualified or authorized reviewer",
              "units": 1.25
            },
            {
              "key": "reviewed_date",
              "label": "Review date",
              "units": 0.85
            },
            {
              "key": "accepted_by",
              "label": "Customer, site, or operations handoff",
              "units": 1.25
            },
            {
              "key": "accepted_date",
              "label": "Handoff date",
              "units": 0.85
            }
          ],
          "guidance": "Signatures acknowledge the recorded decision and handoff; they do not waive unresolved restrictions."
        }
      ]
    }
