    },
    {
      "key": "reading_entries",
      "title": "Battery storage time-series readings and observation evidence",
      "guidance": "Use one row per reading point or event and preserve the context that makes the value meaningful.",
      "blocks": [
        {
          "key": "reading_table",
          "type": "table",
          "label": "Battery storage reading log",
          "columns": [
            {
              "key": "rack_module",
              "label": "Rack / module",
              "units": 0.95
            },
            {
              "key": "soc_soh",
              "label": "SOC / SOH",
              "units": 0.85
            },
            {
              "key": "volt_current",
              "label": "Volts / current",
              "units": 1.0
            },
            {
              "key": "temperature",
              "label": "Temperature spread",
              "units": 1.05
            },
            {
              "key": "alarm_state",
              "label": "Alarm / isolation",
              "units": 1.05
            },
            {
              "key": "evidence",
              "label": "Trend / evidence",
              "units": 1.0
            }
          ],
          "rows": 10,
          "guidance": "Continue under a linked log when more rows are needed; do not overwrite an accepted prior value."
        },
        {
          "key": "entry_quality",
          "type": "checklist",
          "label": "Reading-entry quality checks",
          "items": [
            "Identity and location matched before the value was recorded",
            "Date, time, time zone, method, and data source are traceable",
            "Units, multiplier, scale, decimal, and operating state were checked",
            "Remote or normal-interface data was used where intrusive access was not authorized",
            "Obvious transcription, rollover, missing-data, and stale-value conditions were reviewed",
            "Material variance was repeated or corroborated by another approved source",
            "Unsafe or unreliable observations were stopped and marked unavailable",
            "Corrected entries retain the original value and correction rationale in evidence"
          ]
        },
        {
          "key": "trend_context",
          "type": "textarea",
          "label": "Trend, anomaly, and operating-context narrative",
          "fields": [
            {
              "key": "details",
              "label": "Pattern, external driver, data gap, anomaly, confidence, and supporting chart or evidence reference",
              "multiline": true
            }
          ],
          "height": 58
        }
      ]
    },
    {
      "key": "exceptions_escalation",
      "title": "Battery storage exceptions, stop conditions, and escalation",
      "guidance": "Make every unresolved condition visible with an immediate control, owner, due point, and final disposition.",
      "blocks": [
        {
          "key": "stop_condition_screen",
          "type": "checklist",
          "label": "Stop-condition screen",
          "items": [
            "Smoke, flame, rapid heat rise, hissing, popping, or unusual odor",
            "Swelling, deformation, electrolyte residue, leak, or damaged cell enclosure",
            "Thermal, gas, fire-detection, suppression, or ventilation alarm",
            "Water intrusion, flooding, condensation, or damaged environmental seal",
            "Impact, penetration, dropped module, damaged cable, or exposed conductor",
            "Unknown isolation, stranded charge, backfeed, or reaccumulating stored energy",
            "Manufacturer stop condition or emergency-plan activation threshold",
            "Any entry or task beyond the person's training, PPE, tools, or authorization"
          ],
          "guidance": "Check any condition observed or reported; checking an item does not mean the condition is controlled."
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Qualified-person and stop-work boundary",
          "guidance": "Do not open, enter, touch, reset, or approach a battery system showing heat, smoke, flame, hissing, odor, swelling, leaking, water intrusion, impact damage, or an isolation alarm. Keep people clear and activate the site emergency plan. Stored or stranded energy may remain after shutdown; only designated qualified personnel may assess isolation, recovery, and return to service."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception and escalation register",
          "columns": [
            {
              "key": "condition",
              "label": "Condition / location",
              "units": 1.2
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Owner / route",
              "units": 0.95
            },
            {
              "key": "due",
              "label": "Due / update",
              "units": 0.85
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 4,
          "guidance": "Link each reading log exception to supporting evidence and keep it open until disposition is recorded."
        }
      ]
    },
    {
      "key": "decision_handoff",
      "title": "Battery storage decision, handoff, and accountable closeout",
      "guidance": "Record the decision, remaining limitations, next action, and the people accountable for acceptance.",
      "blocks": [
        {
          "key": "closeout_decision",
          "type": "fields",
          "label": "Reading log closeout decision",
          "fields": [
