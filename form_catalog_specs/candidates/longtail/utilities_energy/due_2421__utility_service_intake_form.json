              "units": 1.05
            },
            {
              "key": "priority",
              "label": "Priority",
              "units": 0.85,
              "field_type": "choice",
              "options": [
                "Select",
                "Routine",
                "Soon",
                "Urgent",
                "Emergency routed"
              ]
            }
          ]
        },
        {
          "key": "requester_contact",
          "type": "fields",
          "label": "Requester and access contact",
          "fields": [
            {
              "key": "requester_name",
              "label": "Requester name",
              "units": 1.0
            },
            {
              "key": "organization",
