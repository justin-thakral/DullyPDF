  "slug": "utility-service-intake-form",
  "title": "Utility Service Intake Form",
  "subtitle": "An original utility service workflow that turns an initial request into a triaged, evidence-backed assignment, with explicit qualified-review, stop-work, escalation, and accountable handoff controls.",
  "description": "A workflow-complete utility service intake form for the electric, gas, water, or thermal utility service point that captures exact identity, domain observations, supporting evidence, decisions, exceptions, responsible owners, and closeout without replacing professional judgment or the organization's controlling procedures.",
  "use_case": "Use when a coordinator receives a new request and must verify identity, scope, evidence, hazards, feasibility, and the next accountable handoff before field activity is scheduled. The utility service coordinator owns routing, and closure requires documented evidence, disposition of restrictions, and acceptance by the designated reviewer.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "intake_routing",
      "title": "Utility service intake identity and routing",
      "guidance": "Create one traceable intake record and assign a person responsible for triage.",
      "blocks": [
        {
          "key": "record_routing",
          "type": "fields",
          "label": "Intake record and assignment",
          "fields": [
            {
              "key": "record_id",
              "label": "Intake record ID",
              "units": 1.0
            },
            {
