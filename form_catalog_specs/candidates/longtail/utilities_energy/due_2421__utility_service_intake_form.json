          "key": "request_narrative",
          "type": "textarea",
          "label": "Requested outcome and known facts",
          "fields": [
            {
              "key": "details",
              "label": "Requester wording, observed facts, desired outcome, exclusions, and unresolved questions",
              "multiline": true
            }
          ],
          "height": 62
        }
      ]
    },
    {
      "key": "exceptions_escalation",
      "title": "Utility service exceptions, stop conditions, and escalation",
      "guidance": "Make every unresolved condition visible with an immediate control, owner, due point, and final disposition.",
      "blocks": [
        {
          "key": "stop_condition_screen",
          "type": "checklist",
          "label": "Stop-condition screen",
          "items": [
            "Gas odor, hissing, suspected leak, or atmosphere concern",
            "Downed conductor, arcing, exposed electrical part, or burn damage",
            "Major water release, flooding, washout, or energized equipment in water",
            "Steam, pressure, hot surface, rotating equipment, or uncontrolled stored energy",
            "Traffic, excavation, unstable surface, animal, or uncontrolled public exposure",
            "Unknown valve, switch, disconnect, cross-connection, or service ownership",
            "Critical-load impact or service interruption without operations authorization",
            "Condition requiring emergency dispatch or work beyond assigned qualification"
          ],
          "guidance": "Check any condition observed or reported; checking an item does not mean the condition is controlled."
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Qualified-person and stop-work boundary",
          "guidance": "Do not use this record to approach downed conductors, investigate a gas odor, enter flooded electrical areas, operate unknown valves or switches, or bypass dispatch control. Keep people clear, use the organization's emergency route, and allow only qualified and authorized personnel to isolate, test, repair, and restore the affected utility service."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception and escalation register",
          "columns": [
            {
              "key": "condition",
              "label": "Condition / location",
              "units": 1.2
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Owner / route",
              "units": 0.95
            },
            {
              "key": "due",
              "label": "Due / update",
              "units": 0.85
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 4,
          "guidance": "Link each intake exception to supporting evidence and keep it open until disposition is recorded."
        }
      ]
    },
    {
      "key": "decision_handoff",
      "title": "Utility service decision, handoff, and accountable closeout",
      "guidance": "Record the decision, remaining limitations, next action, and the people accountable for acceptance.",
