              "units": 1.0
            },
            {
              "key": "service_class",
              "label": "Service class",
              "units": 0.9
            },
            {
              "key": "service_status",
              "label": "Current service status",
              "units": 1.0
            }
          ]
        },
        {
          "key": "baseline_context",
          "type": "fields",
          "label": "Available baseline",
          "fields": [
            {
              "key": "service_address",
              "label": "Service address or coordinates",
              "units": 1.25
            },
            {
              "key": "system_asset",
              "label": "Upstream system asset ref",
              "units": 1.15
            },
            {
              "key": "normal_range",
              "label": "Normal value or status range",
              "units": 1.05
            },
            {
              "key": "last_service",
              "label": "Last service activity ref",
              "units": 1.1
            },
            {
              "key": "access_method",
              "label": "Access and key-control method",
              "units": 1.1
            },
            {
              "key": "critical_load",
              "label": "Critical customer or load flag",
              "units": 1.1
            }
          ]
        },
        {
          "key": "intake_topics",
          "type": "checklist",
          "label": "Requested scope and known conditions",
          "items": [
            "Commodity, service class, account, premise, and device identity",
            "No service, intermittent service, low quality, pressure, voltage, or flow",
            "Start, stop, transfer, reconnect, disconnect, or capacity change",
            "Meter, regulator, valve, disconnect, lateral, or service equipment concern",
            "Access appointment, key control, animals, traffic, and restricted areas",
            "Critical load, medical baseline, business process, or lifeline dependency routing",
            "Customer communication, interruption window, and restoration confirmation",
            "Emergency indicators requiring immediate dispatch outside routine service"
          ],
          "guidance": "Check only topics raised by the requester or supported by intake evidence."
        }
      ]
    },
    {
      "key": "triage_evidence",
      "title": "Utility service triage, evidence, and information gaps",
      "guidance": "Separate what is known from what still needs field or qualified review.",
      "blocks": [
        {
          "key": "triage_status",
          "type": "fields",
          "label": "Triage status",
          "fields": [
            {
              "key": "request_status",
              "label": "Request status",
              "units": 1.0,
              "field_type": "choice",
