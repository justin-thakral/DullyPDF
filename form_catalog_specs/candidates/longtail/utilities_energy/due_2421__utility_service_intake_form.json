              "units": 0.9
            },
            {
              "key": "email",
              "label": "Email",
              "units": 1.15
            },
            {
              "key": "onsite_contact",
              "label": "On-site contact",
              "units": 1.0
            },
            {
              "key": "access_window",
              "label": "Access window",
              "units": 1.0
            }
          ]
        }
      ]
    },
    {
      "key": "system_context",
      "title": "Utility service system context and requested scope",
      "guidance": "Match the request to the exact electric, gas, water, or thermal utility service point before feasibility or scheduling decisions.",
      "blocks": [
        {
          "key": "subject_identity",
          "type": "fields",
          "label": "Utility service identity",
          "fields": [
            {
              "key": "commodity",
