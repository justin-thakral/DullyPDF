        {
          "key": "intake_topics",
          "type": "checklist",
          "label": "Requested scope and known conditions",
          "items": [
            "First report of complete or partial service interruption",
            "Duplicate reports and geographic clustering",
            "Downed line, leak, flooding, fire, damage, or public-safety indicator",
            "Critical facility, medically dependent customer, or lifeline-sector impact",
            "Feeder, circuit, main, zone, transformer, or device status",
            "Crew assignment, switching or isolation dependency, and access constraints",
            "Affected-customer estimate, restoration stage, and confidence",
            "Customer updates, agency coordination, and final restoration confirmation"
          ],
          "guidance": "Check only topics raised by the requester or supported by intake evidence."
        }
      ]
    },
    {
