    {
      "key": "exceptions_escalation",
      "title": "Outage report exceptions, stop conditions, and escalation",
      "guidance": "Make every unresolved condition visible with an immediate control, owner, due point, and final disposition.",
      "blocks": [
        {
          "key": "stop_condition_screen",
          "type": "checklist",
          "label": "Stop-condition screen",
          "items": [
            "Downed or sagging conductor, arcing, fire, or damaged electrical asset",
            "Gas odor, hissing, damaged main, regulator, or atmosphere concern",
            "Water-main break, flooding, washout, sinkhole, or energized water exposure",
            "Steam, pressure, chemical, traffic, debris, or unstable structure",
            "Public entry into an uncontrolled utility work or damage zone",
            "Unknown system state, backfeed, switching, valve, or isolation status",
            "Critical-service consequence beyond the current response capability",
            "Any condition requiring emergency command or operations control"
          ],
          "guidance": "Check any condition observed or reported; checking an item does not mean the condition is controlled."
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Qualified-person and stop-work boundary",
          "guidance": "This record supports situational awareness; it does not authorize switching, valve operation, entry, or approach to damaged utility equipment. Keep callers and the public away from downed lines, gas odors, flooding, fire, and unstable areas. Route emergency indicators immediately and leave isolation and restoration decisions to designated operations control and qualified crews."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception and escalation register",
          "columns": [
            {
              "key": "condition",
              "label": "Condition / location",
              "units": 1.2
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Owner / route",
              "units": 0.95
            },
            {
              "key": "due",
              "label": "Due / update",
              "units": 0.85
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 4,
          "guidance": "Link each intake exception to supporting evidence and keep it open until disposition is recorded."
        }
      ]
    },
    {
