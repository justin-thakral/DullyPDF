              "units": 1.15
            },
            {
              "key": "meter_id",
              "label": "Meter or device ID",
              "units": 1.0
            },
            {
              "key": "service_class",
              "label": "Service class",
              "units": 0.9
            },
            {
              "key": "service_status",
              "label": "Current service status",
              "units": 1.0
            }
          ]
        },
        {
          "key": "baseline_context",
          "type": "fields",
          "label": "Reference baseline",
          "fields": [
            {
              "key": "service_address",
              "label": "Service address or coordinates",
              "units": 1.25
            },
            {
              "key": "system_asset",
              "label": "Upstream system asset ref",
              "units": 1.15
            },
            {
              "key": "normal_range",
              "label": "Normal value or status range",
              "units": 1.05
            },
            {
              "key": "last_service",
              "label": "Last service activity ref",
              "units": 1.1
            },
            {
              "key": "access_method",
              "label": "Access and key-control method",
              "units": 1.1
            },
            {
              "key": "critical_load",
              "label": "Critical customer or load flag",
              "units": 1.1
            }
          ]
        },
        {
          "key": "method_control",
          "type": "fields",
          "label": "Method and data-quality control",
          "fields": [
            {
              "key": "method_ref",
              "label": "Method or procedure ref",
              "units": 1.15
            },
            {
              "key": "instrument_id",
              "label": "Instrument or data-source ID",
              "units": 1.15
            },
            {
              "key": "calibration_ref",
              "label": "Calibration or validation ref",
              "units": 1.15
            },
            {
              "key": "operator",
              "label": "Reader or data owner",
              "units": 1.0
            },
            {
              "key": "normal_range",
              "label": "Normal range or criteria ref",
              "units": 1.15
            },
            {
              "key": "data_system",
              "label": "Source-system export ref",
              "units": 1.15
            }
          ]
        }
      ]
    },
    {
      "key": "reading_entries",
      "title": "Utility service time-series readings and observation evidence",
      "guidance": "Use one row per reading point or event and preserve the context that makes the value meaningful.",
      "blocks": [
        {
          "key": "reading_table",
          "type": "table",
          "label": "Utility service reading log",
          "columns": [
            {
              "key": "service_point",
              "label": "Service point",
              "units": 0.95
            },
            {
              "key": "commodity",
              "label": "Commodity",
              "units": 0.8
            },
            {
              "key": "timestamp",
              "label": "Date / time",
              "units": 0.85
            },
            {
              "key": "value",
              "label": "Value and unit",
              "units": 0.95
            },
            {
              "key": "status",
              "label": "Device / alarm",
              "units": 1.0
            },
            {
              "key": "observer",
              "label": "Observer / evidence",
              "units": 1.05
            }
          ],
          "rows": 10,
          "guidance": "Continue under a linked log when more rows are needed; do not overwrite an accepted prior value."
        },
        {
          "key": "entry_quality",
          "type": "checklist",
          "label": "Reading-entry quality checks",
          "items": [
            "Identity and location matched before the value was recorded",
            "Date, time, time zone, method, and data source are traceable",
            "Units, multiplier, scale, decimal, and operating state were checked",
            "Remote or normal-interface data was used where intrusive access was not authorized",
            "Obvious transcription, rollover, missing-data, and stale-value conditions were reviewed",
            "Material variance was repeated or corroborated by another approved source",
            "Unsafe or unreliable observations were stopped and marked unavailable",
            "Corrected entries retain the original value and correction rationale in evidence"
          ]
        },
        {
          "key": "trend_context",
          "type": "textarea",
          "label": "Trend, anomaly, and operating-context narrative",
          "fields": [
            {
              "key": "details",
              "label": "Pattern, external driver, data gap, anomaly, confidence, and supporting chart or evidence reference",
              "multiline": true
            }
          ],
          "height": 58
        }
      ]
    },
    {
      "key": "exceptions_escalation",
      "title": "Utility service exceptions, stop conditions, and escalation",
      "guidance": "Make every unresolved condition visible with an immediate control, owner, due point, and final disposition.",
      "blocks": [
        {
          "key": "stop_condition_screen",
          "type": "checklist",
          "label": "Stop-condition screen",
          "items": [
            "Gas odor, hissing, suspected leak, or atmosphere concern",
            "Downed conductor, arcing, exposed electrical part, or burn damage",
            "Major water release, flooding, washout, or energized equipment in water",
            "Steam, pressure, hot surface, rotating equipment, or uncontrolled stored energy",
            "Traffic, excavation, unstable surface, animal, or uncontrolled public exposure",
            "Unknown valve, switch, disconnect, cross-connection, or service ownership",
            "Critical-load impact or service interruption without operations authorization",
            "Condition requiring emergency dispatch or work beyond assigned qualification"
          ],
          "guidance": "Check any condition observed or reported; checking an item does not mean the condition is controlled."
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Qualified-person and stop-work boundary",
          "guidance": "Do not use this record to approach downed conductors, investigate a gas odor, enter flooded electrical areas, operate unknown valves or switches, or bypass dispatch control. Keep people clear, use the organization's emergency route, and allow only qualified and authorized personnel to isolate, test, repair, and restore the affected utility service."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception and escalation register",
          "columns": [
            {
              "key": "condition",
              "label": "Condition / location",
              "units": 1.2
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Owner / route",
              "units": 0.95
            },
            {
              "key": "due",
              "label": "Due / update",
              "units": 0.85
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 4,
          "guidance": "Link each reading log exception to supporting evidence and keep it open until disposition is recorded."
        }
      ]
    },
    {
      "key": "decision_handoff",
      "title": "Utility service decision, handoff, and accountable closeout",
      "guidance": "Record the decision, remaining limitations, next action, and the people accountable for acceptance.",
      "blocks": [
        {
          "key": "closeout_decision",
          "type": "fields",
          "label": "Reading log closeout decision",
          "fields": [
            {
              "key": "status",
              "label": "Final status",
              "units": 1.1,
              "field_type": "choice",
              "options": [
                "Select",
                "Accepted",
                "Accepted with follow-up",
                "Restricted or held",
                "Escalated",
                "Cancelled"
              ]
            },
            {
              "key": "decision_date",
              "label": "Decision date and time",
              "units": 1.0
            },
            {
              "key": "decision_owner",
              "label": "Decision owner",
              "units": 1.0
            },
            {
              "key": "evidence_index",
              "label": "Evidence package reference",
              "units": 1.2
            },
            {
              "key": "next_owner",
              "label": "Next-action owner",
              "units": 1.0
            },
            {
              "key": "next_due",
              "label": "Next-action due point",
              "units": 1.0
            }
          ]
        },
        {
          "key": "closeout_checks",
          "type": "checklist",
          "label": "Closeout completeness",
          "items": [
            "Electric, gas, water, or thermal utility service point identity and location were reconciled",
            "Observed facts, measurements, and evidence references are complete",
            "Decision authority and applicable review requirements were confirmed",
            "Stop conditions, restrictions, and open exceptions remain visible",
            "Customer, operations, or site handoff was recorded",
            "Next action, owner, due point, and record-retention route are explicit"
          ]
        },
        {
          "key": "limitations_notes",
          "type": "textarea",
          "label": "Remaining limitations and handoff narrative",
          "fields": [
            {
              "key": "details",
              "label": "Limitations, assumptions, restrictions, customer message, and next-action context",
              "multiline": true
            }
          ],
          "height": 58
        },
        {
          "key": "accountable_signoff",
          "type": "signatures",
          "label": "Accountable review and handoff",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by",
              "units": 1.0
            },
            {
              "key": "prepared_date",
              "label": "Prepared date",
              "units": 0.85
            },
            {
              "key": "reviewed_by",
              "label": "Qualified or authorized reviewer",
              "units": 1.25
            },
            {
              "key": "reviewed_date",
              "label": "Review date",
              "units": 0.85
            },
            {
              "key": "accepted_by",
              "label": "Customer, site, or operations handoff",
              "units": 1.25
            },
            {
              "key": "accepted_date",
              "label": "Handoff date",
              "units": 0.85
            }
          ],
          "guidance": "Signatures acknowledge the recorded decision and handoff; they do not waive unresolved restrictions."
        }
      ]
    }
  ]
