  "source_section": "utilities_energy",
  "source_filename": "due_2424__utility_service_reading_log_form.pdf",
  "slug": "utility-service-reading-log-form",
  "title": "Utility Service Reading Log Form",
  "subtitle": "An original utility service workflow that creates a traceable time series with method, context, variance, and review, with explicit qualified-review, stop-work, escalation, and accountable handoff controls.",
  "description": "A workflow-complete utility service reading log form for the electric, gas, water, or thermal utility service point that captures exact identity, domain observations, supporting evidence, decisions, exceptions, responsible owners, and closeout without replacing professional judgment or the organization's controlling procedures.",
  "use_case": "Use for a defined monitoring period when repeated values need stable identity, units, source, operating context, anomaly escalation, correction history, and accountable period closeout. The utility service coordinator owns routing, and closure requires documented evidence, disposition of restrictions, and acceptance by the designated reviewer.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "log_routing",
      "title": "Utility service reading log identity and period",
      "guidance": "Define one measurement period, one system boundary, and an accountable log owner.",
      "blocks": [
        {
          "key": "record_routing",
          "type": "fields",
          "label": "Reading log and assignment",
          "fields": [
            {
              "key": "record_id",
              "label": "Reading log record ID",
              "units": 1.0
            },
            {
              "key": "opened_at",
              "label": "Opened date and time",
              "units": 1.0
            },
            {
              "key": "site_name",
              "label": "Site or customer name",
              "units": 1.2
            },
            {
              "key": "site_location",
              "label": "Service address or location",
              "units": 1.3
            },
            {
              "key": "record_owner",
              "label": "Assigned record owner",
              "units": 1.05
            },
            {
              "key": "priority",
              "label": "Priority",
              "units": 0.85,
              "field_type": "choice",
              "options": [
                "Select",
                "Routine",
                "Soon",
                "Urgent",
                "Emergency routed"
              ]
            }
          ]
        },
        {
          "key": "period_control",
          "type": "fields",
          "label": "Log period and review cadence",
          "fields": [
            {
              "key": "period_start",
              "label": "Period start",
              "units": 0.9
            },
            {
              "key": "period_end",
              "label": "Period end",
              "units": 0.9
            },
            {
              "key": "timezone",
              "label": "Time zone",
              "units": 0.8
            },
            {
              "key": "frequency",
              "label": "Reading frequency",
              "units": 1.0
            },
            {
              "key": "review_cadence",
              "label": "Review cadence",
              "units": 1.0
            },
            {
              "key": "escalation_contact",
              "label": "Escalation contact",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "measurement_context",
      "title": "Utility service measurement context and method",
      "guidance": "Preserve the identity, baseline, instrument, method, and operating state needed to interpret each value.",
      "blocks": [
        {
          "key": "subject_identity",
          "type": "fields",
          "label": "Utility service identity",
          "fields": [
            {
              "key": "commodity",
