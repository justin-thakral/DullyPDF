    {
      "key": "exceptions_escalation",
      "title": "Meter reading exceptions, stop conditions, and escalation",
      "guidance": "Make every unresolved condition visible with an immediate control, owner, due point, and final disposition.",
      "blocks": [
        {
          "key": "stop_condition_screen",
          "type": "checklist",
          "label": "Stop-condition screen",
          "items": [
            "Gas odor, hissing, damaged regulator, or suspected leak",
            "Exposed conductor, arcing, heat, burn mark, or damaged electric enclosure",
            "Flooding, standing water, active leak, ice, or unstable walking surface",
            "Aggressive animal, insect nest, traffic, excavation, or restricted access",
            "Broken seal or enclosure requiring opening or equipment manipulation",
            "Unknown meter identity, cross-connection, or unsafe customer equipment",
            "Weather or site condition prevents a safe, reliable observation",
            "Any work beyond a normal-interface read and assigned authorization"
          ],
          "guidance": "Check any condition observed or reported; checking an item does not mean the condition is controlled."
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Qualified-person and stop-work boundary",
          "guidance": "A reading record does not authorize opening, bypassing, adjusting, or repairing a meter or related service equipment. Stop for gas odor, exposed electrical parts, water near energized equipment, flooding, animals, traffic, or unsafe access. Withdraw, keep others clear, and route the condition to qualified utility or emergency personnel under current site procedures."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception and escalation register",
          "columns": [
            {
              "key": "condition",
              "label": "Condition / location",
              "units": 1.2
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Owner / route",
              "units": 0.95
            },
            {
              "key": "due",
              "label": "Due / update",
              "units": 0.85
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 4,
          "guidance": "Link each intake exception to supporting evidence and keep it open until disposition is recorded."
        }
      ]
    },
