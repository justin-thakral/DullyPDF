    },
    {
      "key": "reading_entries",
      "title": "Energy audit time-series readings and observation evidence",
      "guidance": "Use one row per reading point or event and preserve the context that makes the value meaningful.",
      "blocks": [
        {
          "key": "reading_table",
          "type": "table",
          "label": "Energy audit reading log",
          "columns": [
            {
              "key": "system_zone",
              "label": "System or zone",
              "units": 1.0
            },
            {
              "key": "timestamp",
              "label": "Date / time",
              "units": 0.85
            },
            {
              "key": "reading",
              "label": "Reading and unit",
              "units": 0.95
            },
            {
              "key": "condition",
              "label": "Load / condition",
              "units": 1.0
            },
            {
              "key": "instrument",
              "label": "Instrument ID",
              "units": 0.85
            },
            {
              "key": "evidence",
              "label": "Note / evidence",
              "units": 1.0
            }
          ],
          "rows": 10,
          "guidance": "Continue under a linked log when more rows are needed; do not overwrite an accepted prior value."
        },
        {
          "key": "entry_quality",
          "type": "checklist",
          "label": "Reading-entry quality checks",
          "items": [
            "Identity and location matched before the value was recorded",
            "Date, time, time zone, method, and data source are traceable",
            "Units, multiplier, scale, decimal, and operating state were checked",
            "Remote or normal-interface data was used where intrusive access was not authorized",
            "Obvious transcription, rollover, missing-data, and stale-value conditions were reviewed",
            "Material variance was repeated or corroborated by another approved source",
            "Unsafe or unreliable observations were stopped and marked unavailable",
            "Corrected entries retain the original value and correction rationale in evidence"
          ]
        },
        {
          "key": "trend_context",
          "type": "textarea",
          "label": "Trend, anomaly, and operating-context narrative",
          "fields": [
            {
              "key": "details",
              "label": "Pattern, external driver, data gap, anomaly, confidence, and supporting chart or evidence reference",
              "multiline": true
            }
          ],
          "height": 58
        }
      ]
    },
    {
      "key": "exceptions_escalation",
      "title": "Energy audit exceptions, stop conditions, and escalation",
      "guidance": "Make every unresolved condition visible with an immediate control, owner, due point, and final disposition.",
      "blocks": [
        {
          "key": "stop_condition_screen",
          "type": "checklist",
          "label": "Stop-condition screen",
          "items": [
            "Exposed electrical parts or a panel requiring intrusive access",
            "Unsafe roof, ladder, mechanical-room, or confined-space access",
            "Moving machinery, hot surface, steam, pressure, or rotating equipment",
            "Suspected hazardous material, severe moisture, or poor air condition",
            "Measurement would disrupt a critical process or life-safety system",
            "Instrument rating, method, or authorization is not confirmed",
            "Site condition differs materially from the approved measurement plan",
            "Any observation requires work outside the assessor's competence or scope"
          ],
          "guidance": "Check any condition observed or reported; checking an item does not mean the condition is controlled."
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Qualified-person and stop-work boundary",
          "guidance": "An energy audit is an evidence record, not permission to open equipment, change controls, or perform hazardous testing. Use non-invasive observations unless an approved task, qualified person, suitable instrument, and site procedure control the work. Stop when conditions or system effects differ from the approved plan and route the issue for professional review."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception and escalation register",
          "columns": [
            {
              "key": "condition",
              "label": "Condition / location",
              "units": 1.2
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Owner / route",
              "units": 0.95
            },
            {
              "key": "due",
              "label": "Due / update",
              "units": 0.85
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 4,
          "guidance": "Link each reading log exception to supporting evidence and keep it open until disposition is recorded."
        }
      ]
    },
    {
      "key": "decision_handoff",
      "title": "Energy audit decision, handoff, and accountable closeout",
      "guidance": "Record the decision, remaining limitations, next action, and the people accountable for acceptance.",
      "blocks": [
        {
          "key": "closeout_decision",
          "type": "fields",
          "label": "Reading log closeout decision",
          "fields": [
            {
              "key": "status",
