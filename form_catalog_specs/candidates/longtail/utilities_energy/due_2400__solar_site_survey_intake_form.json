    },
    {
      "key": "exceptions_escalation",
      "title": "Solar site survey exceptions, stop conditions, and escalation",
      "guidance": "Make every unresolved condition visible with an immediate control, owner, due point, and final disposition.",
      "blocks": [
        {
          "key": "stop_condition_screen",
          "type": "checklist",
          "label": "Stop-condition screen",
          "items": [
            "Unprotected roof edge, unstable ladder, or unsafe access",
            "Wet, damaged, loose, or storm-affected roof or PV components",
            "Exposed conductors, open electrical parts, arcing, or burn marks",
            "Structural movement, severe deterioration, or falling-object exposure",
            "High wind, lightning, ice, heat, or other unsafe weather",
            "Unknown energized equipment or damaged wiring pathway",
            "Blocked emergency access or uncontrolled public exposure",
            "Any condition beyond the surveyor's authorization or training"
          ],
          "guidance": "Check any condition observed or reported; checking an item does not mean the condition is controlled."
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Qualified-person and stop-work boundary",
          "guidance": "This record does not authorize roof access, structural conclusions, or contact with electrical components. Stop the survey when access, weather, damaged components, exposed conductors, or structural conditions are unsafe. Keep unqualified people clear and route the condition to the site's qualified electrical, structural, or safety reviewer."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception and escalation register",
          "columns": [
            {
              "key": "condition",
              "label": "Condition / location",
              "units": 1.2
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Owner / route",
              "units": 0.95
            },
            {
              "key": "due",
              "label": "Due / update",
              "units": 0.85
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 1.15
            }
          ],
          "rows": 4,
          "guidance": "Link each intake exception to supporting evidence and keep it open until disposition is recorded."
        }
      ]
    },
    {
