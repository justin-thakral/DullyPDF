          ]
        },
        {
          "key": "intake_topics",
          "type": "checklist",
          "label": "Requested scope and known conditions",
          "items": [
            "Roof geometry, material, age, and visible condition",
            "Ground-mount area, grading, drainage, and soil constraints",
            "Solar access, shade sources, and seasonal obstruction",
            "Service equipment, meter position, and panel documentation",
            "Array setbacks, access paths, and roof obstructions",
            "Conduit route, inverter location, and equipment clearances",
            "Customer load history and expected future load changes",
            "Utility, permitting, association, or landlord coordination"
          ],
          "guidance": "Check only topics raised by the requester or supported by intake evidence."
        }
      ]
    },
    {
