    {
      "key": "exceptions_escalation",
      "title": "EV charger installation exceptions, stop conditions, and escalation",
      "guidance": "Make every unresolved condition visible with an immediate control, owner, due point, and final disposition.",
      "blocks": [
        {
          "key": "stop_condition_screen",
          "type": "checklist",
          "label": "Stop-condition screen",
          "items": [
            "Exposed or damaged energized component, conductor, connector, or enclosure",
            "Arcing, smoke, abnormal heat, burning odor, or repeated protective trip",
            "Water intrusion, standing water, flood exposure, or damaged seals",
            "Vehicle impact, unstable mounting, sharp edge, or falling equipment",
            "Uncontrolled circuit, unknown backfeed, or incomplete energy isolation",
            "Grounding, bonding, or protective-device result outside approved criteria",
            "Pedestrian, accessible-route, traffic, or cord trip exposure",
            "Work beyond the assigned qualified person's authorization"
          ],
          "guidance": "Check any condition observed or reported; checking an item does not mean the condition is controlled."
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Qualified-person and stop-work boundary",
          "guidance": "This form is not an energized-work permit or energy-control procedure. Stop when exposed parts, unknown circuits, failed protection, water intrusion, heat, smoke, or impact damage is present. A qualified and authorized person must control isolation, testing, commissioning, and return to service under current site procedures and applicable requirements."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception and escalation register",
          "columns": [
            {
              "key": "condition",
              "label": "Condition / location",
              "units": 1.2
            },
            {
              "key": "immediate_control",
