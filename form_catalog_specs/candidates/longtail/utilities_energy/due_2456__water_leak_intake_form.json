          ]
        },
        {
          "key": "baseline_context",
          "type": "fields",
          "label": "Available baseline",
          "fields": [
            {
              "key": "first_observed",
              "label": "First observed date and time",
              "units": 1.15
            },
            {
              "key": "flow_status",
              "label": "Active, intermittent, or stopped",
              "units": 1.1
