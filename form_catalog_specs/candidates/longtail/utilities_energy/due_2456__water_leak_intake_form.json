            {
              "key": "prior_history",
              "label": "Prior leak or repair ref",
              "units": 1.1
            }
          ]
        },
        {
          "key": "intake_topics",
          "type": "checklist",
          "label": "Requested scope and known conditions",
          "items": [
            "Active flow, drip, stain, moisture, pressure loss, or high-use indicator",
            "Fixture, supply, drain, roof, irrigation, service line, or equipment source",
            "Meter movement, isolation test, pressure, and before-and-after evidence",
            "Ceiling, wall, floor, cabinet, insulation, equipment, and contents impact",
            "Electrical exposure, ceiling sag, slip, contamination, freeze, and structural concerns",
            "Shutoff authority, critical water service, fire protection, and occupant impact",
            "Drying, environmental, restoration, plumber, utility, and property-owner routing",
            "Verification period, recurrence monitoring, and final damage handoff"
          ],
          "guidance": "Check only topics raised by the requester or supported by intake evidence."
        }
      ]
    },
    {
