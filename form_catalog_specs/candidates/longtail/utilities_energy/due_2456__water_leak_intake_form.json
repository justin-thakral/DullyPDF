    {
      "key": "system_context",
      "title": "Water leak system context and requested scope",
      "guidance": "Match the request to the exact suspected or confirmed water-release location before feasibility or scheduling decisions.",
      "blocks": [
        {
          "key": "subject_identity",
          "type": "fields",
          "label": "Water leak identity",
