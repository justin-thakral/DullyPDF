          "key": "intake_topics",
          "type": "checklist",
          "label": "Requested scope and known conditions",
          "items": [
            "System, chemistry, module, rack, PCS, inverter, and BMS identity",
            "State of charge, state of health, power, voltage, current, and temperature",
            "Alarm, fault, communication, imbalance, isolation, or derating condition",
            "HVAC, ventilation, detection, suppression, access, and enclosure condition",
            "Swelling, leaking, hissing, odor, heat, smoke, water, or impact damage",
            "Operating mode, dispatch schedule, critical-load, and outage dependency",
            "Manufacturer support, emergency plan, responder information, and isolation reference",
            "Restricted status, monitored recovery, return to service, and follow-up ownership"
          ],
          "guidance": "Check only topics raised by the requester or supported by intake evidence."
        }
      ]
