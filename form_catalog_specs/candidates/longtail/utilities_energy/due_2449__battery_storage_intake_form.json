    {
      "key": "exceptions_escalation",
      "title": "Battery storage exceptions, stop conditions, and escalation",
      "guidance": "Make every unresolved condition visible with an immediate control, owner, due point, and final disposition.",
      "blocks": [
        {
          "key": "stop_condition_screen",
          "type": "checklist",
          "label": "Stop-condition screen",
          "items": [
            "Smoke, flame, rapid heat rise, hissing, popping, or unusual odor",
            "Swelling, deformation, electrolyte residue, leak, or damaged cell enclosure",
            "Thermal, gas, fire-detection, suppression, or ventilation alarm",
            "Water intrusion, flooding, condensation, or damaged environmental seal",
            "Impact, penetration, dropped module, damaged cable, or exposed conductor",
            "Unknown isolation, stranded charge, backfeed, or reaccumulating stored energy",
            "Manufacturer stop condition or emergency-plan activation threshold",
            "Any entry or task beyond the person's training, PPE, tools, or authorization"
          ],
          "guidance": "Check any condition observed or reported; checking an item does not mean the condition is controlled."
        },
        {
          "key": "record_boundary",
          "type": "notice",
          "label": "Qualified-person and stop-work boundary",
          "guidance": "Do not open, enter, touch, reset, or approach a battery system showing heat, smoke, flame, hissing, odor, swelling, leaking, water intrusion, impact damage, or an isolation alarm. Keep people clear and activate the site emergency plan. Stored or stranded energy may remain after shutdown; only designated qualified personnel may assess isolation, recovery, and return to service."
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception and escalation register",
          "columns": [
            {
              "key": "condition",
              "label": "Condition / location",
              "units": 1.2
            },
            {
              "key": "immediate_control",
              "label": "Immediate control",
              "units": 1.15
            },
            {
              "key": "owner",
