  "slug": "outage-report-reading-log-form",
  "title": "Outage Report Reading Log Form",
  "subtitle": "An original outage report workflow that creates a traceable time series with method, context, variance, and review, with explicit qualified-review, stop-work, escalation, and accountable handoff controls.",
  "description": "A workflow-complete outage report reading log form for the utility interruption and restoration event that captures exact identity, domain observations, supporting evidence, decisions, exceptions, responsible owners, and closeout without replacing professional judgment or the organization's controlling procedures.",
  "use_case": "Use for a defined monitoring period when repeated values need stable identity, units, source, operating context, anomaly escalation, correction history, and accountable period closeout. The outage coordination lead owns routing, and closure requires documented evidence, disposition of restrictions, and acceptance by the designated reviewer.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "log_routing",
      "title": "Outage report reading log identity and period",
      "guidance": "Define one measurement period, one system boundary, and an accountable log owner.",
      "blocks": [
