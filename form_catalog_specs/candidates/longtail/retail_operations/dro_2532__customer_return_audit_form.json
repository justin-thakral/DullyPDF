            }
          ]
        },
        {
          "key": "audit_criteria",
          "type": "checklist",
          "label": "Return audit criteria",
          "items": [
            "Return line links to purchase or authorization evidence",
            "Item identity and observed condition are complete",
            "Policy version and decision authority are recorded",
            "Only necessary customer information is retained",
            "Refund or exchange matches the approved route",
            "Inventory and physical disposition agree",
            "Restricted product or device data is routed correctly",
            "Exceptions include rationale and authorization",
            "Customer promise has owner and due point",
            "Closeout connects tender and inventory records"
          ]
        },
        {
          "key": "audit_boundary",
          "type": "notice",
          "label": "Audit conclusion boundary",
          "guidance": "Do not record full payment credentials, unnecessary identity details, diagnoses, or accusations. Do not promise eligibility, safety, recall status, data erasure, or refund timing beyond current authority. Use approved de-escalation and emergency routes. Follow applicable return, privacy, product, payment, and retention policy and route judgment to the authorized reviewer."
        }
      ]
    },
