      "key": "incident_facts",
      "title": "Adjustment incident facts and immediate condition",
      "guidance": "Record direct observations, reported information, and unknowns separately; do not diagnose, blame, or make a legal conclusion.",
      "blocks": [
        {
          "key": "incident_types",
          "type": "checklist",
          "label": "Incident indicators",
          "items": [
            "Large or repeated unexplained variance",
            "Item, pack, lot, serial, or location mismatch",
            "Damaged, contaminated, or expired product found",
            "Receiving or transfer record unavailable",
            "Unauthorized or duplicate system adjustment",
            "System outage or posting corruption",
            "Controlled or high-value stock unsecured",
            "Employee or customer impact from wrong availability"
          ]
        },
        {
          "key": "event_reference",
          "type": "fields",
