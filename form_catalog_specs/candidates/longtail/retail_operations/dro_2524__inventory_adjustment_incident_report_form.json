              "key": "report_source",
              "label": "Direct or reported source",
              "units": 1.1,
              "field_type": "choice",
              "options": [
                "Direct observation",
                "Employee report",
                "Customer report",
                "Vendor report",
                "System alert",
                "Other record"
              ]
            }
          ]
        },
        {
          "key": "fact_narrative",
          "type": "textarea",
          "label": "Chronological facts, exact words when necessary, source of each fact, unknowns, and observed impact",
          "fields": [
            {
              "key": "fact_detail",
              "label": "Inventory Adjustment incident facts and timeline"
            }
          ],
          "height": 84
        },
        {
          "key": "incident_boundary",
          "type": "notice",
          "label": "Response and record boundary",
          "guidance": "Record count facts, system references, and authorized reasons without assigning blame or alleging theft. Do not alter source transactions to force agreement. Follow applicable inventory, financial-control, privacy, and retention policy; route product restrictions, loss patterns, or accounting conclusions to the authorized reviewer."
        }
      ]
