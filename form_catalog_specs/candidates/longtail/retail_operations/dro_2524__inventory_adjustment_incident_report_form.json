      "key": "response_escalation",
      "title": "Adjustment response, notification, and escalation",
      "guidance": "Document the immediate action actually taken, why it was selected, who authorized it, and what remains unresolved.",
      "blocks": [
        {
          "key": "immediate_actions",
          "type": "checklist",
          "label": "Immediate actions and safeguards",
          "items": [
            "Stopped posting until identity was resolved",
            "Preserved pre-adjustment system and count evidence",
            "Separated affected stock under approved status",
            "Requested independent recount",
            "Notified inventory or store management",
            "Routed pattern review without naming a cause",
            "Opened system, receiving, or transfer ticket",
            "Protected customer orders or replenishment from bad data"
