      "guidance": "Reconcile bags, tills, keys, doors, staff, pickups, and deferred tasks against the local closing plan without duplicating denomination-level cash records.",
      "blocks": [
        {
          "key": "basis_reference",
          "type": "fields",
          "label": "Count basis",
          "fields": [
            {
              "key": "expected_source",
