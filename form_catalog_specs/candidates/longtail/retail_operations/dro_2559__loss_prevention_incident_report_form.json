    {
      "key": "response_escalation",
      "title": "Loss prevention response, notification, and escalation",
      "guidance": "Document the immediate action actually taken, why it was selected, who authorized it, and what remains unresolved.",
      "blocks": [
        {
          "key": "immediate_actions",
          "type": "checklist",
          "label": "Immediate actions and safeguards",
          "items": [
            "Used emergency support for immediate threats",
            "Avoided confrontation, pursuit, search, or detention",
            "Protected people and restricted the affected area when authorized",
            "Recorded objective facts and source types",
            "Preserved evidence through the approved restricted system",
            "Notified authorized store or loss-prevention management",
            "Routed privacy, legal, or law-enforcement contact",
            "Established a temporary control and handoff owner"
          ]
        },
