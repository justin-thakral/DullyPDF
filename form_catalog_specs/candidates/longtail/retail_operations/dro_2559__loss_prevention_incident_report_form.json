{
  "schema_version": 1,
  "catalog_id": "retail_operations/dro_2559__loss_prevention_incident_report_form",
  "source_section": "retail_operations",
  "source_filename": "dro_2559__loss_prevention_incident_report_form.pdf",
  "slug": "loss-prevention-incident-report-form",
  "title": "Loss Prevention Incident Report Form",
  "subtitle": "A practical fact-based incident report for loss prevention that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations fact-based incident report for loss prevention covering loss-prevention controls and evidence, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a authorized loss-prevention lead opens one loss prevention record to capture objective facts, protect people and records, document response and notifications, assign follow-up, and close without unsupported conclusions; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_identity",
      "title": "Loss prevention incident report identity and routing",
      "guidance": "Connect this incident report to one location, operating period, accountable owner, and review route.",
