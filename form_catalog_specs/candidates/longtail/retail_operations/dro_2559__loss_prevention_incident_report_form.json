      ]
    },
    {
      "key": "incident_facts",
      "title": "Loss prevention incident facts and immediate condition",
      "guidance": "Record direct observations, reported information, and unknowns separately; do not diagnose, blame, or make a legal conclusion.",
      "blocks": [
        {
          "key": "incident_types",
          "type": "checklist",
          "label": "Incident indicators",
          "items": [
            "Immediate threat, violence, or emergency condition",
            "Reported theft, loss, damage, or suspicious activity",
            "Unauthorized access or restricted-area entry",
            "Key, seal, alarm, door, or device failure",
            "Evidence, footage, or personal-information exposure",
            "Cash, inventory, return, or receiving control discrepancy",
            "Confrontation, pursuit, search, or detention concern",
            "External agency, legal, or media contact"
          ]
        },
        {
          "key": "event_reference",
          "type": "fields",
          "label": "Event time and source",
          "fields": [
            {
              "key": "event_date",
              "label": "Event date",
              "units": 0.75
            },
            {
              "key": "event_time",
              "label": "Event time",
              "units": 0.65
            },
            {
              "key": "discovered_time",
              "label": "Discovered time",
              "units": 0.75
            },
            {
              "key": "exact_location",
              "label": "Exact location",
              "units": 1.15
            },
            {
              "key": "report_source",
              "label": "Direct or reported source",
              "units": 1.1,
              "field_type": "choice",
              "options": [
                "Direct observation",
                "Employee report",
                "Customer report",
                "Vendor report",
                "System alert",
                "Other record"
              ]
            }
          ]
        },
        {
          "key": "fact_narrative",
          "type": "textarea",
          "label": "Chronological facts, exact words when necessary, source of each fact, unknowns, and observed impact",
          "fields": [
            {
              "key": "fact_detail",
              "label": "Loss Prevention incident facts and timeline"
            }
          ],
          "height": 84
        },
        {
          "key": "incident_boundary",
          "type": "notice",
          "label": "Response and record boundary",
          "guidance": "This form does not authorize surveillance expansion, profiling, confrontation, pursuit, search, detention, accusation, or access to restricted evidence. Record objective facts and minimum necessary personal information. Keep footage, credentials, and sensitive evidence in approved restricted systems. Follow applicable privacy, security, legal-request, and emergency policy and route decisions to the authorized professional reviewer."
        }
      ]
    },
