  "slug": "inventory-adjustment-checklist-form",
  "title": "Inventory Adjustment Checklist Form",
  "subtitle": "A practical execution checklist for inventory adjustment that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations execution checklist for inventory adjustment covering inventory count and adjustment, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a inventory control lead opens one inventory adjustment record to execute required steps, record conditions, route exceptions, make a release decision, and hand off open work; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "record_identity",
      "title": "Adjustment checklist identity and routing",
      "guidance": "Connect this checklist to one location, operating period, accountable owner, and review route.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Adjustment record reference",
          "fields": [
            {
              "key": "record_number",
              "label": "Record number",
              "units": 0.85
            },
            {
              "key": "business_date",
              "label": "Business date",
              "units": 0.75
            },
            {
              "key": "start_time",
              "label": "Start time",
              "units": 0.65
            },
            {
              "key": "site",
              "label": "Store or inventory site",
              "units": 1.25
            },
            {
              "key": "unit",
              "label": "Area or stock location",
              "units": 1.15
            }
          ]
        },
        {
          "key": "routing",
          "type": "fields",
          "label": "Owner and operating route",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by",
              "units": 1.0
            },
            {
              "key": "assigned_owner",
              "label": "Assigned inventory control lead",
              "units": 1.15
            },
            {
              "key": "shift_window",
              "label": "Shift or time window",
              "units": 0.95
            },
            {
              "key": "status",
              "label": "Record status",
              "units": 0.85,
              "field_type": "choice",
              "options": [
                "Draft",
                "Active",
                "Hold",
                "Review",
                "Closed"
              ]
            },
            {
              "key": "related_reference",
              "label": "Related record or ticket",
              "units": 1.1
            }
          ]
        },
        {
          "key": "record_scope",
          "type": "textarea",
          "label": "Adjustment event scope, trigger, affected area, and prior handoff",
          "fields": [
            {
              "key": "scope_detail",
              "label": "Inventory Adjustment scope and routing context"
            }
          ],
          "height": 48
        }
      ]
    },
    {
      "key": "execution_sequence",
      "title": "Adjustment readiness and execution sequence",
      "guidance": "Mark each independently verified step; explain any item that cannot be completed as planned.",
      "blocks": [
        {
          "key": "required_steps",
          "type": "checklist",
          "label": "Adjustment steps",
          "items": [
            "SKU, description, unit of measure, and location verified",
            "System on-hand quantity captured before recount",
            "First physical count completed without editing source data",
            "Independent recount completed when required",
            "Open receipts, transfers, picks, and returns reviewed",
            "Damage, expiry, quarantine, or display stock considered",
            "Adjustment reason supported by an evidence reference",
            "Required approval obtained before system posting",
            "Posted quantity and transaction reference verified",
            "Residual variance and follow-up owner handed off"
          ]
        },
        {
          "key": "checkpoint_evidence",
          "type": "table",
          "label": "Key checkpoint observation and evidence",
          "columns": [
            {
              "key": "checkpoint",
              "label": "Checkpoint",
              "units": 1.15
            },
            {
              "key": "observation",
              "label": "Observation or result",
              "units": 1.5
            },
            {
              "key": "evidence",
              "label": "Evidence or record ref.",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Checked by",
              "units": 0.9
            }
          ],
          "rows": 3
        },
        {
          "key": "operating_boundary",
          "type": "notice",
          "label": "Operating boundary",
          "guidance": "Record count facts, system references, and authorized reasons without assigning blame or alleging theft. Do not alter source transactions to force agreement. Follow applicable inventory, financial-control, privacy, and retention policy; route product restrictions, loss patterns, or accounting conclusions to the authorized reviewer."
        }
      ]
    },
    {
      "key": "conditions_evidence",
      "title": "Adjustment conditions and supporting evidence",
      "guidance": "Record what was actually observed; a checked condition is a routing signal, not a conclusion.",
      "blocks": [
        {
          "key": "condition_indicators",
          "type": "checklist",
          "label": "Condition indicators reviewed",
          "items": [
            "SKU, pack, unit, lot, or location mismatch",
            "Open receiving or transfer transaction",
            "Count differs between counters",
            "Damaged, expired, quarantined, or display stock",
            "Negative on-hand or impossible quantity",
            "Serial- or lot-controlled record mismatch",
            "Adjustment exceeds local authority",
            "System posting fails or changes another location"
          ]
        },
        {
          "key": "observation_record",
          "type": "textarea",
          "label": "Observation, location, time, people affected, source, and evidence reference",
          "fields": [
            {
              "key": "observation_detail",
              "label": "Inventory Adjustment observation and evidence detail"
            }
          ],
          "height": 68
        }
      ]
    },
    {
      "key": "exceptions_decision",
      "title": "Adjustment exceptions, escalation, and release decision",
      "guidance": "Give each exception an immediate action, owner, due point, escalation route, and disposition.",
      "blocks": [
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Exception and stop indicators",
          "items": [
            "Item identity or unit of measure unresolved",
            "Independent recount cannot be completed",
            "Supporting movement record missing",
            "Adjustment exceeds approval authority",
            "Pattern requires loss-prevention review",
            "Posting or downstream allocation is blocked"
          ]
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception, control, owner, and disposition",
          "columns": [
            {
              "key": "exception",
              "label": "Exception or variance",
              "units": 1.35
            },
            {
              "key": "action",
              "label": "Immediate action",
              "units": 1.2
            },
            {
              "key": "owner_due",
              "label": "Owner and due point",
              "units": 1.15
            },
            {
              "key": "disposition",
              "label": "Escalation or disposition",
              "units": 1.25
            }
          ],
          "rows": 3
        },
        {
          "key": "decision_route",
          "type": "fields",
          "label": "Adjustment release decision and authorization",
          "fields": [
            {
              "key": "decision",
              "label": "Decision",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Proceed",
                "Proceed with limits",
                "Hold",
                "Escalate",
                "Decline",
                "Rework"
              ]
            },
            {
              "key": "authorized_by",
              "label": "Authorized by",
              "units": 1.0
            },
            {
              "key": "authorization_time",
              "label": "Decision date and time",
              "units": 1.0
            },
            {
              "key": "policy_reference",
              "label": "Policy or approval ref.",
              "units": 1.05
            },
            {
              "key": "review_owner",
              "label": "Review or follow-up owner",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Adjustment outcome, closeout, and handoff",
      "guidance": "Make the final outcome, remaining limitation, next action, owner, and acceptance visible.",
      "blocks": [
        {
          "key": "handoff_controls",
          "type": "checklist",
          "label": "Adjustment closeout controls",
          "items": [
            "Final counted quantity and variance retained",
            "Adjustment reason and evidence reference linked",
            "Approval and posting transaction recorded",
            "Affected replenishment or order owner notified",
            "Pattern or root-cause review assigned",
            "Unresolved item has owner and due point"
          ]
        },
        {
          "key": "outcome_route",
          "type": "fields",
          "label": "Outcome and next action",
          "fields": [
