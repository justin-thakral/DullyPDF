  "source_section": "retail_operations",
  "source_filename": "dro_2531__customer_return_incident_report_form.pdf",
  "slug": "customer-return-incident-report-form",
  "title": "Customer Return Incident Report Form",
  "subtitle": "A practical fact-based incident report for customer return that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations fact-based incident report for customer return covering return decision and disposition, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a returns or service lead opens one customer return record to capture objective facts, protect people and records, document response and notifications, assign follow-up, and close without unsupported conclusions; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "record_identity",
      "title": "Return incident report identity and routing",
      "guidance": "Connect this incident report to one location, operating period, accountable owner, and review route.",
