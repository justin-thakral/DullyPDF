          "height": 48
        }
      ]
    },
    {
      "key": "incident_facts",
      "title": "Return incident facts and immediate condition",
      "guidance": "Record direct observations, reported information, and unknowns separately; do not diagnose, blame, or make a legal conclusion.",
      "blocks": [
        {
          "key": "incident_types",
          "type": "checklist",
          "label": "Incident indicators",
          "items": [
            "Customer dispute or threatening behavior",
            "Wrong item, serial, lot, or quantity presented",
            "Unsafe, leaking, contaminated, or recalled-item indicator",
            "Personal data remains on returned device",
            "Refund, tender, or system processing failure",
            "Return item lost, switched, or misrouted",
            "Employee or customer injury event",
            "Policy exception handled outside authority"
          ]
        },
        {
          "key": "event_reference",
          "type": "fields",
          "label": "Event time and source",
          "fields": [
            {
              "key": "event_date",
              "label": "Event date",
              "units": 0.75
            },
            {
              "key": "event_time",
              "label": "Event time",
              "units": 0.65
            },
            {
              "key": "discovered_time",
              "label": "Discovered time",
              "units": 0.75
            },
            {
              "key": "exact_location",
              "label": "Exact location",
              "units": 1.15
            },
            {
              "key": "report_source",
              "label": "Direct or reported source",
              "units": 1.1,
              "field_type": "choice",
              "options": [
                "Direct observation",
                "Employee report",
                "Customer report",
                "Vendor report",
                "System alert",
                "Other record"
              ]
            }
          ]
        },
        {
          "key": "fact_narrative",
          "type": "textarea",
          "label": "Chronological facts, exact words when necessary, source of each fact, unknowns, and observed impact",
          "fields": [
            {
              "key": "fact_detail",
              "label": "Customer Return incident facts and timeline"
            }
          ],
          "height": 84
        },
        {
          "key": "incident_boundary",
          "type": "notice",
          "label": "Response and record boundary",
          "guidance": "Do not record full payment credentials, unnecessary identity details, diagnoses, or accusations. Do not promise eligibility, safety, recall status, data erasure, or refund timing beyond current authority. Use approved de-escalation and emergency routes. Follow applicable return, privacy, product, payment, and retention policy and route judgment to the authorized reviewer."
        }
      ]
    },
