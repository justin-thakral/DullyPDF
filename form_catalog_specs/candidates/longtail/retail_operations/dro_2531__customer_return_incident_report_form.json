    {
      "key": "response_escalation",
      "title": "Return response, notification, and escalation",
      "guidance": "Document the immediate action actually taken, why it was selected, who authorized it, and what remains unresolved.",
      "blocks": [
        {
          "key": "immediate_actions",
          "type": "checklist",
          "label": "Immediate actions and safeguards",
          "items": [
            "Paused the return decision",
            "Moved people away from an immediate condition",
            "Used approved de-escalation or emergency support",
            "Separated and labeled the item without making a technical finding",
            "Protected customer and payment information",
            "Notified returns, store, or product owner",
            "Preserved transaction and objective evidence references",
            "Established a clear customer follow-up owner"
          ]
        },
