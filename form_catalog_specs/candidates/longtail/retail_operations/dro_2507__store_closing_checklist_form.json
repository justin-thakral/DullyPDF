              "key": "scope_detail",
              "label": "Store Closing scope and routing context"
            }
          ],
          "height": 48
        }
      ]
    },
    {
      "key": "execution_sequence",
      "title": "Closing readiness and execution sequence",
      "guidance": "Mark each independently verified step; explain any item that cannot be completed as planned.",
      "blocks": [
        {
          "key": "required_steps",
          "type": "checklist",
          "label": "Closing steps",
          "items": [
            "Customer-service cutoff and final-customer status recorded",
            "Registers closed and cash routed to the cash procedure",
            "Returns, pickups, and held orders secured",
            "Sales floor, fitting, restroom, and back-room sweep complete",
            "Perishable, powered, and water-using equipment status recorded",
            "Exterior, entry, exit, and receiving doors checked",
            "Keys, access devices, and controlled items accounted for",
            "Staff departure order and lone-worker restriction checked",
            "Lighting and approved shutdown settings applied",
            "Alarm arm result and final departure time recorded"
          ]
        },
        {
          "key": "checkpoint_evidence",
          "type": "table",
          "label": "Key checkpoint observation and evidence",
          "columns": [
            {
              "key": "checkpoint",
              "label": "Checkpoint",
              "units": 1.15
            },
            {
              "key": "observation",
              "label": "Observation or result",
              "units": 1.5
            },
            {
              "key": "evidence",
              "label": "Evidence or record ref.",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Checked by",
              "units": 0.9
            }
          ],
          "rows": 3
        },
        {
          "key": "operating_boundary",
          "type": "notice",
          "label": "Operating boundary",
          "guidance": "Do not leave a known access, alarm, occupancy, utility, or custody exception without an authorized owner and documented limit. Avoid confrontation and use approved emergency routes. Never record alarm codes, safe combinations, or reusable credentials here. Follow applicable closing, safety, privacy, and security policy and route judgment to the authorized reviewer."
        }
      ]
    },
    {
      "key": "conditions_evidence",
      "title": "Closing conditions and supporting evidence",
      "guidance": "Record what was actually observed; a checked condition is a routing signal, not a conclusion.",
      "blocks": [
        {
          "key": "condition_indicators",
          "type": "checklist",
          "label": "Condition indicators reviewed",
          "items": [
            "Customer or visitor remains after cutoff",
            "Cash, deposit, refund, or tender record unresolved",
            "Door, lock, gate, key, or alarm exception",
            "Equipment, refrigeration, water, or utility concern",
            "Product, return, or delivery left unsecured",
            "Cleaning, waste, or customer-area condition incomplete",
            "Staff departure or transport concern",
            "Required close task deferred"
          ]
        },
        {
          "key": "observation_record",
          "type": "textarea",
          "label": "Observation, location, time, people affected, source, and evidence reference",
          "fields": [
            {
              "key": "observation_detail",
              "label": "Store Closing observation and evidence detail"
            }
          ],
          "height": 68
        }
      ]
    },
    {
      "key": "exceptions_decision",
      "title": "Closing exceptions, escalation, and release decision",
      "guidance": "Give each exception an immediate action, owner, due point, escalation route, and disposition.",
      "blocks": [
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Exception and stop indicators",
          "items": [
            "Closing delayed by customer or transaction",
            "Cash or controlled-item variance",
            "Door, key, or alarm unable to secure",
            "Utility or equipment cannot be left as planned",
            "Staffing or departure safeguard unavailable",
            "Final lockup or alarm release withheld"
          ]
        },
