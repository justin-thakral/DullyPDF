              "label": "Decision",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Proceed",
                "Proceed with limits",
                "Hold",
                "Escalate",
                "Decline",
                "Rework"
              ]
            },
            {
              "key": "authorized_by",
              "label": "Authorized by",
              "units": 1.0
            },
            {
              "key": "authorization_time",
              "label": "Decision date and time",
              "units": 1.0
            },
            {
              "key": "policy_reference",
              "label": "Policy or approval ref.",
              "units": 1.05
            },
            {
              "key": "review_owner",
              "label": "Review or follow-up owner",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Closing outcome, closeout, and handoff",
      "guidance": "Make the final outcome, remaining limitation, next action, owner, and acceptance visible.",
      "blocks": [
        {
          "key": "handoff_controls",
          "type": "checklist",
          "label": "Closing closeout controls",
          "items": [
            "Cash, deposits, and tenders handed to named custody",
            "Keys and access devices transferred or secured",
            "Unresolved equipment or facility issue routed",
            "Deferred merchandising or cleaning task assigned",
            "Next opening lead received operating limits",
            "Final departure and store-secured status recorded"
