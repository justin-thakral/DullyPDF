              "units": 0.65
            },
            {
              "key": "site",
              "label": "Store or site",
              "units": 1.25
            },
            {
              "key": "unit",
              "label": "Closing zone or shift",
              "units": 1.15
            }
          ]
        },
        {
          "key": "routing",
          "type": "fields",
          "label": "Owner and operating route",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by",
              "units": 1.0
            },
            {
              "key": "assigned_owner",
              "label": "Assigned closing lead",
              "units": 1.15
            },
            {
              "key": "shift_window",
              "label": "Shift or time window",
              "units": 0.95
            },
            {
              "key": "status",
              "label": "Record status",
              "units": 0.85,
              "field_type": "choice",
              "options": [
                "Draft",
                "Active",
                "Hold",
                "Review",
                "Closed"
              ]
            },
            {
              "key": "related_reference",
              "label": "Related record or ticket",
              "units": 1.1
            }
          ]
        },
        {
          "key": "record_scope",
