  "slug": "store-closing-checklist-form",
  "title": "Store Closing Checklist Form",
  "subtitle": "A practical execution checklist for store closing that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations execution checklist for store closing covering closing security and custody, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a closing lead opens one store closing record to execute required steps, record conditions, route exceptions, make a release decision, and hand off open work; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "record_identity",
      "title": "Closing checklist identity and routing",
      "guidance": "Connect this checklist to one location, operating period, accountable owner, and review route.",
      "blocks": [
