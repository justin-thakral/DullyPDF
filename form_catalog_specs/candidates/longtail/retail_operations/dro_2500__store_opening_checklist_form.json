              "field_type": "choice",
              "options": [
                "Complete",
                "Complete with limits",
                "Open follow-up",
                "Transferred",
                "Cancelled"
              ]
            },
            {
              "key": "remaining_limit",
              "label": "Remaining limit",
              "units": 1.15
            },
            {
              "key": "next_action",
              "label": "Next action",
              "units": 1.1
            },
            {
              "key": "next_owner",
