              "units": 1.2
            },
            {
              "key": "owner_due",
              "label": "Owner and due point",
              "units": 1.15
            },
            {
              "key": "disposition",
              "label": "Escalation or disposition",
              "units": 1.25
            }
          ],
          "rows": 3
        },
        {
          "key": "decision_route",
          "type": "fields",
          "label": "Opening release decision and authorization",
          "fields": [
            {
              "key": "decision",
              "label": "Decision",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Proceed",
                "Proceed with limits",
                "Hold",
                "Escalate",
                "Decline",
                "Rework"
              ]
            },
            {
              "key": "authorized_by",
              "label": "Authorized by",
              "units": 1.0
            },
            {
              "key": "authorization_time",
              "label": "Decision date and time",
              "units": 1.0
            },
            {
              "key": "policy_reference",
              "label": "Policy or approval ref.",
              "units": 1.05
            },
            {
              "key": "review_owner",
              "label": "Review or follow-up owner",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Opening outcome, closeout, and handoff",
      "guidance": "Make the final outcome, remaining limitation, next action, owner, and acceptance visible.",
      "blocks": [
        {
          "key": "handoff_controls",
          "type": "checklist",
          "label": "Opening closeout controls",
          "items": [
            "Opening status communicated to store team",
            "Unresolved work has an owner and due point",
            "Cash and key custody handed to named owners",
            "Service desk and sales floor release recorded",
            "Facilities or vendor follow-up reference linked",
            "Opening record stored in the approved location"
          ]
        },
        {
          "key": "outcome_route",
          "type": "fields",
          "label": "Outcome and next action",
          "fields": [
