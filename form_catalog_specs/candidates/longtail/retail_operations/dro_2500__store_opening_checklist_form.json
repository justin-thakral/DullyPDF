{
  "schema_version": 1,
  "catalog_id": "retail_operations/dro_2500__store_opening_checklist_form",
  "source_section": "retail_operations",
  "source_filename": "dro_2500__store_opening_checklist_form.pdf",
  "slug": "store-opening-checklist-form",
  "title": "Store Opening Checklist Form",
  "subtitle": "A practical execution checklist for store opening that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations execution checklist for store opening covering opening readiness, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a opening lead opens one store opening record to execute required steps, record conditions, route exceptions, make a release decision, and hand off open work; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "record_identity",
      "title": "Opening checklist identity and routing",
      "guidance": "Connect this checklist to one location, operating period, accountable owner, and review route.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Opening record reference",
          "fields": [
            {
              "key": "record_number",
              "label": "Record number",
              "units": 0.85
            },
            {
              "key": "business_date",
              "label": "Business date",
              "units": 0.75
            },
            {
              "key": "start_time",
              "label": "Start time",
              "units": 0.65
            },
            {
              "key": "site",
              "label": "Store or site",
              "units": 1.25
            },
            {
              "key": "unit",
              "label": "Opening zone or shift",
              "units": 1.15
            }
          ]
        },
        {
          "key": "routing",
          "type": "fields",
          "label": "Owner and operating route",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by",
              "units": 1.0
            },
            {
              "key": "assigned_owner",
              "label": "Assigned opening lead",
              "units": 1.15
            },
            {
              "key": "shift_window",
              "label": "Shift or time window",
              "units": 0.95
            },
            {
              "key": "status",
              "label": "Record status",
              "units": 0.85,
              "field_type": "choice",
              "options": [
                "Draft",
                "Active",
                "Hold",
                "Review",
                "Closed"
              ]
            },
            {
              "key": "related_reference",
              "label": "Related record or ticket",
              "units": 1.1
            }
          ]
        },
        {
          "key": "record_scope",
          "type": "textarea",
          "label": "Opening event scope, trigger, affected area, and prior handoff",
          "fields": [
            {
              "key": "scope_detail",
              "label": "Store Opening scope and routing context"
            }
          ],
          "height": 48
        }
      ]
    },
    {
      "key": "execution_sequence",
      "title": "Opening readiness and execution sequence",
      "guidance": "Mark each independently verified step; explain any item that cannot be completed as planned.",
      "blocks": [
        {
          "key": "required_steps",
          "type": "checklist",
          "label": "Opening steps",
          "items": [
            "Exterior approach observed before entry",
            "Authorized keyholder entry time recorded",
            "Alarm disarm result recorded without access codes",
            "Interior walkthrough and overnight condition check complete",
            "Entry, exit, and customer paths checked",
            "Lighting, utilities, and comfort systems status recorded",
            "POS, network, and required service devices checked",
            "Opening cash custody routed to the cash procedure",
            "Promotions, pricing, and customer areas made ready",
            "Staffing coverage and public-opening release confirmed"
          ]
        },
        {
          "key": "checkpoint_evidence",
          "type": "table",
          "label": "Key checkpoint observation and evidence",
          "columns": [
            {
              "key": "checkpoint",
              "label": "Checkpoint",
              "units": 1.15
            },
            {
              "key": "observation",
              "label": "Observation or result",
              "units": 1.5
            },
            {
              "key": "evidence",
              "label": "Evidence or record ref.",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Checked by",
              "units": 0.9
            }
          ],
          "rows": 3
        },
        {
          "key": "operating_boundary",
          "type": "notice",
          "label": "Operating boundary",
          "guidance": "Do not enter, confront a person, disturb suspected evidence, or open to the public when conditions exceed current authorization. Record objective observations and references only; never place alarm codes, safe combinations, or reusable credentials in this form. Follow applicable store, emergency, safety, privacy, and security policy and route judgment to the authorized reviewer."
        }
      ]
    },
    {
      "key": "conditions_evidence",
      "title": "Opening conditions and supporting evidence",
      "guidance": "Record what was actually observed; a checked condition is a routing signal, not a conclusion.",
      "blocks": [
        {
          "key": "condition_indicators",
          "type": "checklist",
          "label": "Condition indicators reviewed",
          "items": [
            "Door, lock, glass, or exterior damage",
            "Alarm, access, or key-control exception",
            "Water, odor, utility, or equipment concern",
            "Unexpected person, delivery, or overnight activity",
            "Customer-area cleanliness or trip concern",
            "POS, network, refrigeration, or lighting outage",
            "Opening float or safe handoff incomplete",
            "Staffing or trained-keyholder shortage"
          ]
        },
        {
          "key": "observation_record",
          "type": "textarea",
          "label": "Observation, location, time, people affected, source, and evidence reference",
          "fields": [
            {
              "key": "observation_detail",
              "label": "Store Opening observation and evidence detail"
            }
          ],
          "height": 68
        }
      ]
    },
    {
      "key": "exceptions_decision",
      "title": "Opening exceptions, escalation, and release decision",
      "guidance": "Give each exception an immediate action, owner, due point, escalation route, and disposition.",
      "blocks": [
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Exception and stop indicators",
          "items": [
            "Entry delayed or access unavailable",
            "Opening stopped for unsafe condition",
            "Alarm response or security review needed",
            "Critical system or utility unavailable",
            "Cash custody not reconciled",
            "Public opening delayed or limited"
          ]
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception, control, owner, and disposition",
          "columns": [
            {
              "key": "exception",
              "label": "Exception or variance",
              "units": 1.35
            },
            {
              "key": "action",
