            }
          ]
        },
        {
          "key": "audit_criteria",
          "type": "checklist",
          "label": "Closing audit criteria",
          "items": [
            "Closing record tied to one business date and shift",
            "Customer cutoff and final departure status present",
            "Cash closure points to the separate cash record",
            "All store zones appear in the sweep",
            "Powered and temperature-controlled equipment addressed",
            "Door, key, and alarm results are explicit",
            "Exceptions show immediate action and escalation",
            "Final lockup decision has an authorized owner",
            "Next opening lead received unresolved work",
            "Closeout and custody acknowledgments are complete"
          ]
        },
        {
          "key": "audit_boundary",
          "type": "notice",
          "label": "Audit conclusion boundary",
          "guidance": "Do not leave a known access, alarm, occupancy, utility, or custody exception without an authorized owner and documented limit. Avoid confrontation and use approved emergency routes. Never record alarm codes, safe combinations, or reusable credentials here. Follow applicable closing, safety, privacy, and security policy and route judgment to the authorized reviewer."
        }
      ]
    },
