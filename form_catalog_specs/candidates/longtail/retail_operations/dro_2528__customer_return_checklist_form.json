{
  "schema_version": 1,
  "catalog_id": "retail_operations/dro_2528__customer_return_checklist_form",
  "source_section": "retail_operations",
  "source_filename": "dro_2528__customer_return_checklist_form.pdf",
  "slug": "customer-return-checklist-form",
  "title": "Customer Return Checklist Form",
  "subtitle": "A practical execution checklist for customer return that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations execution checklist for customer return covering return decision and disposition, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a returns or service lead opens one customer return record to execute required steps, record conditions, route exceptions, make a release decision, and hand off open work; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "record_identity",
      "title": "Return checklist identity and routing",
      "guidance": "Connect this checklist to one location, operating period, accountable owner, and review route.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Return record reference",
          "fields": [
            {
              "key": "record_number",
              "label": "Record number",
              "units": 0.85
            },
            {
              "key": "business_date",
              "label": "Business date",
              "units": 0.75
            },
            {
              "key": "start_time",
              "label": "Start time",
              "units": 0.65
            },
            {
              "key": "site",
              "label": "Store or return site",
              "units": 1.25
            },
            {
              "key": "unit",
              "label": "Desk, lane, or channel",
              "units": 1.15
            }
          ]
        },
        {
          "key": "routing",
          "type": "fields",
          "label": "Owner and operating route",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by",
              "units": 1.0
            },
            {
              "key": "assigned_owner",
              "label": "Assigned returns or service lead",
              "units": 1.15
            },
            {
              "key": "shift_window",
              "label": "Shift or time window",
              "units": 0.95
            },
            {
              "key": "status",
              "label": "Record status",
              "units": 0.85,
              "field_type": "choice",
              "options": [
                "Draft",
                "Active",
                "Hold",
                "Review",
                "Closed"
              ]
            },
            {
              "key": "related_reference",
              "label": "Related record or ticket",
              "units": 1.1
            }
          ]
        },
        {
          "key": "record_scope",
          "type": "textarea",
          "label": "Return event scope, trigger, affected area, and prior handoff",
          "fields": [
            {
              "key": "scope_detail",
              "label": "Customer Return scope and routing context"
            }
          ],
          "height": 48
        }
      ]
    },
    {
      "key": "execution_sequence",
      "title": "Return readiness and execution sequence",
      "guidance": "Mark each independently verified step; explain any item that cannot be completed as planned.",
      "blocks": [
        {
          "key": "required_steps",
          "type": "checklist",
          "label": "Return steps",
          "items": [
            "Return, order, receipt, or authorization reference linked",
            "Item, quantity, serial or lot when needed, and condition observed",
            "Purchase channel, tender route, and timing checked",
            "Current return policy criteria reviewed",
            "Only minimum customer identification recorded",
            "Refund, exchange, repair, denial, or exception decision recorded",
            "Refund routed to an authorized tender method",
            "Restock, hold, damage, vendor, or disposal status assigned",
            "Customer communication and declined options recorded",
            "Product custody and unresolved follow-up handed off"
          ]
        },
        {
          "key": "checkpoint_evidence",
          "type": "table",
          "label": "Key checkpoint observation and evidence",
          "columns": [
            {
              "key": "checkpoint",
              "label": "Checkpoint",
              "units": 1.15
            },
            {
              "key": "observation",
              "label": "Observation or result",
              "units": 1.5
            },
            {
              "key": "evidence",
              "label": "Evidence or record ref.",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Checked by",
              "units": 0.9
            }
          ],
          "rows": 3
        },
        {
          "key": "operating_boundary",
          "type": "notice",
          "label": "Operating boundary",
          "guidance": "Do not record full payment credentials, unnecessary identity details, diagnoses, or accusations. Do not promise eligibility, safety, recall status, data erasure, or refund timing beyond current authority. Use approved de-escalation and emergency routes. Follow applicable return, privacy, product, payment, and retention policy and route judgment to the authorized reviewer."
        }
      ]
    },
    {
      "key": "conditions_evidence",
      "title": "Return conditions and supporting evidence",
      "guidance": "Record what was actually observed; a checked condition is a routing signal, not a conclusion.",
      "blocks": [
        {
          "key": "condition_indicators",
          "type": "checklist",
          "label": "Condition indicators reviewed",
          "items": [
            "Receipt, order, or authorization unavailable",
            "Item, serial, lot, or quantity mismatch",
            "Condition differs from return statement",
            "Return window or channel exception",
            "Refund tender unavailable or disputed",
            "Product needs data, hazard, or specialist review",
            "Customer disagreement or service escalation",
            "Restock or final disposition unresolved"
          ]
        },
        {
          "key": "observation_record",
          "type": "textarea",
          "label": "Observation, location, time, people affected, source, and evidence reference",
          "fields": [
            {
              "key": "observation_detail",
              "label": "Customer Return observation and evidence detail"
            }
          ],
          "height": 68
        }
      ]
    },
    {
      "key": "exceptions_decision",
      "title": "Return exceptions, escalation, and release decision",
      "guidance": "Give each exception an immediate action, owner, due point, escalation route, and disposition.",
      "blocks": [
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Exception and stop indicators",
          "items": [
            "Policy exception requested",
            "High-value or controlled item review needed",
            "Customer identity or purchase link unresolved",
            "Refund route cannot be completed",
            "Product condition requires restricted handling",
            "Interaction requires manager or security support"
          ]
        },
        {
          "key": "exception_register",
          "type": "table",
          "label": "Exception, control, owner, and disposition",
          "columns": [
            {
              "key": "exception",
              "label": "Exception or variance",
              "units": 1.35
            },
            {
              "key": "action",
