              "units": 1.15
            },
            {
              "key": "disposition",
              "label": "Escalation or disposition",
              "units": 1.25
            }
          ],
          "rows": 3
        },
        {
          "key": "decision_route",
          "type": "fields",
          "label": "Return release decision and authorization",
          "fields": [
            {
              "key": "decision",
              "label": "Decision",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Proceed",
                "Proceed with limits",
                "Hold",
                "Escalate",
                "Decline",
                "Rework"
              ]
            },
            {
              "key": "authorized_by",
              "label": "Authorized by",
              "units": 1.0
            },
            {
              "key": "authorization_time",
              "label": "Decision date and time",
              "units": 1.0
            },
            {
              "key": "policy_reference",
              "label": "Policy or approval ref.",
              "units": 1.05
            },
            {
              "key": "review_owner",
              "label": "Review or follow-up owner",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Return outcome, closeout, and handoff",
      "guidance": "Make the final outcome, remaining limitation, next action, owner, and acceptance visible.",
      "blocks": [
        {
          "key": "handoff_controls",
          "type": "checklist",
          "label": "Return closeout controls",
          "items": [
            "Customer outcome and communication recorded",
            "Refund, exchange, or credit reference linked",
            "Returned item moved to the assigned status",
            "Personal data or device-data concern routed",
            "Vendor, repair, or inventory follow-up assigned",
            "Open promise has owner and due point"
          ]
        },
        {
          "key": "outcome_route",
          "type": "fields",
          "label": "Outcome and next action",
          "fields": [
            {
              "key": "final_outcome",
              "label": "Final outcome",
              "units": 1.1,
              "field_type": "choice",
              "options": [
                "Complete",
                "Complete with limits",
                "Open follow-up",
                "Transferred",
                "Cancelled"
              ]
            },
            {
              "key": "remaining_limit",
              "label": "Remaining limit",
              "units": 1.15
            },
            {
              "key": "next_action",
              "label": "Next action",
              "units": 1.1
            },
            {
              "key": "next_owner",
