{
  "schema_version": 1,
  "catalog_id": "retail_operations/dro_2547__visual_merchandising_log_form",
  "source_section": "retail_operations",
  "source_filename": "dro_2547__visual_merchandising_log_form.pdf",
  "slug": "visual-merchandising-log-form",
  "title": "Visual Merchandising Log Form",
  "subtitle": "A practical chronological operating log for visual merchandising that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations chronological operating log for visual merchandising covering display execution and release, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a visual merchandising lead opens one visual merchandising record to record chronological checkpoints, preserve corrections, escalate exceptions, summarize the period, and hand off open actions; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "record_identity",
      "title": "Merchandising log identity and routing",
      "guidance": "Connect this log to one location, operating period, accountable owner, and review route.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Merchandising record reference",
          "fields": [
            {
              "key": "record_number",
              "label": "Record number",
              "units": 0.85
            },
            {
              "key": "business_date",
              "label": "Business date",
              "units": 0.75
            },
            {
              "key": "start_time",
              "label": "Start time",
              "units": 0.65
            },
            {
              "key": "site",
              "label": "Store or display site",
              "units": 1.25
            },
            {
              "key": "unit",
              "label": "Campaign, zone, or fixture",
              "units": 1.15
            }
          ]
        },
        {
          "key": "routing",
          "type": "fields",
          "label": "Owner and operating route",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by",
              "units": 1.0
            },
            {
              "key": "assigned_owner",
              "label": "Assigned visual merchandising lead",
              "units": 1.15
            },
            {
              "key": "shift_window",
              "label": "Shift or time window",
              "units": 0.95
            },
            {
              "key": "status",
              "label": "Record status",
              "units": 0.85,
              "field_type": "choice",
              "options": [
                "Draft",
                "Active",
                "Hold",
                "Review",
                "Closed"
              ]
            },
            {
              "key": "related_reference",
              "label": "Related record or ticket",
              "units": 1.1
            }
          ]
        },
        {
          "key": "record_scope",
          "type": "textarea",
          "label": "Merchandising event scope, trigger, affected area, and prior handoff",
          "fields": [
            {
              "key": "scope_detail",
              "label": "Visual Merchandising scope and routing context"
            }
          ],
          "height": 48
        }
      ]
    },
    {
      "key": "log_basis",
      "title": "Merchandising log basis and entry rules",
      "guidance": "Use chronological entries for one operating period and preserve corrections as new entries rather than overwriting history.",
      "blocks": [
        {
          "key": "event_categories",
          "type": "checklist",
          "label": "Merchandising event categories",
          "items": [
            "Campaign materials received",
            "Existing display removed or prepared",
            "Fixture or sign installation",
            "Product placement and quantity check",
            "Price, offer, copy, or content check",
            "Lighting, power, or digital-device test",
            "Variance decision or correction",
            "Zone release or campaign removal"
          ]
        },
        {
          "key": "log_controls",
          "type": "fields",
          "label": "Log control",
          "fields": [
            {
              "key": "period_start",
              "label": "Period start",
              "units": 0.8
            },
            {
              "key": "period_end",
              "label": "Period end",
              "units": 0.8
            },
            {
              "key": "entry_owner",
              "label": "Primary log owner",
              "units": 1.0
            },
            {
              "key": "handoff_frequency",
              "label": "Handoff frequency",
              "units": 1.0
            },
            {
              "key": "restricted_refs",
              "label": "Restricted-record route",
              "units": 1.1
            }
          ]
        },
        {
          "key": "log_boundary",
          "type": "notice",
          "label": "Logging boundary",
          "guidance": "Do not claim accessibility, electrical, structural, promotional, or legal compliance from this visual record. Stop and restrict a display when conditions exceed current training or authorization. Avoid identifiable customer images unless genuinely required and approved. Follow applicable merchandising, safety, accessibility, privacy, and promotional policy and route judgment to the authorized reviewer."
        }
      ]
    },
    {
      "key": "chronological_entries",
      "title": "Merchandising chronological activity entries",
      "guidance": "Give each entry a time, event or checkpoint, objective result, action or decision, owner, and evidence reference.",
      "blocks": [
        {
          "key": "activity_log",
          "type": "table",
          "label": "Merchandising activity log",
          "columns": [
            {
              "key": "time",
              "label": "Date and time",
              "units": 0.8
            },
            {
              "key": "event",
              "label": "Event or checkpoint",
              "units": 1.15
            },
            {
              "key": "observation",
              "label": "Observation or result",
              "units": 1.25
            },
            {
              "key": "action",
              "label": "Action or decision",
              "units": 1.1
            },
            {
              "key": "owner",
              "label": "Owner",
              "units": 0.75
            },
            {
              "key": "evidence",
              "label": "Evidence ref.",
              "units": 0.8
            }
          ],
          "rows": 6
        },
        {
          "key": "period_context",
          "type": "textarea",
          "label": "Operating context, unusual demand, system limits, corrections to prior entries, and known evidence gaps",
          "fields": [
            {
              "key": "context_detail",
              "label": "Visual Merchandising log context and corrections"
            }
          ],
          "height": 58
        }
      ]
    },
    {
      "key": "exceptions_escalation",
      "title": "Merchandising exceptions, escalation, and status changes",
      "guidance": "Connect every unresolved log entry to an immediate control, owner, due point, and escalation route.",
      "blocks": [
        {
          "key": "condition_indicators",
          "type": "checklist",
          "label": "Conditions requiring a status entry",
          "items": [
            "Plan, revision, price, offer, or copy mismatch",
            "Fixture, sign, product, or hardware missing",
            "Damaged, unstable, sharp, powered, or obstructing component",
            "Unapproved substitution or placement",
            "Customer path, service access, or sightline concern",
            "Lighting, power, screen, or content failure",
            "Install cannot finish before release window",
            "Removal, storage, or waste route unclear"
          ]
        },
        {
          "key": "exception_log",
          "type": "table",
          "label": "Exception and escalation entries",
          "columns": [
            {
              "key": "entry_ref",
              "label": "Log entry ref.",
              "units": 0.8
            },
            {
              "key": "exception",
              "label": "Exception or variance",
              "units": 1.25
            },
            {
              "key": "control",
              "label": "Immediate control",
              "units": 1.1
            },
            {
              "key": "owner_due",
              "label": "Owner and due point",
              "units": 1.05
            },
            {
              "key": "escalation",
              "label": "Escalation or outcome",
              "units": 1.15
            }
          ],
          "rows": 3
        },
        {
          "key": "decision_route",
          "type": "fields",
