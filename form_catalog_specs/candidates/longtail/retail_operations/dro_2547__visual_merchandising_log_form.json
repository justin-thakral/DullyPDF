              "units": 0.8
            },
            {
              "key": "recipient_route",
              "label": "Recipient or route",
              "units": 1.05
            }
          ],
          "rows": 3
        },
        {
          "key": "residual_record",
          "type": "textarea",
          "label": "Unresolved work, customer or staff impact, evidence location, and handoff message",
