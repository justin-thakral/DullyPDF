          "fields": [
            {
              "key": "decision",
              "label": "Decision",
              "units": 1.15,
              "field_type": "choice",
              "options": [
                "Proceed",
                "Proceed with limits",
                "Hold",
                "Escalate",
                "Decline",
                "Rework"
              ]
            },
            {
              "key": "authorized_by",
              "label": "Authorized by",
              "units": 1.0
            },
            {
              "key": "authorization_time",
              "label": "Decision date and time",
              "units": 1.0
            },
            {
              "key": "policy_reference",
              "label": "Policy or approval ref.",
              "units": 1.05
            },
            {
              "key": "review_owner",
              "label": "Review or follow-up owner",
              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "shift_summary",
      "title": "Merchandising period summary and next-shift route",
      "guidance": "Summarize totals and outcomes without replacing the detailed chronological entries.",
      "blocks": [
        {
          "key": "summary_counts",
          "type": "fields",
          "label": "Period summary",
          "fields": [
            {
              "key": "entries_total",
              "label": "Entries recorded",
              "units": 0.8
            },
            {
              "key": "normal_results",
              "label": "Routine results",
              "units": 0.8
            },
            {
              "key": "exceptions_total",
              "label": "Exceptions",
              "units": 0.8
            },
            {
              "key": "open_actions",
              "label": "Open actions",
              "units": 0.8
            },
            {
              "key": "evidence_records",
              "label": "Evidence references",
              "units": 1.0
            }
          ]
        },
        {
          "key": "handoff_controls",
          "type": "checklist",
          "label": "Next-shift log handoff controls",
          "items": [
            "Chronological entries complete through handoff time",
            "Late corrections cross-reference the original entry",
            "Period counts and status summary reconciled",
            "Highest-priority open exception highlighted",
            "Receiving owner briefed on operating limits",
            "Next checkpoint or review time recorded"
          ]
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Merchandising outcome, closeout, and handoff",
      "guidance": "Make the final outcome, remaining limitation, next action, owner, and acceptance visible.",
      "blocks": [
        {
          "key": "handoff_controls",
          "type": "checklist",
          "label": "Merchandising closeout controls",
          "items": [
            "Final campaign revision and zones recorded",
            "Release photos and evidence references linked",
            "Price and promotional source check completed",
            "Open material or fixture issue assigned",
            "Store team received care and removal notes",
            "Removal date and storage or disposal owner assigned"
