      "key": "execution_sequence",
      "title": "Temperature readiness and execution sequence",
      "guidance": "Mark each independently verified step; explain any item that cannot be completed as planned.",
      "blocks": [
        {
          "key": "required_steps",
          "type": "checklist",
          "label": "Temperature steps",
          "items": [
            "Food, batch, case, equipment, or receiving lot identified",
            "Reading location and sample point defined",
            "Instrument ID and readiness check recorded",
            "Current policy target or limit source referenced",
            "Reading time, value, and unit recorded",
            "Repeat or confirmation reading completed when required",
            "Product exposure or equipment condition observed",
            "Hold, move, adjust, discard, or release decision authorized",
            "Equipment, product, and customer impact routed",
            "Follow-up reading and handoff owner recorded"
          ]
        },
        {
          "key": "checkpoint_evidence",
          "type": "table",
          "label": "Key checkpoint observation and evidence",
          "columns": [
