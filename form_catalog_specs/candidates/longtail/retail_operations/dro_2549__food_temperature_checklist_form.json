              "key": "checkpoint",
              "label": "Checkpoint",
              "units": 1.15
            },
            {
              "key": "observation",
              "label": "Observation or result",
              "units": 1.5
            },
            {
              "key": "evidence",
              "label": "Evidence or record ref.",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Checked by",
              "units": 0.9
            }
          ],
          "rows": 3
        },
        {
          "key": "operating_boundary",
          "type": "notice",
          "label": "Operating boundary",
          "guidance": "This form records measurements and decisions under the current procedure; it does not set temperature limits or certify food safety or regulatory compliance. Do not guess a target, exposure duration, or disposition. Stop affected activity when policy requires and route illness, safety, and final product decisions to the qualified food-safety reviewer under applicable requirements."
        }
      ]
    },
    {
      "key": "conditions_evidence",
      "title": "Temperature conditions and supporting evidence",
      "guidance": "Record what was actually observed; a checked condition is a routing signal, not a conclusion.",
      "blocks": [
        {
          "key": "condition_indicators",
          "type": "checklist",
          "label": "Condition indicators reviewed",
          "items": [
            "Instrument unavailable, damaged, or readiness check fails",
            "Food, batch, case, or sample point unclear",
            "Reading is outside the current policy target",
            "Repeat reading materially differs",
            "Exposure start or duration is unknown",
            "Equipment alarm, door, power, airflow, or seal concern",
            "Product has already moved, sold, or been served",
            "Disposition authority or follow-up owner unavailable"
          ]
        },
