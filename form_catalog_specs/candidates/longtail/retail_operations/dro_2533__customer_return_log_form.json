  "source_section": "retail_operations",
  "source_filename": "dro_2533__customer_return_log_form.pdf",
  "slug": "customer-return-log-form",
  "title": "Customer Return Log Form",
  "subtitle": "A practical chronological operating log for customer return that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations chronological operating log for customer return covering return decision and disposition, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a returns or service lead opens one customer return record to record chronological checkpoints, preserve corrections, escalate exceptions, summarize the period, and hand off open actions; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "record_identity",
      "title": "Return log identity and routing",
      "guidance": "Connect this log to one location, operating period, accountable owner, and review route.",
