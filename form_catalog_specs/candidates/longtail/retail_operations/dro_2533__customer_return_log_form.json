      "key": "log_basis",
      "title": "Return log basis and entry rules",
      "guidance": "Use chronological entries for one operating period and preserve corrections as new entries rather than overwriting history.",
      "blocks": [
        {
          "key": "event_categories",
          "type": "checklist",
          "label": "Return event categories",
          "items": [
            "Return intake and item receipt",
            "Purchase or authorization verification",
            "Condition observation",
            "Policy or manager review",
            "Refund, exchange, repair, or denial decision",
            "Tender or system processing",
            "Physical disposition transfer",
            "Customer follow-up or closeout"
          ]
        },
        {
          "key": "log_controls",
          "type": "fields",
          "label": "Log control",
          "fields": [
            {
              "key": "period_start",
              "label": "Period start",
              "units": 0.8
            },
            {
              "key": "period_end",
              "label": "Period end",
              "units": 0.8
            },
            {
              "key": "entry_owner",
              "label": "Primary log owner",
              "units": 1.0
            },
            {
              "key": "handoff_frequency",
              "label": "Handoff frequency",
              "units": 1.0
            },
            {
              "key": "restricted_refs",
              "label": "Restricted-record route",
              "units": 1.1
            }
          ]
        },
        {
          "key": "log_boundary",
          "type": "notice",
          "label": "Logging boundary",
          "guidance": "Do not record full payment credentials, unnecessary identity details, diagnoses, or accusations. Do not promise eligibility, safety, recall status, data erasure, or refund timing beyond current authority. Use approved de-escalation and emergency routes. Follow applicable return, privacy, product, payment, and retention policy and route judgment to the authorized reviewer."
        }
      ]
    },
