      "title": "Adjustment audit scope, criteria, and sample",
      "guidance": "Define the period, locations, records, sample method, and applicable policy before recording findings.",
      "blocks": [
        {
          "key": "scope_basis",
          "type": "fields",
          "label": "Audit basis",
          "fields": [
