        {
          "key": "audit_criteria",
          "type": "checklist",
          "label": "Vendor audit criteria",
          "items": [
            "Vendor identity and approved contact are linked",
            "Scope, sites, products, and term are specific",
            "Sponsor and purchase route are present",
            "Required records show current status and source",
            "Access requests have least-necessary scope",
            "Subcontractors and conflicts are addressed",
            "Restricted commercial data remains in approved systems",
            "Approval conditions have owners and expiration dates",
            "Renewal and offboarding are assigned",
            "Start or hold decision is communicated"
          ]
        },
        {
          "key": "audit_boundary",
          "type": "notice",
          "label": "Audit conclusion boundary",
          "guidance": "Use references and status fields rather than copying tax identifiers, bank details, identity documents, credentials, or confidential contracts into this general form. A listed document is not a legal or professional validation. Follow applicable purchasing, access, privacy, security, and retention policy and route specialist judgments to the authorized reviewer."
        }
      ]
