  "slug": "vendor-intake-audit-form",
  "title": "Vendor Intake Audit Form",
  "subtitle": "A practical evidence-based audit for vendor intake that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations evidence-based audit for vendor intake covering vendor onboarding and access, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a vendor coordinator opens one vendor intake record to define criteria and sample, test objective evidence, record findings, assign corrective verification, and close or reopen actions; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "A",
