  "slug": "vendor-intake-request-form",
  "title": "Vendor Intake Request Form",
  "subtitle": "A practical scope and authorization request for vendor intake that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations scope and authorization request for vendor intake covering vendor onboarding and access, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a vendor coordinator opens one vendor intake record to define a requested outcome, assess impacts and dependencies, record authorization limits, assign approved work, and communicate the decision; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "A",
