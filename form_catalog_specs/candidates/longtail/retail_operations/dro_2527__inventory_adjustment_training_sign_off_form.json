      "title": "Adjustment training plan and learner route",
      "guidance": "Define the procedure revision, learning method, practice setting, supervisor, and authorized scope.",
      "blocks": [
        {
          "key": "learner_session",
          "type": "fields",
          "label": "Learner and session",
