          "height": 48
        }
      ]
    },
    {
      "key": "execution_sequence",
      "title": "Drawer readiness and execution sequence",
      "guidance": "Mark each independently verified step; explain any item that cannot be completed as planned.",
      "blocks": [
        {
          "key": "required_steps",
          "type": "checklist",
          "label": "Drawer steps",
          "items": [
            "Drawer, register, operator, and business period linked",
            "Starting float or transfer amount verified",
            "Cash counted by denomination under required custody",
            "Checks, vouchers, and other tenders separated",
            "Paid-in and paid-out records matched",
            "Voids, refunds, and overrides referenced",
            "POS expected total captured from the approved source",
            "Recount performed when the variance rule required it",
            "Deposit or next-shift float prepared and transferred",
            "Drawer status and unresolved variance handed off"
          ]
        },
        {
          "key": "checkpoint_evidence",
          "type": "table",
          "label": "Key checkpoint observation and evidence",
          "columns": [
            {
              "key": "checkpoint",
              "label": "Checkpoint",
              "units": 1.15
            },
            {
              "key": "observation",
              "label": "Observation or result",
              "units": 1.5
            },
            {
              "key": "evidence",
              "label": "Evidence or record ref.",
              "units": 1.15
            },
            {
              "key": "owner",
              "label": "Checked by",
              "units": 0.9
            }
          ],
          "rows": 3
        },
        {
          "key": "operating_boundary",
          "type": "notice",
          "label": "Operating boundary",
          "guidance": "This record supports operational reconciliation, not accounting, legal, or fraud conclusions. Do not record safe combinations, reusable credentials, full card or bank data, or unsupported accusations. During a threat, prioritize the approved emergency response and do not confront or pursue. Follow applicable cash, privacy, security, and retention policy and route judgment to the authorized reviewer."
        }
      ]
    },
    {
      "key": "conditions_evidence",
      "title": "Drawer conditions and supporting evidence",
      "guidance": "Record what was actually observed; a checked condition is a routing signal, not a conclusion.",
      "blocks": [
        {
          "key": "condition_indicators",
          "type": "checklist",
          "label": "Condition indicators reviewed",
          "items": [
            "Drawer seal, lock, or assignment mismatch",
            "Starting float differs from transfer record",
            "Cash denomination subtotal error",
            "Non-cash tender or voucher mismatch",
            "Paid-in, paid-out, void, or refund record missing",
            "POS total unavailable or business period incorrect",
            "Variance remains after authorized recount",
            "Deposit or custody transfer incomplete"
          ]
        },
        {
          "key": "observation_record",
          "type": "textarea",
          "label": "Observation, location, time, people affected, source, and evidence reference",
          "fields": [
            {
              "key": "observation_detail",
              "label": "Cash Drawer observation and evidence detail"
            }
          ],
          "height": 68
        }
      ]
    },
    {
      "key": "exceptions_decision",
      "title": "Drawer exceptions, escalation, and release decision",
      "guidance": "Give each exception an immediate action, owner, due point, escalation route, and disposition.",
      "blocks": [
        {
          "key": "exception_indicators",
          "type": "checklist",
          "label": "Exception and stop indicators",
          "items": [
            "Drawer identity or operator disputed",
            "Expected total unavailable",
            "Recount changes the variance",
            "Variance exceeds local review point",
            "Tender appears altered or requires specialist review",
            "Custody transfer cannot be completed"
          ]
        },
