              "units": 1.1
            }
          ]
        }
      ]
    },
    {
      "key": "closeout_handoff",
      "title": "Drawer outcome, closeout, and handoff",
      "guidance": "Make the final outcome, remaining limitation, next action, owner, and acceptance visible.",
      "blocks": [
        {
          "key": "handoff_controls",
          "type": "checklist",
          "label": "Drawer closeout controls",
          "items": [
            "Final denomination and tender totals recorded",
            "Expected-to-actual variance decision recorded",
            "Deposit or float package identifier linked",
            "Custody transferred to a named recipient",
            "Open investigation or research owner assigned",
            "Cash record stored in the restricted location"
