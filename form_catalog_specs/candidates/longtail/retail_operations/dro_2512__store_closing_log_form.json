              "units": 0.8
            },
            {
              "key": "period_end",
              "label": "Period end",
              "units": 0.8
            },
            {
              "key": "entry_owner",
              "label": "Primary log owner",
              "units": 1.0
            },
            {
              "key": "handoff_frequency",
              "label": "Handoff frequency",
