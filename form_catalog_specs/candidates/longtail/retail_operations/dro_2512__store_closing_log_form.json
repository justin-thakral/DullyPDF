      "title": "Closing log basis and entry rules",
      "guidance": "Use chronological entries for one operating period and preserve corrections as new entries rather than overwriting history.",
      "blocks": [
        {
          "key": "event_categories",
          "type": "checklist",
          "label": "Closing event categories",
          "items": [
            "Customer-service cutoff",
            "Final transaction or customer departure",
            "Register and deposit custody handoff",
            "Zone sweep result",
            "Equipment or utility shutdown result",
            "Key and door verification",
            "Alarm arm result",
            "Final staff departure"
          ]
        },
        {
          "key": "log_controls",
          "type": "fields",
          "label": "Log control",
          "fields": [
            {
              "key": "period_start",
