      "blocks": [
        {
          "key": "event_categories",
          "type": "checklist",
          "label": "Vendor event categories",
          "items": [
            "Intake request received",
            "Vendor identity and sponsor verified",
            "Scope or site review",
            "Required-record status update",
            "Access or data review",
            "Commercial setup reference",
            "Approval, hold, or rejection decision",
            "Renewal, suspension, or offboarding handoff"
          ]
        },
        {
          "key": "log_controls",
          "type": "fields",
          "label": "Log control",
          "fields": [
