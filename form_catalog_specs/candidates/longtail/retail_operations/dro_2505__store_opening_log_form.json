              "key": "scope_detail",
              "label": "Store Opening scope and routing context"
            }
          ],
          "height": 48
        }
      ]
    },
    {
      "key": "log_basis",
      "title": "Opening log basis and entry rules",
      "guidance": "Use chronological entries for one operating period and preserve corrections as new entries rather than overwriting history.",
      "blocks": [
        {
          "key": "event_categories",
          "type": "checklist",
          "label": "Opening event categories",
          "items": [
            "Keyholder arrival or entry",
            "Alarm disarm or access result",
            "Overnight condition observation",
            "Utility or equipment readiness result",
            "POS or network readiness result",
            "Cash custody handoff",
            "Staffing or zone release",
            "Public opening decision"
          ]
        },
        {
          "key": "log_controls",
          "type": "fields",
          "label": "Log control",
          "fields": [
            {
              "key": "period_start",
              "label": "Period start",
              "units": 0.8
            },
            {
              "key": "period_end",
              "label": "Period end",
              "units": 0.8
            },
            {
              "key": "entry_owner",
              "label": "Primary log owner",
              "units": 1.0
            },
            {
              "key": "handoff_frequency",
              "label": "Handoff frequency",
              "units": 1.0
            },
            {
              "key": "restricted_refs",
              "label": "Restricted-record route",
              "units": 1.1
            }
          ]
        },
        {
          "key": "log_boundary",
          "type": "notice",
          "label": "Logging boundary",
          "guidance": "Do not enter, confront a person, disturb suspected evidence, or open to the public when conditions exceed current authorization. Record objective observations and references only; never place alarm codes, safe combinations, or reusable credentials in this form. Follow applicable store, emergency, safety, privacy, and security policy and route judgment to the authorized reviewer."
        }
      ]
    },
    {
