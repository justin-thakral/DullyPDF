        {
          "key": "record_reference",
          "type": "fields",
          "label": "Opening record reference",
          "fields": [
            {
              "key": "record_number",
              "label": "Record number",
              "units": 0.85
            },
            {
              "key": "business_date",
              "label": "Business date",
              "units": 0.75
            },
            {
              "key": "start_time",
              "label": "Start time",
              "units": 0.65
            },
            {
              "key": "site",
              "label": "Store or site",
              "units": 1.25
            },
            {
              "key": "unit",
              "label": "Opening zone or shift",
              "units": 1.15
            }
          ]
        },
        {
          "key": "routing",
          "type": "fields",
          "label": "Owner and operating route",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by",
              "units": 1.0
