              "units": 0.95
            },
            {
              "key": "status",
              "label": "Record status",
              "units": 0.85,
              "field_type": "choice",
              "options": [
                "Draft",
                "Active",
                "Hold",
                "Review",
                "Closed"
              ]
            },
            {
              "key": "related_reference",
              "label": "Related record or ticket",
              "units": 1.1
            }
          ]
        },
        {
          "key": "record_scope",
          "type": "textarea",
          "label": "Opening event scope, trigger, affected area, and prior handoff",
          "fields": [
