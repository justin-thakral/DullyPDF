{
  "schema_version": 1,
  "catalog_id": "retail_operations/dro_2505__store_opening_log_form",
  "source_section": "retail_operations",
  "source_filename": "dro_2505__store_opening_log_form.pdf",
  "slug": "store-opening-log-form",
  "title": "Store Opening Log Form",
  "subtitle": "A practical chronological operating log for store opening that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations chronological operating log for store opening covering opening readiness, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a opening lead opens one store opening record to record chronological checkpoints, preserve corrections, escalate exceptions, summarize the period, and hand off open actions; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "record_identity",
      "title": "Opening log identity and routing",
      "guidance": "Connect this log to one location, operating period, accountable owner, and review route.",
