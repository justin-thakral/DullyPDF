{
  "schema_version": 1,
  "catalog_id": "retail_operations/dro_2561__loss_prevention_log_form",
  "source_section": "retail_operations",
  "source_filename": "dro_2561__loss_prevention_log_form.pdf",
  "slug": "loss-prevention-log-form",
  "title": "Loss Prevention Log Form",
  "subtitle": "A practical chronological operating log for loss prevention that connects identity, observations and evidence, decision authority, exception ownership, and accountable closeout.",
  "description": "An original retail-operations chronological operating log for loss prevention covering loss-prevention controls and evidence, evidence references, authorization, escalation, operating limits, disposition, and handoff without copying a third-party form.",
  "use_case": "Use when a authorized loss-prevention lead opens one loss prevention record to record chronological checkpoints, preserve corrections, escalate exceptions, summarize the period, and hand off open actions; closure requires a documented outcome, evidence route, responsible owner, and recipient acknowledgment.",
  "risk_tier": "B",
  "sections": [
    {
      "key": "record_identity",
      "title": "Loss prevention log identity and routing",
      "guidance": "Connect this log to one location, operating period, accountable owner, and review route.",
      "blocks": [
        {
          "key": "record_reference",
          "type": "fields",
          "label": "Loss prevention record reference",
          "fields": [
            {
              "key": "record_number",
              "label": "Record number",
              "units": 0.85
            },
            {
              "key": "business_date",
              "label": "Business date",
              "units": 0.75
            },
            {
              "key": "start_time",
              "label": "Start time",
              "units": 0.65
            },
            {
              "key": "site",
              "label": "Store or monitored site",
              "units": 1.25
            },
            {
              "key": "unit",
              "label": "Zone, shift, or control",
              "units": 1.15
            }
          ]
        },
        {
          "key": "routing",
          "type": "fields",
          "label": "Owner and operating route",
          "fields": [
            {
              "key": "prepared_by",
              "label": "Prepared by",
              "units": 1.0
            },
            {
              "key": "assigned_owner",
              "label": "Assigned authorized loss-prevention lead",
              "units": 1.15
            },
            {
              "key": "shift_window",
              "label": "Shift or time window",
              "units": 0.95
            },
            {
              "key": "status",
              "label": "Record status",
              "units": 0.85,
              "field_type": "choice",
              "options": [
                "Draft",
                "Active",
                "Hold",
                "Review",
                "Closed"
              ]
            },
            {
              "key": "related_reference",
              "label": "Related record or ticket",
              "units": 1.1
            }
          ]
        },
        {
          "key": "record_scope",
          "type": "textarea",
          "label": "Loss prevention event scope, trigger, affected area, and prior handoff",
          "fields": [
            {
              "key": "scope_detail",
              "label": "Loss Prevention scope and routing context"
            }
          ],
          "height": 48
        }
      ]
    },
    {
      "key": "log_basis",
      "title": "Loss prevention log basis and entry rules",
      "guidance": "Use chronological entries for one operating period and preserve corrections as new entries rather than overwriting history.",
      "blocks": [
        {
          "key": "event_categories",
          "type": "checklist",
          "label": "Loss prevention event categories",
          "items": [
            "Control or restricted-area check",
            "Key, seal, alarm, door, or device status",
            "High-value or transaction-interface observation",
            "Reported event received",
            "Objective observation recorded",
            "Restricted evidence custody action",
            "Escalation or external-contact routing",
            "Temporary control or next-shift handoff"
          ]
        },
        {
          "key": "log_controls",
          "type": "fields",
          "label": "Log control",
          "fields": [
            {
              "key": "period_start",
              "label": "Period start",
              "units": 0.8
            },
            {
              "key": "period_end",
              "label": "Period end",
              "units": 0.8
            },
            {
              "key": "entry_owner",
              "label": "Primary log owner",
              "units": 1.0
            },
            {
              "key": "handoff_frequency",
              "label": "Handoff frequency",
              "units": 1.0
            },
            {
              "key": "restricted_refs",
              "label": "Restricted-record route",
              "units": 1.1
            }
          ]
        },
        {
          "key": "log_boundary",
          "type": "notice",
          "label": "Logging boundary",
          "guidance": "This form does not authorize surveillance expansion, profiling, confrontation, pursuit, search, detention, accusation, or access to restricted evidence. Record objective facts and minimum necessary personal information. Keep footage, credentials, and sensitive evidence in approved restricted systems. Follow applicable privacy, security, legal-request, and emergency policy and route decisions to the authorized professional reviewer."
        }
      ]
    },
    {
      "key": "chronological_entries",
      "title": "Loss prevention chronological activity entries",
      "guidance": "Give each entry a time, event or checkpoint, objective result, action or decision, owner, and evidence reference.",
