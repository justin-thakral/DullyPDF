              "units": 0.75
            },
            {
              "key": "evidence",
              "label": "Evidence ref.",
              "units": 0.8
            }
          ],
          "rows": 6
        },
        {
          "key": "period_context",
          "type": "textarea",
          "label": "Operating context, unusual demand, system limits, corrections to prior entries, and known evidence gaps",
          "fields": [
            {
              "key": "context_detail",
              "label": "Loss Prevention log context and corrections"
            }
          ],
          "height": 58
        }
      ]
    },
    {
      "key": "exceptions_escalation",
