                "Proceed with limits",
                "Proceed",
                "Escalate",
                "Decline",
                "Rework"
              ]
            },
            {
              "key": "authorized_by",
              "label": "Authorized by",
              "units": 1.0
            },
            {
              "key": "authorization_time",
              "label": "Decision date and time",
              "units": 1.0
            },
            {
              "key": "policy_reference",
              "label": "Policy or approval ref.",
              "units": 1.05
