          "key": "cause_domains",
          "type": "checklist",
          "label": "Nonconformance cause domains reviewed",
          "items": [
            "Nonconformance classification, priority, or routing threshold",
            "Requirement and objective-evidence capture",
            "Lot, serial, time-range, and quantity scope method",
            "Physical segregation, labeling, and system-hold control",
            "Disposition categories and authorization limits",
            "Rework, repair, use-as-is, return, or scrap instructions",
            "Supplier, customer, engineering, or regulatory notification",
            "Reinspection, verification, and final status release",
            "Quantity reconciliation and inventory transactions",
            "Corrective-action trigger and recurring-issue review"
