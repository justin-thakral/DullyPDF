    {
      "key": "immediate_control",
      "title": "Immediate correction, containment, and scope review",
      "guidance": "Protect current and potentially affected output while evidence is preserved.",
      "blocks": [
        {
          "key": "containment_checkpoints",
          "type": "checklist",
          "label": "Containment and affected-scope checkpoints",
          "items": [
            "The unmet requirement is identified separately from the observed evidence",
            "Product, material, lot, serial, work order, and affected operation are traceable",
            "Suspect quantity and potentially affected time or serial range are defined",
            "Physical and electronic status prevents unintended use or shipment",
            "Immediate correction is distinguished from action addressing recurrence",
            "Similar product, inventory, work in process, and prior output were considered",
            "Disposition authority matches the selected use-as-is, rework, repair, return, or scrap path",
            "Rework or repair instructions preserve original condition and verification evidence"
          ]
        },
