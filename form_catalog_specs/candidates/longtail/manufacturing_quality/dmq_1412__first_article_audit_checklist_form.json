    {
      "key": "audit_execution",
      "title": "First Article control audit",
      "guidance": "Record evidence for conformity and nonconformity; do not score from unsupported impressions.",
      "blocks": [
        {
          "key": "audit_checkpoints",
          "type": "checklist",
          "label": "Audit checkpoints",
          "items": [
            "The first article trigger and required scope are documented",
            "The inspected article matches the intended production configuration",
            "Current design data and planning revisions are identified",
            "All characteristics are accounted for without unexplained gaps",
            "Actual results and evidence references support conformity decisions",
            "Materials and special processes remain traceable to the article",
            "Inspection equipment was suitable and current when used",
            "Nonconformities and deviations have authorized disposition",
            "Approval conditions are reflected in production controls",
            "Partial or delta scope clearly identifies unchanged prior evidence",
            "Customer or contractual approval is retained when required",
            "A retrievable baseline supports later configuration changes"
          ]
        },
