  "slug": "first-article-audit-checklist-form",
  "title": "First Article Audit Checklist Form",
  "subtitle": "Set the first article audit criteria and sample, test objective evidence, write precise findings, assign responses, verify follow-up, and close the audit.",
  "description": "An evidence-led first article audit checklist form for evaluating whether the first article build and inspection is implemented and maintained, with explicit criteria, traceable samples, conformity evidence, requirement-based findings, response ownership, and verification.",
  "use_case": "Use for a scheduled, follow-up, triggered, or layered audit of the first article build and inspection when conclusions must remain bounded to a documented population and evidence sample.",
  "risk_tier": "A",
