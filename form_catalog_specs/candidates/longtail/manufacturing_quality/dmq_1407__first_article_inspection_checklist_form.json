  "slug": "first-article-inspection-checklist-form",
  "title": "First Article Inspection Checklist Form",
  "subtitle": "Route the first article build and inspection, verify readiness, record requirement-level results, contain exceptions, authorize status, and preserve accountable closeout.",
  "description": "An operational first article inspection checklist form for controlling a first production-representative article from assignment through evidence-based inspection, exception containment, disposition, handoff, and final verification.",
  "use_case": "Use when a first article inspector must inspect a first production-representative article against the drawing, specification, purchase order, and approved process configuration and provide a traceable basis to approve, conditionally approve, or disapprove the first article before production.",
  "risk_tier": "A",
  "sections": [
