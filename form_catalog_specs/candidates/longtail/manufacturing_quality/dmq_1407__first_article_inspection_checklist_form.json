    {
      "key": "basis_and_readiness",
      "title": "Acceptance basis and inspection readiness",
      "guidance": "Confirm the current drawing, specification, purchase order, and approved process configuration and the evidence needed to inspect.",
      "blocks": [
        {
          "key": "document_control",
          "type": "fields",
          "label": "Controlled reference set",
          "fields": [
            {
              "key": "primary_reference",
              "label": "Controlling inspection references",
              "units": 1.4
            },
            {
              "key": "reference_revision",
              "label": "Reference revision",
              "units": 0.65
            },
            {
              "key": "acceptance_plan",
              "label": "Acceptance or sampling plan",
              "units": 1.05
            },
            {
              "key": "plan_revision",
              "label": "Plan revision",
              "units": 0.6
            },
            {
              "key": "evidence_folder",
              "label": "Evidence folder or link",
              "units": 1.0
            }
          ]
        },
        {
          "key": "readiness_checkpoints",
          "type": "checklist",
          "label": "Pre-inspection readiness checkpoints",
          "items": [
            "Article was produced at the intended production site and line",
            "Part number, revision, drawing, model, and specification are aligned",
            "Production-representative material, tooling, equipment, and methods were used",
            "Raw material and purchased-component traceability is available",
            "Special-process or outside-service evidence is linked to the article",
            "Every required characteristic has an accountable result or valid not-applicable basis",
            "Variable characteristics include actual values rather than pass-only entries",
            "Functional, performance, fit, or interface checks are complete where specified"
          ]
        },
        {
          "key": "evidence_available",
          "type": "checklist",
          "label": "Available evidence package",
          "items": [
            "Ballooned drawing, model, or characteristic accountability list",
            "Material certificate and purchased-component traceability",
            "Special-process or outside-service certificate",
            "Inspection report with actual variable results",
            "Functional, fit, or performance test result",
            "Tooling, fixture, program, and machine configuration reference",
            "Approved deviation or engineering clarification",
            "First article photographs, sample location, or retention reference"
          ]
        }
      ]
    },
    {
      "key": "inspection_execution",
      "title": "First Article inspection execution",
      "guidance": "Record actual observations and results against identifiable requirements.",
      "blocks": [
        {
          "key": "measurement_results",
          "type": "table",
          "label": "First article characteristic accountability",
          "columns": [
            {
              "key": "characteristic_ref",
              "label": "Characteristic / ref.",
              "units": 1.0
            },
            {
              "key": "nominal_tolerance",
