    {
      "key": "audit_execution",
      "title": "Nonconformance control audit",
      "guidance": "Record evidence for conformity and nonconformity; do not score from unsupported impressions.",
      "blocks": [
        {
          "key": "audit_checkpoints",
          "type": "checklist",
          "label": "Audit checkpoints",
          "items": [
            "Each record states the requirement, evidence, and precise nonconformance",
            "Product and process traceability supports a defensible affected scope",
            "Containment status prevents unintended processing or shipment",
            "Similar and previously produced items receive documented extent review",
            "Disposition authority and rationale match the selected path",
            "Use-as-is or repair decisions identify applicable approval requirements",
            "Rework instructions and verification results remain linked",
            "Supplier and customer communication is retained when required",
            "Disposition quantities reconcile to the suspected quantity",
            "Recurring issues are evaluated for corrective action",
            "Final release is separated from initial discovery and containment",
            "Closure preserves limitations, evidence, dates, owners, and review"
          ]
        },
