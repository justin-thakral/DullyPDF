        {
          "key": "result_controls",
          "type": "checklist",
          "label": "Result interpretation controls",
          "items": [
            "Production-representative material, tooling, equipment, and methods were used",
            "Raw material and purchased-component traceability is available",
            "Special-process or outside-service evidence is linked to the article",
            "Every required characteristic has an accountable result or valid not-applicable basis",
            "Variable characteristics include actual values rather than pass-only entries",
            "Functional, performance, fit, or interface checks are complete where specified",
            "Deviations and drawing ambiguities are resolved before approval",
            "Inspection media, programs, and gauges match the characteristic and revision"
          ]
        }
      ]
    },
    {
      "key": "findings_analysis",
      "title": "Findings, patterns, and escalation",
      "guidance": "Separate facts from interpretation and route significant or recurring exceptions.",
      "blocks": [
        {
          "key": "report_exception_types",
          "type": "checklist",
          "label": "First Article exceptions requiring action",
          "items": [
            "Design, drawing, model, or specification revision conflict",
            "Production-representative site, process, equipment, or tooling not used",
            "Characteristic missing from the accountability record",
            "Actual result outside requirement or tolerance",
            "Material, component, or special-process traceability gap",
            "Test method, gage capability, or calibration status unsuitable",
            "Unapproved deviation, repair, rework, or configuration difference",
            "Production started beyond an explicitly authorized limited quantity"
          ],
          "guidance": "Select every applicable exception and preserve the original observation."
        },
