          "key": "finding_escalation",
          "type": "checklist",
          "label": "Finding and escalation controls",
          "items": [
            "Required check missed, late, incomplete, or recorded against the wrong lot",
            "Process parameter outside the approved operating window",
            "Characteristic result outside limit or trending toward a limit",
            "Gage status expired, damaged, unsuitable, or unavailable",
            "Material, tooling, program, or revision identity mismatch",
            "Defective output not immediately contained or identified",
            "Adjustment made without recording before-and-after evidence",
            "Shift handoff omitted the last accepted unit or next check due"
          ]
