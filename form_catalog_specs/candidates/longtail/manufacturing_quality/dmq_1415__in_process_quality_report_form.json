    {
      "key": "population_evidence",
      "title": "Population, source records, and data integrity",
      "guidance": "Reconcile source data to the in-process inspection and control check population before summarizing.",
      "blocks": [
        {
          "key": "source_record_reconciliation",
          "type": "table",
          "label": "Source-record reconciliation",
          "columns": [
            {
              "key": "source_record",
              "label": "Source record / system",
              "units": 1.2
            },
            {
              "key": "population",
              "label": "Population",
              "units": 0.85
            },
            {
              "key": "reviewed",
              "label": "Reviewed count",
              "units": 0.7
            },
            {
              "key": "excluded",
              "label": "Excluded count",
              "units": 0.65
            },
            {
              "key": "reason",
              "label": "Exclusion / gap",
              "units": 1.0
            },
            {
              "key": "owner",
              "label": "Data owner",
              "units": 0.7
            }
          ],
          "rows": 6
        },
        {
          "key": "data_integrity_checks",
          "type": "checklist",
          "label": "Data completeness and traceability checks",
          "items": [
            "The active routing and control plan match the work order revision",
            "First-piece and restart approvals can be traced to production start",
            "Sampling times or quantities satisfy the documented frequency",
            "Actual results identify the measured unit and equipment used",
            "Operators preserve original observations after adjustments",
            "Drift and defect signals lead to timely containment",
            "Affected product range is defined from the last known acceptable check",
            "Reinspection scope and results support restart authorization",
            "Nonconformance records are linked when limits are exceeded",
            "Automated data gaps or alarms have documented review"
          ]
        },
        {
          "key": "data_limitations",
          "type": "textarea",
          "label": "Missing data, sampling assumptions, system limitations, and effect on conclusions",
          "fields": [
            {
              "key": "limitations_detail",
              "label": "Data limitations and qualification"
            }
          ],
          "height": 50
        }
      ]
    },
