            {
              "key": "status",
              "label": "Status",
              "units": 0.55
            }
          ],
          "rows": 6
        },
        {
          "key": "result_controls",
          "type": "checklist",
          "label": "Result interpretation controls",
          "items": [
            "Material lot and work-in-process identity remain traceable",
            "First-piece or restart approval is present before routine production",
            "Specified sample size and inspection frequency are being followed",
            "Process parameters are within the documented operating window",
            "Measurement equipment status and resolution are suitable",
            "Actual readings are recorded at the required time or quantity interval",
            "Defects and trends are separated from conforming work immediately",
            "Rework or adjustment does not erase the original observation"
          ]
        }
      ]
    },
    {
      "key": "findings_analysis",
      "title": "Findings, patterns, and escalation",
      "guidance": "Separate facts from interpretation and route significant or recurring exceptions.",
      "blocks": [
        {
          "key": "report_exception_types",
          "type": "checklist",
          "label": "In-Process Quality exceptions requiring action",
          "items": [
            "Required check missed, late, incomplete, or recorded against the wrong lot",
            "Process parameter outside the approved operating window",
            "Characteristic result outside limit or trending toward a limit",
            "Gage status expired, damaged, unsuitable, or unavailable",
            "Material, tooling, program, or revision identity mismatch",
            "Defective output not immediately contained or identified",
            "Adjustment made without recording before-and-after evidence",
            "Shift handoff omitted the last accepted unit or next check due"
          ],
          "guidance": "Select every applicable exception and preserve the original observation."
        },
        {
          "key": "report_exception_log",
          "type": "table",
          "label": "Exception, containment, ownership, and disposition log",
