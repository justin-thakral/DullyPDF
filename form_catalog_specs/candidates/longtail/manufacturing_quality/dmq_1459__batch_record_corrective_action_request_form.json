          "key": "implementation_controls",
          "type": "checklist",
          "label": "Implementation and communication controls",
          "items": [
            "Record in-process samples, tests, calculations, yields, and reconciliation",
            "Document deviations, alarms, interruptions, and atypical results when observed",
            "Complete packaging, labeling, count, and material reconciliation",
            "Review completeness and resolve open deviations or investigations",
            "Approve batch disposition and archive the complete linked record",
            "Document, procedure, software, tooling, or system changes are controlled",
            "Affected personnel receive the approved change before independent work",
            "Implementation evidence shows the action was completed as approved",
            "Temporary controls have an owner and defined removal condition"
          ]
