      "title": "Corrective action plan and controlled implementation",
      "guidance": "Map each action to an evidence-supported cause and retain proof of implementation.",
      "blocks": [
        {
          "key": "corrective_action_plan",
          "type": "table",
          "label": "Cause-to-action implementation plan",
