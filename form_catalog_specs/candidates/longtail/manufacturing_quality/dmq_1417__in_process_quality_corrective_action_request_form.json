        {
          "key": "implementation_controls",
          "type": "checklist",
          "label": "Implementation and communication controls",
          "items": [
            "Record characteristic results and process parameter readings",
            "Recognize drift, defect patterns, missed checks, or out-of-control signals",
            "Stop or contain affected work and identify the suspected range",
            "Authorize adjustment, reinspection, and controlled restart",
            "Hand off the last accepted unit and next inspection due point",
            "Document, procedure, software, tooling, or system changes are controlled",
            "Affected personnel receive the approved change before independent work",
            "Implementation evidence shows the action was completed as approved",
            "Temporary controls have an owner and defined removal condition"
          ]
        },
        {
          "key": "implementation_limits",
