          "key": "cause_domains",
          "type": "checklist",
          "label": "In-Process Quality cause domains reviewed",
          "items": [
            "Work instruction, routing, control plan, or product revision",
            "Sampling size, frequency, location, or automated collection point",
            "Characteristic, process parameter, limit, or reaction plan",
            "Machine, tool, fixture, program, or process sequence",
            "Measurement method, instrument, resolution, or data system",
            "First-piece, restart, adjustment, or reinspection authorization",
            "Defect containment range and material status transaction",
            "Operator or inspector responsibility and shift handoff",
            "Downstream acceptance or release decision",
            "Open work orders, held material, and partially processed quantity"
          ]
        },
