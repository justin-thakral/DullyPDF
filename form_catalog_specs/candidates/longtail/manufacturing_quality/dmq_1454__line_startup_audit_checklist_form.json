    {
      "key": "audit_execution",
      "title": "Line Startup control audit",
      "guidance": "Record evidence for conformity and nonconformity; do not score from unsupported impressions.",
      "blocks": [
        {
          "key": "audit_checkpoints",
          "type": "checklist",
          "label": "Audit checkpoints",
          "items": [
            "Line-clearance evidence identifies the prior product and removed materials",
            "Active work orders, recipes, programs, and setup revisions agree",
            "Cleaning, maintenance, and changeover status is complete before startup",
            "Materials, labels, tooling, and measurement devices match the new job",
            "Safety-control readiness is checked under current site procedures",
            "Actual settings and independently verified values are retained",
            "First-piece or trial output supports the release decision",
            "Startup scrap and unreleased output remain segregated",
            "Deviations and unresolved readiness conditions prevent release",
            "First accepted unit and next required check are identifiable",
            "Crew handoff includes released settings and operating restrictions",
            "Startup records reconcile to production start time and quantities"
          ]
        },
