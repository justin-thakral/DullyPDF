    {
      "key": "audit_execution",
      "title": "Incoming Material control audit",
      "guidance": "Record evidence for conformity and nonconformity; do not score from unsupported impressions.",
      "blocks": [
        {
          "key": "audit_checkpoints",
          "type": "checklist",
          "label": "Audit checkpoints",
          "items": [
            "Pending receipts are physically and electronically identifiable",
            "Inspectors use the purchasing and material revisions in effect at receipt",
            "Sampling records identify population, method, sample size, and sample IDs",
            "Measurement equipment status is current at the time of use",
            "Acceptance results preserve both the requirement and the observed evidence",
            "Nonconforming receipts remain segregated until authorized disposition",
            "Supplier notifications and responses are linked to the receipt record",
            "Accepted quantities reconcile to inventory put-away transactions",
            "Conditional acceptance includes limits, owner, and expiration",
            "Retained samples and certificates can be retrieved by supplier lot",
            "Storage requirements are transferred with the material status",
            "Completed records show independent review where required by site procedure"
          ]
        },
