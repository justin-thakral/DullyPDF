  "slug": "incoming-material-audit-checklist-form",
  "title": "Incoming Material Audit Checklist Form",
  "subtitle": "Set the incoming material audit criteria and sample, test objective evidence, write precise findings, assign responses, verify follow-up, and close the audit.",
  "description": "An evidence-led incoming material audit checklist form for evaluating whether the supplier receipt inspection is implemented and maintained, with explicit criteria, traceable samples, conformity evidence, requirement-based findings, response ownership, and verification.",
  "use_case": "Use for a scheduled, follow-up, triggered, or layered audit of the supplier receipt inspection when conclusions must remain bounded to a documented population and evidence sample.",
  "risk_tier": "A",
