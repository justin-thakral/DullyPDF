    {
      "key": "basis_and_readiness",
      "title": "Acceptance basis and inspection readiness",
      "guidance": "Confirm the current work instruction, control plan, routing step, and product requirement and the evidence needed to inspect.",
      "blocks": [
        {
          "key": "document_control",
          "type": "fields",
          "label": "Controlled reference set",
          "fields": [
            {
              "key": "primary_reference",
              "label": "Controlling inspection references",
              "units": 1.4
            },
            {
              "key": "reference_revision",
              "label": "Reference revision",
              "units": 0.65
            },
            {
              "key": "acceptance_plan",
              "label": "Acceptance or sampling plan",
              "units": 1.05
            },
            {
              "key": "plan_revision",
              "label": "Plan revision",
              "units": 0.6
            },
            {
              "key": "evidence_folder",
              "label": "Evidence folder or link",
              "units": 1.0
            }
          ]
        },
        {
          "key": "readiness_checkpoints",
          "type": "checklist",
          "label": "Pre-inspection readiness checkpoints",
          "items": [
            "Work instruction, routing, and control plan revisions match the job",
            "Line, machine, tooling, and process program match the operation",
            "Material lot and work-in-process identity remain traceable",
            "First-piece or restart approval is present before routine production",
            "Specified sample size and inspection frequency are being followed",
            "Process parameters are within the documented operating window",
            "Measurement equipment status and resolution are suitable",
            "Actual readings are recorded at the required time or quantity interval"
          ]
        },
        {
          "key": "evidence_available",
          "type": "checklist",
          "label": "Available evidence package",
          "items": [
            "Current work instruction, routing, and control plan",
            "First-piece, setup, or restart approval reference",
            "Machine, tooling, fixture, and program revision record",
            "Time- or quantity-based sample identification",
            "Actual characteristic and process parameter readings",
            "Control chart, trend, alarm, or automated data reference",
            "Contained quantity and affected serial or time range",
            "Adjustment, reinspection, and restart authorization"
          ]
        }
      ]
    },
    {
      "key": "inspection_execution",
      "title": "In-Process Quality inspection execution",
      "guidance": "Record actual observations and results against identifiable requirements.",
      "blocks": [
        {
          "key": "measurement_results",
          "type": "table",
          "label": "In-process characteristic and parameter checks",
          "columns": [
            {
              "key": "time_unit",
              "label": "Time / unit sampled",
              "units": 0.9
            },
            {
              "key": "characteristic",
              "label": "Characteristic / parameter",
              "units": 1.15
            },
            {
              "key": "requirement",
              "label": "Requirement / range",
              "units": 0.95
            },
            {
              "key": "actual_result",
              "label": "Actual result",
              "units": 0.8
            },
            {
              "key": "gage_asset",
              "label": "Gage / asset",
              "units": 0.75
            },
            {
              "key": "status",
              "label": "Status",
              "units": 0.55
            }
          ],
          "rows": 8,
          "guidance": "Record actual values where the requirement is variable; do not use pass-only entries when evidence is available."
        },
        {
          "key": "execution_controls",
          "type": "checklist",
          "label": "Execution and traceability controls",
          "items": [
            "Specified sample size and inspection frequency are being followed",
            "Process parameters are within the documented operating window",
            "Measurement equipment status and resolution are suitable",
            "Actual readings are recorded at the required time or quantity interval",
            "Defects and trends are separated from conforming work immediately",
            "Rework or adjustment does not erase the original observation",
            "Missed checks trigger documented scope and product-impact review",
            "Handoff identifies the last accepted unit and next required check"
          ]
        },
        {
          "key": "observation_summary",
          "type": "textarea",
          "label": "Inspection observations, evidence references, sample rationale, and limitations",
          "fields": [
            {
              "key": "observation_detail",
              "label": "Observed condition and evidence summary"
            }
          ],
          "height": 60
        }
      ]
    },
    {
      "key": "findings_containment",
      "title": "Findings, containment, and escalation",
      "guidance": "Make every exception visible with immediate control, ownership, and a disposition route.",
      "blocks": [
        {
          "key": "exception_types",
          "type": "checklist",
          "label": "In-Process Quality exceptions requiring action",
          "items": [
            "Required check missed, late, incomplete, or recorded against the wrong lot",
            "Process parameter outside the approved operating window",
            "Characteristic result outside limit or trending toward a limit",
            "Gage status expired, damaged, unsuitable, or unavailable",
            "Material, tooling, program, or revision identity mismatch",
            "Defective output not immediately contained or identified",
            "Adjustment made without recording before-and-after evidence",
            "Shift handoff omitted the last accepted unit or next check due"
          ],
          "guidance": "Select every applicable exception and preserve the original observation."
        },
        {
          "key": "exception_log",
          "type": "table",
          "label": "Exception, containment, ownership, and disposition log",
          "columns": [
            {
              "key": "exception_evidence",
