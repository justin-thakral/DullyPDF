  "slug": "in-process-quality-inspection-checklist-form",
  "title": "In-Process Quality Inspection Checklist Form",
  "subtitle": "Route the in-process inspection and control check, verify readiness, record requirement-level results, contain exceptions, authorize status, and preserve accountable closeout.",
  "description": "An operational in-process quality inspection checklist form for controlling a work-in-process lot or serial range from assignment through evidence-based inspection, exception containment, disposition, handoff, and final verification.",
  "use_case": "Use when a in-process inspector or operator must inspect a work-in-process lot or serial range against the work instruction, control plan, routing step, and product requirement and provide a traceable basis to continue, adjust, contain, stop, or authorize restart of the operation.",
  "risk_tier": "A",
