        {
          "key": "execution_stages",
          "type": "checklist",
          "label": "Required execution stages",
          "items": [
            "Identify the specific unmet requirement and objective evidence",
            "Trace the affected item, operation, lot, serial, and quantity",
            "Stop, segregate, label, and system-hold suspect product",
            "Determine scope across work in process, inventory, and prior output",
            "Route technical review and authorized disposition",
            "Execute rework, repair, return, use-as-is, or scrap instructions",
            "Verify disposition results and reconcile every affected quantity",
            "Release status, link corrective action if needed, and close the record"
          ]
        }
      ]
    },
