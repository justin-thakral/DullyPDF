              "units": 0.65
            },
            {
              "key": "due",
              "label": "Due",
              "units": 0.55
            },
            {
              "key": "change_record",
              "label": "Change / evidence ref.",
              "units": 0.9
            },
            {
              "key": "status",
              "label": "Status",
              "units": 0.55
            }
          ],
          "rows": 8
        },
        {
          "key": "implementation_controls",
          "type": "checklist",
          "label": "Implementation and communication controls",
          "items": [
            "Preserve as-found readings at required test points before adjustment",
            "Adjust or repair only under authorized instruction and identify the action",
            "Record as-left results, acceptance status, and supporting certificate",
            "Assess prior measurement impact when an as-found result is out of tolerance",
            "Update label, register, restrictions, next due date, and return-to-service status",
            "Document, procedure, software, tooling, or system changes are controlled",
            "Affected personnel receive the approved change before independent work",
            "Implementation evidence shows the action was completed as approved",
            "Temporary controls have an owner and defined removal condition"
          ]
        },
        {
          "key": "implementation_limits",
          "type": "textarea",
          "label": "Resource dependency, implementation risk, temporary control, adverse effect, and unresolved action",
          "fields": [
