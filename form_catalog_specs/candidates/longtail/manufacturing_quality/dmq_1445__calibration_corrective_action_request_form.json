          "rows": 7
        },
        {
          "key": "cause_domains",
          "type": "checklist",
          "label": "Calibration cause domains reviewed",
          "items": [
            "Asset identification, ownership, location, or intended use",
            "Calibration interval, due-date rule, or recall method",
            "Procedure, function, range, test point, or acceptance limit",
            "Reference standard, calibration chain, or certificate requirement",
            "Environmental condition and stabilization control",
            "As-found, adjustment, repair, and as-left data capture",
            "Measurement uncertainty or decision-rule review",
            "Out-of-tolerance impact assessment and affected-result search",
            "Status label, register, restriction, and return-to-service authority",
            "Existing assets, open work, and previously accepted product"
          ]
        },
