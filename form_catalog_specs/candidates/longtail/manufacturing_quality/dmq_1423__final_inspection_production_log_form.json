        {
          "key": "execution_stages",
          "type": "checklist",
          "label": "Required execution stages",
          "items": [
            "Verify order, product revision, lot, serial range, and offered quantity",
            "Confirm all required production, test, and special-process records",
            "Perform final dimensional, attribute, functional, and workmanship checks",
            "Verify marking, labeling, preservation, packaging, and documentation",
            "Reconcile accepted, rejected, rework, and held quantities",
            "Resolve open nonconformance, concession, and customer-source-inspection items",
            "Authorize final product status and shipment release",
            "Transfer restrictions, certificates, and open follow-up to fulfillment"
          ]
        }
      ]
