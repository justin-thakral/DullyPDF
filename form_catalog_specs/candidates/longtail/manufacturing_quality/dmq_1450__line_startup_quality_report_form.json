      "key": "population_evidence",
      "title": "Population, source records, and data integrity",
      "guidance": "Reconcile source data to the production line clearance, setup, and controlled release population before summarizing.",
      "blocks": [
        {
          "key": "source_record_reconciliation",
          "type": "table",
          "label": "Source-record reconciliation",
          "columns": [
            {
              "key": "source_record",
              "label": "Source record / system",
              "units": 1.2
            },
            {
              "key": "population",
              "label": "Population",
              "units": 0.85
