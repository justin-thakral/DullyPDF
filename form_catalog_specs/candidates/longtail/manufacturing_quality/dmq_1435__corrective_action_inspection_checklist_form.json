            {
              "key": "reference_revision",
              "label": "Reference revision",
              "units": 0.65
            },
            {
              "key": "acceptance_plan",
              "label": "Acceptance or sampling plan",
              "units": 1.05
            },
            {
              "key": "plan_revision",
              "label": "Plan revision",
              "units": 0.6
