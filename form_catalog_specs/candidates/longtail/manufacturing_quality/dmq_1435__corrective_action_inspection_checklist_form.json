            {
              "key": "evidence_folder",
              "label": "Evidence folder or link",
              "units": 1.0
            }
          ]
        },
        {
          "key": "readiness_checkpoints",
          "type": "checklist",
          "label": "Pre-inspection readiness checkpoints",
          "items": [
            "The problem statement names the requirement, evidence, location, timing, and extent",
            "Immediate correction and containment are complete or actively owned",
            "Affected and similar processes, products, suppliers, and prior periods were reviewed",
            "Cause analysis distinguishes direct, contributing, detection, and systemic causes",
            "Selected causes are supported by evidence rather than assumption",
            "Actions address verified causes and prevent recurrence or occurrence elsewhere",
            "Each action has an owner, due date, completion evidence, and status",
            "Procedure, training, tooling, system, supplier, and measurement impacts are considered"
          ]
        },
        {
          "key": "evidence_available",
          "type": "checklist",
          "label": "Available evidence package",
          "items": [
            "Source audit, nonconformance, complaint, trend, or process record",
            "Specific requirement and objective problem evidence",
            "Containment completion and affected-scope review",
            "Cause-analysis method, contributors, tests, and supporting data",
            "Action plan, owner, due date, and implementation evidence",
            "Updated procedure, training, tooling, software, or supplier control",
            "Effectiveness baseline, target, sample, period, and observed result",
            "Independent review, residual risk, closure, or reopen decision"
          ]
        }
      ]
    },
