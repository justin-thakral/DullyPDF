        {
          "key": "execution_stages",
          "type": "checklist",
          "label": "Required execution stages",
          "items": [
            "Freeze the production-representative design and planning revision",
            "Verify material, purchased components, and source traceability",
            "Record machine, tooling, fixture, program, and process configuration",
            "Account for drawing, model, specification, and note characteristics",
            "Complete dimensional, visual, functional, and special-process evidence",
            "Resolve missing evidence, nonconformities, and authorized deviations",
            "Obtain required technical, quality, or customer approval",
            "Transfer approval status and restrictions to production planning"
          ]
        }
      ]
    },
