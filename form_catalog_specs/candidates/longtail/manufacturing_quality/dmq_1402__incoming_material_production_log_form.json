        {
          "key": "execution_stages",
          "type": "checklist",
          "label": "Required execution stages",
          "items": [
            "Unload and segregate pending-inspection material",
            "Match purchase order, packing slip, labels, and lot identity",
            "Inspect packaging, seals, condition, quantity, and shelf life",
            "Select and identify samples under the current sampling instruction",
            "Perform required dimensional, physical, or certificate checks",
            "Record discrepancy containment and notify the supplier owner",
            "Apply accepted, quarantined, or rejected status identification",
            "Transfer material to the authorized storage or return location"
          ]
        }
      ]
