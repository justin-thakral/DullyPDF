    {
      "key": "audit_execution",
      "title": "Calibration control audit",
      "guidance": "Record evidence for conformity and nonconformity; do not score from unsupported impressions.",
      "blocks": [
        {
          "key": "audit_checkpoints",
          "type": "checklist",
          "label": "Audit checkpoints",
          "items": [
            "The asset register uniquely identifies each controlled measuring device",
            "Calibration intervals have documented basis and due status is visible",
            "Procedures match equipment function, range, resolution, and intended use",
            "Reference standards are suitable and supported by retrievable chain records",
            "Environmental conditions and stabilization are recorded when relevant",
            "As-found data is retained before adjustment or repair",
            "Test-point results show reference, indication, error, tolerance, and status",
            "Out-of-tolerance results lead to prior-measurement impact review",
            "As-left status and restrictions support the return-to-service decision",
            "Labels and electronic register status remain consistent",
            "Lost, damaged, overdue, or inactive assets receive controlled disposition",
            "Certificates and technical review can be retrieved for each service event"
          ]
        },
