    },
    {
      "key": "basis_and_readiness",
      "title": "Acceptance basis and inspection readiness",
      "guidance": "Confirm the current purchase order, material specification, and sampling instruction and the evidence needed to inspect.",
      "blocks": [
        {
          "key": "document_control",
          "type": "fields",
          "label": "Controlled reference set",
          "fields": [
            {
              "key": "primary_reference",
              "label": "Controlling inspection references",
              "units": 1.4
            },
            {
              "key": "reference_revision",
              "label": "Reference revision",
              "units": 0.65
            },
            {
              "key": "acceptance_plan",
              "label": "Acceptance or sampling plan",
              "units": 1.05
            },
            {
              "key": "plan_revision",
              "label": "Plan revision",
              "units": 0.6
            },
            {
              "key": "evidence_folder",
              "label": "Evidence folder or link",
              "units": 1.0
            }
          ]
        },
        {
          "key": "readiness_checkpoints",
          "type": "checklist",
          "label": "Pre-inspection readiness checkpoints",
          "items": [
            "Supplier identity matches the approved purchasing source",
            "Purchase order item, revision, and quantity match the shipment",
            "Container labels match the packing documentation and supplier lot",
            "Seals and tamper-evident features are intact where specified",
            "Packaging is free of damage, moisture, contamination, or infestation",
            "Shelf-life or expiration information leaves the required usable life",
            "Required certificate of analysis or conformance is present and legible",
            "Storage temperature or handling condition remained within the stated range"
          ]
        },
        {
          "key": "evidence_available",
          "type": "checklist",
          "label": "Available evidence package",
          "items": [
            "Purchase order and current material specification",
            "Packing slip, advance ship notice, or carrier record",
            "Supplier certificate of analysis or conformance",
            "Container, label, damage, or seal photographs",
            "Sampling instruction and identified retained-sample record",
            "Measurement data or laboratory result reference",
            "Quarantine or rejection tag and segregated-location reference",
            "Supplier notification, return authorization, or concession record"
          ]
        }
      ]
    },
    {
      "key": "inspection_execution",
      "title": "Incoming Material inspection execution",
      "guidance": "Record actual observations and results against identifiable requirements.",
      "blocks": [
        {
          "key": "measurement_results",
          "type": "table",
          "label": "Material characteristic and sample results",
          "columns": [
            {
              "key": "characteristic_sample",
              "label": "Characteristic / sample",
              "units": 1.15
            },
            {
              "key": "requirement",
              "label": "Requirement / limit",
              "units": 1.0
            },
            {
              "key": "method_instrument",
              "label": "Method / instrument",
              "units": 1.0
            },
            {
              "key": "observed_result",
              "label": "Observed result",
              "units": 0.9
            },
            {
              "key": "units",
              "label": "Units",
              "units": 0.45
            },
            {
              "key": "status",
              "label": "Accept / reject",
              "units": 0.7
            }
          ],
          "rows": 8,
          "guidance": "Record actual values where the requirement is variable; do not use pass-only entries when evidence is available."
        },
        {
          "key": "execution_controls",
          "type": "checklist",
          "label": "Execution and traceability controls",
          "items": [
            "Packaging is free of damage, moisture, contamination, or infestation",
            "Shelf-life or expiration information leaves the required usable life",
            "Required certificate of analysis or conformance is present and legible",
            "Storage temperature or handling condition remained within the stated range",
            "Sampling instruction and sample quantity are current for this material",
            "Uninspected material is segregated and marked pending disposition",
            "Country of origin or traceability information is present when required",
            "Received count, weight, or length agrees with the documented quantity"
          ]
        },
        {
          "key": "observation_summary",
          "type": "textarea",
          "label": "Inspection observations, evidence references, sample rationale, and limitations",
          "fields": [
            {
              "key": "observation_detail",
              "label": "Observed condition and evidence summary"
            }
          ],
          "height": 60
        }
      ]
    },
    {
      "key": "findings_containment",
      "title": "Findings, containment, and escalation",
      "guidance": "Make every exception visible with immediate control, ownership, and a disposition route.",
      "blocks": [
        {
          "key": "exception_types",
          "type": "checklist",
          "label": "Incoming Material exceptions requiring action",
          "items": [
            "Material or supplier identity mismatch",
            "Missing, illegible, or inconsistent certificate",
            "Damaged, wet, open, contaminated, or compromised packaging",
            "Quantity, weight, count, or unit-of-measure discrepancy",
            "Shelf-life, temperature, or controlled-storage exception",
            "Failed dimensional, physical, chemical, or visual requirement",
            "Mixed supplier lots or untraceable containers",
            "Required sampling or test could not be completed"
          ],
          "guidance": "Select every applicable exception and preserve the original observation."
        },
        {
          "key": "exception_log",
          "type": "table",
          "label": "Exception, containment, ownership, and disposition log",
          "columns": [
            {
              "key": "exception_evidence",
              "label": "Exception / evidence",
              "units": 1.2
            },
            {
              "key": "immediate_action",
              "label": "Immediate action",
              "units": 1.0
            },
            {
              "key": "owner",
              "label": "Owner",
              "units": 0.65
            },
            {
              "key": "due_point",
              "label": "Due date / point",
              "units": 0.7
            },
            {
              "key": "escalation",
              "label": "Escalation / record",
              "units": 0.85
            },
            {
              "key": "disposition",
              "label": "Final disposition",
              "units": 0.85
            }
          ],
          "rows": 6
        },
        {
