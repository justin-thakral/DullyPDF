{
  "schema_version": 1,
  "catalog_id": "manufacturing_quality/dmq_1400__incoming_material_inspection_checklist_form",
  "source_section": "manufacturing_quality",
  "source_filename": "dmq_1400__incoming_material_inspection_checklist_form.pdf",
  "slug": "incoming-material-inspection-checklist-form",
  "title": "Incoming Material Inspection Checklist Form",
  "subtitle": "Route the supplier receipt inspection, verify readiness, record requirement-level results, contain exceptions, authorize status, and preserve accountable closeout.",
  "description": "An operational incoming material inspection checklist form for controlling a received material lot from assignment through evidence-based inspection, exception containment, disposition, handoff, and final verification.",
  "use_case": "Use when a receiving inspector must inspect a received material lot against the purchase order, material specification, and sampling instruction and provide a traceable basis to accept, conditionally accept, quarantine, or reject the received lot.",
  "risk_tier": "A",
  "sections": [
    {
