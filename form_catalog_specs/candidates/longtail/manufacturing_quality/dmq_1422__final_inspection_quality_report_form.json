    {
      "key": "findings_analysis",
      "title": "Findings, patterns, and escalation",
      "guidance": "Separate facts from interpretation and route significant or recurring exceptions.",
      "blocks": [
        {
          "key": "report_exception_types",
          "type": "checklist",
          "label": "Final Inspection exceptions requiring action",
          "items": [
            "Product, revision, order, lot, serial, or quantity mismatch",
            "Required production, test, or special-process record missing",
            "Final characteristic, function, workmanship, or cleanliness failure",
            "Marking, labeling, date code, serial, or certificate error",
            "Packaging, preservation, count, or shipping configuration mismatch",
            "Open nonconformance, rework, deviation, or concession",
            "Accepted and rejected quantities do not reconcile",
            "Product staged or shipped before documented release"
          ],
          "guidance": "Select every applicable exception and preserve the original observation."
        },
