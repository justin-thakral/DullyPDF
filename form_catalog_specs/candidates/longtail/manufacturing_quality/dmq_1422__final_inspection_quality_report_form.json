  "slug": "final-inspection-quality-report-form",
  "title": "Final Inspection Quality Report Form",
  "subtitle": "Reconcile the finished-product inspection and release review population, summarize evidence and trends, separate limitations from conclusions, assign decisions, and track follow-up.",
  "description": "A decision-ready final inspection quality report form that turns source records for a finished lot, order, or serial range into reconciled measures, exception patterns, qualified conclusions, owned actions, and a retrievable reporting package.",
  "use_case": "Use when the quality release or shipment authorization owner needs a bounded quality report for the finished-product inspection and release review rather than a raw inspection checklist or chronological log.",
  "risk_tier": "A",
