          "key": "result_controls",
          "type": "checklist",
          "label": "Result interpretation controls",
          "items": [
            "Final dimensions, attributes, and functional checks meet the acceptance plan",
            "Appearance, workmanship, cleanliness, and preservation are acceptable",
            "Labels, markings, serials, and date or lot codes are accurate and legible",
            "Packaging materials, count, protection, and configuration match requirements",
            "Required certificates, manuals, reports, or customer documents are included",
            "Nonconformities, rework, deviations, and concessions have final disposition",
            "Accepted, rejected, and held quantities reconcile to the offered quantity",
            "Shipment staging prevents mix, damage, substitution, or premature release"
          ]
        }
      ]
