              "key": "reviewed",
              "label": "Reviewed count",
              "units": 0.7
            },
            {
              "key": "excluded",
              "label": "Excluded count",
              "units": 0.65
            },
            {
              "key": "reason",
              "label": "Exclusion / gap",
              "units": 1.0
            },
