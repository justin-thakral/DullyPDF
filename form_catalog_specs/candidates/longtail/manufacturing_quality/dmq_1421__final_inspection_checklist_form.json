    {
      "key": "basis_and_readiness",
      "title": "Acceptance basis and inspection readiness",
      "guidance": "Confirm the current customer order, product specification, inspection plan, and packaging requirement and the evidence needed to inspect.",
      "blocks": [
        {
          "key": "document_control",
          "type": "fields",
          "label": "Controlled reference set",
          "fields": [
            {
              "key": "primary_reference",
              "label": "Controlling inspection references",
              "units": 1.4
            },
            {
              "key": "reference_revision",
              "label": "Reference revision",
              "units": 0.65
            },
            {
              "key": "acceptance_plan",
              "label": "Acceptance or sampling plan",
              "units": 1.05
            },
            {
              "key": "plan_revision",
              "label": "Plan revision",
              "units": 0.6
            },
            {
              "key": "evidence_folder",
              "label": "Evidence folder or link",
              "units": 1.0
            }
          ]
        },
        {
          "key": "readiness_checkpoints",
          "type": "checklist",
          "label": "Pre-inspection readiness checkpoints",
          "items": [
            "Part, product, revision, order, lot, and quantity agree across records",
            "Required in-process, test, and special-process records are complete",
            "Final dimensions, attributes, and functional checks meet the acceptance plan",
            "Appearance, workmanship, cleanliness, and preservation are acceptable",
            "Labels, markings, serials, and date or lot codes are accurate and legible",
            "Packaging materials, count, protection, and configuration match requirements",
            "Required certificates, manuals, reports, or customer documents are included",
            "Nonconformities, rework, deviations, and concessions have final disposition"
          ]
        },
        {
          "key": "evidence_available",
          "type": "checklist",
          "label": "Available evidence package",
          "items": [
            "Customer order and current product or inspection specification",
            "Completed routing, traveler, or batch production record",
            "Final characteristic and functional test results",
            "Special-process, material, or supplier certificates",
            "Workmanship, marking, label, and packaging photographs",
            "Rework verification, deviation, or concession record",
            "Quantity reconciliation and final status transaction",
            "Certificate package, release record, and shipment handoff"
          ]
        }
      ]
    },
    {
      "key": "inspection_execution",
      "title": "Final Inspection inspection execution",
      "guidance": "Record actual observations and results against identifiable requirements.",
      "blocks": [
        {
          "key": "measurement_results",
          "type": "table",
          "label": "Final product acceptance results",
          "columns": [
            {
              "key": "characteristic",
              "label": "Characteristic / test",
              "units": 1.15
            },
            {
              "key": "requirement",
              "label": "Requirement / limit",
              "units": 1.0
            },
            {
              "key": "sample_serial",
              "label": "Sample / serial",
              "units": 0.8
            },
            {
              "key": "actual_result",
              "label": "Actual result",
              "units": 0.8
            },
            {
              "key": "evidence_ref",
              "label": "Evidence ref.",
              "units": 0.7
            },
            {
              "key": "status",
              "label": "Accept / reject",
              "units": 0.65
            }
          ],
          "rows": 8,
          "guidance": "Record actual values where the requirement is variable; do not use pass-only entries when evidence is available."
        },
        {
          "key": "execution_controls",
          "type": "checklist",
          "label": "Execution and traceability controls",
          "items": [
            "Labels, markings, serials, and date or lot codes are accurate and legible",
            "Packaging materials, count, protection, and configuration match requirements",
            "Required certificates, manuals, reports, or customer documents are included",
            "Nonconformities, rework, deviations, and concessions have final disposition",
            "Accepted, rejected, and held quantities reconcile to the offered quantity",
            "Shipment staging prevents mix, damage, substitution, or premature release",
            "Release authority and any customer source inspection are complete",
            "Shipping restrictions and open follow-up are visible to fulfillment"
          ]
        },
        {
          "key": "observation_summary",
          "type": "textarea",
          "label": "Inspection observations, evidence references, sample rationale, and limitations",
          "fields": [
            {
              "key": "observation_detail",
              "label": "Observed condition and evidence summary"
            }
          ],
          "height": 60
        }
      ]
    },
    {
      "key": "findings_containment",
      "title": "Findings, containment, and escalation",
      "guidance": "Make every exception visible with immediate control, ownership, and a disposition route.",
      "blocks": [
        {
          "key": "exception_types",
          "type": "checklist",
          "label": "Final Inspection exceptions requiring action",
          "items": [
            "Product, revision, order, lot, serial, or quantity mismatch",
            "Required production, test, or special-process record missing",
            "Final characteristic, function, workmanship, or cleanliness failure",
            "Marking, labeling, date code, serial, or certificate error",
            "Packaging, preservation, count, or shipping configuration mismatch",
            "Open nonconformance, rework, deviation, or concession",
            "Accepted and rejected quantities do not reconcile",
            "Product staged or shipped before documented release"
          ],
          "guidance": "Select every applicable exception and preserve the original observation."
        },
        {
          "key": "exception_log",
          "type": "table",
          "label": "Exception, containment, ownership, and disposition log",
          "columns": [
            {
              "key": "exception_evidence",
