  "source_section": "manufacturing_quality",
  "source_filename": "dmq_1421__final_inspection_checklist_form.pdf",
  "slug": "final-inspection-checklist-form",
  "title": "Final Inspection Checklist Form",
  "subtitle": "Route the finished-product inspection and release review, verify readiness, record requirement-level results, contain exceptions, authorize status, and preserve accountable closeout.",
  "description": "An operational final inspection checklist form for controlling a finished lot, order, or serial range from assignment through evidence-based inspection, exception containment, disposition, handoff, and final verification.",
  "use_case": "Use when a final inspector must inspect a finished lot, order, or serial range against the customer order, product specification, inspection plan, and packaging requirement and provide a traceable basis to accept, hold, rework, reject, or release finished product for shipment.",
  "risk_tier": "A",
  "sections": [
