    {
      "key": "population_evidence",
      "title": "Population, source records, and data integrity",
      "guidance": "Reconcile source data to the nonconforming product or process control population before summarizing.",
      "blocks": [
        {
          "key": "source_record_reconciliation",
          "type": "table",
          "label": "Source-record reconciliation",
          "columns": [
            {
              "key": "source_record",
              "label": "Source record / system",
              "units": 1.2
            },
            {
              "key": "population",
              "label": "Population",
              "units": 0.85
            },
            {
              "key": "reviewed",
              "label": "Reviewed count",
              "units": 0.7
            },
            {
              "key": "excluded",
              "label": "Excluded count",
              "units": 0.65
            },
            {
              "key": "reason",
              "label": "Exclusion / gap",
              "units": 1.0
            },
            {
              "key": "owner",
              "label": "Data owner",
              "units": 0.7
            }
          ],
          "rows": 6
        },
        {
          "key": "data_integrity_checks",
          "type": "checklist",
          "label": "Data completeness and traceability checks",
          "items": [
            "Each record states the requirement, evidence, and precise nonconformance",
            "Product and process traceability supports a defensible affected scope",
            "Containment status prevents unintended processing or shipment",
            "Similar and previously produced items receive documented extent review",
            "Disposition authority and rationale match the selected path",
            "Use-as-is or repair decisions identify applicable approval requirements",
            "Rework instructions and verification results remain linked",
            "Supplier and customer communication is retained when required",
            "Disposition quantities reconcile to the suspected quantity",
            "Recurring issues are evaluated for corrective action"
          ]
        },
        {
          "key": "data_limitations",
          "type": "textarea",
          "label": "Missing data, sampling assumptions, system limitations, and effect on conclusions",
          "fields": [
            {
              "key": "limitations_detail",
              "label": "Data limitations and qualification"
            }
          ],
          "height": 50
        }
      ]
    },
