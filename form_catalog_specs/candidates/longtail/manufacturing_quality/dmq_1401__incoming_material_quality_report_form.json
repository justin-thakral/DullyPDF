          ],
          "rows": 6
        },
        {
          "key": "result_controls",
          "type": "checklist",
          "label": "Result interpretation controls",
          "items": [
            "Container labels match the packing documentation and supplier lot",
            "Seals and tamper-evident features are intact where specified",
            "Packaging is free of damage, moisture, contamination, or infestation",
            "Shelf-life or expiration information leaves the required usable life",
            "Required certificate of analysis or conformance is present and legible",
            "Storage temperature or handling condition remained within the stated range",
            "Sampling instruction and sample quantity are current for this material",
            "Uninspected material is segregated and marked pending disposition"
          ]
        }
      ]
    },
    {
      "key": "findings_analysis",
      "title": "Findings, patterns, and escalation",
      "guidance": "Separate facts from interpretation and route significant or recurring exceptions.",
      "blocks": [
        {
          "key": "report_exception_types",
          "type": "checklist",
          "label": "Incoming Material exceptions requiring action",
          "items": [
            "Material or supplier identity mismatch",
            "Missing, illegible, or inconsistent certificate",
            "Damaged, wet, open, contaminated, or compromised packaging",
            "Quantity, weight, count, or unit-of-measure discrepancy",
            "Shelf-life, temperature, or controlled-storage exception",
            "Failed dimensional, physical, chemical, or visual requirement",
            "Mixed supplier lots or untraceable containers",
            "Required sampling or test could not be completed"
          ],
          "guidance": "Select every applicable exception and preserve the original observation."
        },
