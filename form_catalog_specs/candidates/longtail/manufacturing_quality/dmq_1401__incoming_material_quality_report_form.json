      "key": "population_evidence",
      "title": "Population, source records, and data integrity",
      "guidance": "Reconcile source data to the supplier receipt inspection population before summarizing.",
      "blocks": [
        {
          "key": "source_record_reconciliation",
          "type": "table",
          "label": "Source-record reconciliation",
          "columns": [
            {
              "key": "source_record",
              "label": "Source record / system",
              "units": 1.2
            },
            {
              "key": "population",
              "label": "Population",
              "units": 0.85
            },
            {
              "key": "reviewed",
              "label": "Reviewed count",
              "units": 0.7
            },
            {
              "key": "excluded",
              "label": "Excluded count",
              "units": 0.65
            },
            {
              "key": "reason",
              "label": "Exclusion / gap",
              "units": 1.0
            },
            {
              "key": "owner",
              "label": "Data owner",
              "units": 0.7
            }
          ],
          "rows": 6
        },
        {
          "key": "data_integrity_checks",
          "type": "checklist",
          "label": "Data completeness and traceability checks",
          "items": [
            "Pending receipts are physically and electronically identifiable",
            "Inspectors use the purchasing and material revisions in effect at receipt",
            "Sampling records identify population, method, sample size, and sample IDs",
            "Measurement equipment status is current at the time of use",
            "Acceptance results preserve both the requirement and the observed evidence",
            "Nonconforming receipts remain segregated until authorized disposition",
            "Supplier notifications and responses are linked to the receipt record",
            "Accepted quantities reconcile to inventory put-away transactions",
            "Conditional acceptance includes limits, owner, and expiration",
            "Retained samples and certificates can be retrieved by supplier lot"
          ]
        },
        {
          "key": "data_limitations",
          "type": "textarea",
          "label": "Missing data, sampling assumptions, system limitations, and effect on conclusions",
          "fields": [
            {
              "key": "limitations_detail",
              "label": "Data limitations and qualification"
            }
          ],
          "height": 50
        }
      ]
    },
