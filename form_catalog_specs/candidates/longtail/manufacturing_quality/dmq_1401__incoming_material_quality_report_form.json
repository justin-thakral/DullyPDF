  "slug": "incoming-material-quality-report-form",
  "title": "Incoming Material Quality Report Form",
  "subtitle": "Reconcile the supplier receipt inspection population, summarize evidence and trends, separate limitations from conclusions, assign decisions, and track follow-up.",
  "description": "A decision-ready incoming material quality report form that turns source records for a received material lot into reconciled measures, exception patterns, qualified conclusions, owned actions, and a retrievable reporting package.",
  "use_case": "Use when the quality or material review owner needs a bounded quality report for the supplier receipt inspection rather than a raw inspection checklist or chronological log.",
  "risk_tier": "A",
