    {
      "key": "population_evidence",
      "title": "Population, source records, and data integrity",
      "guidance": "Reconcile source data to the measurement equipment calibration and status control population before summarizing.",
      "blocks": [
        {
          "key": "source_record_reconciliation",
          "type": "table",
          "label": "Source-record reconciliation",
          "columns": [
            {
              "key": "source_record",
              "label": "Source record / system",
              "units": 1.2
            },
            {
              "key": "population",
              "label": "Population",
              "units": 0.85
            },
            {
              "key": "reviewed",
              "label": "Reviewed count",
              "units": 0.7
            },
            {
              "key": "excluded",
              "label": "Excluded count",
              "units": 0.65
            },
            {
              "key": "reason",
              "label": "Exclusion / gap",
              "units": 1.0
            },
            {
              "key": "owner",
              "label": "Data owner",
              "units": 0.7
            }
          ],
          "rows": 6
        },
        {
          "key": "data_integrity_checks",
          "type": "checklist",
          "label": "Data completeness and traceability checks",
          "items": [
            "The asset register uniquely identifies each controlled measuring device",
            "Calibration intervals have documented basis and due status is visible",
            "Procedures match equipment function, range, resolution, and intended use",
            "Reference standards are suitable and supported by retrievable chain records",
            "Environmental conditions and stabilization are recorded when relevant",
            "As-found data is retained before adjustment or repair",
            "Test-point results show reference, indication, error, tolerance, and status",
            "Out-of-tolerance results lead to prior-measurement impact review",
            "As-left status and restrictions support the return-to-service decision",
            "Labels and electronic register status remain consistent"
          ]
        },
        {
          "key": "data_limitations",
          "type": "textarea",
          "label": "Missing data, sampling assumptions, system limitations, and effect on conclusions",
          "fields": [
            {
              "key": "limitations_detail",
              "label": "Data limitations and qualification"
            }
          ],
          "height": 50
        }
      ]
    },
