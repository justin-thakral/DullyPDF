        {
          "key": "execution_stages",
          "type": "checklist",
          "label": "Required execution stages",
          "items": [
            "Verify asset identity, intended use, range, resolution, and due status",
            "Select the approved procedure and suitable in-status reference standards",
            "Record environmental conditions and initial physical or functional condition",
            "Preserve as-found readings at required test points before adjustment",
            "Adjust or repair only under authorized instruction and identify the action",
            "Record as-left results, acceptance status, and supporting certificate",
            "Assess prior measurement impact when an as-found result is out of tolerance",
            "Update label, register, restrictions, next due date, and return-to-service status"
          ]
        }
      ]
