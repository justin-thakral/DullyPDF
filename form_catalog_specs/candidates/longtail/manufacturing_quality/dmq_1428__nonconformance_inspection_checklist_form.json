              "units": 1.15
            },
            {
              "key": "extent",
              "label": "Extent / quantity",
              "units": 0.7
            },
            {
              "key": "record_ref",
              "label": "Evidence ref.",
              "units": 0.65
            },
            {
              "key": "status",
              "label": "Status",
              "units": 0.55
            }
          ],
          "rows": 8,
          "guidance": "Record actual values where the requirement is variable; do not use pass-only entries when evidence is available."
        },
        {
          "key": "execution_controls",
          "type": "checklist",
          "label": "Execution and traceability controls",
          "items": [
            "Immediate correction is distinguished from action addressing recurrence",
            "Similar product, inventory, work in process, and prior output were considered",
            "Disposition authority matches the selected use-as-is, rework, repair, return, or scrap path",
            "Rework or repair instructions preserve original condition and verification evidence",
            "Customer, supplier, engineering, or regulatory notification is routed when applicable",
            "Accepted, reworked, returned, and scrapped quantities reconcile",
            "Required reinspection or verification is complete before status release",
            "Closure records final disposition, residual limitation, and accountable reviewer"
          ]
        },
        {
          "key": "observation_summary",
          "type": "textarea",
          "label": "Inspection observations, evidence references, sample rationale, and limitations",
          "fields": [
            {
              "key": "observation_detail",
              "label": "Observed condition and evidence summary"
            }
          ],
          "height": 60
        }
      ]
    },
    {
      "key": "findings_containment",
      "title": "Findings, containment, and escalation",
      "guidance": "Make every exception visible with immediate control, ownership, and a disposition route.",
      "blocks": [
        {
          "key": "exception_types",
          "type": "checklist",
          "label": "Nonconformance exceptions requiring action",
          "items": [
            "Requirement cannot be identified or conflicts across documents",
            "Affected lot, serial, time range, or quantity cannot be bounded",
            "Suspect product may have moved, been consumed, or shipped",
            "Physical segregation and system status do not agree",
            "Disposition selected without the required technical authority",
            "Rework or repair performed without controlled instruction",
            "Verification fails or creates a new nonconformance",
            "Disposition quantities or final locations do not reconcile"
          ],
          "guidance": "Select every applicable exception and preserve the original observation."
        },
        {
          "key": "exception_log",
          "type": "table",
