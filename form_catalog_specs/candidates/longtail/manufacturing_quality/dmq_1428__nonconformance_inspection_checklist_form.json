    {
      "key": "basis_and_readiness",
      "title": "Acceptance basis and inspection readiness",
      "guidance": "Confirm the current specific requirement, objective evidence, and nonconformance procedure and the evidence needed to inspect.",
      "blocks": [
        {
          "key": "document_control",
          "type": "fields",
          "label": "Controlled reference set",
          "fields": [
            {
              "key": "primary_reference",
              "label": "Controlling inspection references",
              "units": 1.4
            },
            {
              "key": "reference_revision",
              "label": "Reference revision",
              "units": 0.65
            },
            {
              "key": "acceptance_plan",
              "label": "Acceptance or sampling plan",
              "units": 1.05
            },
            {
              "key": "plan_revision",
              "label": "Plan revision",
              "units": 0.6
            },
            {
              "key": "evidence_folder",
              "label": "Evidence folder or link",
              "units": 1.0
            }
          ]
        },
        {
          "key": "readiness_checkpoints",
          "type": "checklist",
          "label": "Pre-inspection readiness checkpoints",
          "items": [
            "The unmet requirement is identified separately from the observed evidence",
            "Product, material, lot, serial, work order, and affected operation are traceable",
            "Suspect quantity and potentially affected time or serial range are defined",
            "Physical and electronic status prevents unintended use or shipment",
            "Immediate correction is distinguished from action addressing recurrence",
            "Similar product, inventory, work in process, and prior output were considered",
            "Disposition authority matches the selected use-as-is, rework, repair, return, or scrap path",
            "Rework or repair instructions preserve original condition and verification evidence"
          ]
        },
        {
          "key": "evidence_available",
          "type": "checklist",
          "label": "Available evidence package",
          "items": [
            "Requirement, drawing, specification, procedure, or acceptance reference",
            "Objective observation, measurement, test result, or photograph",
            "Lot, serial, work order, operation, and quantity traceability",
            "Containment tag, hold transaction, and segregated-location record",
            "Extent review for similar product, inventory, and prior output",
            "Disposition rationale and required approval",
            "Rework or repair instruction and verification result",
            "Quantity reconciliation, status release, and corrective-action link"
          ]
        }
      ]
    },
    {
      "key": "inspection_execution",
      "title": "Nonconformance inspection execution",
      "guidance": "Record actual observations and results against identifiable requirements.",
      "blocks": [
        {
          "key": "measurement_results",
          "type": "table",
          "label": "Nonconforming requirement and evidence detail",
          "columns": [
            {
              "key": "item_sample",
