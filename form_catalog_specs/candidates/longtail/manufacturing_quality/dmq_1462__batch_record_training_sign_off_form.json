    {
      "key": "prerequisites_instruction",
      "title": "Prerequisites, references, and instruction",
      "guidance": "Confirm readiness and teach the current approved master instruction, formula or bill, routing, and batch procedure within the role boundary.",
      "blocks": [
        {
          "key": "prerequisite_checklist",
          "type": "checklist",
          "label": "Prerequisites and learning resources",
          "items": [
            "Role assignment and supervisor authorization are confirmed",
            "Current procedure, work instruction, forms, and reference examples are available",
            "Required foundational or safety training is current",
            "Tools, equipment, software, and practice materials are available",
            "Learner can identify when to stop and request qualified support",
            "Language, literacy, accessibility, or accommodation needs are addressed",
            "Trainer is authorized for the assigned curriculum",
            "Practice work is clearly separated from live production records"
          ]
        },
        {
          "key": "instruction_topics",
          "type": "checklist",
          "label": "Batch Record instruction topics",
          "items": [
            "Master instruction, issued record revision, and unique batch identity",
            "Material lot, actual quantity, equipment, and line-readiness entries",
            "Significant-step date, time, actual value, performer, and verifier",
            "In-process sample, test, calculation, and yield documentation",
            "Contemporaneous deviation, alarm, interruption, and atypical-result entry",
            "Record correction that preserves original information and attribution",
            "Material, packaging, label, scrap, reject, and finished-quantity reconciliation",
            "Production and quality review of open deviations and investigations",
            "Final disposition and complete linked-record archiving"
          ]
        },
        {
          "key": "instruction_notes",
          "type": "textarea",
          "label": "Examples used, questions answered, procedure emphasis, prohibited shortcuts, and learner feedback",
