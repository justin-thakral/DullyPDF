    {
      "key": "basis_and_readiness",
      "title": "Acceptance basis and inspection readiness",
      "guidance": "Confirm the current calibration procedure, equipment specification, and reference-standard chain and the evidence needed to inspect.",
      "blocks": [
        {
          "key": "document_control",
          "type": "fields",
          "label": "Controlled reference set",
          "fields": [
            {
              "key": "primary_reference",
              "label": "Controlling inspection references",
              "units": 1.4
            },
            {
              "key": "reference_revision",
              "label": "Reference revision",
              "units": 0.65
            },
            {
              "key": "acceptance_plan",
              "label": "Acceptance or sampling plan",
              "units": 1.05
            },
            {
              "key": "plan_revision",
              "label": "Plan revision",
              "units": 0.6
            },
            {
              "key": "evidence_folder",
              "label": "Evidence folder or link",
              "units": 1.0
            }
          ]
        },
        {
          "key": "readiness_checkpoints",
          "type": "checklist",
          "label": "Pre-inspection readiness checkpoints",
          "items": [
            "Asset ID, manufacturer, model, serial, range, and resolution agree with the register",
            "Calibration procedure and acceptance limits match the equipment and intended use",
            "Reference standards are identified, in status, and suitable for the measurement range",
            "Environmental conditions meet the procedure or are recorded for qualified review",
            "As-found condition and readings are preserved before adjustment",
            "Each test point records reference value, indication, error, and acceptance status",
            "Adjustment or repair is identified separately from calibration results",
            "As-left results meet the approved return-to-service criteria"
          ]
        },
        {
          "key": "evidence_available",
          "type": "checklist",
          "label": "Available evidence package",
          "items": [
            "Asset register identity and intended-use record",
            "Current calibration procedure and acceptance limits",
            "Reference-standard IDs, certificates, due status, and chain records",
            "Environmental condition readings and stabilization evidence",
            "As-found and as-left test-point results",
            "Adjustment, repair, limitation, or damage record",
            "Out-of-tolerance impact review and affected-measurement search",
            "Certificate, status label, register update, and return authorization"
          ]
        }
      ]
    },
    {
      "key": "inspection_execution",
      "title": "Calibration inspection execution",
      "guidance": "Record actual observations and results against identifiable requirements.",
      "blocks": [
        {
          "key": "measurement_results",
          "type": "table",
          "label": "Calibration test points and measurement results",
          "columns": [
            {
              "key": "function_range",
              "label": "Function / range",
              "units": 0.85
            },
            {
              "key": "reference_value",
              "label": "Reference value",
              "units": 0.85
            },
            {
              "key": "as_found",
              "label": "As found",
              "units": 0.75
            },
            {
              "key": "error_tolerance",
              "label": "Error / tolerance",
              "units": 0.95
            },
            {
              "key": "as_left",
              "label": "As left",
              "units": 0.75
            },
            {
              "key": "status",
              "label": "Pass / fail",
              "units": 0.6
            }
          ],
          "rows": 8,
          "guidance": "Record actual values where the requirement is variable; do not use pass-only entries when evidence is available."
        },
        {
          "key": "execution_controls",
          "type": "checklist",
          "label": "Execution and traceability controls",
          "items": [
            "As-found condition and readings are preserved before adjustment",
            "Each test point records reference value, indication, error, and acceptance status",
            "Adjustment or repair is identified separately from calibration results",
            "As-left results meet the approved return-to-service criteria",
            "Out-of-tolerance findings trigger impact review for prior measurement results",
            "Traceability claims identify the documented calibration chain and associated records",
            "Status label, due date, restrictions, and asset register are updated consistently",
            "Certificate, data, uncertainty information, and review are retrievable"
          ]
        },
        {
          "key": "observation_summary",
          "type": "textarea",
          "label": "Inspection observations, evidence references, sample rationale, and limitations",
          "fields": [
            {
              "key": "observation_detail",
              "label": "Observed condition and evidence summary"
            }
          ],
          "height": 60
        }
      ]
    },
    {
      "key": "findings_containment",
      "title": "Findings, containment, and escalation",
      "guidance": "Make every exception visible with immediate control, ownership, and a disposition route.",
      "blocks": [
        {
          "key": "exception_types",
          "type": "checklist",
          "label": "Calibration exceptions requiring action",
          "items": [
            "Asset identity, range, resolution, or intended use is uncertain",
            "Procedure, acceptance limit, or reference standard is unsuitable",
            "Reference-standard calibration or traceability record is expired or missing",
            "Environmental condition is outside procedure limits",
            "As-found result is outside tolerance or asset is damaged",
            "Adjustment obscures the original as-found condition",
            "Prior measurement impact cannot be bounded or affected product may have shipped",
            "As-left result fails, restriction is unclear, or register and label disagree"
          ],
          "guidance": "Select every applicable exception and preserve the original observation."
        },
        {
          "key": "exception_log",
          "type": "table",
          "label": "Exception, containment, ownership, and disposition log",
          "columns": [
            {
              "key": "exception_evidence",
