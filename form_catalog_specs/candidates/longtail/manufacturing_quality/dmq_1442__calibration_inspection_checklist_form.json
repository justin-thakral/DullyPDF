  "slug": "calibration-inspection-checklist-form",
  "title": "Calibration Inspection Checklist Form",
  "subtitle": "Route the measurement equipment calibration and status control, verify readiness, record requirement-level results, contain exceptions, authorize status, and preserve accountable closeout.",
  "description": "An operational calibration inspection checklist form for controlling a measuring instrument, standard, or gage from assignment through evidence-based inspection, exception containment, disposition, handoff, and final verification.",
  "use_case": "Use when a calibration technician or coordinator must inspect a measuring instrument, standard, or gage against the calibration procedure, equipment specification, and reference-standard chain and provide a traceable basis to return, restrict, remove, repair, or retire the measurement asset.",
  "risk_tier": "A",
  "sections": [
