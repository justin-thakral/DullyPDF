        {
          "key": "result_controls",
          "type": "checklist",
          "label": "Result interpretation controls",
          "items": [
            "Affected and similar processes, products, suppliers, and prior periods were reviewed",
            "Cause analysis distinguishes direct, contributing, detection, and systemic causes",
            "Selected causes are supported by evidence rather than assumption",
            "Actions address verified causes and prevent recurrence or occurrence elsewhere",
            "Each action has an owner, due date, completion evidence, and status",
            "Procedure, training, tooling, system, supplier, and measurement impacts are considered",
            "Implementation changes are controlled and communicated before use",
            "Effectiveness criteria, data source, sample, timing, and reviewer were set in advance"
          ]
        }
      ]
    },
    {
      "key": "findings_analysis",
      "title": "Findings, patterns, and escalation",
      "guidance": "Separate facts from interpretation and route significant or recurring exceptions.",
      "blocks": [
        {
          "key": "report_exception_types",
          "type": "checklist",
          "label": "Corrective Action exceptions requiring action",
          "items": [
            "Problem statement is broad, symptom-only, or unsupported by evidence",
            "Containment remains incomplete or affected scope is uncertain",
            "Cause is selected by opinion without testing available alternatives",
            "Action only corrects the instance and does not address recurrence",
            "Owner, due date, resources, or completion evidence is missing",
            "Implementation occurred outside change control or without communication",
            "Effectiveness test lacks a baseline, target, sample, period, or reviewer",
            "Issue recurs, target is missed, or action creates an adverse effect"
          ],
          "guidance": "Select every applicable exception and preserve the original observation."
        },
