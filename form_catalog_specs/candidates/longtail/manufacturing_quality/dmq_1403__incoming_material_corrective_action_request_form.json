    {
      "key": "immediate_control",
      "title": "Immediate correction, containment, and scope review",
      "guidance": "Protect current and potentially affected output while evidence is preserved.",
      "blocks": [
        {
          "key": "containment_checkpoints",
          "type": "checklist",
          "label": "Containment and affected-scope checkpoints",
          "items": [
            "Supplier identity matches the approved purchasing source",
            "Purchase order item, revision, and quantity match the shipment",
            "Container labels match the packing documentation and supplier lot",
            "Seals and tamper-evident features are intact where specified",
            "Packaging is free of damage, moisture, contamination, or infestation",
            "Shelf-life or expiration information leaves the required usable life",
            "Required certificate of analysis or conformance is present and legible",
            "Storage temperature or handling condition remained within the stated range"
          ]
        },
        {
