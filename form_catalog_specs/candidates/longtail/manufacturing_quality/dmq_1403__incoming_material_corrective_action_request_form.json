          "key": "cause_domains",
          "type": "checklist",
          "label": "Incoming Material cause domains reviewed",
          "items": [
            "Approved supplier or manufacturing source",
            "Material specification, grade, composition, or revision",
            "Sampling level, acceptance number, or test frequency",
            "Inspection method, fixture, instrument, or laboratory",
            "Packaging, container, seal, or labeling requirement",
            "Shelf-life, temperature, humidity, or storage condition",
            "Quarantine status, location, or inventory transaction",
            "Certificate, traceability, or retained-sample requirement",
            "Downstream process or product qualification",
            "Open purchase orders and material already in transit"
