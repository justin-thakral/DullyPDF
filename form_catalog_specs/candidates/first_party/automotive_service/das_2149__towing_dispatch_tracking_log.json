        {
          "key": "authority_notice",
          "type": "notice",
          "label": "Record boundary and unresolved review",
          "guidance": "This operational record does not establish legal towing authority or replace required law-enforcement, impound, inventory, lien, rate-disclosure, insurance, or vehicle-property documents. Keep any unresolved damage, custody, authority, billing, or destination issue assigned to a named owner until final disposition."
