    },
    {
      "key": "live_dispatch_timeline",
      "title": "Live dispatch timeline and communication trail",
      "guidance": "Use actual event times, not estimates, and retain the responsible person, location or status, and confirmation for each milestone.",
      "blocks": [
        {
          "key": "event_log",
          "type": "table",
          "label": "Time-stamped dispatch event log",
          "columns": [
            {"key": "event", "label": "Event", "units": 1.0},
            {"key": "date_time", "label": "Date and time", "units": 0.9},
            {"key": "actor", "label": "Driver or dispatcher", "units": 1.0},
            {"key": "location_status", "label": "Location or status", "units": 1.25},
            {"key": "confirmation", "label": "Note or confirmation", "units": 1.3}
