{
  "schema_version": 1,
  "catalog_id": "automotive_service/das_2149__towing_dispatch_tracking_log",
  "source_section": "automotive_service",
  "source_filename": "das_2149__towing_dispatch_tracking_log.pdf",
  "slug": "towing-dispatch-tracking-log",
  "title": "Towing Dispatch and Custody Tracking Log",
  "subtitle": "Capture call authority, vehicle and scene facts, assigned recovery resources, actual dispatch milestones, pre-movement condition, custody transfers, destination acceptance, exceptions, charges, and final status.",
  "description": "A workflow-complete towing dispatch log covering requesting-party authority, vehicle identity, pickup and destination details, scene hazards and access constraints, service and equipment assignment, driver acceptance, a time-stamped live status trail, pre-existing damage and property evidence, key custody, destination handoff, quoted and final charges, delivery exceptions, unresolved damage or billing reviews, and dispatcher closeout.",
  "use_case": "Use when a dispatcher, tow operator, account representative, and destination receiver need one fillable record connecting the initial towing request to safe resource assignment, actual event times, vehicle custody, accepted delivery, exception resolution, and financial closeout.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "call_intake",
      "title": "Call intake, requesting party, and authority routing",
      "guidance": "Create one dispatch reference from first contact and identify who requested the service, how they relate to the vehicle, and what authority or account reference applies.",
      "blocks": [
        {
          "key": "dispatch_reference",
          "type": "fields",
          "label": "Dispatch call reference",
          "fields": [
            {"key": "dispatch_number", "label": "Dispatch or call number", "units": 0.95},
            {"key": "received_date_time", "label": "Call received date and time", "units": 1.05},
            {"key": "dispatcher", "label": "Dispatcher", "units": 0.8},
            {"key": "priority", "label": "Priority", "units": 0.75, "field_type": "choice", "options": ["Routine", "Priority", "Traffic exposure", "Emergency support", "Scheduled"]},
            {"key": "account_contract", "label": "Account or contract", "units": 1.0},
            {"key": "call_status", "label": "Call status", "units": 0.85, "field_type": "choice", "options": ["Open", "Assigned", "En route", "On scene", "Transporting", "Delivered", "Closed"]}
          ]
        },
        {
          "key": "requesting_party",
          "type": "fields",
          "label": "Requester and callback",
          "fields": [
            {"key": "requester", "label": "Requester, agency, or customer", "units": 1.25},
            {"key": "callback_number", "label": "Callback number", "units": 0.9},
            {"key": "relationship_vehicle", "label": "Relationship to vehicle", "units": 1.0},
            {"key": "on_scene_contact", "label": "On-scene contact", "units": 0.95},
            {"key": "communication_method", "label": "Communication method", "units": 0.9}
          ]
        },
        {
          "key": "authority_reference",
          "type": "fields",
          "label": "Authority, case, and purchase reference",
          "fields": [
            {"key": "authority_type", "label": "Authority type", "units": 0.9, "field_type": "choice", "options": ["Vehicle owner", "Authorized agent", "Motor club", "Fleet account", "Law enforcement", "Property authority", "Other documented authority"]},
            {"key": "authority_name", "label": "Authorizing name or agency", "units": 1.15},
            {"key": "case_po_reference", "label": "Case, authorization, or PO", "units": 1.05},
            {"key": "authority_verified_by", "label": "Verified by", "units": 0.8},
            {"key": "verification_date_time", "label": "Verified date and time", "units": 0.95}
          ]
        },
        {
          "key": "call_intake_notes",
          "type": "textarea",
          "label": "Initial request, customer expectations, jurisdiction, authorization limits, contact attempts, and dispatch routing notes",
          "fields": [
            {"key": "intake_note_detail", "label": "Call intake and authority detail"}
          ],
          "height": 62
        }
      ]
    },
    {
      "key": "vehicle_scene_destination",
      "title": "Vehicle, scene, pickup, and destination",
      "guidance": "Match the vehicle and recovery equipment to the actual location, access, condition, occupant, and requested destination.",
      "blocks": [
