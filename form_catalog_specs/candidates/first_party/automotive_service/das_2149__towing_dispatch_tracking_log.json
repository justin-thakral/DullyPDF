            "Loose parts require securing"
          ]
        },
        {
          "key": "scene_risk_detail",
          "type": "textarea",
          "label": "Exact directions, recovery angle, access limits, vehicle damage already present, occupant status, traffic control, hazards, and safety notes",
          "fields": [
            {"key": "scene_detail", "label": "Scene condition, access, and risk detail"}
          ],
          "height": 78
        },
        {
          "key": "scene_evidence",
