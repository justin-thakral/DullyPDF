          "fields": [
            {"key": "en_route_time", "label": "En route", "units": 0.75},
            {"key": "arrived_time", "label": "Arrived", "units": 0.75},
            {"key": "hooked_loaded_time", "label": "Hooked or loaded", "units": 0.9},
            {"key": "departed_scene_time", "label": "Departed scene", "units": 0.9},
            {"key": "destination_arrival", "label": "Destination arrival", "units": 0.95},
            {"key": "clear_time", "label": "Clear time", "units": 0.75}
          ]
        },
        {
