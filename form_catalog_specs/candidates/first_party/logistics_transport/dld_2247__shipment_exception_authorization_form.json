    {
      "key": "authorization_conditions",
      "title": "Authorization exception and retained limits",
      "guidance": "Stop Shipment Exception at the stated boundary and obtain renewed consent for a material variance.",
      "blocks": [
        {
          "key": "stop_and_route",
          "type": "notice",
          "label": "Do not proceed without renewed authorization",
          "guidance": "Stop normal processing when location, custody, condition, customer communication, or authorized recovery remains unresolved. Protect shipment, affected unit, route event, service commitment, evidence, and recovery action; record the Shipment Exception notification and obtain renewed authorization from shipper / recovery authority before continuing."
        },
        {
          "key": "authorization_stops",
          "type": "checklist",
          "label": "Conditions requiring a hold or renewed authorization",
          "items": [
            "Shipment cannot be located",
            "Condition or quantity cannot be established",
            "Unsafe cargo or handling concern",
            "Customer commitment changes without authority"
          ],
          "guidance": "Identify the affected shipment, affected unit, route event, service commitment, evidence, and recovery action scope, preserve the stated limit, and contact shipper / recovery authority before continuing."
        },
