  "slug": "courier-pickup-form",
  "title": "Courier Pickup Request, Manifest, and Handling Instructions",
  "subtitle": "Create a dispatch-ready request identifying every package, service level, handling control, and authorized handoff.",
  "description": "A courier pickup request and package manifest that carries sender, recipient, service timing, package-level identity, handling, access, custody acceptance, exceptions, pricing, and signatures through pickup closeout.",
  "use_case": "Use before a courier pickup when the requester, dispatcher, sender, and accepting courier need one package-specific record of what is expected, what was accepted, and how exceptions were resolved.",
  "risk_tier": "A",
