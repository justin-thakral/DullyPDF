              "key": "record_number",
              "label": "Tracking record ID",
              "units": 1.0
            },
            {
              "key": "record_date",
              "label": "Date / period",
              "units": 0.8
            },
            {
              "key": "party",
              "label": "Supplier / receiver",
              "units": 1.0555555555555556
            },
            {
              "key": "location",
              "label": "Receiving point / dock",
              "units": 1.2222222222222223
            }
          ]
        },
        {
          "key": "compact_subject_identity",
          "type": "fields",
          "label": "Distribution Delivery Receipt identity",
          "fields": [
            {
              "key": "identity_1",
              "label": "Purchase order, shipment, and appointment",
              "units": 2.2777777777777777
            },
            {
              "key": "identity_2",
              "label": "Carrier, vehicle, trailer, and seal",
              "units": 1.9444444444444444
            },
            {
              "key": "identity_3",
              "label": "Handling-unit, pallet, carton, lot, and item identifiers",
              "units": 2.6
            }
          ]
        }
      ]
    },
    {
      "key": "compact_task_record",
      "title": "Tracking review and variance evidence",
      "guidance": "Capture Distribution Delivery Receipt facts for purchase-order shipment, handling unit, seal, receiving dock, and custody transfer; include result, limit, source, and next control.",
      "blocks": [
        {
          "key": "compact_task_checks",
          "type": "checklist",
          "label": "Distribution Delivery Receipt tracked controls",
          "items": [
            "Arrival and dock times",
            "Seal and trailer condition",
            "Unit count and label match",
            "Visible damage and packaging condition",
            "Temperature or special-handling result",
            "Receiver authority and custody point"
          ]
        },
        {
          "key": "compact_task_lines",
          "type": "table",
          "label": "Status and event entries",
          "columns": [
            {
              "key": "time",
              "label": "Date, time, or event",
              "units": 0.8
            },
            {
              "key": "subject",
              "label": "Item, stage, route, or checkpoint",
              "units": 1.1
            },
            {
              "key": "actual",
              "label": "Actual state, count, or reading",
              "units": 1.05
            },
            {
              "key": "status",
              "label": "Status, variance, or exception",
              "units": 0.95
            },
            {
              "key": "action",
              "label": "Owner and next trigger",
              "units": 1.0
            }
          ],
          "rows": 3
        }
      ]
    },
    {
      "key": "compact_closeout",
      "title": "Status decision and next trigger",
      "guidance": "For Distribution Delivery Receipt, preserve each open variance with its current state, accountable owner, and next dated update. Receiving Lead performs period review.",
      "blocks": [
        {
          "key": "compact_exception_evidence",
          "type": "checklist",
          "label": "Status exceptions, overdue actions, and retained evidence",
          "items": [
            "Count or identity mismatch",
            "Visible damage or compromised seal",
            "Temperature or handling deviation",
            "Receiver or dock authority unavailable",
            "Signed unit-count record",
            "Seal and trailer photographs",
            "Damage and shortage evidence",
            "Receiving-system transaction reference"
          ],
          "guidance": "Pause Distribution Delivery Receipt when identity, count, condition, handling, or custody acceptance remains unresolved. Retain the available Distribution Delivery Receipt proof and route unresolved purchase-order shipment, handling unit, seal, receiving dock, and custody transfer scope to receiving lead."
        },
        {
          "key": "compact_outcome",
