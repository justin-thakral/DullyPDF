  "slug": "delivery-receipt-tracking-log",
  "title": "Delivery Receipt Tracking Log",
  "subtitle": "Distribution Delivery Receipt: preserves changes and next triggers.",
  "description": "Delivery Receipt Tracking Log covers purchase-order shipment, handling unit, seal, receiving dock, and custody transfer. The receiving lead records Distribution Delivery Receipt events, owners, exceptions, and next triggers. Delivery Receipt Tracking Log keeps Distribution Delivery Receipt exceptions visible until the receiving lead handoff.",
  "use_case": "Use Delivery Receipt Tracking Log at origin, destination dock, staging zone, and receiving location. Document purchase-order shipment, handling unit, seal, receiving dock, and custody transfer identity before Distribution Delivery Receipt begins. Compare purchase-order shipment, handling unit, seal, receiving dock, and custody transfer findings with stated Distribution Delivery Receipt criteria; route unresolved Distribution Delivery Receipt issues to distribution operations reviewer.",
  "risk_tier": "A",
  "sections": [
    {
      "key": "compact_identity",
      "title": "Tracking period and subject identity",
      "guidance": "For Distribution Delivery Receipt, identify responsible parties, origin, destination dock, staging zone, and receiving location, and the linked purchase-order shipment, handling unit, seal, receiving dock, and custody transfer source.",
      "blocks": [
        {
          "key": "compact_record_context",
          "type": "fields",
