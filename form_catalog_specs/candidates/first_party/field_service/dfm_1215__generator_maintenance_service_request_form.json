  "slug": "generator-maintenance-service-request-form",
  "title": "Generator Maintenance Service Request and Site Readiness",
  "subtitle": "Create a dispatch-ready request covering asset identity, symptoms, outage constraints, access, hazards, work authority, and service closeout.",
  "description": "A generator-specific request and service record that carries site and asset facts through dispatch, pre-work review, findings, work performed, recommendations, return-to-service status, and customer acceptance.",
